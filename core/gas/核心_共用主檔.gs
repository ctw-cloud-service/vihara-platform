// ============================================================================
// 檔案名稱：核心_共用主檔.gs
// 所屬層級：平台核心／服務層
// 檔案版本：v1.0.0（2026-10-25）
// 用途說明：
//   多個模組共用的基本資料（護法會組別、庫房位置…），統一放在各精舍的
//   「精舍設定」試算表，每種主檔一個分頁（分頁名稱：主檔_主檔名稱）。
//
//   規則：
//     · 由精舍管理員在畫面上維護（權限「平台.管理主檔」）；已登入的人都可讀取。
//     · 每筆資料有固定「代號」，各模組只存代號；改名稱不影響已引用的資料。
//     · 不刪除，只停用（避免已引用的舊資料找不到名稱）。
//
//   主檔定義的寫法（放在用到它的模組檔案中，函式名稱固定為「主檔定義_主檔代號」）：
//
//     function 主檔定義_protector_group() {
//       return {
//         str主檔名稱: '護法會組別',
//         str代號前綴: 'G',                 // 自動代號：G001、G002…
//         arr額外欄位: ['負責人']           // 標準欄位以外需要的欄位（可省略）
//       };
//     }
//
//   每個主檔分頁的標準欄位：代號、名稱、排序、狀態、備註，再加上額外欄位。
//
// 相依檔案：核心_錯誤、核心_試算表存取、核心_工具、核心_結構定義、核心_租戶解析、
//           核心_權限、核心_日誌、核心_流水號、核心_精舍管理（共用檢查函式）
// ============================================================================


// ----------------------------------------------------------------------------
// 本檔常數
// ----------------------------------------------------------------------------
const arr主檔標準欄位 = Object.freeze(['代號', '名稱', '排序', '狀態', '備註']);
const str主檔管理權限 = '平台.管理主檔';


/**
 * ============================================================================
 * 函式名稱：取得主檔定義
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：找出主檔定義並補齊預設值，同時組出分頁定義。
 *
 * 參數：
 *   str主檔代號   {string} 例如 'protector_group'
 *
 * 傳回：
 *   {Object} { str主檔代號, str主檔名稱, str代號前綴, arr額外欄位, obj分頁定義 }
 * ============================================================================
 */
function 取得主檔定義(str主檔代號) {
  const str代號 = String(str主檔代號 || '').trim();

  // 格式檢查：只允許 a–z、0–9、底線
  if (!/^[a-z0-9_]+$/.test(str代號)) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `主檔代號「${str主檔代號}」格式不正確，請通知系統管理員。`);
  }

  // 依固定名稱找出主檔定義函式
  const fn定義 = globalThis[`主檔定義_${str代號}`];
  if (typeof fn定義 !== 'function') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `系統中沒有「${str代號}」這種主檔，請通知系統管理員。`);
  }

  const obj定義 = fn定義() || {};
  const str主檔名稱 = obj定義.str主檔名稱 || str代號;
  const arr額外欄位 = Array.isArray(obj定義.arr額外欄位) ? obj定義.arr額外欄位 : [];

  return {
    str主檔代號: str代號,
    str主檔名稱: str主檔名稱,
    str代號前綴: obj定義.str代號前綴 || '',
    arr額外欄位: arr額外欄位,
    obj分頁定義: { str分頁: `主檔_${str主檔名稱}`, arr欄位: arr主檔標準欄位.concat(arr額外欄位) }
  };
}


/**
 * ============================================================================
 * 函式名稱：取得主檔分頁_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：取得精舍的主檔分頁；第一次使用時自動建立（含標題與欄位標記）。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   obj主檔       {Object} 「取得主檔定義」的結果
 *
 * 傳回：{Sheet}
 * ============================================================================
 */
function 取得主檔分頁_(str精舍代號, obj主檔) {
  const obj設定 = 取得精舍設定試算表(str精舍代號);
  const obj分頁 = obj設定.getSheetByName(obj主檔.obj分頁定義.str分頁);

  // 已存在就直接使用（不重複寫標題，節省時間）
  if (obj分頁) return obj分頁;

  // 第一次使用：依定義建立
  return 建立結構分頁(obj設定, obj主檔.obj分頁定義);
}


/**
 * ============================================================================
 * 函式名稱：列出主檔
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：讀取某種主檔的全部資料，依「排序」由小到大，供畫面顯示或下拉選單使用。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍內任一已登入者的工作階段
 *   obj參數       {Object} { str主檔代號, bool含停用（選填，預設 false） }
 *
 * 傳回：
 *   {Object} { bool成功, str主檔名稱, arr項目: [ { str代號, str名稱, int排序, str狀態, str備註, obj額外 } ] }
 * ============================================================================
 */
function 列出主檔(obj工作階段, obj參數) {
  // 必須是登入某個精舍的人（系統管理員不讀精舍資料）
  if (!obj工作階段 || !obj工作階段.str精舍代號) {
    throw new 平台錯誤(obj錯誤代碼.權限不足, '請先登入精舍後再查看。');
  }
  檢查必要參數(obj參數, ['str主檔代號'], '查看主檔');

  const obj主檔 = 取得主檔定義(obj參數.str主檔代號);
  const obj分頁 = 取得主檔分頁_(obj工作階段.str精舍代號, obj主檔);

  const arr項目 = 讀取全部資料列(obj分頁, obj主檔.obj分頁定義.arr欄位)
    .map(function (obj列) { return 轉換主檔項目_(obj列.obj值, obj主檔); })
    .filter(function (obj項目) { return obj參數.bool含停用 || obj項目.str狀態 === obj狀態.啟用; })
    .sort(function (a, b) { return a.int排序 - b.int排序 || a.str代號.localeCompare(b.str代號); });

  return { bool成功: true, str主檔名稱: obj主檔.str主檔名稱, arr項目: arr項目 };
}


/**
 * ============================================================================
 * 函式名稱：儲存主檔項目
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   新增或修改一筆主檔資料。沒給代號就是新增（系統自動給代號）；有代號就是修改。
 *   同一主檔中，啟用中的名稱不可重複。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} {
 *                    str主檔代號,
 *                    str代號（選填；修改時必填）, str名稱,
 *                    int排序（選填）, str狀態（選填）, str備註（選填）,
 *                    obj額外（選填：{ 額外欄位名稱: 值 }）
 *                  }
 *
 * 傳回：{Object} { bool成功, str代號, str訊息 }
 * ============================================================================
 */
function 儲存主檔項目(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str主檔管理權限, '維護主檔');
  檢查必要參數(obj參數, ['str主檔代號', 'str名稱'], '儲存主檔');

  const str精舍代號 = obj工作階段.str精舍代號;
  const obj主檔 = 取得主檔定義(obj參數.str主檔代號);
  const str名稱 = String(obj參數.str名稱).trim();
  const str狀態 = obj參數.str狀態 ? 檢查狀態值_(obj參數.str狀態) : obj狀態.啟用;
  const str指定代號 = obj參數.str代號 ? String(obj參數.str代號).trim() : '';

  // 組出要寫入的欄位（額外欄位只接受定義中有的）
  const obj欄位值 = { '名稱': str名稱, '狀態': str狀態 };
  if (obj參數.int排序 !== undefined && obj參數.int排序 !== '') obj欄位值['排序'] = Number(obj參數.int排序) || 0;
  if (obj參數.str備註 !== undefined) obj欄位值['備註'] = String(obj參數.str備註);
  Object.keys(obj參數.obj額外 || {}).forEach(function (str欄位) {
    if (obj主檔.arr額外欄位.indexOf(str欄位) === -1) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${obj主檔.str主檔名稱}」沒有「${str欄位}」這個欄位。`);
    }
    obj欄位值[str欄位] = obj參數.obj額外[str欄位];
  });

  let str結果代號 = str指定代號;
  執行並鎖定(function () {
    const obj分頁 = 取得主檔分頁_(str精舍代號, obj主檔);
    const arr全部 = 讀取全部資料列(obj分頁, obj主檔.obj分頁定義.arr欄位);

    // 啟用中的名稱不可重複（修改自己時除外）
    const bool名稱重複 = arr全部.some(function (obj列) {
      return String(obj列.obj值['名稱']).trim() === str名稱
        && String(obj列.obj值['狀態']).trim() === obj狀態.啟用
        && String(obj列.obj值['代號']).trim() !== str指定代號;
    });
    if (bool名稱重複 && str狀態 === obj狀態.啟用) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${obj主檔.str主檔名稱}」中已經有「${str名稱}」。`);
    }

    if (str指定代號 === '') {
      // ── 新增：自動給代號，排序預設排在最後 ──
      const int號碼 = 取得流水號區段(str精舍代號, `主檔_${obj主檔.str主檔代號}`, 1);
      str結果代號 = `${obj主檔.str代號前綴}${String(int號碼).padStart(3, '0')}`;
      if (obj欄位值['排序'] === undefined) obj欄位值['排序'] = arr全部.length + 1;
      新增資料列(obj分頁, Object.assign({ '代號': str結果代號 }, obj欄位值));
    } else {
      // ── 修改：代號必須存在 ──
      const arr目標 = arr全部.filter(function (obj列) { return String(obj列.obj值['代號']).trim() === str指定代號; });
      if (arr目標.length === 0) {
        throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${obj主檔.str主檔名稱}」中找不到代號「${str指定代號}」。`);
      }
      更新資料列(obj分頁, arr目標[0].int列號, obj欄位值);
    }
  }, '儲存主檔');

  寫入操作日誌(obj工作階段, '儲存主檔', `${obj主檔.str主檔名稱}：${str結果代號} ${str名稱}（${str狀態}）`);
  return { bool成功: true, str代號: str結果代號, str訊息: `已儲存「${str名稱}」。` };
}


/**
 * ============================================================================
 * 函式名稱：取得主檔對照
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   供各模組把代號換成名稱（含已停用的項目，舊資料才不會顯示空白）。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   str主檔代號   {string} 例如 'protector_group'
 *
 * 傳回：{Object} { 代號: 名稱 }
 * ============================================================================
 */
function 取得主檔對照(str精舍代號, str主檔代號) {
  const obj主檔 = 取得主檔定義(str主檔代號);
  const obj對照 = {};
  讀取全部資料列(取得主檔分頁_(str精舍代號, obj主檔), ['代號', '名稱']).forEach(function (obj列) {
    obj對照[String(obj列.obj值['代號']).trim()] = String(obj列.obj值['名稱']).trim();
  });
  return obj對照;
}


/**
 * ============================================================================
 * 函式名稱：轉換主檔項目_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：把試算表的一列轉成畫面使用的格式。
 * 參數：
 *   obj值     {Object} 讀出的欄位值
 *   obj主檔   {Object} 主檔定義
 * 傳回：{Object} { str代號, str名稱, int排序, str狀態, str備註, obj額外 }
 * ============================================================================
 */
function 轉換主檔項目_(obj值, obj主檔) {
  const obj額外 = {};
  obj主檔.arr額外欄位.forEach(function (str欄位) { obj額外[str欄位] = obj值[str欄位]; });
  return {
    str代號: String(obj值['代號']).trim(),
    str名稱: String(obj值['名稱']).trim(),
    int排序: Number(obj值['排序']) || 0,
    str狀態: String(obj值['狀態']).trim(),
    str備註: String(obj值['備註'] || ''),
    obj額外: obj額外
  };
}
