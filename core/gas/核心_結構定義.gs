/**
 * ============================================================================
 * 函式名稱：建立結構分頁
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   依分頁定義建立（或補齊）一個分頁：
 *     ① 分頁不存在就新增；
 *     ② 第 1 列寫入標題，缺少的欄位補在最後面（不動到既有欄位與資料）；
 *     ③ 標題列設為粗體並凍結；
 *     ④ 每個欄位貼上隱藏標記，之後改名或搬移都找得到。
 *   可重複執行，已存在的部分不會重複建立。
 *
 * 參數：
 *   obj試算表       {Spreadsheet} 目標試算表
 *   obj分頁定義     {Object}      例如 obj系統主控結構.精舍清單
 *
 * 傳回：
 *   {Sheet} 建立好的分頁
 * ============================================================================
 */
function 建立結構分頁(obj試算表, obj分頁定義) {
  // 防呆：定義必須完整
  if (!obj試算表 || !obj分頁定義 || !obj分頁定義.str分頁 || !Array.isArray(obj分頁定義.arr欄位)) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '建立分頁時缺少試算表或分頁定義，請通知系統管理員。');
  }

  // ① 取得或新增分頁
  let obj分頁 = obj試算表.getSheetByName(obj分頁定義.str分頁);
  if (!obj分頁) {
    obj分頁 = obj試算表.insertSheet(obj分頁定義.str分頁);
  }

  // ② 找出還沒有的欄位（已有標記或已有同名標題都算存在）
  const obj對照 = 取得欄位對照(obj分頁, true);
  const arr缺少欄位 = obj分頁定義.arr欄位.filter(function (str欄位) {
    return 查找欄號(obj對照, str欄位) === 0;
  });

  // 缺少的欄位接在目前最後一欄之後
  if (arr缺少欄位.length > 0) {
    obj分頁.getRange(1, obj對照.int最後欄 + 1, 1, arr缺少欄位.length).setValues([arr缺少欄位]);
  }

  // ③ 標題列粗體、凍結第 1 列
  const int最後欄 = obj分頁.getLastColumn();
  obj分頁.getRange(1, 1, 1, int最後欄).setFontWeight('bold');
  obj分頁.setFrozenRows(1);

  // ④ 貼上欄位標記：只替「目前標題仍與代號相同、且還沒有標記」的欄位貼，
  //    已經有標記的欄位（可能被人改過標題）保持原樣
  const obj最新對照 = 取得欄位對照(obj分頁, true);
  const obj待標記 = {};
  obj分頁定義.arr欄位.forEach(function (str欄位) {
    if (!obj最新對照.obj依標記[str欄位] && obj最新對照.obj依標題[str欄位]) {
      obj待標記[str欄位] = str欄位;
    }
  });
  if (Object.keys(obj待標記).length > 0) {
    標記欄位代號(obj分頁, obj待標記);
  }

  return obj分頁;
}


/**
 * ============================================================================
 * 函式名稱：建立整份結構
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   依結構定義（例如 obj系統主控結構）一次建立所有分頁，
 *   並刪除新試算表預設的空白「工作表1」。
 *
 * 參數：
 *   obj試算表   {Spreadsheet} 目標試算表
 *   obj結構     {Object}      obj系統主控結構 或 obj精舍設定結構
 *
 * 傳回：
 *   {number} 處理的分頁數量
 * ============================================================================
 */
function 建立整份結構(obj試算表, obj結構) {
  // 逐一建立
  const arr定義 = Object.keys(obj結構).map(function (str鍵) { return obj結構[str鍵]; });
  arr定義.forEach(function (obj分頁定義) {
    建立結構分頁(obj試算表, obj分頁定義);
  });

  // 刪除沒有內容、且不在定義中的預設分頁（例如「工作表1」「Sheet1」）
  const arr定義名稱 = arr定義.map(function (obj) { return obj.str分頁; });
  obj試算表.getSheets().forEach(function (obj分頁) {
    const bool不在定義 = arr定義名稱.indexOf(obj分頁.getName()) === -1;
    const bool是空白 = obj分頁.getLastRow() === 0 && obj分頁.getLastColumn() === 0;
    if (bool不在定義 && bool是空白 && obj試算表.getSheets().length > 1) {
      obj試算表.deleteSheet(obj分頁);
    }
  });

  return arr定義.length;
}
