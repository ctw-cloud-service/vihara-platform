// ============================================================================
// 檔案名稱：核心_錯誤.gs
// 所屬層級：平台核心／共用
// 檔案版本：v1.2.0（2026-10-25）
//   v1.2.0：「檢查必要參數」顯示給使用者的欄位名稱去掉型態代碼（str帳號 → 帳號）
//   v1.1.0：新增「登入失敗」「登入逾時」「權限不足」三個錯誤代碼
//   v1.0.0：初版
// 用途說明：
//   定義整個平台統一使用的「錯誤代碼」、「錯誤類型」與「錯誤回應格式」。
//   所有模組遇到問題時，一律丟出「平台錯誤」，由路由統一轉成前端看得懂的回應，
//   讓使用者看到的永遠是白話的說明，而不是程式內部的英文錯誤訊息。
// 相依檔案：無（本檔是最底層，其他檔案都會用到它）
// ============================================================================


// ----------------------------------------------------------------------------
// 錯誤代碼一覽
// 說明：前端依「代碼」判斷要怎麼處理（例如登入逾時就導回登入頁），
//       使用者看到的則是「訊息」。代碼用英文是為了前後端比對穩定，不會因改字而失效。
// ----------------------------------------------------------------------------
const obj錯誤代碼 = Object.freeze({
  參數錯誤: 'BAD_PARAMETER',          // 呼叫時少給資料或資料格式不對
  設定缺漏: 'CONFIG_MISSING',         // 指令碼屬性（系統設定）沒有設定
  檔案無法開啟: 'FILE_OPEN_FAILED',   // 試算表被刪除、或沒有共享給系統帳號
  工作表不存在: 'SHEET_NOT_FOUND',    // 試算表裡找不到指定名稱的分頁
  欄位缺漏: 'COLUMN_MISSING',         // 分頁裡找不到必要的欄位（可能被改名或刪除）
  資料列不存在: 'ROW_NOT_FOUND',      // 指定的列號超出範圍或是標題列
  系統忙碌: 'SYSTEM_BUSY',            // 同時太多人操作，暫時拿不到鎖定
  登入失敗: 'AUTH_FAILED',            // Google 憑證無效，或帳號不屬於此精舍
  登入逾時: 'SESSION_EXPIRED',        // 工作階段過期或不存在，前端應導回登入頁
  權限不足: 'FORBIDDEN',              // 已登入，但沒有執行此動作的權限
  未預期錯誤: 'UNEXPECTED_ERROR'      // 其他無法歸類的問題
});


/**
 * ============================================================================
 * 類別名稱：平台錯誤
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   平台專用的錯誤類型。與一般 Error 的差別是多帶了「錯誤代碼」與
 *   「給使用者看的白話訊息」，以及方便系統管理員追查的「詳細資料」。
 *
 * 建構參數：
 *   str錯誤代碼     {string} 取自 obj錯誤代碼，例如 obj錯誤代碼.欄位缺漏
 *   str使用者訊息   {string} 直接顯示給使用者的白話說明
 *   obj詳細資料     {Object} 選填，記錄追查用的內部資訊（不會顯示給使用者）
 *
 * 範例：
 *   throw new 平台錯誤(obj錯誤代碼.參數錯誤, '請輸入活動名稱。');
 * ============================================================================
 */
class 平台錯誤 extends Error {
  constructor(str錯誤代碼, str使用者訊息, obj詳細資料) {
    // 呼叫父類別，讓 message 也有內容（執行紀錄裡看得到）
    super(str使用者訊息 || '系統發生未預期的問題，請稍後再試。');

    // 類型名稱，方便在執行紀錄中辨識
    this.name = '平台錯誤';

    // 錯誤代碼：沒給就當作未預期錯誤
    this.str錯誤代碼 = str錯誤代碼 || obj錯誤代碼.未預期錯誤;

    // 使用者訊息：與 message 相同，另存一份讓意圖更清楚
    this.str使用者訊息 = this.message;

    // 詳細資料：只供系統管理員追查，不回傳給前端
    this.obj詳細資料 = obj詳細資料 || {};
  }
}


/**
 * ============================================================================
 * 函式名稱：轉換為平台錯誤
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把任何錯誤（Google 內建錯誤、程式錯字造成的錯誤…）統一包裝成「平台錯誤」。
 *   已經是平台錯誤的就原封不動傳回，避免重複包裝而失去原本的白話訊息。
 *
 * 參數：
 *   err原始錯誤   {*}      捕捉到的任何錯誤
 *   str發生情境   {string} 正在做什麼事時出錯，例如「讀取活動清單」
 *
 * 傳回：
 *   {平台錯誤} 包裝後的錯誤
 * ============================================================================
 */
function 轉換為平台錯誤(err原始錯誤, str發生情境) {
  // 已經是平台錯誤：直接傳回，保留原本的代碼與白話訊息
  if (err原始錯誤 instanceof 平台錯誤) {
    return err原始錯誤;
  }

  // 取出原始訊息：有 message 就用 message，否則轉成文字
  const str原始訊息 = (err原始錯誤 && err原始錯誤.message)
    ? err原始錯誤.message
    : String(err原始錯誤);

  // 沒說明情境時，用通用說法
  const str情境 = str發生情境 || '執行作業';

  // 組成給使用者看的訊息：說明發生什麼事＋下一步怎麼做
  const str使用者訊息 = `${str情境}時發生未預期的問題，請稍後再試一次；若一直發生，請通知系統管理員。`;

  return new 平台錯誤(obj錯誤代碼.未預期錯誤, str使用者訊息, {
    str發生情境: str情境,
    str原始訊息: str原始訊息,
    str堆疊: (err原始錯誤 && err原始錯誤.stack) ? String(err原始錯誤.stack) : ''
  });
}


/**
 * ============================================================================
 * 函式名稱：建立錯誤回應
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把錯誤轉成回傳給前端的固定格式。詳細資料不會放進回應，
 *   避免把檔案代號等內部資訊洩漏到瀏覽器。
 *
 * 參數：
 *   err錯誤       {*}      捕捉到的任何錯誤
 *   str發生情境   {string} 選填，正在做什麼事時出錯
 *
 * 傳回：
 *   {Object} { bool成功: false, str錯誤代碼, str訊息 }
 * ============================================================================
 */
function 建立錯誤回應(err錯誤, str發生情境) {
  // 先統一包裝成平台錯誤
  const err平台 = 轉換為平台錯誤(err錯誤, str發生情境 || '處理請求');

  // 在執行紀錄留下完整資訊，方便系統管理員到「執行作業」頁面追查
  console.error(`[${err平台.str錯誤代碼}] ${err平台.str使用者訊息}`, JSON.stringify(err平台.obj詳細資料));

  // 只回傳代碼與白話訊息
  return {
    bool成功: false,
    str錯誤代碼: err平台.str錯誤代碼,
    str訊息: err平台.str使用者訊息
  };
}


/**
 * ============================================================================
 * 函式名稱：檢查必要參數
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   檢查呼叫時傳入的資料是否齊全。缺少的項目會一次全部列出，
 *   讓使用者一次補齊，不必一項一項試。
 *
 * 參數：
 *   obj參數         {Object}   要檢查的資料
 *   arr必要名稱     {string[]} 必須有值的項目名稱
 *   str作業名稱     {string}   正在做的事，用於錯誤訊息，例如「新增活動」
 *
 * 傳回：
 *   無（通過就安靜結束；不通過會丟出「平台錯誤」）
 * ============================================================================
 */
function 檢查必要參數(obj參數, arr必要名稱, str作業名稱) {
  // 整包資料都沒給
  if (obj參數 === null || obj參數 === undefined || typeof obj參數 !== 'object') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${str作業名稱}」沒有收到任何資料，請重新操作一次。`);
  }

  // 逐一檢查：undefined、null、空字串（去除空白後）都算沒填
  const arr缺少項目 = arr必要名稱.filter(function (str名稱) {
    const any值 = obj參數[str名稱];
    if (any值 === undefined || any值 === null) return true;
    if (typeof any值 === 'string' && any值.trim() === '') return true;
    return false;
  });

  // 有缺少就一次列出；顯示時去掉開頭的英文型態代碼（str帳號 → 帳號），使用者才看得懂
  if (arr缺少項目.length > 0) {
    const arr顯示名稱 = arr缺少項目.map(function (str名稱) { return str名稱.replace(/^[a-z]+(?=[^a-z])/, ''); });
    throw new 平台錯誤(
      obj錯誤代碼.參數錯誤,
      `「${str作業名稱}」缺少以下資料：${arr顯示名稱.join('、')}。請補齊後再試。`,
      { arr缺少項目: arr缺少項目 }
    );
  }
}
