// ============================================================================
// 檔案名稱：核心_副本管理.gs
// 所屬層級：平台核心／服務層
// 檔案版本：v1.0.0（2026-10-25）
// 用途說明：
//   活動型模組（法會活動、禪修班…）共用的副本機制：
//     · 從範本複製一份副本，放在「精舍資料夾／模組名稱副本」資料夾
//     · 登記到精舍設定的「副本清單」，並在副本內貼上隱藏的副本資訊
//     · 共享名單＝本精舍啟用中的精舍管理員＋該副本指派的承辦人（且承辦人仍啟用）
//     · 人員異動時重新同步，多的移除、少的補上
//
//   各模組只要呼叫本檔函式，不必自己處理檔案與共享。
//
// 相依檔案：核心_錯誤、核心_試算表存取、核心_工具、核心_結構定義、核心_租戶解析、
//           核心_模組管理
// ============================================================================


// ----------------------------------------------------------------------------
// 本檔常數
// ----------------------------------------------------------------------------
const str副本資訊鍵 = '平台副本資訊';   // 副本內隱藏資訊（試算表層級 DeveloperMetadata）的鍵名


/**
 * ============================================================================
 * 函式名稱：建立副本
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   從範本建立一份副本、登記到副本清單，並依指派人員設定共享。
 *   中途失敗時會把已複製的副本丟到垃圾桶，不留半套資料。
 *   ※ 供模組內部呼叫，權限檢查由呼叫的模組負責。
 *
 * 參數：
 *   obj參數 {Object} {
 *     str精舍代號, str模組代號,
 *     str記錄ID,       模組自己的記錄代號（例如活動 ID），用來對應回模組主控台
 *     str範本ID,       要複製的範本試算表代號
 *     str副本名稱,     例如「2026 觀音法會」
 *     arr指派帳號      選填，指派的承辦人 Google 帳號
 *   }
 *
 * 傳回：
 *   {Object} { str副本ID, str網址, obj同步結果 }
 * ============================================================================
 */
function 建立副本(obj參數) {
  檢查必要參數(obj參數, ['str精舍代號', 'str模組代號', 'str記錄ID', 'str範本ID', 'str副本名稱'], '建立副本');

  const obj精舍 = 取得精舍資訊(obj參數.str精舍代號);
  const obj模組 = 取得模組定義(obj參數.str模組代號);
  if (!obj模組) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `系統中沒有「${obj參數.str模組代號}」模組，無法建立副本。`);
  }
  const arr指派 = 整理帳號清單_(obj參數.arr指派帳號);

  // ── 取得範本 ──
  let obj範本檔;
  try {
    obj範本檔 = DriveApp.getFileById(String(obj參數.str範本ID).trim());
  } catch (err) {
    throw new 平台錯誤(
      obj錯誤代碼.檔案無法開啟,
      `找不到「${obj模組.str模組名稱}」的範本檔，可能已被刪除。請通知系統管理員。`,
      { str範本ID: obj參數.str範本ID }
    );
  }

  // ── 複製到「精舍資料夾／模組名稱副本」 ──
  const obj存放資料夾 = 取得副本資料夾_(obj精舍, obj模組.str模組名稱);
  const obj副本檔 = obj範本檔.makeCopy(String(obj參數.str副本名稱).trim(), obj存放資料夾);
  const str副本ID = obj副本檔.getId();

  try {
    // 在副本內貼上隱藏資訊（副本選單呼叫系統時用來辨識身分）
    SpreadsheetApp.openById(str副本ID).addDeveloperMetadata(str副本資訊鍵, JSON.stringify({
      str精舍代號: obj精舍.str精舍代號,
      str模組代號: obj模組.str模組代號,
      str記錄ID: String(obj參數.str記錄ID)
    }));

    // 登記到副本清單
    執行並鎖定(function () {
      const obj定義 = obj精舍設定結構.副本清單;
      新增資料列(取得工作表(取得精舍設定試算表(obj精舍.str精舍代號), obj定義.str分頁), {
        '副本ID': str副本ID,
        '模組代號': obj模組.str模組代號,
        '記錄ID': String(obj參數.str記錄ID),
        '名稱': String(obj參數.str副本名稱).trim(),
        '指派帳號': arr指派.join(','),
        '狀態': obj狀態.啟用,
        '建立日期': new Date()
      });
    }, '登記副本');
  } catch (err) {
    // 失敗：丟掉剛複製的副本
    try { obj副本檔.setTrashed(true); } catch (errIgnore) { /* 略過 */ }
    throw err;
  }

  // 設定共享（失敗不影響副本建立，結果交給呼叫端提示使用者）
  const obj同步結果 = 同步副本共享(obj精舍.str精舍代號, str副本ID);

  return { str副本ID: str副本ID, str網址: obj副本檔.getUrl(), obj同步結果: obj同步結果 };
}


/**
 * ============================================================================
 * 函式名稱：讀取副本資訊
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   由副本代號查出它屬於哪個精舍、哪個模組、哪筆記錄，以及目前指派的人。
 *   同時比對副本內的隱藏資訊與副本清單，兩者不一致時拒絕使用（防止偽造）。
 *
 * 參數：
 *   str副本ID   {string} 副本試算表代號
 *
 * 傳回：
 *   {Object} { str副本ID, str精舍代號, str模組代號, str記錄ID, str名稱, arr指派帳號, str狀態, int列號 }
 * ============================================================================
 */
function 讀取副本資訊(str副本ID) {
  const str代號 = String(str副本ID || '').trim();

  // ── 讀副本內的隱藏資訊 ──
  const obj副本 = 開啟試算表(str代號, '活動副本');
  const arr標記 = obj副本.createDeveloperMetadataFinder().withKey(str副本資訊鍵).find();
  if (arr標記.length === 0) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '這份試算表不是由平台建立的副本，無法使用平台功能。');
  }
  let obj內嵌;
  try {
    obj內嵌 = JSON.parse(arr標記[0].getValue());
  } catch (err) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '副本的隱藏資訊已損壞，請通知系統管理員。');
  }

  // ── 比對副本清單 ──
  const obj定義 = obj精舍設定結構.副本清單;
  const arr符合 = 依條件尋找資料列(
    取得工作表(取得精舍設定試算表(obj內嵌.str精舍代號), obj定義.str分頁),
    obj定義.arr欄位,
    function (obj值) { return String(obj值['副本ID']).trim() === str代號; }
  );
  if (arr符合.length === 0
    || String(arr符合[0].obj值['模組代號']).trim() !== obj內嵌.str模組代號
    || String(arr符合[0].obj值['記錄ID']).trim() !== String(obj內嵌.str記錄ID)) {
    throw new 平台錯誤(obj錯誤代碼.權限不足, '這份副本的登記資料不一致，已停止使用。請通知系統管理員。');
  }

  const obj值 = arr符合[0].obj值;
  return {
    str副本ID: str代號,
    str精舍代號: 正規化精舍代號(obj內嵌.str精舍代號),
    str模組代號: obj內嵌.str模組代號,
    str記錄ID: String(obj內嵌.str記錄ID),
    str名稱: String(obj值['名稱']).trim(),
    arr指派帳號: 整理帳號清單_(String(obj值['指派帳號']).split(',')),
    str狀態: String(obj值['狀態']).trim(),
    int列號: arr符合[0].int列號
  };
}


/**
 * ============================================================================
 * 函式名稱：設定副本指派
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：更換副本指派的承辦人（整組取代），並立即同步共享。
 *       ※ 供模組內部呼叫，權限檢查由呼叫的模組負責。
 *
 * 參數：
 *   str精舍代號   {string}   精舍代號
 *   str副本ID     {string}   副本代號
 *   arr指派帳號   {string[]} 指派的承辦人 Google 帳號
 *
 * 傳回：{Object} 同步結果（見「同步副本共享」）
 * ============================================================================
 */
function 設定副本指派(str精舍代號, str副本ID, arr指派帳號) {
  const arr指派 = 整理帳號清單_(arr指派帳號);

  執行並鎖定(function () {
    const obj定義 = obj精舍設定結構.副本清單;
    const obj分頁 = 取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁);
    const obj列 = 找出唯一資料列_(obj分頁, obj定義.arr欄位, function (obj值) {
      return String(obj值['副本ID']).trim() === String(str副本ID).trim();
    }, '副本清單中找不到這份副本。');
    更新資料列(obj分頁, obj列.int列號, { '指派帳號': arr指派.join(',') });
  }, '設定副本指派');

  return 同步副本共享(str精舍代號, str副本ID);
}


/**
 * ============================================================================
 * 函式名稱：設定副本狀態
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   啟用或停用副本。停用的副本不再自動同步共享（例如活動已結束），
 *   但檔案與既有共享保持不變。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   str副本ID     {string} 副本代號
 *   str狀態       {string} 啟用／停用
 *
 * 傳回：無
 * ============================================================================
 */
function 設定副本狀態(str精舍代號, str副本ID, str狀態) {
  const str新狀態 = 檢查狀態值_(str狀態);
  執行並鎖定(function () {
    const obj定義 = obj精舍設定結構.副本清單;
    const obj分頁 = 取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁);
    const obj列 = 找出唯一資料列_(obj分頁, obj定義.arr欄位, function (obj值) {
      return String(obj值['副本ID']).trim() === String(str副本ID).trim();
    }, '副本清單中找不到這份副本。');
    更新資料列(obj分頁, obj列.int列號, { '狀態': str新狀態 });
  }, '設定副本狀態');
}


/**
 * ============================================================================
 * 函式名稱：同步副本共享
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   讓副本的編輯者剛好等於「應有名單」：少的補上、多的移除。
 *   擁有者（系統帳號）永遠保留。個別帳號失敗時不中斷，最後一併回報。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   str副本ID     {string} 副本代號
 *
 * 傳回：
 *   {Object} { arr新增, arr移除, arr失敗: [ { str帳號, str原因 } ] }
 * ============================================================================
 */
function 同步副本共享(str精舍代號, str副本ID) {
  const obj結果 = { arr新增: [], arr移除: [], arr失敗: [] };

  // 應有名單
  const obj副本列 = 讀取副本清單列_(str精舍代號, str副本ID);
  const arr應有 = 計算應有編輯者_(str精舍代號, obj副本列.arr指派帳號);

  // 目前的編輯者（排除擁有者）
  const obj檔案 = DriveApp.getFileById(String(str副本ID).trim());
  const str擁有者 = obj檔案.getOwner() ? 正規化帳號(obj檔案.getOwner().getEmail()) : '';
  const arr目前 = obj檔案.getEditors()
    .map(function (obj使用者) { return 正規化帳號(obj使用者.getEmail()); })
    .filter(function (str帳號) { return str帳號 !== '' && str帳號 !== str擁有者; });

  // 補上缺少的
  arr應有.filter(function (str帳號) { return arr目前.indexOf(str帳號) === -1 && str帳號 !== str擁有者; })
    .forEach(function (str帳號) {
      try {
        obj檔案.addEditor(str帳號);
        obj結果.arr新增.push(str帳號);
      } catch (err) {
        obj結果.arr失敗.push({ str帳號: str帳號, str原因: '無法加入共享，請確認是有效的 Google 帳號' });
      }
    });

  // 移除多出來的
  arr目前.filter(function (str帳號) { return arr應有.indexOf(str帳號) === -1; })
    .forEach(function (str帳號) {
      try {
        obj檔案.removeEditor(str帳號);
        obj結果.arr移除.push(str帳號);
      } catch (err) {
        obj結果.arr失敗.push({ str帳號: str帳號, str原因: '無法移除共享' });
      }
    });

  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：同步精舍全部副本
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   人員異動（停用承辦人、新增或停用精舍管理員）後，重新同步本精舍所有啟用中的副本。
 *   單一副本失敗不影響其他副本。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *
 * 傳回：
 *   {Object} { int副本數, int異動數, arr問題: [ 文字說明 ] }
 * ============================================================================
 */
function 同步精舍全部副本(str精舍代號) {
  const obj定義 = obj精舍設定結構.副本清單;
  const arr副本 = 依條件尋找資料列(
    取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁),
    obj定義.arr欄位,
    function (obj值) { return String(obj值['狀態']).trim() === obj狀態.啟用; }
  );

  const obj彙總 = { int副本數: arr副本.length, int異動數: 0, arr問題: [] };
  arr副本.forEach(function (obj列) {
    const str名稱 = String(obj列.obj值['名稱']).trim();
    try {
      const obj結果 = 同步副本共享(str精舍代號, String(obj列.obj值['副本ID']).trim());
      obj彙總.int異動數 += obj結果.arr新增.length + obj結果.arr移除.length;
      obj結果.arr失敗.forEach(function (obj失敗) {
        obj彙總.arr問題.push(`「${str名稱}」${obj失敗.str帳號}：${obj失敗.str原因}`);
      });
    } catch (err) {
      obj彙總.arr問題.push(`「${str名稱}」無法同步：${err && err.message ? err.message : err}`);
    }
  });

  return obj彙總;
}


/**
 * ============================================================================
 * 函式名稱：人員異動後同步副本
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   供人員管理、精舍管理在人員異動後呼叫。同步失敗不會讓原本的異動失敗，
 *   只把需要注意的事組成一句提醒，附在回覆訊息後面。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *
 * 傳回：{string} 提醒文字；沒有問題時為空字串
 * ============================================================================
 */
function 人員異動後同步副本(str精舍代號) {
  try {
    const obj彙總 = 同步精舍全部副本(str精舍代號);
    if (obj彙總.arr問題.length === 0) return '';
    return `（另有 ${obj彙總.arr問題.length} 項副本共享未完成：${obj彙總.arr問題.join('；')}）`;
  } catch (err) {
    console.warn('人員異動後同步副本失敗：' + (err && err.message ? err.message : err));
    return '（副本共享稍後未能同步，請稍後在精舍設定頁按「重新同步副本共享」。）';
  }
}


