/**
 * ============================================================================
 * 函式名稱：讀取副本清單列_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：從副本清單讀出一份副本的登記資料。
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   str副本ID     {string} 副本代號
 * 傳回：{Object} { int列號, arr指派帳號, str狀態 }
 * ============================================================================
 */
function 讀取副本清單列_(str精舍代號, str副本ID) {
  const obj定義 = obj精舍設定結構.副本清單;
  const obj列 = 找出唯一資料列_(
    取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁),
    obj定義.arr欄位,
    function (obj值) { return String(obj值['副本ID']).trim() === String(str副本ID).trim(); },
    '副本清單中找不到這份副本。'
  );
  return {
    int列號: obj列.int列號,
    arr指派帳號: 整理帳號清單_(String(obj列.obj值['指派帳號']).split(',')),
    str狀態: String(obj列.obj值['狀態']).trim()
  };
}


/**
 * ============================================================================
 * 函式名稱：計算應有編輯者_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：應有名單＝本精舍啟用中的精舍管理員＋指派帳號中仍是啟用承辦人的人。
 * 參數：
 *   str精舍代號   {string}   精舍代號
 *   arr指派帳號   {string[]} 副本指派的帳號
 * 傳回：{string[]} 應有的編輯者帳號
 * ============================================================================
 */
function 計算應有編輯者_(str精舍代號, arr指派帳號) {
  const str代號 = 正規化精舍代號(str精舍代號);
  const arr名單 = [];

  // 啟用中的精舍管理員
  const obj管理員定義 = obj系統主控結構.精舍管理員;
  依條件尋找資料列(取得工作表(取得系統主控(), obj管理員定義.str分頁), obj管理員定義.arr欄位, function (obj值) {
    return String(obj值['精舍代號']).trim().toUpperCase() === str代號
      && String(obj值['狀態']).trim() === obj狀態.啟用;
  }).forEach(function (obj列) { arr名單.push(正規化帳號(obj列.obj值['Google帳號'])); });

  // 指派帳號中，仍是啟用承辦人的人
  const obj人員定義 = obj精舍設定結構.人員;
  const obj啟用人員 = {};
  依條件尋找資料列(取得工作表(取得精舍設定試算表(str代號), obj人員定義.str分頁), obj人員定義.arr欄位, function (obj值) {
    return String(obj值['狀態']).trim() === obj狀態.啟用;
  }).forEach(function (obj列) { obj啟用人員[正規化帳號(obj列.obj值['Google帳號'])] = true; });

  arr指派帳號.forEach(function (str帳號) {
    if (obj啟用人員[str帳號]) arr名單.push(str帳號);
  });

  return 整理帳號清單_(arr名單);
}


/**
 * ============================================================================
 * 函式名稱：整理帳號清單_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：帳號清單統一小寫、去除空白與重複。
 * 參數：
 *   arr帳號   {string[]} 原始清單（可為 undefined）
 * 傳回：{string[]}
 * ============================================================================
 */
function 整理帳號清單_(arr帳號) {
  const arr結果 = [];
  (arr帳號 || []).forEach(function (str帳號) {
    const str值 = 正規化帳號(str帳號);
    if (str值 !== '' && arr結果.indexOf(str值) === -1) arr結果.push(str值);
  });
  return arr結果;
}


/**
 * ============================================================================
 * 函式名稱：取得副本資料夾_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：取得「精舍資料夾／模組名稱副本」資料夾，沒有就建立。
 * 參數：
 *   obj精舍       {Object} 精舍資訊
 *   str模組名稱   {string} 例如「法會活動」
 * 傳回：{Folder}
 * ============================================================================
 */
function 取得副本資料夾_(obj精舍, str模組名稱) {
  let obj精舍資料夾;
  try {
    obj精舍資料夾 = DriveApp.getFolderById(obj精舍.str精舍資料夾ID);
  } catch (err) {
    throw new 平台錯誤(
      obj錯誤代碼.檔案無法開啟,
      `找不到「${obj精舍.str精舍名稱}」的資料夾，可能已被刪除。請通知系統管理員。`
    );
  }

  // 已有同名資料夾就沿用
  const str資料夾名稱 = `${str模組名稱}副本`;
  const obj既有 = obj精舍資料夾.getFoldersByName(str資料夾名稱);
  if (obj既有.hasNext()) return obj既有.next();

  return obj精舍資料夾.createFolder(str資料夾名稱);
}
