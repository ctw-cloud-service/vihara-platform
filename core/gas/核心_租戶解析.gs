// ============================================================================
// 檔案名稱：核心_租戶解析.gs
// 所屬層級：平台核心／控制層
// 檔案版本：v1.2.0（2026-10-25）
//   v1.2.0：新增「取得精舍外部檔案設定」，同時取得檔案代號與分頁名稱
//   v1.1.0：新增「清除精舍快取」，精舍資料修改後立即生效
//   v1.0.0：初版
// 用途說明：
//   由「精舍代號」查出該精舍的各項檔案位置（精舍設定、模組主控台、外部檔案）。
//   前端永遠不傳檔案代號，一律由本檔在伺服器端查出，確保各精舍資料互不相通。
// 相依檔案：核心_錯誤.gs、核心_試算表存取.gs、核心_工具.gs、核心_結構定義.gs
// ============================================================================


// ----------------------------------------------------------------------------
// 同一次執行內的快取（執行結束自動清空，不會讀到過期資料）
// ----------------------------------------------------------------------------
const obj租戶快取_ = {
  obj系統主控: null,     // 已開啟的系統主控試算表
  obj精舍: {}            // 精舍代號 → 精舍資訊
};

// 測試專用：指定暫存的系統主控試算表，正式執行時一律為 null
let str測試用系統主控ID_ = null;


/**
 * ============================================================================
 * 函式名稱：設定測試用系統主控_
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：僅供測試程式使用，改用暫存的系統主控試算表，不影響正式資料。
 * 參數：
 *   str試算表ID   {string|null} 暫存試算表代號；傳 null 恢復正式設定
 * 傳回：無
 * ============================================================================
 */
function 設定測試用系統主控_(str試算表ID) {
  str測試用系統主控ID_ = str試算表ID || null;
  // 切換來源後清除快取
  obj租戶快取_.obj系統主控 = null;
  obj租戶快取_.obj精舍 = {};
}


/**
 * ============================================================================
 * 函式名稱：清除精舍快取
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：修改精舍名稱或狀態後呼叫，讓同一次執行中後續讀到最新資料。
 * 參數：
 *   str精舍代號   {string} 選填；不給就清除全部精舍快取
 * 傳回：無
 * ============================================================================
 */
function 清除精舍快取(str精舍代號) {
  if (str精舍代號) {
    delete obj租戶快取_.obj精舍[String(str精舍代號).trim().toUpperCase()];
    return;
  }
  obj租戶快取_.obj精舍 = {};
}


/**
 * ============================================================================
 * 函式名稱：取得系統主控
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：開啟系統主控試算表（同一次執行只開一次）。
 * 參數：無
 * 傳回：{Spreadsheet} 系統主控試算表
 * ============================================================================
 */
function 取得系統主控() {
  // 已開啟過就直接用
  if (obj租戶快取_.obj系統主控) return obj租戶快取_.obj系統主控;

  // 測試時用暫存檔，正式時讀指令碼屬性
  const str試算表ID = str測試用系統主控ID_ || 取得系統設定值(obj設定名稱.系統主控試算表ID);
  obj租戶快取_.obj系統主控 = 開啟試算表(str試算表ID, '系統主控試算表');
  return obj租戶快取_.obj系統主控;
}


/**
 * ============================================================================
 * 函式名稱：取得精舍資訊
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   依精舍代號查出精舍名稱與檔案位置。精舍不存在或已停用時給出白話說明。
 *
 * 參數：
 *   str精舍代號     {string}  精舍代號（大小寫皆可）
 *   bool允許停用    {boolean} 選填，true 時已停用的精舍也傳回（供總管理頁使用）
 *
 * 傳回：
 *   {Object} { str精舍代號, str精舍名稱, str精舍資料夾ID, str精舍設定ID, str狀態 }
 * ============================================================================
 */
function 取得精舍資訊(str精舍代號, bool允許停用) {
  // 統一格式（也會擋掉格式錯誤的代號）
  const str代號 = 正規化精舍代號(str精舍代號);

  // 讀取（同一次執行只查一次）
  let obj精舍 = obj租戶快取_.obj精舍[str代號];
  if (!obj精舍) {
    const obj定義 = obj系統主控結構.精舍清單;
    const obj分頁 = 取得工作表(取得系統主控(), obj定義.str分頁);
    const arr符合 = 依條件尋找資料列(obj分頁, obj定義.arr欄位, function (obj值) {
      return String(obj值['精舍代號']).trim().toUpperCase() === str代號;
    });

    // 找不到這個精舍
    if (arr符合.length === 0) {
      throw new 平台錯誤(
        obj錯誤代碼.參數錯誤,
        `找不到精舍代號「${str代號}」。請確認網址是否正確，或洽系統管理員。`,
        { str精舍代號: str代號 }
      );
    }

    // 整理成固定格式並存入快取
    const obj值 = arr符合[0].obj值;
    obj精舍 = {
      str精舍代號: str代號,
      str精舍名稱: String(obj值['精舍名稱']).trim(),
      str精舍資料夾ID: String(obj值['精舍資料夾ID']).trim(),
      str精舍設定ID: String(obj值['精舍設定ID']).trim(),
      str狀態: String(obj值['狀態']).trim()
    };
    obj租戶快取_.obj精舍[str代號] = obj精舍;
  }

  // 已停用的精舍：一般使用者不可進入
  if (obj精舍.str狀態 !== obj狀態.啟用 && !bool允許停用) {
    throw new 平台錯誤(
      obj錯誤代碼.權限不足,
      `「${obj精舍.str精舍名稱}」目前已停用，暫時無法使用。如有疑問請洽系統管理員。`,
      { str精舍代號: str代號 }
    );
  }

  return obj精舍;
}


/**
 * ============================================================================
 * 函式名稱：取得精舍設定試算表
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：開啟指定精舍的「精舍設定」試算表（人員、權限、共用主檔）。
 * 參數：
 *   str精舍代號   {string} 精舍代號
 * 傳回：{Spreadsheet} 精舍設定試算表
 * ============================================================================
 */
function 取得精舍設定試算表(str精舍代號) {
  const obj精舍 = 取得精舍資訊(str精舍代號);
  return 開啟試算表(obj精舍.str精舍設定ID, `「${obj精舍.str精舍名稱}」精舍設定`);
}


/**
 * ============================================================================
 * 函式名稱：取得精舍外部檔案ID
 * 版本：v1.0.1（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   查出精舍登記的外部檔案代號，例如「學員名冊」「大車點名試算表」。
 *   （需要分頁名稱時請改用「取得精舍外部檔案設定」）
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   str項目       {string} 外部檔案項目名稱
 *
 * 傳回：{string} 檔案代號
 * ============================================================================
 */
function 取得精舍外部檔案ID(str精舍代號, str項目) {
  return 取得精舍外部檔案設定(str精舍代號, str項目).str檔案ID;
}


/**
 * ============================================================================
 * 函式名稱：取得精舍外部檔案設定
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：查出精舍登記的外部檔案代號與分頁名稱。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   str項目       {string} 外部檔案項目名稱
 *
 * 傳回：{Object} { str檔案ID, str分頁名稱 }（分頁名稱未登記時為空字串）
 * ============================================================================
 */
function 取得精舍外部檔案設定(str精舍代號, str項目) {
  const obj精舍 = 取得精舍資訊(str精舍代號);
  const obj定義 = obj精舍設定結構.外部檔案;
  const obj分頁 = 取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁);

  // 找出項目名稱相同、且檔案代號有填的那一列（只讀必要的兩欄，相容舊版結構）
  const arr符合 = 依條件尋找資料列(obj分頁, ['項目', '檔案ID'], function (obj值) {
    return String(obj值['項目']).trim() === str項目 && String(obj值['檔案ID']).trim() !== '';
  });

  // 尚未設定
  if (arr符合.length === 0) {
    throw new 平台錯誤(
      obj錯誤代碼.設定缺漏,
      `「${obj精舍.str精舍名稱}」尚未設定「${str項目}」。請精舍管理員到「精舍設定」頁面設定後再試。`,
      { str精舍代號: obj精舍.str精舍代號, str項目: str項目 }
    );
  }

  // 舊版精舍設定可能還沒有「分頁名稱」欄（尚未執行補齊所有精舍結構），讀不到就當空白
  let str分頁名稱 = '';
  const int分頁欄 = 查找欄號(取得欄位對照(obj分頁), '分頁名稱');
  if (int分頁欄 > 0) {
    str分頁名稱 = String(obj分頁.getRange(arr符合[0].int列號, int分頁欄).getValue() || '').trim();
  }

  return { str檔案ID: String(arr符合[0].obj值['檔案ID']).trim(), str分頁名稱: str分頁名稱 };
}


/**
 * ============================================================================
 * 函式名稱：取得已開通模組
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   列出精舍已開通、且系統仍在使用中的模組，供入口頁顯示可進入的模組。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *
 * 傳回：
 *   {Object[]} [ { str模組代號, str模組名稱, str主控台ID }, ... ]
 * ============================================================================
 */
function 取得已開通模組(str精舍代號) {
  const obj精舍 = 取得精舍資訊(str精舍代號);
  const obj主控 = 取得系統主控();

  // 系統層：仍在使用中的模組（代號 → 名稱）
  const obj模組定義 = obj系統主控結構.模組清單;
  const obj啟用模組 = {};
  依條件尋找資料列(取得工作表(obj主控, obj模組定義.str分頁), obj模組定義.arr欄位, function (obj值) {
    return String(obj值['狀態']).trim() === obj狀態.啟用;
  }).forEach(function (obj列) {
    obj啟用模組[String(obj列.obj值['模組代號']).trim()] = String(obj列.obj值['模組名稱']).trim();
  });

  // 精舍層：這個精舍開通中的模組
  const obj開通定義 = obj系統主控結構.精舍模組開通;
  return 依條件尋找資料列(取得工作表(obj主控, obj開通定義.str分頁), obj開通定義.arr欄位, function (obj值) {
    return String(obj值['精舍代號']).trim().toUpperCase() === obj精舍.str精舍代號
      && String(obj值['狀態']).trim() === obj狀態.啟用
      && Object.prototype.hasOwnProperty.call(obj啟用模組, String(obj值['模組代號']).trim());
  }).map(function (obj列) {
    const str模組代號 = String(obj列.obj值['模組代號']).trim();
    return {
      str模組代號: str模組代號,
      str模組名稱: obj啟用模組[str模組代號],
      str主控台ID: String(obj列.obj值['主控台ID']).trim()
    };
  });
}


/**
 * ============================================================================
 * 函式名稱：取得模組主控台ID
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：查出精舍某模組的主控台代號；尚未開通時給出白話說明。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   str模組代號   {string} 模組代號，例如 'event'
 *
 * 傳回：{string} 主控台試算表代號
 * ============================================================================
 */
function 取得模組主控台ID(str精舍代號, str模組代號) {
  const obj精舍 = 取得精舍資訊(str精舍代號);

  // 在已開通清單中尋找
  const arr符合 = 取得已開通模組(obj精舍.str精舍代號).filter(function (obj模組) {
    return obj模組.str模組代號 === str模組代號;
  });

  // 未開通，或主控台尚未建立
  if (arr符合.length === 0 || arr符合[0].str主控台ID === '') {
    throw new 平台錯誤(
      obj錯誤代碼.權限不足,
      `「${obj精舍.str精舍名稱}」尚未開通這個功能（${str模組代號}）。請精舍管理員到「精舍設定」頁面開通。`,
      { str精舍代號: obj精舍.str精舍代號, str模組代號: str模組代號 }
    );
  }

  return arr符合[0].str主控台ID;
}
