// ============================================================================
// 檔案名稱：測試_核心_驗證與權限.gs
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.0.1（2026-10-25）
//   v1.0.1：精舍設定分頁數改依結構定義計算（因應新增「副本清單」分頁）
//   v1.0.0：初版
// 用途說明：
//   在 Apps Script 編輯器中執行「測試_核心_驗證與權限」。
//   會自動建立暫存的「系統主控」與「精舍設定」試算表，填入測試資料，
//   逐項測試工具、結構建立、租戶解析、身分判定、工作階段與權限，
//   最後把暫存檔移到垃圾桶。不會讀寫正式資料。
//
//   ※ Google 憑證本身的驗證需要真實登入，無法在此自動測試，
//     會在前端登入頁完成後一併測試。
//
// 相依檔案：核心_錯誤、核心_試算表存取、核心_工具、核心_結構定義、
//           核心_租戶解析、核心_權限、核心_驗證
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：測試_核心_驗證與權限
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：自動測試本批平台核心函式。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_核心_驗證與權限() {
  const arr結果 = [];
  const arr暫存檔 = [];   // 測試結束要丟到垃圾桶的檔案

  // 測試用帳號
  const str系統管理員 = 'admin.test@example.com';
  const str管理員帳號 = 'abbot.test@example.com';
  const str承辦人帳號 = 'staff.test@example.com';
  const str停用帳號 = 'left.test@example.com';

  // 記錄結果
  function 記錄(str項目, bool通過, str補充) {
    arr結果.push({ str項目: str項目, bool通過: bool通過 });
    console.log(`${bool通過 ? '✔' : '✘'} ${str項目}${str補充 ? '：' + str補充 : ''}`);
  }

  // 預期丟出指定錯誤代碼
  function 預期錯誤(str項目, str預期代碼, fn執行) {
    try {
      fn執行();
      記錄(str項目, false, '應該要出錯，但沒有出錯');
    } catch (err) {
      記錄(str項目, (err instanceof 平台錯誤) && err.str錯誤代碼 === str預期代碼, err.message);
    }
  }

  try {
    // ── 工具 ──
    記錄('精舍代號轉大寫', 正規化精舍代號(' tc01 ') === 'TC01');
    預期錯誤('精舍代號不可有空白', obj錯誤代碼.參數錯誤, function () { 正規化精舍代號('T C'); });
    預期錯誤('精舍代號不可用中文', obj錯誤代碼.參數錯誤, function () { 正規化精舍代號('台中'); });
    記錄('電話：補回開頭 0 並加連字號', 格式化電話(911222333) === '0911-222333', 格式化電話(911222333));
    記錄('電話：已有格式保持一致', 格式化電話('0911 222 333') === '0911-222333');
    記錄('電話：市話原樣保留', 格式化電話('04-23456789') === '04-23456789');
    const str報到碼 = 產生數字碼(6);
    記錄('產生 6 位數字碼', /^[0-9]{6}$/.test(str報到碼), str報到碼);
    記錄('產生 64 字元識別碼', /^[0-9a-f]{64}$/i.test(產生識別碼()));
    記錄('執行並鎖定傳回工作結果', 執行並鎖定(function () { return 42; }, '測試') === 42);

    // ── 建立暫存的系統主控與精舍設定 ──
    const obj主控 = SpreadsheetApp.create(`平台測試_系統主控_${new Date().getTime()}`);
    arr暫存檔.push(obj主控.getId());
    const int主控分頁數 = 建立整份結構(obj主控, obj系統主控結構);
    記錄('建立系統主控結構', int主控分頁數 === 5 && obj主控.getSheets().length === 5,
      obj主控.getSheets().map(function (s) { return s.getName(); }).join('、'));

    const obj設定 = SpreadsheetApp.create(`平台測試_精舍設定_${new Date().getTime()}`);
    arr暫存檔.push(obj設定.getId());
    建立整份結構(obj設定, obj精舍設定結構);
    記錄('建立精舍設定結構', obj設定.getSheets().length === Object.keys(obj精舍設定結構).length);

    // 重複執行不會出錯也不會重複建立欄位
    建立整份結構(obj主控, obj系統主控結構);
    記錄('結構可重複建立不重複欄位',
      obj主控.getSheetByName('精舍清單').getLastColumn() === obj系統主控結構.精舍清單.arr欄位.length);

    // ── 填入測試資料 ──
    設定測試用系統主控_(obj主控.getId());
    str測試用系統管理員帳號_ = str系統管理員;

    批次新增資料列(obj主控.getSheetByName('精舍清單'), [
      { '精舍代號': 'TC', '精舍名稱': '測試台中精舍', '精舍資料夾ID': 'x', '精舍設定ID': obj設定.getId(), '狀態': '啟用' },
      { '精舍代號': 'OFF', '精舍名稱': '測試停用精舍', '精舍資料夾ID': 'x', '精舍設定ID': obj設定.getId(), '狀態': '停用' }
    ]);
    新增資料列(obj主控.getSheetByName('精舍管理員'),
      { '精舍代號': 'TC', 'Google帳號': 'Abbot.Test@Example.com', '姓名': '測試住持', '狀態': '啟用' });
    新增資料列(obj主控.getSheetByName('模組清單'),
      { '模組代號': 'event', '模組名稱': '法會活動', '型態': '活動型', '版本': '1.0.0', '狀態': '啟用' });
    新增資料列(obj主控.getSheetByName('精舍模組開通'),
      { '精舍代號': 'TC', '模組代號': 'event', '主控台ID': 'console-001', '狀態': '啟用' });

    批次新增資料列(obj設定.getSheetByName('人員'), [
      { 'Google帳號': str承辦人帳號, '姓名': '測試承辦人', '狀態': '啟用' },
      { 'Google帳號': str停用帳號, '姓名': '已離開的人', '狀態': '停用' }
    ]);
    批次新增資料列(obj設定.getSheetByName('權限指派'), [
      { 'Google帳號': str承辦人帳號, '模組代號': 'event', '權限項目': '整理資料' },
      { 'Google帳號': str承辦人帳號, '模組代號': 'event', '權限項目': '整理資料' },   // 重複，應只算一次
      { 'Google帳號': str承辦人帳號, '模組代號': 'event', '權限項目': '匯出大車點名' }
    ]);
    新增資料列(obj設定.getSheetByName('外部檔案'), { '項目': '學員名冊', '檔案ID': 'roster-001' });

    // ── 租戶解析 ──
    const obj精舍 = 取得精舍資訊('tc');
    記錄('以小寫代號取得精舍資訊', obj精舍.str精舍名稱 === '測試台中精舍');
    預期錯誤('停用的精舍無法進入', obj錯誤代碼.權限不足, function () { 取得精舍資訊('OFF'); });
    記錄('總管理頁可查看停用精舍', 取得精舍資訊('OFF', true).str狀態 === '停用');
    預期錯誤('不存在的精舍代號', obj錯誤代碼.參數錯誤, function () { 取得精舍資訊('NOPE'); });
    記錄('取得已開通模組', 取得已開通模組('TC').length === 1 && 取得已開通模組('TC')[0].str模組名稱 === '法會活動');
    記錄('取得模組主控台ID', 取得模組主控台ID('TC', 'event') === 'console-001');
    預期錯誤('未開通的模組', obj錯誤代碼.權限不足, function () { 取得模組主控台ID('TC', 'inventory'); });
    記錄('取得外部檔案ID', 取得精舍外部檔案ID('TC', '學員名冊') === 'roster-001');
    預期錯誤('未設定的外部檔案', obj錯誤代碼.設定缺漏, function () { 取得精舍外部檔案ID('TC', '大車點名試算表'); });

    // ── 身分判定 ──
    記錄('系統管理員登入總管理頁', 判定身分_(str系統管理員, '').str角色 === obj角色.系統管理員);
    預期錯誤('一般帳號不能登入總管理頁', obj錯誤代碼.登入失敗, function () { 判定身分_(str管理員帳號, ''); });
    const obj住持 = 判定身分_(str管理員帳號, 'TC');
    記錄('精舍管理員（帳號大小寫不同仍可辨識）', obj住持.str角色 === obj角色.精舍管理員 && obj住持.str姓名 === '測試住持');
    const obj承辦 = 判定身分_(str承辦人帳號, 'TC');
    記錄('承辦人並讀出權限（重複指派只算一次）',
      obj承辦.str角色 === obj角色.承辦人 && obj承辦.arr權限.length === 2, obj承辦.arr權限.join('、'));
    預期錯誤('停用的人員無法登入', obj錯誤代碼.登入失敗, function () { 判定身分_(str停用帳號, 'TC'); });
    預期錯誤('未加入精舍的帳號無法登入', obj錯誤代碼.登入失敗, function () { 判定身分_('stranger@example.com', 'TC'); });

    // ── 工作階段 ──
    const str代碼 = 建立工作階段(obj承辦);
    const obj階段 = 取得工作階段(str代碼);
    記錄('建立並取回工作階段', obj階段.str帳號 === str承辦人帳號 && obj階段.str工作階段代碼 === str代碼);
    結束工作階段(str代碼);
    預期錯誤('登出後工作階段失效', obj錯誤代碼.登入逾時, function () { 取得工作階段(str代碼); });
    預期錯誤('沒有代碼視為未登入', obj錯誤代碼.登入逾時, function () { 取得工作階段(''); });

    // ── 權限 ──
    記錄('精舍管理員可做模組事務', 是否具備權限(obj住持, 'event.匯出大車點名'));
    記錄('精舍管理員可做平台事務', 是否具備權限(obj住持, '平台.增修人員'));
    記錄('精舍管理員不可做系統事務', !是否具備權限(obj住持, '系統.開通精舍'));
    記錄('承辦人可做被指派的項目', 是否具備權限(obj承辦, 'event.整理資料'));
    記錄('承辦人不可做未指派的項目', !是否具備權限(obj承辦, 'event.轉為正式'));
    記錄('承辦人不可做平台事務', !是否具備權限(obj承辦, '平台.增修人員'));
    const obj系統 = 判定身分_(str系統管理員, '');
    記錄('系統管理員可做系統事務', 是否具備權限(obj系統, '系統.開通精舍'));
    記錄('系統管理員看不到精舍資料', !是否具備權限(obj系統, 'event.整理資料'));
    預期錯誤('無權限時給出白話說明', obj錯誤代碼.權限不足, function () {
      檢查權限(obj承辦, 'event.轉為正式', '轉為正式');
    });
    預期錯誤('不可操作其他精舍資料', obj錯誤代碼.權限不足, function () { 檢查同一精舍(obj承辦, 'KH'); });
    預期錯誤('總管理頁限系統管理員', obj錯誤代碼.權限不足, function () {
      檢查角色(obj住持, [obj角色.系統管理員], '開通精舍');
    });

    // ── Google 憑證（只測沒有憑證的情況）──
    預期錯誤('沒有 Google 憑證時拒絕登入', obj錯誤代碼.登入失敗, function () { 驗證Google憑證(''); });

  } catch (err) {
    記錄('測試流程中斷', false, err.message);
  } finally {
    // 恢復正式設定，並把暫存檔移到垃圾桶
    設定測試用系統主控_(null);
    str測試用系統管理員帳號_ = null;
    arr暫存檔.forEach(function (str檔案ID) {
      try { DriveApp.getFileById(str檔案ID).setTrashed(true); } catch (err) { /* 已刪除則略過 */ }
    });
    console.log('（暫存試算表已移到垃圾桶）');
  }

  const arr失敗 = arr結果.filter(function (obj) { return !obj.bool通過; });
  console.log(`==== 測試完成：通過 ${arr結果.length - arr失敗.length} 項，失敗 ${arr失敗.length} 項 ====`);
  return {
    int通過: arr結果.length - arr失敗.length,
    int失敗: arr失敗.length,
    arr失敗項目: arr失敗.map(function (obj) { return obj.str項目; })
  };
}
