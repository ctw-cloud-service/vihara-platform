// ============================================================================
// 檔案名稱：核心_試算表存取.gs
// 所屬層級：平台核心／資料層
// 檔案版本：v1.1.0（2026-10-25）
//   v1.1.0：新增「附加資料列」（免鎖定的單列追加）與「刪除資料列」
//   v1.0.0：初版
// 用途說明：
//   平台「唯一」直接操作試算表的地方。其他模組一律呼叫本檔的函式讀寫資料，
//   不自行 openById、不自行用欄位字母（A、B、C）定位。
//
//   欄位定位方式（兩段式）：
//     1. 先找「隱藏的欄位標記」（DeveloperMetadata，鍵為「平台欄位代號」）。
//        標記貼在整欄上，就算有人把標題改名、或把欄位拖到別的位置，仍找得到。
//     2. 找不到標記時，才用第 1 列的標題文字比對。
//     兩種都找不到，就明確告訴使用者「少了哪些欄位」。
//
// 相依檔案：核心_錯誤.gs
// 使用注意：寫入類函式（新增、更新）請在呼叫端以鎖定包住，
//           避免多人同時寫入時列號錯亂（鎖定功能在 核心_工具.gs 提供）。
// ============================================================================


// ----------------------------------------------------------------------------
// 本檔常數
// ----------------------------------------------------------------------------
const str欄位標記鍵 = '平台欄位代號';   // DeveloperMetadata 的鍵名
const int標題列號 = 1;                   // 所有平台試算表的標題都在第 1 列

// 欄位對照快取：同一次執行中，同一個分頁只讀一次標題與標記，加快速度。
// GAS 每次執行結束後全域變數會清空，所以不會讀到過期的對照。
const obj欄位對照快取 = {};


/**
 * ============================================================================
 * 函式名稱：取得系統設定值
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   讀取 GAS「專案設定 → 指令碼屬性」中的設定值，
 *   例如「系統主控試算表ID」、「OAuth用戶端ID」。
 *
 * 參數：
 *   str設定名稱   {string}  指令碼屬性的名稱
 *   bool必填      {boolean} 預設 true；必填但沒設定時丟出錯誤，選填則傳回 null
 *
 * 傳回：
 *   {string|null} 設定值
 * ============================================================================
 */
function 取得系統設定值(str設定名稱, bool必填) {
  // 未指定時預設為必填
  const bool是否必填 = (bool必填 === undefined) ? true : Boolean(bool必填);

  // 防呆：設定名稱本身不可空白
  if (!str設定名稱 || String(str設定名稱).trim() === '') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '讀取系統設定時沒有指定設定名稱，請通知系統管理員。');
  }

  // 從指令碼屬性讀取
  const str設定值 = PropertiesService.getScriptProperties().getProperty(str設定名稱);

  // 沒有值的處理
  if (str設定值 === null || String(str設定值).trim() === '') {
    if (bool是否必填) {
      throw new 平台錯誤(
        obj錯誤代碼.設定缺漏,
        `系統設定「${str設定名稱}」尚未設定。請系統管理員到 Apps Script 的「專案設定 → 指令碼屬性」補上。`,
        { str設定名稱: str設定名稱 }
      );
    }
    return null;
  }

  // 去除前後空白後傳回（避免複製貼上時多帶空白）
  return String(str設定值).trim();
}


/**
 * ============================================================================
 * 函式名稱：開啟試算表
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   依檔案代號（ID）開啟試算表，失敗時給出白話的可能原因。
 *
 * 參數：
 *   str試算表ID   {string} 試算表的檔案代號
 *   str檔案說明   {string} 這是什麼檔案，用於錯誤訊息，例如「台中精舍－法會活動主控台」
 *
 * 傳回：
 *   {Spreadsheet} 已開啟的試算表
 * ============================================================================
 */
function 開啟試算表(str試算表ID, str檔案說明) {
  // 錯誤訊息裡要顯示的檔案名稱
  const str說明 = str檔案說明 || '指定的試算表';

  // 沒有檔案代號：通常是設定遺失或尚未建立
  if (!str試算表ID || String(str試算表ID).trim() === '') {
    throw new 平台錯誤(
      obj錯誤代碼.參數錯誤,
      `找不到「${str說明}」的檔案代號，可能尚未建立或設定遺失。請通知系統管理員。`,
      { str檔案說明: str說明 }
    );
  }

  try {
    // 去除空白後開啟
    return SpreadsheetApp.openById(String(str試算表ID).trim());
  } catch (err) {
    // 開不了的原因多半只有兩種，一次說明清楚
    throw new 平台錯誤(
      obj錯誤代碼.檔案無法開啟,
      `無法開啟「${str說明}」。可能原因：① 檔案已被刪除或移到垃圾桶；② 檔案沒有共享給系統帳號 ctw.cloud.service。請檢查後再試。`,
      { str試算表ID: String(str試算表ID), str原始訊息: err && err.message ? err.message : String(err) }
    );
  }
}


/**
 * ============================================================================
 * 函式名稱：取得工作表
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   在已開啟的試算表中取得指定名稱的分頁，找不到時列出現有分頁名稱，
 *   方便判斷是不是被改名了。
 *
 * 參數：
 *   obj試算表       {Spreadsheet} 由「開啟試算表」取得
 *   str工作表名稱   {string}      分頁名稱，例如「活動清單」
 *
 * 傳回：
 *   {Sheet} 分頁
 * ============================================================================
 */
function 取得工作表(obj試算表, str工作表名稱) {
  // 防呆：參數不完整
  if (!obj試算表 || !str工作表名稱) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '取得分頁時缺少試算表或分頁名稱，請通知系統管理員。');
  }

  // 依名稱取得分頁
  const obj工作表 = obj試算表.getSheetByName(str工作表名稱);

  // 找不到：列出現有分頁，幫助判斷是否被改名
  if (!obj工作表) {
    const arr現有分頁 = obj試算表.getSheets().map(function (obj分頁) { return obj分頁.getName(); });
    throw new 平台錯誤(
      obj錯誤代碼.工作表不存在,
      `「${obj試算表.getName()}」裡找不到「${str工作表名稱}」分頁，可能被改名或刪除。現有分頁：${arr現有分頁.join('、') || '（無）'}。`,
      { str工作表名稱: str工作表名稱, arr現有分頁: arr現有分頁 }
    );
  }

  return obj工作表;
}


/**
 * ============================================================================
 * 函式名稱：取得欄位對照
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   讀取分頁的「欄位標記」與「第 1 列標題」，建立「欄位名稱 → 欄號」的對照表。
 *   同一次執行中會快取結果；分頁結構剛被程式改過時，請傳 bool重新讀取 = true。
 *
 * 參數：
 *   obj工作表       {Sheet}   要讀取的分頁
 *   bool重新讀取    {boolean} 選填，true 表示忽略快取重新讀取
 *
 * 傳回：
 *   {Object} {
 *     obj依標記:   { 欄位代號: 欄號 },   // 來自隱藏標記
 *     obj依標題:   { 標題文字: 欄號 },   // 來自第 1 列（重複標題不列入）
 *     arr重複標題: [ 標題文字, ... ],    // 第 1 列出現兩次以上的標題
 *     int最後欄:   number                // 目前最後一個有資料的欄號
 *   }
 * ============================================================================
 */
function 取得欄位對照(obj工作表, bool重新讀取) {
  // 快取鍵：試算表 ID ＋ 分頁 ID（分頁改名也不受影響）
  const str快取鍵 = `${obj工作表.getParent().getId()}|${obj工作表.getSheetId()}`;

  // 有快取且不要求重新讀取，直接傳回
  if (!bool重新讀取 && obj欄位對照快取[str快取鍵]) {
    return obj欄位對照快取[str快取鍵];
  }

  // 準備空的對照表
  const obj對照 = { obj依標記: {}, obj依標題: {}, arr重複標題: [], int最後欄: 0 };

  // 目前最後一欄；空白分頁為 0
  const int最後欄 = obj工作表.getLastColumn();
  obj對照.int最後欄 = int最後欄;

  // ── 第一段：讀取第 1 列標題 ──
  if (int最後欄 > 0) {
    const arr標題 = obj工作表.getRange(int標題列號, 1, 1, int最後欄).getValues()[0];
    const obj出現次數 = {};

    arr標題.forEach(function (any標題, int索引) {
      // 標題一律轉文字並去除前後空白；空白標題略過
      const str標題 = String(any標題).trim();
      if (str標題 === '') return;

      // 記錄出現次數，用來找出重複標題
      obj出現次數[str標題] = (obj出現次數[str標題] || 0) + 1;

      // 第一次出現才記欄號（欄號從 1 開始，所以索引 + 1）
      if (obj出現次數[str標題] === 1) {
        obj對照.obj依標題[str標題] = int索引 + 1;
      }
    });

    // 重複的標題：從依標題對照中移除，避免抓錯欄
    Object.keys(obj出現次數).forEach(function (str標題) {
      if (obj出現次數[str標題] > 1) {
        obj對照.arr重複標題.push(str標題);
        delete obj對照.obj依標題[str標題];
      }
    });
  }

  // ── 第二段：讀取隱藏的欄位標記 ──
  const arr標記 = obj工作表.createDeveloperMetadataFinder()
    .withKey(str欄位標記鍵)
    .withLocationType(SpreadsheetApp.DeveloperMetadataLocationType.COLUMN)
    .find();

  arr標記.forEach(function (obj標記) {
    // 標記所在的欄號
    const int欄號 = obj標記.getLocation().getColumn().getColumn();
    // 標記的值就是欄位代號
    const str代號 = String(obj標記.getValue() || '').trim();
    if (str代號 !== '') {
      obj對照.obj依標記[str代號] = int欄號;
    }
  });

  // 存入快取後傳回
  obj欄位對照快取[str快取鍵] = obj對照;
  return obj對照;
}


/**
 * ============================================================================
 * 函式名稱：清除欄位對照快取
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   程式新增欄位、搬移欄位或貼上標記後，清除快取，讓下次讀取拿到最新結構。
 *
 * 參數：
 *   obj工作表   {Sheet} 選填；不給就清除全部快取
 *
 * 傳回：無
 * ============================================================================
 */
function 清除欄位對照快取(obj工作表) {
  // 指定分頁：只清除該分頁
  if (obj工作表) {
    delete obj欄位對照快取[`${obj工作表.getParent().getId()}|${obj工作表.getSheetId()}`];
    return;
  }
  // 未指定：全部清除
  Object.keys(obj欄位對照快取).forEach(function (str鍵) { delete obj欄位對照快取[str鍵]; });
}


/**
 * ============================================================================
 * 函式名稱：查找欄號
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   依欄位名稱找出欄號。先找隱藏標記，再找標題文字。
 *
 * 參數：
 *   obj欄位對照   {Object} 由「取得欄位對照」取得
 *   str欄位名稱   {string} 欄位代號或標題文字
 *
 * 傳回：
 *   {number} 欄號（從 1 開始）；找不到傳回 0；標題重複且無標記傳回 -1
 * ============================================================================
 */
function 查找欄號(obj欄位對照, str欄位名稱) {
  // 統一去除前後空白
  const str名稱 = String(str欄位名稱).trim();

  // 第一優先：隱藏標記（不怕改名、不怕搬移）
  if (obj欄位對照.obj依標記[str名稱]) {
    return obj欄位對照.obj依標記[str名稱];
  }

  // 標題重複又沒有標記：無法判斷是哪一欄
  if (obj欄位對照.arr重複標題.indexOf(str名稱) !== -1) {
    return -1;
  }

  // 第二優先：標題文字
  return obj欄位對照.obj依標題[str名稱] || 0;
}


/**
 * ============================================================================
 * 函式名稱：檢查欄位結構
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   確認分頁裡具備所有必要欄位，並傳回各欄位的欄號。
 *   有缺少或重複時，一次列出所有問題欄位。
 *
 * 參數：
 *   obj工作表       {Sheet}    要檢查的分頁
 *   arr必要欄位     {string[]} 必要的欄位名稱
 *   bool重新讀取    {boolean}  選填，true 表示忽略快取
 *
 * 傳回：
 *   {Object} { 欄位名稱: 欄號 }
 * ============================================================================
 */
function 檢查欄位結構(obj工作表, arr必要欄位, bool重新讀取) {
  // 讀取對照表
  const obj對照 = 取得欄位對照(obj工作表, bool重新讀取);

  const obj欄號表 = {};      // 找到的欄位
  const arr缺少欄位 = [];    // 找不到的欄位
  const arr重複欄位 = [];    // 標題重複、無法判斷的欄位

  // 逐一查找
  arr必要欄位.forEach(function (str欄位) {
    const int欄號 = 查找欄號(obj對照, str欄位);
    if (int欄號 > 0) {
      obj欄號表[str欄位] = int欄號;
    } else if (int欄號 === -1) {
      arr重複欄位.push(str欄位);
    } else {
      arr缺少欄位.push(str欄位);
    }
  });

  // 有問題就組成一段完整說明
  if (arr缺少欄位.length > 0 || arr重複欄位.length > 0) {
    const str位置 = `「${obj工作表.getParent().getName()}」的「${obj工作表.getName()}」分頁`;
    const arr說明 = [];
    if (arr缺少欄位.length > 0) {
      arr說明.push(`少了以下欄位：${arr缺少欄位.join('、')}（可能被改名或刪除）`);
    }
    if (arr重複欄位.length > 0) {
      arr說明.push(`以下標題出現兩次以上，系統無法判斷要用哪一欄：${arr重複欄位.join('、')}`);
    }
    throw new 平台錯誤(
      obj錯誤代碼.欄位缺漏,
      `${str位置}${arr說明.join('；')}。請還原欄位標題後再試。`,
      { arr缺少欄位: arr缺少欄位, arr重複欄位: arr重複欄位 }
    );
  }

  return obj欄號表;
}


/**
 * ============================================================================
 * 函式名稱：讀取全部資料列
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   一次讀出分頁中所有資料列（第 2 列起），只取指定的欄位。
 *   整張表只讀一次，比逐格讀取快很多。
 *
 * 參數：
 *   obj工作表         {Sheet}    要讀取的分頁
 *   arr欄位名稱       {string[]} 要取的欄位
 *   bool保留空白列    {boolean}  選填，預設 false（所有指定欄位都空白的列會略過）
 *
 * 傳回：
 *   {Object[]} [ { int列號: 2, obj值: { 欄位名稱: 值, ... } }, ... ]
 * ============================================================================
 */
function 讀取全部資料列(obj工作表, arr欄位名稱, bool保留空白列) {
  // 先確認欄位都在，並取得欄號
  const obj欄號表 = 檢查欄位結構(obj工作表, arr欄位名稱);

  // 只有標題列或全空：直接傳回空陣列
  const int最後列 = obj工作表.getLastRow();
  if (int最後列 <= int標題列號) {
    return [];
  }

  // 一次讀出第 2 列到最後一列、第 1 欄到最後一欄
  const int最後欄 = obj工作表.getLastColumn();
  const arr全部值 = obj工作表
    .getRange(int標題列號 + 1, 1, int最後列 - int標題列號, int最後欄)
    .getValues();

  const arr結果 = [];

  arr全部值.forEach(function (arr整列, int索引) {
    // 只挑出指定欄位的值
    const obj值 = {};
    let bool全部空白 = true;

    arr欄位名稱.forEach(function (str欄位) {
      const any值 = arr整列[obj欄號表[str欄位] - 1];
      obj值[str欄位] = any值;
      if (any值 !== '' && any值 !== null) bool全部空白 = false;
    });

    // 空白列預設略過
    if (bool全部空白 && !bool保留空白列) return;

    // 實際列號 = 標題列號 + 1 + 索引
    arr結果.push({ int列號: int標題列號 + 1 + int索引, obj值: obj值 });
  });

  return arr結果;
}


/**
 * ============================================================================
 * 函式名稱：依條件尋找資料列
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   讀出資料後，只留下符合條件的列。
 *
 * 參數：
 *   obj工作表     {Sheet}    要讀取的分頁
 *   arr欄位名稱   {string[]} 要取的欄位
 *   fn條件        {Function} 判斷函式，收到 obj值，傳回 true 表示保留
 *
 * 傳回：
 *   {Object[]} 與「讀取全部資料列」相同格式
 *
 * 範例：
 *   依條件尋找資料列(obj分頁, ['活動ID', '狀態'], function (obj值) {
 *     return obj值['狀態'] === '進行中';
 *   });
 * ============================================================================
 */
function 依條件尋找資料列(obj工作表, arr欄位名稱, fn條件) {
  // 條件必須是函式
  if (typeof fn條件 !== 'function') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '尋找資料時沒有提供判斷條件，請通知系統管理員。');
  }

  return 讀取全部資料列(obj工作表, arr欄位名稱).filter(function (obj列) {
    return fn條件(obj列.obj值);
  });
}


/**
 * ============================================================================
 * 函式名稱：組成整列資料（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把 { 欄位名稱: 值 } 依欄號放進一整列的陣列中。
 *   檢查欄位名稱是否都存在，避免寫到錯的欄。
 *
 * 參數：
 *   obj工作表     {Sheet}  目標分頁
 *   obj欄位值     {Object} { 欄位名稱: 值 }
 *   arr原列       {Array}  選填；更新時傳入原本那一列，未指定的欄位保持原值
 *
 * 傳回：
 *   {Array} 長度等於最後一欄的陣列
 * ============================================================================
 */
function 組成整列資料_(obj工作表, obj欄位值, arr原列) {
  // 防呆：沒有要寫入的內容
  const arr欄位 = Object.keys(obj欄位值 || {});
  if (arr欄位.length === 0) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '寫入資料時沒有提供任何欄位內容，請通知系統管理員。');
  }

  // 取得欄號（缺欄位會在這裡丟出白話錯誤）
  const obj欄號表 = 檢查欄位結構(obj工作表, arr欄位);
  const int最後欄 = 取得欄位對照(obj工作表).int最後欄;

  // 有原列就複製一份（更新時保留其他欄位），沒有就全部填空白
  const arr整列 = arr原列
    ? arr原列.slice()
    : new Array(int最後欄).fill('');

  // 依欄號放入新值
  arr欄位.forEach(function (str欄位) {
    // undefined 一律存成空白，避免寫出 "undefined" 字樣
    const any值 = obj欄位值[str欄位];
    arr整列[obj欄號表[str欄位] - 1] = (any值 === undefined || any值 === null) ? '' : any值;
  });

  return arr整列;
}


/**
 * ============================================================================
 * 函式名稱：新增資料列
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   在分頁最後面新增一列。只需提供要寫入的欄位，其他欄位留空白。
 *   ※ 請在鎖定範圍內呼叫，確保傳回的列號正確。
 *
 * 參數：
 *   obj工作表   {Sheet}  目標分頁
 *   obj欄位值   {Object} { 欄位名稱: 值 }
 *
 * 傳回：
 *   {number} 新增的列號
 * ============================================================================
 */
function 新增資料列(obj工作表, obj欄位值) {
  // 組成整列（含欄位檢查）
  const arr整列 = 組成整列資料_(obj工作表, obj欄位值, null);

  // 寫在最後一列的下一列
  const int新列號 = obj工作表.getLastRow() + 1;
  obj工作表.getRange(int新列號, 1, 1, arr整列.length).setValues([arr整列]);

  return int新列號;
}


/**
 * ============================================================================
 * 函式名稱：附加資料列
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   在分頁最後面追加一列，由 Google 保證多人同時追加也不會互相覆蓋，
 *   因此「不需要」鎖定。適合操作日誌、報到紀錄這類只追加、不需要知道列號的資料。
 *
 * 參數：
 *   obj工作表   {Sheet}  目標分頁
 *   obj欄位值   {Object} { 欄位名稱: 值 }
 *
 * 傳回：無
 * ============================================================================
 */
function 附加資料列(obj工作表, obj欄位值) {
  // 組成整列（含欄位檢查），再交給 Google 追加
  const arr整列 = 組成整列資料_(obj工作表, obj欄位值, null);
  obj工作表.appendRow(arr整列);
}


/**
 * ============================================================================
 * 函式名稱：刪除資料列
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   刪除指定的多列。由下往上刪，避免刪掉上面的列後，下面的列號跟著改變而刪錯。
 *   ※ 請在鎖定範圍內呼叫；列號應來自同一次鎖定中讀到的資料。
 *
 * 參數：
 *   obj工作表   {Sheet}    目標分頁
 *   arr列號     {number[]} 要刪除的列號（第 2 列起）
 *
 * 傳回：
 *   {number} 實際刪除的列數
 * ============================================================================
 */
function 刪除資料列(obj工作表, arr列號) {
  // 沒有要刪的
  if (!Array.isArray(arr列號) || arr列號.length === 0) return 0;

  // 檢查列號：必須是整數、不可是標題列、不可超過最後一列
  const int最後列 = obj工作表.getLastRow();
  const arr無效 = arr列號.filter(function (int列號) {
    return !Number.isInteger(int列號) || int列號 <= int標題列號 || int列號 > int最後列;
  });
  if (arr無效.length > 0) {
    throw new 平台錯誤(
      obj錯誤代碼.資料列不存在,
      `要刪除的資料（第 ${arr無效.join('、')} 列）不存在，可能已被他人異動。請重新整理畫面後再試。`,
      { arr無效列號: arr無效, int最後列: int最後列 }
    );
  }

  // 去除重複後由大到小排序，從最下面開始刪
  const arr排序 = arr列號.filter(function (int列號, int索引) {
    return arr列號.indexOf(int列號) === int索引;
  }).sort(function (a, b) { return b - a; });

  arr排序.forEach(function (int列號) {
    obj工作表.deleteRow(int列號);
  });

  return arr排序.length;
}


/**
 * ============================================================================
 * 函式名稱：批次新增資料列
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   一次新增多列（例如同步 200 筆報名資料），只寫入一次，速度快很多。
 *   ※ 請在鎖定範圍內呼叫。
 *
 * 參數：
 *   obj工作表         {Sheet}    目標分頁
 *   arr欄位值清單     {Object[]} [ { 欄位名稱: 值 }, ... ]
 *
 * 傳回：
 *   {Object} { int起始列號, int筆數 }；沒有資料時 int筆數 為 0
 * ============================================================================
 */
function 批次新增資料列(obj工作表, arr欄位值清單) {
  // 沒有資料：不做任何事
  if (!Array.isArray(arr欄位值清單) || arr欄位值清單.length === 0) {
    return { int起始列號: 0, int筆數: 0 };
  }

  // 逐筆組成整列
  const arr多列 = arr欄位值清單.map(function (obj欄位值) {
    return 組成整列資料_(obj工作表, obj欄位值, null);
  });

  // 一次寫入
  const int起始列號 = obj工作表.getLastRow() + 1;
  obj工作表.getRange(int起始列號, 1, arr多列.length, arr多列[0].length).setValues(arr多列);

  return { int起始列號: int起始列號, int筆數: arr多列.length };
}


/**
 * ============================================================================
 * 函式名稱：更新資料列
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   更新指定列的部分欄位，其他欄位保持原值。
 *   ※ 請在鎖定範圍內呼叫，避免兩人同時修改同一列時互相覆蓋。
 *
 * 參數：
 *   obj工作表   {Sheet}  目標分頁
 *   int列號     {number} 要更新的列號（第 2 列起）
 *   obj欄位值   {Object} { 欄位名稱: 新值 }
 *
 * 傳回：無
 * ============================================================================
 */
function 更新資料列(obj工作表, int列號, obj欄位值) {
  // 列號必須是整數，且不可以是標題列、不可以超過最後一列
  const int最後列 = obj工作表.getLastRow();
  if (!Number.isInteger(int列號) || int列號 <= int標題列號 || int列號 > int最後列) {
    throw new 平台錯誤(
      obj錯誤代碼.資料列不存在,
      `要更新的資料（第 ${int列號} 列）不存在，可能已被刪除或搬移。請重新整理畫面後再試。`,
      { int列號: int列號, int最後列: int最後列 }
    );
  }

  // 讀出原本整列
  const int最後欄 = 取得欄位對照(obj工作表).int最後欄;
  const arr原列 = obj工作表.getRange(int列號, 1, 1, int最後欄).getValues()[0];

  // 只替換指定欄位後整列寫回
  const arr新列 = 組成整列資料_(obj工作表, obj欄位值, arr原列);
  obj工作表.getRange(int列號, 1, 1, arr新列.length).setValues([arr新列]);
}


/**
 * ============================================================================
 * 函式名稱：標記欄位代號
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   在範本或新建立的分頁上，替欄位貼上隱藏標記。
 *   之後就算標題被改名或欄位被搬移，系統仍能找到正確的欄。
 *   通常只在「建立範本」或「建立新分頁」時呼叫一次。
 *
 * 參數：
 *   obj工作表     {Sheet}  目標分頁
 *   obj代號對照   {Object} { 欄位代號: 目前的標題文字 }
 *                          例：{ '活動ID': '活動ID', '活動名稱': '活動名稱' }
 *
 * 傳回：
 *   {number} 成功貼上的標記數量
 * ============================================================================
 */
function 標記欄位代號(obj工作表, obj代號對照) {
  // 防呆
  const arr代號 = Object.keys(obj代號對照 || {});
  if (arr代號.length === 0) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '貼欄位標記時沒有提供欄位清單，請通知系統管理員。');
  }

  // 以標題文字找出各欄（重新讀取，確保拿到最新結構）
  const obj對照 = 取得欄位對照(obj工作表, true);
  const arr找不到 = [];
  let int成功數 = 0;

  arr代號.forEach(function (str代號) {
    const str標題 = String(obj代號對照[str代號]).trim();
    const int欄號 = obj對照.obj依標題[str標題];

    // 標題找不到（或重複）：先記下，最後一次回報
    if (!int欄號) {
      arr找不到.push(str標題);
      return;
    }

    // 移除舊標記，確保「一個代號只在一欄」且「一欄只有一個代號」：
    //   ① 同一代號貼在別欄的舊標記 ② 這一欄上其他代號的舊標記
    obj工作表.createDeveloperMetadataFinder()
      .withKey(str欄位標記鍵)
      .withLocationType(SpreadsheetApp.DeveloperMetadataLocationType.COLUMN)
      .find()
      .forEach(function (obj舊標記) {
        const bool同代號 = String(obj舊標記.getValue()) === str代號;
        const bool同欄 = obj舊標記.getLocation().getColumn().getColumn() === int欄號;
        if (bool同代號 || bool同欄) obj舊標記.remove();
      });

    // 以 A1 表示法取得整欄（例如 C:C），貼上新標記
    const str欄字母 = 欄號轉字母_(int欄號);
    obj工作表.getRange(`${str欄字母}:${str欄字母}`).addDeveloperMetadata(str欄位標記鍵, str代號);
    int成功數 += 1;
  });

  // 結構已改變，清除快取
  清除欄位對照快取(obj工作表);

  // 有找不到的標題就告知
  if (arr找不到.length > 0) {
    throw new 平台錯誤(
      obj錯誤代碼.欄位缺漏,
      `「${obj工作表.getName()}」分頁找不到以下標題（或標題重複），無法貼上欄位標記：${arr找不到.join('、')}。已成功標記 ${int成功數} 個欄位。`,
      { arr找不到: arr找不到, int成功數: int成功數 }
    );
  }

  return int成功數;
}


/**
 * ============================================================================
 * 函式名稱：欄號轉字母（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：把欄號轉成欄位字母，例如 1 → A、27 → AA。
 *
 * 參數：
 *   int欄號   {number} 從 1 開始的欄號
 *
 * 傳回：
 *   {string} 欄位字母
 * ============================================================================
 */
function 欄號轉字母_(int欄號) {
  let int剩餘 = int欄號;
  let str字母 = '';
  // 26 進位換算（A=1 … Z=26）
  while (int剩餘 > 0) {
    const int餘數 = (int剩餘 - 1) % 26;
    str字母 = String.fromCharCode(65 + int餘數) + str字母;
    int剩餘 = Math.floor((int剩餘 - 1) / 26);
  }
  return str字母;
}
