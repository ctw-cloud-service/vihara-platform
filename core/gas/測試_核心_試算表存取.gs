// ============================================================================
// 檔案名稱：測試_核心_試算表存取.gs
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.0.0（2026-10-25）
// 用途說明：
//   在 Apps Script 編輯器中直接執行「測試_核心_試算表存取」，
//   系統會自動建立一份暫存試算表、逐項測試，最後把暫存檔移到垃圾桶。
//   結果顯示在「執行紀錄」：✔ 表示通過，✘ 表示失敗。
// 相依檔案：核心_錯誤.gs、核心_試算表存取.gs
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：測試_核心_試算表存取
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：自動測試「核心_試算表存取」的所有函式。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_核心_試算表存取() {
  const arr結果 = [];           // 每一項測試的結果
  let obj暫存試算表 = null;      // 測試用的暫存檔

  // 記錄一項測試結果的小工具
  function 記錄(str項目, bool通過, str補充) {
    arr結果.push({ str項目: str項目, bool通過: bool通過 });
    console.log(`${bool通過 ? '✔' : '✘'} ${str項目}${str補充 ? '：' + str補充 : ''}`);
  }

  // 預期會丟出指定錯誤代碼的測試小工具
  function 預期錯誤(str項目, str預期代碼, fn執行) {
    try {
      fn執行();
      記錄(str項目, false, '應該要出錯，但沒有出錯');
    } catch (err) {
      const bool符合 = (err instanceof 平台錯誤) && err.str錯誤代碼 === str預期代碼;
      記錄(str項目, bool符合, err.message);
    }
  }

  try {
    // ── 準備：建立暫存試算表與標題 ──
    obj暫存試算表 = SpreadsheetApp.create(`平台測試_暫存_${new Date().getTime()}`);
    const obj分頁 = obj暫存試算表.getSheets()[0];
    obj分頁.setName('測試資料');
    obj分頁.getRange(1, 1, 1, 4).setValues([['活動ID', '活動名稱', '狀態', '備註']]);

    // 1. 開啟試算表
    const obj重新開啟 = 開啟試算表(obj暫存試算表.getId(), '測試暫存檔');
    記錄('開啟試算表', obj重新開啟.getId() === obj暫存試算表.getId());

    // 2. 開啟不存在的檔案 → 檔案無法開啟
    預期錯誤('開啟不存在的檔案會給出白話錯誤', obj錯誤代碼.檔案無法開啟, function () {
      開啟試算表('這不是有效的檔案代號', '不存在的檔案');
    });

    // 3. 取得不存在的分頁 → 工作表不存在
    預期錯誤('取得不存在的分頁會列出現有分頁', obj錯誤代碼.工作表不存在, function () {
      取得工作表(obj重新開啟, '不存在的分頁');
    });

    // 4. 新增資料列
    const int列號一 = 新增資料列(obj分頁, { '活動ID': 'EV001', '活動名稱': '觀音法會', '狀態': '進行中' });
    const int列號二 = 新增資料列(obj分頁, { '活動ID': 'EV002', '活動名稱': '藥師法會', '狀態': '已結束' });
    記錄('新增資料列傳回正確列號', int列號一 === 2 && int列號二 === 3, `第 ${int列號一}、${int列號二} 列`);

    // 5. 批次新增
    const obj批次 = 批次新增資料列(obj分頁, [
      { '活動ID': 'EV003', '活動名稱': '禪七', '狀態': '進行中' },
      { '活動ID': 'EV004', '活動名稱': '朝山', '狀態': '籌備中' }
    ]);
    記錄('批次新增資料列', obj批次.int起始列號 === 4 && obj批次.int筆數 === 2);

    // 6. 讀取全部資料列
    const arr全部 = 讀取全部資料列(obj分頁, ['活動ID', '狀態']);
    記錄('讀取全部資料列筆數正確', arr全部.length === 4, `共 ${arr全部.length} 筆`);

    // 7. 依條件尋找
    const arr進行中 = 依條件尋找資料列(obj分頁, ['活動ID', '狀態'], function (obj值) {
      return obj值['狀態'] === '進行中';
    });
    記錄('依條件尋找資料列', arr進行中.length === 2);

    // 8. 更新資料列（只改狀態，活動名稱要保留）
    更新資料列(obj分頁, int列號一, { '狀態': '已結束' });
    const arr更新後 = 讀取全部資料列(obj分頁, ['活動名稱', '狀態']);
    記錄('更新資料列只改指定欄位',
      arr更新後[0].obj值['狀態'] === '已結束' && arr更新後[0].obj值['活動名稱'] === '觀音法會');

    // 9. 更新標題列 → 資料列不存在
    預期錯誤('不可更新標題列', obj錯誤代碼.資料列不存在, function () {
      更新資料列(obj分頁, 1, { '狀態': 'X' });
    });

    // 10. 寫入不存在的欄位 → 欄位缺漏
    預期錯誤('寫入不存在的欄位會列出缺少欄位', obj錯誤代碼.欄位缺漏, function () {
      新增資料列(obj分頁, { '不存在的欄位': '值' });
    });

    // 11. 貼上欄位標記後改標題名稱，仍找得到欄位
    標記欄位代號(obj分頁, { '活動名稱': '活動名稱' });
    obj分頁.getRange(1, 2).setValue('法會名稱（有人改了標題）');
    清除欄位對照快取(obj分頁);
    const arr改名後 = 讀取全部資料列(obj分頁, ['活動名稱']);
    記錄('標題被改名後仍以標記找到欄位', arr改名後[0].obj值['活動名稱'] === '觀音法會');

    // 12. 搬移欄位後仍找得到（把第 2 欄移到最後）
    obj分頁.moveColumns(obj分頁.getRange('B:B'), 5);
    清除欄位對照快取(obj分頁);
    const arr搬移後 = 讀取全部資料列(obj分頁, ['活動名稱', '活動ID']);
    記錄('欄位被搬移後仍以標記找到欄位',
      arr搬移後[0].obj值['活動名稱'] === '觀音法會' && arr搬移後[0].obj值['活動ID'] === 'EV001');

    // 13. 重複標題 → 欄位缺漏（重複）
    obj分頁.getRange(1, 5).setValue('狀態');
    清除欄位對照快取(obj分頁);
    預期錯誤('標題重複時會明確提示', obj錯誤代碼.欄位缺漏, function () {
      讀取全部資料列(obj分頁, ['狀態']);
    });

    // 14. 必要參數檢查
    預期錯誤('缺少必要參數會一次列出', obj錯誤代碼.參數錯誤, function () {
      檢查必要參數({ str活動名稱: '' }, ['str活動名稱', 'str類型'], '新增活動');
    });

    // 15. 錯誤回應不洩漏內部資訊
    const obj回應 = 建立錯誤回應(new Error('internal detail'), '測試');
    記錄('錯誤回應只含代碼與白話訊息',
      obj回應.bool成功 === false && obj回應.str錯誤代碼 === obj錯誤代碼.未預期錯誤 && obj回應.str訊息.indexOf('internal') === -1);

  } catch (err) {
    // 測試流程本身中斷
    記錄('測試流程中斷', false, err.message);
  } finally {
    // 不論成功與否，都把暫存檔移到垃圾桶
    if (obj暫存試算表) {
      DriveApp.getFileById(obj暫存試算表.getId()).setTrashed(true);
      console.log('（暫存試算表已移到垃圾桶）');
    }
  }

  // 統計
  const arr失敗 = arr結果.filter(function (obj) { return !obj.bool通過; });
  console.log(`==== 測試完成：通過 ${arr結果.length - arr失敗.length} 項，失敗 ${arr失敗.length} 項 ====`);
  return {
    int通過: arr結果.length - arr失敗.length,
    int失敗: arr失敗.length,
    arr失敗項目: arr失敗.map(function (obj) { return obj.str項目; })
  };
}
