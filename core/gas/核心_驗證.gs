// ============================================================================
// 檔案名稱：核心_驗證.gs
// 所屬層級：平台核心／控制層
// 檔案版本：v1.0.0（2026-10-25）
// 用途說明：
//   處理登入與「工作階段」（登入後的通行證）。
//
//   登入流程：
//     1. 前端以 Google 登入取得「身分憑證」（ID token），連同精舍代號送來。
//     2. 本檔向 Google 確認憑證真偽，取得 Google 帳號。
//     3. 依序比對：系統管理員 → 該精舍的精舍管理員 → 該精舍的承辦人。
//     4. 通過後發給「工作階段代碼」，有效 6 小時；之後每次請求都帶著它。
//
//   權限即時性：
//     工作階段每 10 分鐘會重新讀取一次身分與權限，
//     精舍管理員停用某人或調整權限後，最晚 10 分鐘生效。
//
//   報到志工以「報到碼」登入，由法會活動模組呼叫「建立工作階段」處理。
//
// 相依檔案：核心_錯誤.gs、核心_試算表存取.gs、核心_工具.gs、
//           核心_結構定義.gs、核心_租戶解析.gs、核心_權限.gs
// ============================================================================


// ----------------------------------------------------------------------------
// 本檔常數
// ----------------------------------------------------------------------------
const int工作階段秒數 = 21600;          // 6 小時（Google 快取允許的最長時間）
const int權限更新毫秒 = 10 * 60 * 1000;  // 每 10 分鐘重新讀取身分與權限
const str工作階段前綴 = '工作階段_';      // 快取鍵前綴，避免與其他快取資料混淆
const arrGoogle發行者 = ['accounts.google.com', 'https://accounts.google.com'];

// 測試專用：指定系統管理員帳號，正式執行時一律為 null（改讀指令碼屬性）
let str測試用系統管理員帳號_ = null;


/**
 * ============================================================================
 * 函式名稱：取得系統管理員帳號_
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：讀取系統管理員的 Google 帳號（測試時可暫時指定）。
 * 參數：無
 * 傳回：{string} 正規化後的帳號
 * ============================================================================
 */
function 取得系統管理員帳號_() {
  return 正規化帳號(str測試用系統管理員帳號_ || 取得系統設定值(obj設定名稱.系統管理員帳號));
}


/**
 * ============================================================================
 * 函式名稱：驗證Google憑證
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   向 Google 確認前端送來的身分憑證是真的、是發給本平台的、且還沒過期。
 *
 * 參數：
 *   str憑證   {string} 前端 Google 登入取得的 ID token
 *
 * 傳回：
 *   {Object} { str帳號, str姓名 }
 * ============================================================================
 */
function 驗證Google憑證(str憑證) {
  // 沒有憑證
  if (!str憑證 || String(str憑證).trim() === '') {
    throw new 平台錯誤(obj錯誤代碼.登入失敗, '沒有收到 Google 登入資訊，請重新登入。');
  }

  // 本平台的 OAuth 用戶端 ID（憑證必須是發給這個 ID 的）
  const str用戶端ID = 取得系統設定值(obj設定名稱.OAuth用戶端ID);

  // 呼叫 Google 的憑證查驗服務
  let obj回應;
  try {
    obj回應 = UrlFetchApp.fetch(
      'https://oauth2.googleapis.com/tokeninfo?id_token=' + encodeURIComponent(String(str憑證).trim()),
      { muteHttpExceptions: true }
    );
  } catch (err) {
    // 網路問題：不是使用者的錯
    throw new 平台錯誤(
      obj錯誤代碼.未預期錯誤,
      '目前無法連線到 Google 確認登入身分，請稍後再試。',
      { str原始訊息: err && err.message ? err.message : String(err) }
    );
  }

  // Google 回覆憑證無效（通常是過期或被竄改）
  if (obj回應.getResponseCode() !== 200) {
    throw new 平台錯誤(
      obj錯誤代碼.登入失敗,
      'Google 登入已失效，請重新登入。',
      { int狀態碼: obj回應.getResponseCode() }
    );
  }

  // 解析內容
  let obj內容;
  try {
    obj內容 = JSON.parse(obj回應.getContentText());
  } catch (err) {
    throw new 平台錯誤(obj錯誤代碼.登入失敗, 'Google 登入資訊無法辨識，請重新登入。');
  }

  // 逐項檢查：發給本平台、由 Google 發行、信箱已驗證、未過期
  const bool發給本平台 = obj內容.aud === str用戶端ID;
  const bool由Google發行 = arrGoogle發行者.indexOf(obj內容.iss) !== -1;
  const bool信箱已驗證 = obj內容.email_verified === true || obj內容.email_verified === 'true';
  const bool未過期 = Number(obj內容.exp) * 1000 > new Date().getTime();

  if (!bool發給本平台 || !bool由Google發行 || !bool信箱已驗證 || !bool未過期) {
    throw new 平台錯誤(
      obj錯誤代碼.登入失敗,
      'Google 登入資訊未通過檢查，請重新登入。',
      { bool發給本平台: bool發給本平台, bool由Google發行: bool由Google發行, bool信箱已驗證: bool信箱已驗證, bool未過期: bool未過期 }
    );
  }

  return { str帳號: 正規化帳號(obj內容.email), str姓名: obj內容.name || '' };
}


/**
 * ============================================================================
 * 函式名稱：判定身分_
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   依 Google 帳號與精舍代號判定角色與權限（登入與定期更新權限時共用）。
 *     · 沒有精舍代號：只接受系統管理員（總管理頁）
 *     · 有精舍代號：依序比對精舍管理員、承辦人
 *
 * 參數：
 *   str帳號         {string} 已驗證的 Google 帳號
 *   str精舍代號     {string} 精舍代號；總管理頁傳空字串
 *
 * 傳回：
 *   {Object} { str帳號, str角色, str精舍代號, str精舍名稱, str姓名, arr權限 }
 * ============================================================================
 */
function 判定身分_(str帳號, str精舍代號) {
  const str目標帳號 = 正規化帳號(str帳號);

  // ── 總管理頁：沒有精舍代號 ──
  if (!str精舍代號 || String(str精舍代號).trim() === '') {
    if (str目標帳號 === 取得系統管理員帳號_()) {
      return {
        str帳號: str目標帳號, str角色: obj角色.系統管理員,
        str精舍代號: '', str精舍名稱: '', str姓名: '系統管理員', arr權限: []
      };
    }
    throw new 平台錯誤(
      obj錯誤代碼.登入失敗,
      `此帳號（${str目標帳號}）不是系統管理員。若要使用精舍的功能，請從精舍的專屬網址登入。`
    );
  }

  // ── 精舍頁：先確認精舍存在且啟用 ──
  const obj精舍 = 取得精舍資訊(str精舍代號);
  const obj基本 = { str帳號: str目標帳號, str精舍代號: obj精舍.str精舍代號, str精舍名稱: obj精舍.str精舍名稱 };

  // 第一關：精舍管理員（記錄在系統主控）
  const obj管理員定義 = obj系統主控結構.精舍管理員;
  const arr管理員 = 依條件尋找資料列(
    取得工作表(取得系統主控(), obj管理員定義.str分頁),
    obj管理員定義.arr欄位,
    function (obj值) {
      return String(obj值['精舍代號']).trim().toUpperCase() === obj精舍.str精舍代號
        && 正規化帳號(obj值['Google帳號']) === str目標帳號
        && String(obj值['狀態']).trim() === obj狀態.啟用;
    }
  );
  if (arr管理員.length > 0) {
    return Object.assign({}, obj基本, {
      str角色: obj角色.精舍管理員,
      str姓名: String(arr管理員[0].obj值['姓名']).trim(),
      arr權限: []    // 精舍管理員不需列舉，規則由「是否具備權限」判斷
    });
  }

  // 第二關：承辦人（記錄在精舍設定的「人員」分頁）
  const obj人員定義 = obj精舍設定結構.人員;
  const arr人員 = 依條件尋找資料列(
    取得工作表(取得精舍設定試算表(obj精舍.str精舍代號), obj人員定義.str分頁),
    obj人員定義.arr欄位,
    function (obj值) {
      return 正規化帳號(obj值['Google帳號']) === str目標帳號
        && String(obj值['狀態']).trim() === obj狀態.啟用;
    }
  );
  if (arr人員.length > 0) {
    return Object.assign({}, obj基本, {
      str角色: obj角色.承辦人,
      str姓名: String(arr人員[0].obj值['姓名']).trim(),
      arr權限: 讀取承辦人權限(obj精舍.str精舍代號, str目標帳號)
    });
  }

  // 都不是
  throw new 平台錯誤(
    obj錯誤代碼.登入失敗,
    `此 Google 帳號（${str目標帳號}）尚未加入「${obj精舍.str精舍名稱}」，或已被停用。請洽該精舍的精舍管理員。`
  );
}


/**
 * ============================================================================
 * 函式名稱：建立工作階段
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：登入成功後發給工作階段代碼，並把身分資料存入快取 6 小時。
 *
 * 參數：
 *   obj身分   {Object} 「判定身分_」的結果，或報到志工的身分資料
 *
 * 傳回：{string} 工作階段代碼
 * ============================================================================
 */
function 建立工作階段(obj身分) {
  // 產生難以猜測的代碼
  const str代碼 = 產生識別碼();
  const int現在 = new Date().getTime();

  // 存入快取：加上建立時間與權限讀取時間
  const obj資料 = Object.assign({}, obj身分, { int建立時間: int現在, int權限讀取時間: int現在 });
  CacheService.getScriptCache().put(str工作階段前綴 + str代碼, JSON.stringify(obj資料), int工作階段秒數);

  return str代碼;
}


/**
 * ============================================================================
 * 函式名稱：取得工作階段
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   每次請求都先呼叫這裡，以工作階段代碼取回身分資料。
 *   已超過 10 分鐘就重新讀取身分與權限；每次使用都會延長 6 小時有效期。
 *
 * 參數：
 *   str工作階段代碼   {string} 前端帶來的代碼
 *
 * 傳回：
 *   {Object} 身分資料（含 str工作階段代碼）
 * ============================================================================
 */
function 取得工作階段(str工作階段代碼) {
  // 沒帶代碼
  if (!str工作階段代碼) {
    throw new 平台錯誤(obj錯誤代碼.登入逾時, '尚未登入或登入已逾時，請重新登入。');
  }

  // 從快取取出
  const obj快取 = CacheService.getScriptCache();
  const str鍵 = str工作階段前綴 + String(str工作階段代碼).trim();
  const str內容 = obj快取.get(str鍵);
  if (!str內容) {
    throw new 平台錯誤(obj錯誤代碼.登入逾時, '登入已逾時，請重新登入。');
  }

  let obj資料 = JSON.parse(str內容);
  const int現在 = new Date().getTime();

  // 精舍管理員與承辦人：超過 10 分鐘就重新確認身分與權限
  const bool需更新 = (obj資料.str角色 === obj角色.精舍管理員 || obj資料.str角色 === obj角色.承辦人)
    && (int現在 - obj資料.int權限讀取時間 > int權限更新毫秒);

  if (bool需更新) {
    try {
      const obj新身分 = 判定身分_(obj資料.str帳號, obj資料.str精舍代號);
      obj資料 = Object.assign({}, obj資料, obj新身分, { int權限讀取時間: int現在 });
    } catch (err) {
      // 已被移除、停用，或精舍停用：立即讓工作階段失效
      if (err instanceof 平台錯誤
        && (err.str錯誤代碼 === obj錯誤代碼.登入失敗 || err.str錯誤代碼 === obj錯誤代碼.權限不足)) {
        obj快取.remove(str鍵);
        throw new 平台錯誤(obj錯誤代碼.登入逾時, '您的帳號狀態已變更，請重新登入。');
      }
      // 其他問題（例如暫時無法開檔）：沿用原本資料，不影響使用者操作
      console.warn('工作階段權限更新失敗，暫用原資料：' + (err && err.message));
    }
  }

  // 寫回快取（同時延長有效期）
  obj快取.put(str鍵, JSON.stringify(obj資料), int工作階段秒數);

  return Object.assign({}, obj資料, { str工作階段代碼: String(str工作階段代碼).trim() });
}


/**
 * ============================================================================
 * 函式名稱：結束工作階段
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：登出時刪除工作階段。
 * 參數：
 *   str工作階段代碼   {string} 要結束的代碼
 * 傳回：無
 * ============================================================================
 */
function 結束工作階段(str工作階段代碼) {
  if (!str工作階段代碼) return;
  CacheService.getScriptCache().remove(str工作階段前綴 + String(str工作階段代碼).trim());
}


/**
 * ============================================================================
 * 函式名稱：執行Google登入
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   前端「Google 登入」的完整處理：驗證憑證 → 判定身分 → 發工作階段。
 *   將由「核心_路由」對應到 action「驗證.Google登入」。
 *
 * 參數：
 *   obj參數   {Object} { str憑證: 'Google ID token', str精舍代號: 'TC'（總管理頁不給） }
 *
 * 傳回：
 *   {Object} {
 *     bool成功: true,
 *     str工作階段代碼,
 *     obj身分: { str帳號, str角色, str精舍代號, str精舍名稱, str姓名, arr權限 }
 *   }
 * ============================================================================
 */
function 執行Google登入(obj參數) {
  // 必須有憑證
  檢查必要參數(obj參數, ['str憑證'], 'Google 登入');

  // 1. 向 Google 確認身分
  const obj帳號 = 驗證Google憑證(obj參數.str憑證);

  // 2. 判定角色（精舍代號有給才正規化）
  const str精舍代號 = obj參數.str精舍代號 ? 正規化精舍代號(obj參數.str精舍代號) : '';
  const obj身分 = 判定身分_(obj帳號.str帳號, str精舍代號);

  // 精舍資料裡沒有姓名時，用 Google 帳號上的姓名
  if (!obj身分.str姓名) obj身分.str姓名 = obj帳號.str姓名;

  // 3. 發給工作階段
  const str工作階段代碼 = 建立工作階段(obj身分);

  return { bool成功: true, str工作階段代碼: str工作階段代碼, obj身分: obj身分 };
}
