// ============================================================================
// 檔案名稱：核心_學員名冊.gs
// 所屬層級：平台核心／服務層
// 檔案版本：v1.1.0（2026-10-25）
//   v1.1.0：名冊格式改由各精舍自訂；登記時自動尋找含必要欄位的分頁
//   v1.0.0：初版（固定「明細」分頁）
// 用途說明：
//   讀取各精舍自有的學員名冊（唯讀，由專人維護，平台不修改），提供：
//     · 依學員編號查詢（法會報到掃 QR code 時用）
//     · 依「姓名＋法名」比對學員編號（整理報名資料時用）
//     · 比對不到的人配發臨時編號（T-精舍代號-流水號）
//
//   名冊格式（各精舍自訂）：
//     · 分頁名稱、欄位順序、其他欄位都可以不同。
//     · 第 1 列為標題，一定要有「學員編號」「姓名」「法名」三個標題。
//     · 「性別」「手機號碼」有就讀，沒有也可以。
//     · 登記名冊時，系統自動找出含三個必要標題的分頁；有多個分頁符合時，
//       優先用「明細」，否則請精舍管理員指定分頁名稱。找到的分頁名稱記在精舍設定。
//   名冊屬於精舍，平台不能在上面貼欄位標記，因此只依標題文字找欄位。
//
// 相依檔案：核心_錯誤、核心_試算表存取、核心_工具、核心_租戶解析、核心_流水號
// ============================================================================


// ----------------------------------------------------------------------------
// 學員名冊格式
// ----------------------------------------------------------------------------
const obj學員名冊格式 = Object.freeze({
  str外部檔案項目: '學員名冊',                    // 精舍設定「外部檔案」中的項目名稱
  str優先分頁: '明細',                            // 多個分頁都符合時優先使用
  arr必要欄位: ['學員編號', '姓名', '法名'],
  arr選用欄位: ['性別', '手機號碼']
});

// 比對結果
const obj比對結果 = Object.freeze({
  符合: '符合',
  找不到: '找不到',
  多筆符合: '多筆符合'
});

// 同一次執行內的名冊快取（精舍代號 → 名冊資料）
const obj學員名冊快取_ = {};


/**
 * ============================================================================
 * 函式名稱：正規化學員編號
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   學員編號一律轉成文字。試算表常把編號存成數字（例如 105053920），
 *   QR code 掃出來則是文字，統一後才能正確比對。
 *
 * 參數：
 *   any編號   {string|number} 原始編號
 *
 * 傳回：{string} 去除空白後的編號；空值傳回空字串
 * ============================================================================
 */
function 正規化學員編號(any編號) {
  if (any編號 === null || any編號 === undefined) return '';
  // 數字：轉成不帶小數點的整數文字（避免出現 105053920.0）
  if (typeof any編號 === 'number') return String(Math.round(any編號));
  return String(any編號).replace(/\s/g, '');
}


/**
 * ============================================================================
 * 函式名稱：正規化人名
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：去除姓名、法名中的所有空白（含全形空白），避免「傳 廉」與「傳廉」比對不到。
 * 參數：
 *   any名稱   {string} 原始姓名或法名
 * 傳回：{string}
 * ============================================================================
 */
function 正規化人名(any名稱) {
  if (any名稱 === null || any名稱 === undefined) return '';
  return String(any名稱).replace(/[\s　]/g, '');
}


/**
 * ============================================================================
 * 函式名稱：尋找名冊分頁
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   找出名冊中「第 1 列含學員編號、姓名、法名三個標題」的分頁。
 *     · 有指定分頁名稱：只檢查該分頁
 *     · 沒指定：只有一個分頁符合就用它；多個符合時優先「明細」，否則請使用者指定
 *
 * 參數：
 *   obj試算表       {Spreadsheet} 學員名冊
 *   str指定分頁     {string}      選填，指定的分頁名稱
 *
 * 傳回：{Sheet} 名冊分頁
 * ============================================================================
 */
function 尋找名冊分頁(obj試算表, str指定分頁) {
  const arr必要 = obj學員名冊格式.arr必要欄位;

  // ── 有指定：直接檢查該分頁（缺欄位時列出缺少哪些） ──
  if (str指定分頁 && String(str指定分頁).trim() !== '') {
    const obj分頁 = 取得工作表(obj試算表, String(str指定分頁).trim());
    檢查欄位結構(obj分頁, arr必要, true);
    return obj分頁;
  }

  // ── 沒指定：逐一檢查每個分頁 ──
  const arr符合 = obj試算表.getSheets().filter(function (obj分頁) {
    const obj對照 = 取得欄位對照(obj分頁, true);
    return arr必要.every(function (str欄位) { return 查找欄號(obj對照, str欄位) > 0; });
  });

  if (arr符合.length === 1) return arr符合[0];

  if (arr符合.length === 0) {
    throw new 平台錯誤(
      obj錯誤代碼.欄位缺漏,
      `「${obj試算表.getName()}」中找不到學員名冊的分頁：第 1 列必須有「${arr必要.join('」「')}」三個標題。`
    );
  }

  // 多個分頁符合：優先用「明細」
  const arr優先 = arr符合.filter(function (obj分頁) { return obj分頁.getName() === obj學員名冊格式.str優先分頁; });
  if (arr優先.length === 1) return arr優先[0];

  throw new 平台錯誤(
    obj錯誤代碼.參數錯誤,
    `「${obj試算表.getName()}」有多個分頁都像學員名冊：${arr符合.map(function (o) { return o.getName(); }).join('、')}。請指定要使用哪一個分頁。`,
    { arr符合分頁: arr符合.map(function (o) { return o.getName(); }) }
  );
}


/**
 * ============================================================================
 * 函式名稱：檢查學員名冊結構
 * 版本：v1.1.0（2026-10-25）
 *   v1.1.0：改為自動尋找分頁，並傳回分頁名稱
 * ----------------------------------------------------------------------------
 * 用途：
 *   檢查一份試算表能否作為學員名冊。精舍管理員登記名冊時先檢查，
 *   避免日後報到才發現格式不對。
 *
 * 參數：
 *   obj試算表       {Spreadsheet} 要檢查的試算表
 *   str指定分頁     {string}      選填，指定的分頁名稱
 *
 * 傳回：{Object} { str分頁名稱, int學員數, arr可用欄位 }
 * ============================================================================
 */
function 檢查學員名冊結構(obj試算表, str指定分頁) {
  const obj分頁 = 尋找名冊分頁(obj試算表, str指定分頁);

  // 選用欄位：有哪些就用哪些
  const obj對照 = 取得欄位對照(obj分頁);
  const arr可用選用 = obj學員名冊格式.arr選用欄位.filter(function (str欄位) { return 查找欄號(obj對照, str欄位) > 0; });

  return {
    str分頁名稱: obj分頁.getName(),
    int學員數: Math.max(obj分頁.getLastRow() - 1, 0),
    arr可用欄位: obj學員名冊格式.arr必要欄位.concat(arr可用選用)
  };
}


/**
 * ============================================================================
 * 函式名稱：讀取學員名冊
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   讀出精舍的整份學員名冊，並建立兩種索引，之後查詢不必再讀試算表。
 *   同一次執行中只讀一次。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *
 * 傳回：
 *   {Object} {
 *     arr學員:        [ { str學員編號, str姓名, str法名, str性別, str手機號碼 } ],
 *     obj依編號:      { 學員編號: 學員 },
 *     obj依姓名法名:  { '姓名|法名': [ 學員, ... ] }
 *   }
 * ============================================================================
 */
function 讀取學員名冊(str精舍代號) {
  const str代號 = 正規化精舍代號(str精舍代號);
  if (obj學員名冊快取_[str代號]) return obj學員名冊快取_[str代號];

  // 開啟精舍登記的名冊與分頁（分頁名稱於登記時記下；舊資料沒有記錄則自動尋找）
  const obj設定 = 取得精舍外部檔案設定(str代號, obj學員名冊格式.str外部檔案項目);
  const obj名冊 = 開啟試算表(obj設定.str檔案ID, '學員名冊');
  const obj結構 = 檢查學員名冊結構(obj名冊, obj設定.str分頁名稱);
  const obj分頁 = 取得工作表(obj名冊, obj結構.str分頁名稱);

  const obj結果 = { arr學員: [], obj依編號: {}, obj依姓名法名: {} };

  讀取全部資料列(obj分頁, obj結構.arr可用欄位).forEach(function (obj列) {
    const obj學員 = {
      str學員編號: 正規化學員編號(obj列.obj值['學員編號']),
      str姓名: 正規化人名(obj列.obj值['姓名']),
      str法名: 正規化人名(obj列.obj值['法名']),
      str性別: String(obj列.obj值['性別'] || '').trim(),
      str手機號碼: 格式化電話(obj列.obj值['手機號碼'])
    };

    // 沒有編號或沒有姓名的列略過
    if (obj學員.str學員編號 === '' || obj學員.str姓名 === '') return;

    obj結果.arr學員.push(obj學員);
    obj結果.obj依編號[obj學員.str學員編號] = obj學員;
    const str鍵 = `${obj學員.str姓名}|${obj學員.str法名}`;
    (obj結果.obj依姓名法名[str鍵] = obj結果.obj依姓名法名[str鍵] || []).push(obj學員);
  });

  obj學員名冊快取_[str代號] = obj結果;
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：依編號查詢學員
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：報到時以學員編號查出學員資料。
 *
 * 參數：
 *   str精舍代號   {string}        精舍代號
 *   any學員編號   {string|number} 學員編號（QR code 內容）
 *
 * 傳回：{Object|null} 學員資料；查無此人傳回 null
 * ============================================================================
 */
function 依編號查詢學員(str精舍代號, any學員編號) {
  const str編號 = 正規化學員編號(any學員編號);
  if (str編號 === '') return null;
  return 讀取學員名冊(str精舍代號).obj依編號[str編號] || null;
}


/**
 * ============================================================================
 * 函式名稱：比對學員編號
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   以「姓名＋法名」到名冊比對學員編號（同一人的判定規則）。
 *     · 剛好一筆：符合，帶回學員編號
 *     · 找不到：交由呼叫端決定是否配發臨時編號
 *     · 多筆：名冊中有同名同法名的人，不自動選，列出候選讓承辦人判斷
 *
 * 參數：
 *   str精舍代號   {string}   精舍代號
 *   arr人員       {Object[]} [ { str姓名, str法名 }, ... ]
 *
 * 傳回：
 *   {Object[]} 與輸入同順序：[ { str姓名, str法名, str比對結果, str學員編號, arr候選編號 } ]
 * ============================================================================
 */
function 比對學員編號(str精舍代號, arr人員) {
  const obj名冊 = 讀取學員名冊(str精舍代號);

  return (arr人員 || []).map(function (obj人) {
    const str姓名 = 正規化人名(obj人 && obj人.str姓名);
    const str法名 = 正規化人名(obj人 && obj人.str法名);
    const arr符合 = obj名冊.obj依姓名法名[`${str姓名}|${str法名}`] || [];

    // 依筆數判定結果
    let str結果 = obj比對結果.找不到;
    if (arr符合.length === 1) str結果 = obj比對結果.符合;
    if (arr符合.length > 1) str結果 = obj比對結果.多筆符合;

    return {
      str姓名: str姓名,
      str法名: str法名,
      str比對結果: str結果,
      str學員編號: arr符合.length === 1 ? arr符合[0].str學員編號 : '',
      arr候選編號: arr符合.length > 1 ? arr符合.map(function (obj學員) { return obj學員.str學員編號; }) : []
    };
  });
}


/**
 * ============================================================================
 * 函式名稱：比對並配發臨時編號
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   比對學員編號後，「找不到」的人自動配發臨時編號（一次保留連號，速度快）。
 *   「多筆符合」的人不配發，留給承辦人判斷。
 *   ※ 本函式自行鎖定，呼叫端「不要」再包在執行並鎖定裡。
 *
 * 參數：
 *   str精舍代號   {string}   精舍代號
 *   arr人員       {Object[]} [ { str姓名, str法名 }, ... ]
 *
 * 傳回：
 *   {Object[]} 同「比對學員編號」，另加 bool臨時編號（是否為新配發的臨時編號）
 * ============================================================================
 */
function 比對並配發臨時編號(str精舍代號, arr人員) {
  const arr結果 = 比對學員編號(str精舍代號, arr人員).map(function (obj) {
    return Object.assign({}, obj, { bool臨時編號: false });
  });

  // 找出需要臨時編號的人；同一批中同姓名＋法名的人視為同一人，只配發一個號碼
  const arr待配發鍵 = [];
  arr結果.forEach(function (obj) {
    const str鍵 = `${obj.str姓名}|${obj.str法名}`;
    if (obj.str比對結果 === obj比對結果.找不到 && obj.str姓名 !== '' && arr待配發鍵.indexOf(str鍵) === -1) {
      arr待配發鍵.push(str鍵);
    }
  });
  if (arr待配發鍵.length === 0) return arr結果;

  // 一次保留連號
  const arr臨時編號 = 執行並鎖定(function () {
    return 產生臨時編號(str精舍代號, arr待配發鍵.length);
  }, '配發臨時編號');

  // 依鍵填回每一筆
  arr結果.forEach(function (obj) {
    const int位置 = arr待配發鍵.indexOf(`${obj.str姓名}|${obj.str法名}`);
    if (obj.str比對結果 === obj比對結果.找不到 && int位置 !== -1) {
      obj.str學員編號 = arr臨時編號[int位置];
      obj.bool臨時編號 = true;
    }
  });

  return arr結果;
}
