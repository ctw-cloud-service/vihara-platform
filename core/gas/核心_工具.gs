// ============================================================================
// 檔案名稱：核心_工具.gs
// 所屬層級：平台核心／共用
// 檔案版本：v1.0.0（2026-10-25）
// 用途說明：
//   各模組都會用到的小工具：鎖定（防止多人同時寫入）、帳號與精舍代號的
//   統一格式、日期與電話格式化、產生隨機碼。
// 相依檔案：核心_錯誤.gs
// ============================================================================


// ----------------------------------------------------------------------------
// 本檔常數
// ----------------------------------------------------------------------------
const str平台時區 = 'Asia/Taipei';     // 所有日期一律以台灣時間顯示
const int預設鎖定等待毫秒 = 30000;      // 拿不到鎖定時最多等 30 秒


/**
 * ============================================================================
 * 函式名稱：執行並鎖定
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   在「同一時間只允許一人執行」的保護下執行一段工作，
 *   例如新增資料列、產生流水號。多台裝置同時報到時，可避免列號錯亂或重複編號。
 *
 * 參數：
 *   fn工作           {Function} 要執行的工作，其傳回值會原樣傳回
 *   str作業名稱      {string}   作業名稱，用於忙碌時的提示，例如「寫入報到紀錄」
 *   int等待毫秒      {number}   選填，最多等待多久，預設 30000（30 秒）
 *
 * 傳回：
 *   {*} fn工作 的傳回值
 * ============================================================================
 */
function 執行並鎖定(fn工作, str作業名稱, int等待毫秒) {
  // 防呆：一定要給工作
  if (typeof fn工作 !== 'function') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '鎖定執行時沒有提供要做的工作，請通知系統管理員。');
  }

  // 取得整個 GAS 專案共用的鎖（所有使用者、所有精舍共用同一把）
  const obj鎖 = LockService.getScriptLock();
  const int等待 = int等待毫秒 || int預設鎖定等待毫秒;

  // 在時限內拿不到鎖：代表有人正在處理，請使用者稍後再試
  if (!obj鎖.tryLock(int等待)) {
    throw new 平台錯誤(
      obj錯誤代碼.系統忙碌,
      `目前使用的人較多，「${str作業名稱 || '這項作業'}」暫時無法執行，請等幾秒後再試一次。`
    );
  }

  try {
    // 拿到鎖後執行工作
    return fn工作();
  } finally {
    // 無論成功或失敗都要釋放，否則其他人會一直等待
    obj鎖.releaseLock();
  }
}


/**
 * ============================================================================
 * 函式名稱：正規化帳號
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把 Google 帳號統一成「去除空白、全部小寫」，比對時才不會因大小寫不同而失敗。
 *
 * 參數：
 *   str帳號   {string} 原始帳號
 *
 * 傳回：
 *   {string} 正規化後的帳號；空值傳回空字串
 * ============================================================================
 */
function 正規化帳號(str帳號) {
  if (str帳號 === null || str帳號 === undefined) return '';
  return String(str帳號).trim().toLowerCase();
}


/**
 * ============================================================================
 * 函式名稱：正規化精舍代號
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   檢查並統一精舍代號格式。規則：只能用英文字母或數字、字數不限、
 *   不可有空白或符號；英文一律轉大寫（tc 與 TC 視為同一個精舍）。
 *
 * 參數：
 *   str精舍代號   {string} 原始代號
 *
 * 傳回：
 *   {string} 正規化後的代號（大寫）
 * ============================================================================
 */
function 正規化精舍代號(str精舍代號) {
  // 去除前後空白並轉大寫
  const str代號 = (str精舍代號 === null || str精舍代號 === undefined)
    ? ''
    : String(str精舍代號).trim().toUpperCase();

  // 空白
  if (str代號 === '') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '沒有指定精舍代號。請確認網址是否完整（例如結尾要有 ?site=精舍代號）。');
  }

  // 只允許 A–Z 與 0–9
  if (!/^[A-Z0-9]+$/.test(str代號)) {
    throw new 平台錯誤(
      obj錯誤代碼.參數錯誤,
      `精舍代號「${str精舍代號}」格式不正確：只能使用英文字母或數字，不可有空白或符號。`
    );
  }

  return str代號;
}


/**
 * ============================================================================
 * 函式名稱：格式化日期
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：以台灣時間把日期轉成文字。
 *
 * 參數：
 *   dat日期     {Date}   要格式化的日期；不給就用現在時間
 *   str格式     {string} 選填，預設 'yyyy-MM-dd HH:mm:ss'
 *
 * 傳回：
 *   {string} 格式化後的文字；不是有效日期時傳回空字串
 * ============================================================================
 */
function 格式化日期(dat日期, str格式) {
  // 沒給日期就用現在
  const dat目標 = dat日期 || new Date();

  // 不是有效日期（例如空白儲存格）就傳回空字串，避免出現 Invalid Date
  if (!(dat目標 instanceof Date) || isNaN(dat目標.getTime())) return '';

  return Utilities.formatDate(dat目標, str平台時區, str格式 || 'yyyy-MM-dd HH:mm:ss');
}


/**
 * ============================================================================
 * 函式名稱：格式化電話
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   手機號碼統一成「0911-000000」格式。
 *   會自動補回試算表吃掉的開頭 0（例如 911000000 → 0911-000000）。
 *   不是手機號碼（例如市話）則只去除前後空白，原樣保留。
 *
 * 參數：
 *   any電話   {string|number} 原始電話
 *
 * 傳回：
 *   {string} 格式化後的電話
 * ============================================================================
 */
function 格式化電話(any電話) {
  // 空值
  if (any電話 === null || any電話 === undefined) return '';
  const str原始 = String(any電話).trim();
  if (str原始 === '') return '';

  // 只留數字
  let str數字 = str原始.replace(/\D/g, '');

  // 試算表把開頭 0 吃掉的手機號碼：9 碼且以 9 開頭，補回 0
  if (str數字.length === 9 && str數字.charAt(0) === '9') {
    str數字 = '0' + str數字;
  }

  // 標準手機號碼：10 碼且以 09 開頭 → 0911-000000
  if (str數字.length === 10 && str數字.indexOf('09') === 0) {
    return `${str數字.substring(0, 4)}-${str數字.substring(4)}`;
  }

  // 其他（市話、國際號碼）：原樣保留
  return str原始;
}


/**
 * ============================================================================
 * 函式名稱：產生數字碼
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   產生指定位數的隨機數字，例如 6 位數報到碼「482913」。
 *   以 Google 的 UUID 為亂數來源，比 Math.random 更難被猜到。
 *
 * 參數：
 *   int位數   {number} 要幾位數，預設 6
 *
 * 傳回：
 *   {string} 數字字串（保留開頭的 0）
 * ============================================================================
 */
function 產生數字碼(int位數) {
  const int目標位數 = int位數 || 6;
  let str結果 = '';

  // UUID 由 0–9、a–f 組成，只取其中的數字字元；不夠就再產生一個
  while (str結果.length < int目標位數) {
    str結果 += Utilities.getUuid().replace(/[^0-9]/g, '');
  }

  return str結果.substring(0, int目標位數);
}


/**
 * ============================================================================
 * 函式名稱：產生識別碼
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   產生不會重複、難以猜測的長識別碼，用於登入後的工作階段代碼（token）。
 *
 * 參數：無
 *
 * 傳回：
 *   {string} 64 個字元的英數字串
 * ============================================================================
 */
function 產生識別碼() {
  // 兩組 UUID 去掉連字號後串接，共 64 字元
  return (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '');
}
