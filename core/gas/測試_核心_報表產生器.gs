// ============================================================================
// 檔案名稱：測試_核心_報表產生器.gs
// 所屬層級：平台核心／測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.0.0（2026-11-04）
// 用途說明：
//   在 Apps Script 編輯器執行「測試_核心_報表產生器純邏輯」（數秒，不碰任何檔案）：
//   版面位置、標題解析、各種比較方式、Excel寫法、日期、排序、篩選與排序整體結果。
//   副本實際操作（建立分頁、下拉、產生、範本、權限）在法會模組的「測試_法會_報表產生器」。
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：測試_核心_報表產生器純邏輯
 * 版本：v1.0.0（2026-11-04）
 * ----------------------------------------------------------------------------
 * 用途：自動測試報表產生器不碰檔案的計算規則。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_核心_報表產生器純邏輯() {
  const arr結果 = [];
  const fn記 = function (str項目, bool通過, str補充) {
    arr結果.push({ str項目: str項目, bool通過: !!bool通過 });
    console.log(`${bool通過 ? '✔' : '✘'} ${str項目}${str補充 ? '：' + str補充 : ''}`);
  };
  const fn符 = function (any原值, str顯示, str比較, str值) {
    return 報表_符合條件_(any原值, str顯示, { str比較: str比較, str值: str值 });
  };

  // ── 一、版面位置 ──
  const p1 = 報表_條件位置_(0), p3 = 報表_條件位置_(2), p4 = 報表_條件位置_(3), p6 = 報表_條件位置_(5);
  fn記('條件1 在 A2:D2', p1.int列 === 2 && p1.int標籤欄 === 1 && p1.int欄位欄 === 2 && p1.int值欄 === 4);
  fn記('條件3 在 I2:L2、條件4 在 A3、條件6 在 I3', p3.int列 === 2 && p3.int標籤欄 === 9 && p4.int列 === 3 && p4.int標籤欄 === 1 && p6.int列 === 3 && p6.int值欄 === 12);
  const s1 = 報表_排序位置_(0), s3 = 報表_排序位置_(2);
  fn記('排序1 在 E1:G1、排序3 在 K1:M1', s1.int標籤欄 === 5 && s1.int方向欄 === 7 && s3.int標籤欄 === 11 && s3.int方向欄 === 13);
  fn記('設定區到 M 欄', 報表_設定區欄數_() === 13);
  fn記('副本端欄位欄（2、6、10）與核心一致', [0, 1, 2].every(function (i) { return 報表_條件位置_(i).int欄位欄 === 2 + i * 4; }));

  // ── 二、標題 ──
  const h1 = 報表_解析標題_('姓名', '');
  const h2 = 報表_解析標題_('護七_組別 → 組別', '');
  const h3 = 報表_解析標題_('組別', '來源欄：護七_組別');
  const h4 = 報表_解析標題_('護七_組別>組別', '');
  fn記('標題：一般欄名', h1.str來源欄 === '姓名' && h1.str顯示名稱 === '姓名');
  fn記('標題：「來源 → 顯示」', h2.str來源欄 === '護七_組別' && h2.str顯示名稱 === '組別');
  fn記('標題：備註記住來源欄', h3.str來源欄 === '護七_組別' && h3.str顯示名稱 === '組別');
  fn記('標題：半形 > 也可以', h4.str來源欄 === '護七_組別' && h4.str顯示名稱 === '組別');
  fn記('標題：空白傳回 null', 報表_解析標題_('  ', '') === null);

  // ── 三、比較方式 ──
  fn記('等於：文字不分大小寫、去空白', fn符('ABC ', 'ABC ', '等於', 'abc') && !fn符('ABCD', 'ABCD', '等於', 'abc'));
  fn記('等於：數字 1 不含 10', fn符(1, '1', '等於', '1') && !fn符(10, '10', '等於', '1'));
  fn記('等於：數字格與文字 "001"', fn符(1, '1', '等於', '001'));
  fn記('等於：日期比到日', fn符(new Date(2026, 10, 1, 9, 30), '11/1', '等於', '2026/11/1') && fn符(new Date(2026, 10, 1), '11/1', '等於', '11/1'));
  fn記('不等於：空白也算不等於', fn符('', '', '不等於', '是') && !fn符('是', '是', '不等於', '是'));
  fn記('包含／不包含', fn符('香積組內場', '香積組內場', '包含', '香積') && fn符('知客組', '知客組', '不包含', '香積') && !fn符('香積組', '香積組', '不包含', '香積'));
  fn記('開頭是', fn符('王小明', '王小明', '開頭是', '王') && !fn符('李王', '李王', '開頭是', '王'));
  fn記('空白／有填', fn符('', '', '空白', '') && fn符(' ', ' ', '空白', '') && fn符('x', 'x', '有填', '') && !fn符('', '', '有填', ''));
  fn記('大於：數字', fn符(70, '70', '大於', '65') && !fn符(65, '65', '大於', '65') && fn符(65, '65', '大於等於', '65'));
  fn記('大於：千分位文字也比數值', fn符('1,200', '1,200', '大於', '999'));
  fn記('大於：文字格不比較（不符合）', !fn符('七十', '七十', '大於', '5') && !fn符('', '', '小於', '5'));
  fn記('小於等於：日期', fn符(new Date(2026, 9, 31), '10/31', '小於等於', '2026/11/1') && !fn符(new Date(2026, 10, 2), '11/2', '小於等於', '2026/11/1'));
  fn記('介於：數字含頭尾', fn符(1, '1', '介於', '1~5') && fn符(5, '5', '介於', '1～5') && !fn符(6, '6', '介於', '1~5'));
  fn記('介於：日期', fn符(new Date(2026, 10, 15, 10, 0), '11/15', '介於', '2026/11/1至2026/11/30') && !fn符(new Date(2026, 11, 1), '12/1', '介於', '2026/11/1~2026/11/30'));
  fn記('介於：寫法錯誤不符合', !fn符(3, '3', '介於', '1-5') && !fn符(3, '3', '介於', '~5'));
  fn記('看不懂的比較方式不符合', !fn符('a', 'a', '像', 'a'));

  // ── 四、Excel寫法（同 報表.gs V5.6） ──
  fn記('Excel：>=5 只比數字', fn符(5, '5', 'Excel寫法', '>=5') && !fn符(4, '4', 'Excel寫法', '>=5') && !fn符('五', '五', 'Excel寫法', '>=5'));
  fn記('Excel：<>自行（空白也算）', fn符('大車', '大車', 'Excel寫法', '<>自行') && fn符('', '', 'Excel寫法', '<>自行') && !fn符('自行', '自行', 'Excel寫法', '<>自行'));
  fn記('Excel：*蓮* 含有', fn符('慧蓮居士', '慧蓮居士', 'Excel寫法', '*蓮*') && !fn符('慧明', '慧明', 'Excel寫法', '*蓮*'));
  fn記('Excel：沒寫運算子＝開頭符合', fn符('王小明', '王小明', 'Excel寫法', '王') && !fn符('小王', '小王', 'Excel寫法', '王'));
  fn記('Excel：= 空白、<> 有填', fn符('', '', 'Excel寫法', '=') && fn符('x', 'x', 'Excel寫法', '<>'));
  fn記('Excel：=王小明 完全相等', fn符('王小明', '王小明', 'Excel寫法', '=王小明') && !fn符('王小明明', '王小明明', 'Excel寫法', '=王小明'));
  fn記('Excel：日期 >=2026/11/1', fn符(new Date(2026, 10, 1), '11/1', 'Excel寫法', '>=2026/11/1') && !fn符(new Date(2026, 9, 30), '10/30', 'Excel寫法', '>=2026/11/1'));
  fn記('Excel：~* 為字面星號', fn符('A*B', 'A*B', 'Excel寫法', '=A~*B') && !fn符('AXB', 'AXB', 'Excel寫法', '=A~*B'));
  fn記('日期文字：2/30 無效', 報表_解析日期文字_('2026/2/30') === null && 報表_解析日期文字_('2026年11月1日') !== null);

  // ── 五、排序 ──
  const arr數 = [[3, '3'], ['', ''], [10, '10'], [2, '2']];
  const arr遞增 = arr數.slice().sort(function (a, b) { return 報表_排序比較_(a[0], a[1], b[0], b[1], false); }).map(function (a) { return a[1]; });
  const arr遞減 = arr數.slice().sort(function (a, b) { return 報表_排序比較_(a[0], a[1], b[0], b[1], true); }).map(function (a) { return a[1]; });
  fn記('排序：數字依數值、空白最後', arr遞增.join(',') === '2,3,10,', arr遞增.join(','));
  fn記('排序：遞減時空白仍在最後', arr遞減.join(',') === '10,3,2,', arr遞減.join(','));
  fn記('排序：日期依時間', 報表_排序比較_(new Date(2026, 0, 2), '1/2', new Date(2025, 11, 31), '12/31', false) > 0);

  // ── 六、篩選＋排序整體 ──
  const obj來源 = {
    arr原值: [['甲', '香積組', 30], ['乙', '知客組', 25], ['丙', '香積組內場', 40], ['', '', ''], ['丁', '', 50]],
    arr顯示: [['甲', '香積組', '30'], ['乙', '知客組', '25'], ['丙', '香積組內場', '40'], ['', '', ''], ['丁', '', '50']]
  };
  const r全部 = 報表_篩選排序_(obj來源, {
    bool任一: false, arr條件: [{ int欄: 1, str比較: '包含', str值: '香積' }],
    arr排序: [{ int欄: 2, bool遞減: true }], arr輸出欄: [0, -1, 2]
  });
  fn記('篩選：包含香積、年齡遞減、空白欄留空', JSON.stringify(r全部) === JSON.stringify([['丙', '', '40'], ['甲', '', '30']]), JSON.stringify(r全部));
  const r任一 = 報表_篩選排序_(obj來源, {
    bool任一: true, arr條件: [{ int欄: 1, str比較: '等於', str值: '知客組' }, { int欄: 2, str比較: '大於', str值: '45' }],
    arr排序: [], arr輸出欄: [0]
  });
  fn記('篩選：任一符合、維持原順序', JSON.stringify(r任一) === JSON.stringify([['乙'], ['丁']]), JSON.stringify(r任一));
  const r無條件 = 報表_篩選排序_(obj來源, { bool任一: false, arr條件: [], arr排序: [], arr輸出欄: [0] });
  fn記('篩選：沒有條件全部列出、整列空白略過', r無條件.length === 4);

  const arr失敗 = arr結果.filter(function (o) { return !o.bool通過; });
  console.log(`==== 測試完成：通過 ${arr結果.length - arr失敗.length} 項，失敗 ${arr失敗.length} 項 ====`);
  return { int通過: arr結果.length - arr失敗.length, int失敗: arr失敗.length, arr失敗項目: arr失敗.map(function (o) { return o.str項目; }) };
}
