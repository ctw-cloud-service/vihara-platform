// ============================================================================
// 檔案名稱：測試_核心_具名函式掃描.gs
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.0.0（2026-10-25）
// 用途說明：
//   在 Apps Script 編輯器中執行「測試_具名函式掃描」。
//
//   要確認的事：平台能不能自己找出程式中所有「模組定義_xxx」「主檔定義_xxx」
//   這類固定開頭的函式。可以的話，新增模組時就不必修改核心程式，
//   「登記所有模組」「列出主檔種類」都靠這個做法。
//
//   比較三種掃描方式，並檢查：
//     ① 找得到本檔的測試函式
//     ② 找得到「別的 .gs 檔」裡的函式（例如 核心_模組管理.gs 的 取得模組定義）
//     ③ 不會把 const／let 常數誤當成函式
//     ④ 掃描速度（每次請求都可能用到，要夠快）
//
//   不讀寫任何試算表或雲端硬碟，不需要重新部署。
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：模組定義_testscan
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：測試專用的模組定義，只用來確認掃描找得到它。
 * 參數：無
 * 傳回：{Object} 模組定義
 * ============================================================================
 */
function 模組定義_testscan() {
  return { str模組名稱: '掃描測試模組', str型態: '持續型', arr可指派權限: [] };
}


/**
 * ============================================================================
 * 函式名稱：主檔定義_testscan
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：測試專用的主檔定義，只用來確認掃描找得到它。
 * 參數：無
 * 傳回：{Object} 主檔定義
 * ============================================================================
 */
function 主檔定義_testscan() {
  return { str主檔名稱: '掃描測試主檔', str代號前綴: 'S' };
}


// 測試用常數：開頭與函式相同，但不是函式，掃描結果不應出現
const 模組定義_testscan_不是函式 = '這是常數，不應被當成模組';


/**
 * ============================================================================
 * 函式名稱：列出具名函式_試作
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   找出所有名稱以 str前綴 開頭的頂層函式，傳回「前綴之後的部分」。
 *   例：前綴「模組定義_」→ ['event', 'testscan']。
 *   本測試通過後，正式版會放進 核心_工具.gs。
 *
 * 參數：
 *   str前綴   {string} 例如 '模組定義_'
 *   str方式   {string} 選填：'keys'（預設）| 'names' | 'forin'，供比較用
 *
 * 傳回：{string[]} 依字母排序的代號清單（只收英文小寫、數字、底線）
 * ============================================================================
 */
function 列出具名函式_試作(str前綴, str方式) {
  // 取得全域名稱清單（三種方式只差在取名單的作法）
  let arr名稱;
  if (str方式 === 'names') {
    arr名稱 = Object.getOwnPropertyNames(globalThis);
  } else if (str方式 === 'forin') {
    arr名稱 = [];
    for (const str名稱 in globalThis) arr名稱.push(str名稱);   // eslint-disable-line guard-for-in
  } else {
    arr名稱 = Object.keys(globalThis);
  }

  // 篩選：開頭相符、真的是函式、代號格式正確（與 取得模組定義 的規則相同）
  return arr名稱
    .filter(function (str名稱) { return str名稱.indexOf(str前綴) === 0; })
    .filter(function (str名稱) { return typeof globalThis[str名稱] === 'function'; })
    .map(function (str名稱) { return str名稱.substring(str前綴.length); })
    .filter(function (str代號) { return /^[a-z0-9_]+$/.test(str代號); })
    .sort();
}


/**
 * ============================================================================
 * 函式名稱：測試_具名函式掃描
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：比較三種掃描方式，結果寫在執行記錄中。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, str建議方式 }
 * ============================================================================
 */
function 測試_具名函式掃描() {
  const arr結果 = [];
  function 記錄(str項目, bool通過, str補充) {
    arr結果.push({ str項目: str項目, bool通過: bool通過 });
    console.log(`${bool通過 ? '✔' : '✘'} ${str項目}${str補充 ? '：' + str補充 : ''}`);
  }

  const arr方式 = ['keys', 'names', 'forin'];
  const obj各方式通過 = {};

  arr方式.forEach(function (str方式) {
    console.log(`── 方式：${str方式} ──`);
    let bool全過 = true;
    try {
      // ① 本檔的測試函式
      const arr模組 = 列出具名函式_試作('模組定義_', str方式);
      const arr主檔 = 列出具名函式_試作('主檔定義_', str方式);
      const bool模組 = arr模組.indexOf('testscan') !== -1;
      const bool主檔 = arr主檔.indexOf('testscan') !== -1;
      記錄(`[${str方式}] 找到本檔的模組定義`, bool模組, `模組：${arr模組.join('、') || '（無）'}`);
      記錄(`[${str方式}] 找到本檔的主檔定義`, bool主檔, `主檔：${arr主檔.join('、') || '（無）'}`);

      // ② 別的 .gs 檔的函式：以「取得模組」為前綴，應找到 核心_模組管理 與 核心_租戶解析 的函式
      //    （「定義」「主控台ID」不符合代號格式會被濾掉，所以這裡直接查原始名單）
      const arr全域 = str方式 === 'names' ? Object.getOwnPropertyNames(globalThis)
        : (str方式 === 'forin' ? (function () { const a = []; for (const k in globalThis) a.push(k); return a; })()
          : Object.keys(globalThis));
      const bool跨檔 = arr全域.indexOf('取得模組定義') !== -1 && arr全域.indexOf('取得已開通模組') !== -1;
      記錄(`[${str方式}] 找得到其他檔案的函式`, bool跨檔, '取得模組定義（核心_模組管理）、取得已開通模組（核心_租戶解析）');

      // ③ 常數不可混入
      const bool無常數 = arr模組.indexOf('testscan_不是函式') === -1;
      記錄(`[${str方式}] 常數沒有被誤認`, bool無常數);

      // ④ 速度：連續 20 次取平均
      const int開始 = new Date().getTime();
      for (let i = 0; i < 20; i++) 列出具名函式_試作('模組定義_', str方式);
      const num平均 = (new Date().getTime() - int開始) / 20;
      const bool夠快 = num平均 < 50;
      記錄(`[${str方式}] 速度`, bool夠快, `平均 ${num平均.toFixed(1)} 毫秒／次（標準：50 毫秒內）`);

      bool全過 = bool模組 && bool主檔 && bool跨檔 && bool無常數 && bool夠快;
    } catch (err) {
      記錄(`[${str方式}] 執行時發生錯誤`, false, err.message);
      bool全過 = false;
    }
    obj各方式通過[str方式] = bool全過;
  });

  // ── 總結 ──
  const int通過 = arr結果.filter(function (o) { return o.bool通過; }).length;
  const int失敗 = arr結果.length - int通過;
  const str建議方式 = arr方式.filter(function (str) { return obj各方式通過[str]; })[0] || '';

  console.log('════════════════════════════════');
  console.log(`共 ${arr結果.length} 項：通過 ${int通過}、失敗 ${int失敗}`);
  console.log(`可用的方式：${arr方式.filter(function (s) { return obj各方式通過[s]; }).join('、') || '（無）'}`);
  console.log(str建議方式
    ? `結論：可以自動掃描，正式版採用「${str建議方式}」方式。`
    : '結論：GAS 無法自動掃描，改用「模組清單分頁就是名單」的備案。');

  return { int通過: int通過, int失敗: int失敗, str建議方式: str建議方式 };
}
