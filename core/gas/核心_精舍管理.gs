// ============================================================================
// 檔案名稱：核心_精舍管理.gs
// 所屬層級：平台核心／服務層
// 檔案版本：v1.3.0（2026-10-28）
//   v1.3.0：「精舍設定」試算表以「檢視者」共享給該精舍啟用中的精舍管理員（不給編輯權）；
//           開通精舍、新增／重新啟用／停用精舍管理員、停用／啟用精舍時自動同步；
//           補齊所有精舍結構時一併同步。新增「同步精舍設定共享」
//   v1.2.0：精舍名稱不可重複（忽略空白、含已停用的精舍）；開通與改名都會檢查
//   v1.1.0：新增或停用精舍管理員後自動同步副本共享；新增「補齊所有精舍結構」
//   v1.0.0：初版
// 用途說明：
//   系統管理員的工作：初始化平台、開通／停用精舍、登記精舍管理員。
//   精舍內部的人員與權限由精舍管理員處理（見 核心_人員管理.gs）。
//
//   精舍設定試算表的共享（v1.3.0）：
//     · 只以「檢視者」共享給該精舍啟用中的精舍管理員，方便查看；修改一律透過精舍設定頁
//     · 精舍停用時移除所有共享；重新啟用時恢復
//     · 系統帳號以外的人若有編輯權（例如在雲端硬碟手動加入），同步時會移除
//
//   ctw.cloud.service 雲端硬碟的資料夾結構（由「初始化平台」自動建立）：
//     精舍雲端服務平台／
//       ├─ 系統主控（試算表）
//       ├─ 範本／
//       └─ 精舍資料／
//            └─ TC 台中精舍／
//                 └─ 精舍設定（試算表）
//
// 相依檔案：核心_錯誤、核心_試算表存取、核心_工具、核心_結構定義、
//           核心_租戶解析、核心_權限、核心_日誌
// ============================================================================


// ----------------------------------------------------------------------------
// 本檔常數
// ----------------------------------------------------------------------------
const str平台資料夾名稱 = '精舍雲端服務平台';
const str系統主控檔名 = '系統主控';
const str精舍設定檔名 = '精舍設定';
const reg電子郵件格式 = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

// 測試專用：指定暫存的「精舍資料」資料夾，正式執行時一律為 null
let str測試用精舍資料根ID_ = null;


/**
 * ============================================================================
 * 函式名稱：取得精舍資料根資料夾_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：取得存放各精舍資料夾的「精舍資料」資料夾；尚未初始化時給出白話說明。
 * 參數：無
 * 傳回：{Folder}
 * ============================================================================
 */
function 取得精舍資料根資料夾_() {
  const str資料夾ID = str測試用精舍資料根ID_ || 取得系統設定值(obj設定名稱.精舍資料根ID);
  try {
    return DriveApp.getFolderById(str資料夾ID);
  } catch (err) {
    throw new 平台錯誤(
      obj錯誤代碼.設定缺漏,
      '找不到「精舍資料」資料夾。請系統管理員在 Apps Script 重新執行「初始化平台」。',
      { str資料夾ID: str資料夾ID }
    );
  }
}


/**
 * ============================================================================
 * 函式名稱：初始化平台
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   平台第一次使用時，由系統管理員在 Apps Script 編輯器「手動執行一次」：
 *     ① 建立「精舍雲端服務平台」「範本」「精舍資料」三個資料夾；
 *     ② 建立「系統主控」試算表與所有分頁；
 *     ③ 把各檔案代號自動寫入指令碼屬性。
 *   可重複執行：已建立的部分會沿用，只補齊缺少的部分。
 *
 * 執行前提：
 *   · 指令碼屬性已設定「系統管理員帳號」
 *   · 必須以該帳號（ctw.cloud.service）登入 Apps Script 執行
 *
 * 參數：無
 * 傳回：{Object} { str系統主控試算表ID, str系統資料夾ID }
 * ============================================================================
 */
function 初始化平台() {
  // ── 安全檢查：只能由系統管理員帳號執行，避免檔案建在別人的雲端硬碟 ──
  const str系統管理員 = 正規化帳號(取得系統設定值(obj設定名稱.系統管理員帳號));
  const str執行帳號 = 正規化帳號(Session.getEffectiveUser().getEmail());
  if (str執行帳號 !== str系統管理員) {
    throw new 平台錯誤(
      obj錯誤代碼.權限不足,
      `請以系統管理員帳號（${str系統管理員}）登入 Apps Script 後再執行。目前帳號：${str執行帳號 || '無法辨識'}。`
    );
  }

  const obj屬性 = PropertiesService.getScriptProperties();

  // ── ① 資料夾：有記錄且還在就沿用，否則新建 ──
  const obj平台資料夾 = 取得或建立資料夾_(obj屬性, obj設定名稱.系統資料夾ID, str平台資料夾名稱, null);
  const obj範本資料夾 = 取得或建立資料夾_(obj屬性, obj設定名稱.範本資料夾ID, '範本', obj平台資料夾);
  取得或建立資料夾_(obj屬性, obj設定名稱.精舍資料根ID, '精舍資料', obj平台資料夾);

  // ── ② 系統主控：有記錄且開得了就沿用，否則新建並移入平台資料夾 ──
  let obj系統主控 = null;
  const str既有ID = obj屬性.getProperty(obj設定名稱.系統主控試算表ID);
  if (str既有ID) {
    try { obj系統主控 = SpreadsheetApp.openById(str既有ID); } catch (err) { obj系統主控 = null; }
  }
  if (!obj系統主控) {
    obj系統主控 = SpreadsheetApp.create(str系統主控檔名);
    DriveApp.getFileById(obj系統主控.getId()).moveTo(obj平台資料夾);
    obj屬性.setProperty(obj設定名稱.系統主控試算表ID, obj系統主控.getId());
  }

  // 建立或補齊所有分頁
  建立整份結構(obj系統主控, obj系統主控結構);

  console.log(`✔ 平台初始化完成。系統主控：${obj系統主控.getUrl()}`);
  console.log(`  範本資料夾：${obj範本資料夾.getUrl()}`);
  return { str系統主控試算表ID: obj系統主控.getId(), str系統資料夾ID: obj平台資料夾.getId() };
}


/**
 * ============================================================================
 * 函式名稱：取得或建立資料夾_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：依指令碼屬性中的資料夾代號取得資料夾；不存在或已在垃圾桶就新建，並更新屬性。
 *
 * 參數：
 *   obj屬性         {Properties} 指令碼屬性
 *   str屬性名稱     {string}     存放資料夾代號的屬性名稱
 *   str資料夾名稱   {string}     新建時使用的名稱
 *   obj上層資料夾   {Folder}     新建時放在哪裡；null 表示雲端硬碟根目錄
 *
 * 傳回：{Folder}
 * ============================================================================
 */
function 取得或建立資料夾_(obj屬性, str屬性名稱, str資料夾名稱, obj上層資料夾) {
  // 先試著沿用既有資料夾（不能在垃圾桶裡）
  const str既有ID = obj屬性.getProperty(str屬性名稱);
  if (str既有ID) {
    try {
      const obj既有 = DriveApp.getFolderById(str既有ID);
      if (!obj既有.isTrashed()) return obj既有;
    } catch (err) {
      // 找不到：往下新建
    }
  }

  // 新建並記錄代號
  const obj新資料夾 = obj上層資料夾 ? obj上層資料夾.createFolder(str資料夾名稱) : DriveApp.createFolder(str資料夾名稱);
  obj屬性.setProperty(str屬性名稱, obj新資料夾.getId());
  return obj新資料夾;
}


/**
 * ============================================================================
 * 函式名稱：列出精舍
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：總管理頁的精舍清單，含每個精舍的精舍管理員。
 *
 * 參數：
 *   obj工作階段   {Object} 系統管理員的工作階段
 *   obj參數       {Object} 不需要
 *
 * 傳回：
 *   {Object} { bool成功, arr精舍: [ { str精舍代號, str精舍名稱, str狀態, str開通日期,
 *                                      arr管理員: [ { str帳號, str姓名, str狀態 } ] } ] }
 * ============================================================================
 */
function 列出精舍(obj工作階段, obj參數) {
  檢查權限(obj工作階段, '系統.管理精舍', '查看精舍清單');

  const obj主控 = 取得系統主控();

  // 讀出所有管理員，依精舍代號分組
  const obj管理員定義 = obj系統主控結構.精舍管理員;
  const obj管理員分組 = {};
  讀取全部資料列(取得工作表(obj主控, obj管理員定義.str分頁), obj管理員定義.arr欄位).forEach(function (obj列) {
    const str代號 = String(obj列.obj值['精舍代號']).trim().toUpperCase();
    (obj管理員分組[str代號] = obj管理員分組[str代號] || []).push({
      str帳號: 正規化帳號(obj列.obj值['Google帳號']),
      str姓名: String(obj列.obj值['姓名']).trim(),
      str狀態: String(obj列.obj值['狀態']).trim()
    });
  });

  // 讀出所有精舍並附上管理員
  const obj精舍定義 = obj系統主控結構.精舍清單;
  const arr精舍 = 讀取全部資料列(取得工作表(obj主控, obj精舍定義.str分頁), obj精舍定義.arr欄位).map(function (obj列) {
    const str代號 = String(obj列.obj值['精舍代號']).trim().toUpperCase();
    return {
      str精舍代號: str代號,
      str精舍名稱: String(obj列.obj值['精舍名稱']).trim(),
      str狀態: String(obj列.obj值['狀態']).trim(),
      str開通日期: 格式化日期(obj列.obj值['開通日期'], 'yyyy-MM-dd'),
      arr管理員: obj管理員分組[str代號] || []
    };
  });

  return { bool成功: true, arr精舍: arr精舍 };
}


/**
 * ============================================================================
 * 函式名稱：開通精舍
 * 版本：v1.2.0（2026-10-28）
 *   v1.2.0：開通後把精舍設定以檢視者共享給第一位精舍管理員
 *   v1.1.0：精舍名稱不可與既有精舍重複
 * ----------------------------------------------------------------------------
 * 用途：
 *   建立新精舍：建立精舍資料夾與「精舍設定」試算表，登記精舍與第一位精舍管理員，
 *   並把精舍設定以「檢視者」共享給精舍管理員。
 *   若中途失敗，會把已建立的資料夾丟到垃圾桶，不留下半套資料。
 *
 * 參數：
 *   obj工作階段   {Object} 系統管理員的工作階段
 *   obj參數       {Object} { str精舍代號, str精舍名稱, str管理員帳號, str管理員姓名 }
 *
 * 傳回：{Object} { bool成功, str精舍代號, str訊息 }
 * ============================================================================
 */
function 開通精舍(obj工作階段, obj參數) {
  // ── 權限與資料檢查 ──
  檢查權限(obj工作階段, '系統.管理精舍', '開通精舍');
  檢查必要參數(obj參數, ['str精舍代號', 'str精舍名稱', 'str管理員帳號', 'str管理員姓名'], '開通精舍');

  const str代號 = 正規化精舍代號(obj參數.str精舍代號);
  const str名稱 = String(obj參數.str精舍名稱).trim();
  const str管理員帳號 = 正規化帳號(obj參數.str管理員帳號);
  const str管理員姓名 = String(obj參數.str管理員姓名).trim();
  檢查電子郵件_(str管理員帳號, '精舍管理員的 Google 帳號');

  // 代號與名稱都不可重複（先檢查一次，避免白白建立檔案；鎖定內會再確認一次）
  檢查精舍代號未使用_(str代號);
  檢查精舍名稱未使用_(str名稱, '');

  // ── 建立資料夾與精舍設定（耗時較久，不放在鎖定中以免擋住其他人） ──
  const obj精舍根 = 取得精舍資料根資料夾_();
  const obj精舍資料夾 = obj精舍根.createFolder(`${str代號} ${str名稱}`);

  try {
    const obj設定 = SpreadsheetApp.create(`${str精舍設定檔名}－${str名稱}`);
    DriveApp.getFileById(obj設定.getId()).moveTo(obj精舍資料夾);
    建立整份結構(obj設定, obj精舍設定結構);

    // ── 登記到系統主控（鎖定中再確認一次代號未被搶先使用） ──
    執行並鎖定(function () {
      檢查精舍代號未使用_(str代號);
      檢查精舍名稱未使用_(str名稱, '');
      const obj主控 = 取得系統主控();
      新增資料列(取得工作表(obj主控, obj系統主控結構.精舍清單.str分頁), {
        '精舍代號': str代號, '精舍名稱': str名稱,
        '精舍資料夾ID': obj精舍資料夾.getId(), '精舍設定ID': obj設定.getId(),
        '狀態': obj狀態.啟用, '開通日期': new Date()
      });
      新增資料列(取得工作表(obj主控, obj系統主控結構.精舍管理員.str分頁), {
        '精舍代號': str代號, 'Google帳號': str管理員帳號, '姓名': str管理員姓名,
        '狀態': obj狀態.啟用, '登記日期': new Date()
      });
    }, '開通精舍');
  } catch (err) {
    // 失敗：把剛建立的資料夾（含精舍設定）丟到垃圾桶，不留半套資料
    try { obj精舍資料夾.setTrashed(true); } catch (errIgnore) { /* 已無法處理則略過 */ }
    throw err;
  }

  寫入操作日誌(obj工作階段, '開通精舍', `${str代號} ${str名稱}，精舍管理員 ${str管理員姓名}（${str管理員帳號}）`, str代號);

  // 精舍設定以檢視者共享給第一位精舍管理員（失敗不影響開通，只附提醒）
  const str提醒 = 精舍設定共享提醒_(str代號);
  return { bool成功: true, str精舍代號: str代號, str訊息: `已開通「${str名稱}」（${str代號}）。${str提醒}` };
}


/**
 * ============================================================================
 * 函式名稱：更新精舍
 * 版本：v1.2.0（2026-10-28）
 *   v1.2.0：停用／重新啟用精舍時，同步精舍設定的檢視者共享
 *   v1.1.0：改名時檢查不可與其他精舍同名（與自己原本的名稱相同不算）
 * ----------------------------------------------------------------------------
 * 用途：修改精舍名稱，或停用／重新啟用精舍。精舍代號不可修改。
 *
 * 參數：
 *   obj工作階段   {Object} 系統管理員的工作階段
 *   obj參數       {Object} { str精舍代號, str精舍名稱（選填）, str狀態（選填：啟用／停用） }
 *
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 更新精舍(obj工作階段, obj參數) {
  檢查權限(obj工作階段, '系統.管理精舍', '修改精舍');
  檢查必要參數(obj參數, ['str精舍代號'], '修改精舍');

  const str代號 = 正規化精舍代號(obj參數.str精舍代號);
  const obj更新 = {};

  // 名稱（有給才改）
  if (obj參數.str精舍名稱 !== undefined && String(obj參數.str精舍名稱).trim() !== '') {
    obj更新['精舍名稱'] = String(obj參數.str精舍名稱).trim();
  }
  // 狀態（有給才改，只接受啟用或停用）
  if (obj參數.str狀態 !== undefined && obj參數.str狀態 !== '') {
    obj更新['狀態'] = 檢查狀態值_(obj參數.str狀態);
  }
  if (Object.keys(obj更新).length === 0) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '沒有要修改的內容，請填寫精舍名稱或選擇狀態。');
  }

  執行並鎖定(function () {
    // 有改名才檢查名稱；排除自己，讓「名稱不變只改狀態」或「改回原名」不會被擋
    if (obj更新['精舍名稱'] !== undefined) 檢查精舍名稱未使用_(obj更新['精舍名稱'], str代號);

    const obj定義 = obj系統主控結構.精舍清單;
    const obj分頁 = 取得工作表(取得系統主控(), obj定義.str分頁);
    const obj列 = 找出唯一資料列_(obj分頁, obj定義.arr欄位, function (obj值) {
      return String(obj值['精舍代號']).trim().toUpperCase() === str代號;
    }, `找不到精舍代號「${str代號}」。`);
    更新資料列(obj分頁, obj列.int列號, obj更新);
  }, '修改精舍');

  // 清除本次執行的精舍快取，避免後續讀到舊資料
  清除精舍快取(str代號);

  寫入操作日誌(obj工作階段, '修改精舍', `${str代號}：${JSON.stringify(obj更新)}`, str代號);

  // 停用／重新啟用：精舍設定的共享跟著移除／恢復
  const str提醒 = obj更新['狀態'] ? 精舍設定共享提醒_(str代號) : '';
  return { bool成功: true, str訊息: `精舍資料已更新。${str提醒}` };
}


/**
 * ============================================================================
 * 函式名稱：新增精舍管理員
 * 版本：v1.1.0（2026-10-28）
 *   v1.1.0：同步精舍設定的檢視者共享
 * ----------------------------------------------------------------------------
 * 用途：替精舍增加一位精舍管理員（每精舍可有多位）。
 *       帳號若曾被停用，會直接重新啟用並更新姓名。
 *
 * 參數：
 *   obj工作階段   {Object} 系統管理員的工作階段
 *   obj參數       {Object} { str精舍代號, str帳號, str姓名 }
 *
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 新增精舍管理員(obj工作階段, obj參數) {
  檢查權限(obj工作階段, '系統.管理精舍', '新增精舍管理員');
  檢查必要參數(obj參數, ['str精舍代號', 'str帳號', 'str姓名'], '新增精舍管理員');

  const obj精舍 = 取得精舍資訊(obj參數.str精舍代號, true);
  const str帳號 = 正規化帳號(obj參數.str帳號);
  const str姓名 = String(obj參數.str姓名).trim();
  檢查電子郵件_(str帳號, '精舍管理員的 Google 帳號');

  let str結果 = '';
  執行並鎖定(function () {
    const obj定義 = obj系統主控結構.精舍管理員;
    const obj分頁 = 取得工作表(取得系統主控(), obj定義.str分頁);
    const arr既有 = 依條件尋找資料列(obj分頁, obj定義.arr欄位, function (obj值) {
      return String(obj值['精舍代號']).trim().toUpperCase() === obj精舍.str精舍代號
        && 正規化帳號(obj值['Google帳號']) === str帳號;
    });

    if (arr既有.length > 0) {
      // 已存在：啟用中就告知，停用中就重新啟用
      if (String(arr既有[0].obj值['狀態']).trim() === obj狀態.啟用) {
        throw new 平台錯誤(obj錯誤代碼.參數錯誤, `${str帳號} 已經是「${obj精舍.str精舍名稱}」的精舍管理員。`);
      }
      更新資料列(obj分頁, arr既有[0].int列號, { '姓名': str姓名, '狀態': obj狀態.啟用 });
      str結果 = '已重新啟用';
    } else {
      新增資料列(obj分頁, {
        '精舍代號': obj精舍.str精舍代號, 'Google帳號': str帳號, '姓名': str姓名,
        '狀態': obj狀態.啟用, '登記日期': new Date()
      });
      str結果 = '已新增';
    }
  }, '新增精舍管理員');

  寫入操作日誌(obj工作階段, '新增精舍管理員', `${str姓名}（${str帳號}）${str結果}`, obj精舍.str精舍代號);

  // 精舍管理員可看到所有副本：補上共享；精舍設定也以檢視者共享
  const str提醒 = 人員異動後同步副本(obj精舍.str精舍代號) + 精舍設定共享提醒_(obj精舍.str精舍代號);
  return { bool成功: true, str訊息: `${str姓名}（${str帳號}）${str結果}為「${obj精舍.str精舍名稱}」的精舍管理員。${str提醒}` };
}


/**
 * ============================================================================
 * 函式名稱：停用精舍管理員
 * 版本：v1.1.0（2026-10-28）
 *   v1.1.0：同步精舍設定的檢視者共享（移除此人）
 * ----------------------------------------------------------------------------
 * 用途：停用一位精舍管理員。不可停用精舍的最後一位管理員，
 *       否則精舍將無人能管理人員與權限。
 *
 * 參數：
 *   obj工作階段   {Object} 系統管理員的工作階段
 *   obj參數       {Object} { str精舍代號, str帳號 }
 *
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 停用精舍管理員(obj工作階段, obj參數) {
  檢查權限(obj工作階段, '系統.管理精舍', '停用精舍管理員');
  檢查必要參數(obj參數, ['str精舍代號', 'str帳號'], '停用精舍管理員');

  const obj精舍 = 取得精舍資訊(obj參數.str精舍代號, true);
  const str帳號 = 正規化帳號(obj參數.str帳號);

  執行並鎖定(function () {
    const obj定義 = obj系統主控結構.精舍管理員;
    const obj分頁 = 取得工作表(取得系統主控(), obj定義.str分頁);

    // 本精舍啟用中的管理員
    const arr啟用中 = 依條件尋找資料列(obj分頁, obj定義.arr欄位, function (obj值) {
      return String(obj值['精舍代號']).trim().toUpperCase() === obj精舍.str精舍代號
        && String(obj值['狀態']).trim() === obj狀態.啟用;
    });
    const arr目標 = arr啟用中.filter(function (obj列) { return 正規化帳號(obj列.obj值['Google帳號']) === str帳號; });

    if (arr目標.length === 0) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, `${str帳號} 不是「${obj精舍.str精舍名稱}」啟用中的精舍管理員。`);
    }
    if (arr啟用中.length <= 1) {
      throw new 平台錯誤(
        obj錯誤代碼.參數錯誤,
        `「${obj精舍.str精舍名稱}」只剩這一位精舍管理員，不能停用。請先新增另一位精舍管理員。`
      );
    }
    更新資料列(obj分頁, arr目標[0].int列號, { '狀態': obj狀態.停用 });
  }, '停用精舍管理員');

  寫入操作日誌(obj工作階段, '停用精舍管理員', str帳號, obj精舍.str精舍代號);

  // 移除此人在所有副本與精舍設定的共享
  const str提醒 = 人員異動後同步副本(obj精舍.str精舍代號) + 精舍設定共享提醒_(obj精舍.str精舍代號);
  return { bool成功: true, str訊息: `已停用 ${str帳號} 的精舍管理員身分。${str提醒}` };
}


/**
 * ============================================================================
 * 函式名稱：補齊所有精舍結構
 * 版本：v1.1.0（2026-10-28）
 *   v1.1.0：一併同步每個精舍的精舍設定檢視者共享（v1.3.0 之前開通的精舍由此補上）
 * ----------------------------------------------------------------------------
 * 用途：
 *   平台升版、精舍設定新增分頁或欄位後，由系統管理員在 Apps Script 編輯器
 *   「手動執行一次」，替每個精舍的精舍設定補齊新結構，並同步檢視者共享。
 *   既有資料不受影響。可重複執行。
 *
 * 參數：無
 * 傳回：{Object} { int成功數, arr失敗: [ 說明 ] }
 * ============================================================================
 */
function 補齊所有精舍結構() {
  // 系統主控本身也一併補齊
  建立整份結構(取得系統主控(), obj系統主控結構);

  const obj定義 = obj系統主控結構.精舍清單;
  const arr精舍 = 讀取全部資料列(取得工作表(取得系統主控(), obj定義.str分頁), obj定義.arr欄位);
  const obj結果 = { int成功數: 0, arr失敗: [] };

  arr精舍.forEach(function (obj列) {
    const str名稱 = `${obj列.obj值['精舍代號']} ${obj列.obj值['精舍名稱']}`;
    try {
      const obj設定 = 開啟試算表(String(obj列.obj值['精舍設定ID']).trim(), `${str名稱} 精舍設定`);
      建立整份結構(obj設定, obj精舍設定結構);
      obj結果.int成功數 += 1;

      // 同步檢視者共享（失敗只記錄，不算補齊失敗）
      const str提醒 = 精舍設定共享提醒_(String(obj列.obj值['精舍代號']).trim());
      console.log(`✔ ${str名稱}${str提醒}`);
    } catch (err) {
      obj結果.arr失敗.push(`${str名稱}：${err && err.message ? err.message : err}`);
      console.log(`✘ ${str名稱}：${err && err.message ? err.message : err}`);
    }
  });

  console.log(`==== 補齊完成：成功 ${obj結果.int成功數} 個精舍，失敗 ${obj結果.arr失敗.length} 個 ====`);
  return obj結果;
}


