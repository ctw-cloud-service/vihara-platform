/**
 * ============================================================================
 * 函式名稱：計算精舍設定應有檢視者_（內部使用）
 * 版本：v1.0.0（2026-10-28）
 * ----------------------------------------------------------------------------
 * 用途：
 *   精舍設定試算表「應該」共享給誰：精舍啟用中時＝該精舍啟用中的精舍管理員；
 *   精舍已停用時＝沒有人。
 *
 * 參數：
 *   obj精舍   {Object} 「取得精舍資訊」的結果（需含 str狀態）
 *
 * 傳回：{string[]} 正規化後的帳號清單（不重複）
 * ============================================================================
 */
function 計算精舍設定應有檢視者_(obj精舍) {
  // 精舍停用：一律不共享
  if (obj精舍.str狀態 !== obj狀態.啟用) return [];

  const obj定義 = obj系統主控結構.精舍管理員;
  const arr帳號 = [];
  依條件尋找資料列(取得工作表(取得系統主控(), obj定義.str分頁), obj定義.arr欄位, function (obj值) {
    return String(obj值['精舍代號']).trim().toUpperCase() === obj精舍.str精舍代號
      && String(obj值['狀態']).trim() === obj狀態.啟用;
  }).forEach(function (obj列) {
    const str帳號 = 正規化帳號(obj列.obj值['Google帳號']);
    if (str帳號 !== '' && arr帳號.indexOf(str帳號) === -1) arr帳號.push(str帳號);
  });
  return arr帳號;
}


/**
 * ============================================================================
 * 函式名稱：同步精舍設定共享
 * 版本：v1.0.0（2026-10-28）
 * ----------------------------------------------------------------------------
 * 用途：
 *   讓精舍設定試算表的共享剛好等於「應有檢視者」：
 *     ① 系統帳號（擁有者）以外的編輯者一律移除（精舍設定不可手動修改）
 *     ② 應有名單中尚未是檢視者的補上
 *     ③ 不在應有名單中的檢視者移除
 *   個別帳號失敗時不中斷，最後一併回報。可重複執行。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號（大小寫皆可）
 *
 * 傳回：
 *   {Object} { arr新增, arr移除, arr失敗: [ { str帳號, str原因 } ] }
 * ============================================================================
 */
function 同步精舍設定共享(str精舍代號) {
  const obj結果 = { arr新增: [], arr移除: [], arr失敗: [] };

  // 已停用的精舍也要處理（移除共享），所以允許停用
  const obj精舍 = 取得精舍資訊(str精舍代號, true);
  const arr應有 = 計算精舍設定應有檢視者_(obj精舍);

  // 開啟精舍設定檔案
  let obj檔案;
  try {
    obj檔案 = DriveApp.getFileById(obj精舍.str精舍設定ID);
  } catch (err) {
    throw new 平台錯誤(
      obj錯誤代碼.檔案無法開啟,
      `找不到「${obj精舍.str精舍名稱}」的精舍設定試算表，可能已被刪除。請通知系統管理員。`,
      { str精舍代號: obj精舍.str精舍代號 }
    );
  }
  const str擁有者 = obj檔案.getOwner() ? 正規化帳號(obj檔案.getOwner().getEmail()) : '';

  // ① 移除擁有者以外的編輯者（應有名單中的人，下一步會改以檢視者加回）
  obj檔案.getEditors()
    .map(function (obj使用者) { return 正規化帳號(obj使用者.getEmail()); })
    .filter(function (str帳號) { return str帳號 !== '' && str帳號 !== str擁有者; })
    .forEach(function (str帳號) {
      try {
        obj檔案.removeEditor(str帳號);
        obj結果.arr移除.push(str帳號);
      } catch (err) {
        obj結果.arr失敗.push({ str帳號: str帳號, str原因: '無法移除編輯權' });
      }
    });

  // 目前的檢視者（不含擁有者）
  const arr目前 = obj檔案.getViewers()
    .map(function (obj使用者) { return 正規化帳號(obj使用者.getEmail()); })
    .filter(function (str帳號) { return str帳號 !== '' && str帳號 !== str擁有者; });

  // ② 補上缺少的檢視者
  arr應有.filter(function (str帳號) { return arr目前.indexOf(str帳號) === -1 && str帳號 !== str擁有者; })
    .forEach(function (str帳號) {
      try {
        obj檔案.addViewer(str帳號);
        obj結果.arr新增.push(str帳號);
      } catch (err) {
        obj結果.arr失敗.push({ str帳號: str帳號, str原因: '無法加入檢視共享，請確認是有效的 Google 帳號' });
      }
    });

  // ③ 移除不在名單中的檢視者
  arr目前.filter(function (str帳號) { return arr應有.indexOf(str帳號) === -1; })
    .forEach(function (str帳號) {
      try {
        obj檔案.removeViewer(str帳號);
        if (obj結果.arr移除.indexOf(str帳號) === -1) obj結果.arr移除.push(str帳號);
      } catch (err) {
        obj結果.arr失敗.push({ str帳號: str帳號, str原因: '無法移除檢視共享' });
      }
    });

  // 有異動才寫日誌
  if (obj結果.arr新增.length + obj結果.arr移除.length > 0) {
    寫入操作日誌(null, '同步精舍設定共享',
      `新增：${obj結果.arr新增.join('、') || '無'}；移除：${obj結果.arr移除.join('、') || '無'}`, obj精舍.str精舍代號);
  }
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：精舍設定共享提醒_（內部使用）
 * 版本：v1.0.0（2026-10-28）
 * ----------------------------------------------------------------------------
 * 用途：
 *   開通精舍、管理員異動、精舍停用／啟用後呼叫「同步精舍設定共享」。
 *   共享失敗不讓原本的操作失敗，只組成一句提醒附在回覆訊息後面。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *
 * 傳回：{string} 提醒文字；沒有問題時為空字串
 * ============================================================================
 */
function 精舍設定共享提醒_(str精舍代號) {
  try {
    const obj結果 = 同步精舍設定共享(str精舍代號);
    if (obj結果.arr失敗.length === 0) return '';
    return `（精舍設定試算表的檢視共享有 ${obj結果.arr失敗.length} 項未完成：`
      + obj結果.arr失敗.map(function (o) { return `${o.str帳號} ${o.str原因}`; }).join('；') + '）';
  } catch (err) {
    console.warn('同步精舍設定共享失敗：' + (err && err.message ? err.message : err));
    return '（精舍設定試算表的檢視共享未能完成，請稍後在 GAS 編輯器執行「補齊所有精舍結構」。）';
  }
}


