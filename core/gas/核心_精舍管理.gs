/**
 * ============================================================================
 * 函式名稱：檢查精舍代號未使用_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：確認精舍代號尚未被使用（不分大小寫，停用的精舍也算已使用）。
 * 參數：
 *   str代號   {string} 已正規化的精舍代號
 * 傳回：無
 * ============================================================================
 */
function 檢查精舍代號未使用_(str代號) {
  const obj定義 = obj系統主控結構.精舍清單;
  const arr既有 = 依條件尋找資料列(取得工作表(取得系統主控(), obj定義.str分頁), obj定義.arr欄位, function (obj值) {
    return String(obj值['精舍代號']).trim().toUpperCase() === str代號;
  });
  if (arr既有.length > 0) {
    throw new 平台錯誤(
      obj錯誤代碼.參數錯誤,
      `精舍代號「${str代號}」已被「${arr既有[0].obj值['精舍名稱']}」使用，請換一個代號。`
    );
  }
}


/**
 * ============================================================================
 * 函式名稱：正規化精舍名稱_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：比對精舍名稱是否相同時使用的統一格式：
 *       去掉所有空白（含全形空白），英文字母轉小寫。
 *       例如「普泉 精舍」「普泉精舍」視為相同。只用於比對，不改變儲存的名稱。
 * 參數：
 *   str名稱   {string} 精舍名稱
 * 傳回：{string} 比對用的名稱
 * ============================================================================
 */
function 正規化精舍名稱_(str名稱) {
  return String(str名稱 === null || str名稱 === undefined ? '' : str名稱)
    .replace(/[\s\u3000]+/g, '')   // 去掉半形與全形空白（明確列出 \u3000 以便閱讀）
    .toLowerCase();
}


/**
 * ============================================================================
 * 函式名稱：檢查精舍名稱未使用_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   確認精舍名稱沒有被其他精舍使用（忽略空白與英文大小寫；停用的精舍也算已使用，
 *   避免日後重新啟用時出現兩個同名精舍）。
 * 參數：
 *   str名稱       {string} 要使用的名稱
 *   str排除代號   {string} 改名時傳入自己的代號（自己不算重複）；開通時傳空字串
 * 傳回：無
 * ============================================================================
 */
function 檢查精舍名稱未使用_(str名稱, str排除代號) {
  const str比對名稱 = 正規化精舍名稱_(str名稱);
  const str排除 = String(str排除代號 || '').trim().toUpperCase();
  const obj定義 = obj系統主控結構.精舍清單;
  const arr既有 = 依條件尋找資料列(取得工作表(取得系統主控(), obj定義.str分頁), obj定義.arr欄位, function (obj值) {
    const str代號 = String(obj值['精舍代號']).trim().toUpperCase();
    return str代號 !== str排除 && 正規化精舍名稱_(obj值['精舍名稱']) === str比對名稱;
  });
  if (arr既有.length > 0) {
    const obj衝突 = arr既有[0].obj值;
    const str狀態說明 = String(obj衝突['狀態']).trim() === obj狀態.停用 ? '（已停用）' : '';
    throw new 平台錯誤(
      obj錯誤代碼.參數錯誤,
      `精舍名稱「${str名稱}」已被代號 ${String(obj衝突['精舍代號']).trim().toUpperCase()}${str狀態說明} 使用，請換一個名稱。`
    );
  }
}


/**
 * ============================================================================
 * 函式名稱：檢查電子郵件_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：檢查 Google 帳號是否像一個電子郵件地址。
 * 參數：
 *   str帳號   {string} 已正規化的帳號
 *   str欄位   {string} 錯誤訊息中的欄位名稱
 * 傳回：無
 * ============================================================================
 */
function 檢查電子郵件_(str帳號, str欄位) {
  if (!reg電子郵件格式.test(str帳號)) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `${str欄位}「${str帳號}」格式不正確，應類似 name@gmail.com。`);
  }
}


/**
 * ============================================================================
 * 函式名稱：檢查狀態值_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：狀態只接受「啟用」或「停用」。
 * 參數：
 *   str狀態   {string} 使用者傳來的狀態
 * 傳回：{string} 合法的狀態值
 * ============================================================================
 */
function 檢查狀態值_(str狀態) {
  const str值 = String(str狀態).trim();
  if (str值 !== obj狀態.啟用 && str值 !== obj狀態.停用) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `狀態只能是「啟用」或「停用」，收到的是「${str值}」。`);
  }
  return str值;
}


/**
 * ============================================================================
 * 函式名稱：找出唯一資料列_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：依條件找出一列；找不到時丟出指定的白話訊息。
 * 參數：
 *   obj分頁         {Sheet}    目標分頁
 *   arr欄位         {string[]} 要讀的欄位
 *   fn條件          {Function} 判斷條件
 *   str找不到訊息   {string}   找不到時的說明
 * 傳回：{Object} { int列號, obj值 }
 * ============================================================================
 */
function 找出唯一資料列_(obj分頁, arr欄位, fn條件, str找不到訊息) {
  const arr符合 = 依條件尋找資料列(obj分頁, arr欄位, fn條件);
  if (arr符合.length === 0) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, str找不到訊息);
  }
  return arr符合[0];
}
