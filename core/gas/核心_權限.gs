// ============================================================================
// 檔案名稱：核心_權限.gs
// 所屬層級：平台核心／控制層
// 檔案版本：v1.1.0（2026-10-25）
//   v1.1.0：無權限提示依項目類型給建議（系統事務、平台事務不再提示「洽精舍管理員指派」）
//   v1.0.0：初版
// 用途說明：
//   判斷「已登入的人」能不能做某件事。
//
//   權限項目的寫法：「模組代號.項目名稱」，例如：
//     event.整理資料、event.匯出大車點名、inventory.入庫
//   平台層保留兩個前綴：
//     系統.xxx   只有系統管理員可執行（例如 系統.開通精舍）
//     平台.xxx   只有精舍管理員可執行（例如 平台.增修人員），不能指派給承辦人
//
//   各角色規則：
//     系統管理員   只能執行「系統.」開頭的項目，看不到精舍內部資料
//     精舍管理員   可執行本精舍「系統.」以外的所有項目
//     承辦人       只能執行被指派的項目
//     報到志工     只能執行登入時給予的項目（例如 event.報到）
//
// 相依檔案：核心_錯誤.gs、核心_試算表存取.gs、核心_工具.gs、
//           核心_結構定義.gs、核心_租戶解析.gs
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：是否具備權限
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：判斷工作階段是否可執行某權限項目（只回答是或否，不丟錯誤）。
 *
 * 參數：
 *   obj工作階段     {Object} 由「取得工作階段」取得
 *   str權限項目     {string} 例如 'event.匯出大車點名'
 *
 * 傳回：{boolean}
 * ============================================================================
 */
function 是否具備權限(obj工作階段, str權限項目) {
  // 沒有登入資料或沒指定項目：一律否
  if (!obj工作階段 || !str權限項目) return false;

  const str項目 = String(str權限項目).trim();
  const bool系統項目 = str項目.indexOf('系統.') === 0;

  switch (obj工作階段.str角色) {
    case obj角色.系統管理員:
      // 系統管理員只管開通精舍等系統事務
      return bool系統項目;

    case obj角色.精舍管理員:
      // 精舍管理員：本精舍內除了系統事務以外都可以
      return !bool系統項目;

    case obj角色.承辦人:
    case obj角色.報到志工:
      // 只能做被給予的項目；系統項目與平台項目一律不行（防止資料被誤填）
      if (bool系統項目 || str項目.indexOf('平台.') === 0) return false;
      return Array.isArray(obj工作階段.arr權限) && obj工作階段.arr權限.indexOf(str項目) !== -1;

    default:
      // 不認得的角色：一律否
      return false;
  }
}


/**
 * ============================================================================
 * 函式名稱：檢查權限
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：沒有權限時丟出白話錯誤，告訴使用者該找誰。
 *
 * 參數：
 *   obj工作階段     {Object} 由「取得工作階段」取得
 *   str權限項目     {string} 例如 'event.匯出大車點名'
 *   str作業名稱     {string} 選填，給使用者看的動作名稱，例如「匯出大車點名」
 *
 * 傳回：無
 * ============================================================================
 */
function 檢查權限(obj工作階段, str權限項目, str作業名稱) {
  if (是否具備權限(obj工作階段, str權限項目)) return;

  // 依「這是誰才能做的事」與角色，給出正確的建議
  const str動作 = str作業名稱 || str權限項目;
  const str項目 = String(str權限項目 || '');
  const str角色 = obj工作階段 ? obj工作階段.str角色 : '';
  let str建議;
  if (str項目.indexOf('系統.') === 0) {
    // 系統事務：只有系統管理員能做，任何人都無法被指派
    str建議 = '此功能只限系統管理員使用。';
  } else if (str項目.indexOf('平台.') === 0) {
    // 平台事務：只有精舍管理員能做，不能指派給承辦人
    str建議 = '此功能只限精舍管理員使用。';
  } else if (str角色 === obj角色.承辦人) {
    // 模組事務：承辦人可以被指派
    str建議 = '如需此權限，請洽精舍管理員指派。';
  } else {
    str建議 = '如有疑問請洽系統管理員。';
  }

  throw new 平台錯誤(
    obj錯誤代碼.權限不足,
    `您沒有「${str動作}」的權限。${str建議}`,
    { str權限項目: str權限項目, str角色: obj工作階段 ? obj工作階段.str角色 : '' }
  );
}


/**
 * ============================================================================
 * 函式名稱：檢查角色
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：限定只有某些角色可以進行（例如總管理頁只限系統管理員）。
 *
 * 參數：
 *   obj工作階段     {Object}   由「取得工作階段」取得
 *   arr允許角色     {string[]} 例如 [obj角色.系統管理員]
 *   str作業名稱     {string}   給使用者看的動作名稱
 *
 * 傳回：無
 * ============================================================================
 */
function 檢查角色(obj工作階段, arr允許角色, str作業名稱) {
  const str角色 = obj工作階段 ? obj工作階段.str角色 : '';
  if (arr允許角色.indexOf(str角色) !== -1) return;

  throw new 平台錯誤(
    obj錯誤代碼.權限不足,
    `「${str作業名稱 || '這項作業'}」只限${arr允許角色.join('或')}使用。`,
    { str角色: str角色, arr允許角色: arr允許角色 }
  );
}


/**
 * ============================================================================
 * 函式名稱：檢查同一精舍
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   確認要操作的資料屬於登入者所在的精舍，防止透過竄改參數讀取別的精舍。
 *
 * 參數：
 *   obj工作階段   {Object} 由「取得工作階段」取得
 *   str精舍代號   {string} 資料所屬的精舍代號
 *
 * 傳回：無
 * ============================================================================
 */
function 檢查同一精舍(obj工作階段, str精舍代號) {
  const str資料精舍 = String(str精舍代號 || '').trim().toUpperCase();
  const str登入精舍 = obj工作階段 ? String(obj工作階段.str精舍代號 || '').toUpperCase() : '';

  if (str資料精舍 !== '' && str資料精舍 === str登入精舍) return;

  throw new 平台錯誤(
    obj錯誤代碼.權限不足,
    '您只能操作自己精舍的資料。',
    { str登入精舍: str登入精舍, str資料精舍: str資料精舍 }
  );
}


/**
 * ============================================================================
 * 函式名稱：讀取承辦人權限
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   從精舍設定的「權限指派」分頁讀出某承辦人的全部權限項目，
 *   組成「模組代號.權限項目」格式，例如 'event.整理資料'。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   str帳號       {string} 承辦人的 Google 帳號
 *
 * 傳回：{string[]} 權限項目清單（不重複）
 * ============================================================================
 */
function 讀取承辦人權限(str精舍代號, str帳號) {
  const str目標帳號 = 正規化帳號(str帳號);
  const obj定義 = obj精舍設定結構.權限指派;
  const obj分頁 = 取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁);

  // 篩出此帳號的指派列
  const arr指派 = 依條件尋找資料列(obj分頁, obj定義.arr欄位, function (obj值) {
    return 正規化帳號(obj值['Google帳號']) === str目標帳號;
  });

  // 組成「模組代號.權限項目」，去除重複與空白
  const obj已加入 = {};
  const arr權限 = [];
  arr指派.forEach(function (obj列) {
    const str模組 = String(obj列.obj值['模組代號']).trim();
    const str項目 = String(obj列.obj值['權限項目']).trim();
    if (str模組 === '' || str項目 === '') return;
    const str完整項目 = `${str模組}.${str項目}`;
    if (!obj已加入[str完整項目]) {
      obj已加入[str完整項目] = true;
      arr權限.push(str完整項目);
    }
  });

  return arr權限;
}
