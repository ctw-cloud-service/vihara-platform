// ============================================================================
// 檔案名稱：核心_模組管理.gs
// 所屬層級：平台核心／服務層
// 檔案版本：v1.0.0（2026-10-25）
// 用途說明：
//   管理「業務模組」。本版先提供「查詢模組定義」，
//   精舍開通模組、建立模組主控台的功能，於副本管理完成後加入。
//
//   模組定義的寫法（每個模組在自己的檔案裡寫一個函式，名稱固定為
//   「模組定義_模組代號」，平台會自動找到它，不必修改核心程式）：
//
//     function 模組定義_event() {
//       return {
//         str模組代號: 'event',
//         str模組名稱: '法會活動',
//         str型態: '活動型',            // 活動型 或 持續型
//         arr可指派權限: [              // 精舍管理員可以指派給承辦人的項目
//           { str項目: '整理資料', str說明: '下載報名資料、檢查重複' },
//           { str項目: '匯出大車點名', str說明: '產生並匯出大車點名資料' }
//         ]
//       };
//     }
//
// 相依檔案：核心_錯誤.gs
// ============================================================================


// ----------------------------------------------------------------------------
// 模組型態
// ----------------------------------------------------------------------------
const obj模組型態 = Object.freeze({
  活動型: '活動型',
  持續型: '持續型'
});


/**
 * ============================================================================
 * 函式名稱：取得模組定義
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   找出某模組的定義（模組名稱、型態、可指派權限）。
 *   模組代號只允許英文小寫、數字與底線，避免被拿來呼叫其他函式。
 *
 * 參數：
 *   str模組代號   {string} 例如 'event'
 *
 * 傳回：
 *   {Object|null} 模組定義；程式中沒有這個模組時傳回 null
 * ============================================================================
 */
function 取得模組定義(str模組代號) {
  const str代號 = String(str模組代號 || '').trim();

  // 格式檢查：只允許 a–z、0–9、底線
  if (!/^[a-z0-9_]+$/.test(str代號)) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `模組代號「${str模組代號}」格式不正確，請通知系統管理員。`);
  }

  // 依固定名稱找出模組定義函式
  const fn定義 = globalThis[`模組定義_${str代號}`];
  if (typeof fn定義 !== 'function') return null;

  // 取得定義並補齊預設值
  const obj定義 = fn定義() || {};
  return {
    str模組代號: str代號,
    str模組名稱: obj定義.str模組名稱 || str代號,
    str型態: obj定義.str型態 || obj模組型態.持續型,
    arr可指派權限: Array.isArray(obj定義.arr可指派權限) ? obj定義.arr可指派權限 : []
  };
}


/**
 * ============================================================================
 * 函式名稱：是否為可指派權限
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：檢查「模組代號.項目」是否為該模組允許指派給承辦人的項目。
 *
 * 參數：
 *   str權限項目   {string} 例如 'event.整理資料'
 *
 * 傳回：{boolean}
 * ============================================================================
 */
function 是否為可指派權限(str權限項目) {
  // 拆成「模組代號」與「項目」
  const str完整 = String(str權限項目 || '').trim();
  const int分隔位置 = str完整.indexOf('.');
  if (int分隔位置 <= 0) return false;

  const str模組代號 = str完整.substring(0, int分隔位置);
  const str項目 = str完整.substring(int分隔位置 + 1);

  // 系統與平台項目不可指派給承辦人
  if (str模組代號 === '系統' || str模組代號 === '平台') return false;

  // 模組代號格式不對、或程式中沒有這個模組：不可指派
  if (!/^[a-z0-9_]+$/.test(str模組代號)) return false;
  const obj定義 = 取得模組定義(str模組代號);
  if (!obj定義) return false;

  // 在模組的可指派清單中
  return obj定義.arr可指派權限.some(function (obj權限) { return obj權限.str項目 === str項目; });
}
