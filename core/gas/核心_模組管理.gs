// ============================================================================
// 檔案名稱：核心_模組管理.gs
// 所屬層級：平台核心／服務層
// 檔案版本：v1.1.0（2026-10-25）
//   v1.1.0：新增「登記所有模組」（GAS 編輯器執行）、精舍管理員的「列出模組」
//           「開通模組」「關閉模組」；模組定義加 str說明；主控台改由
//           「主控台結構_模組代號」產生；選用掛勾「開通後處理_模組代號」
//   v1.0.0：初版（查詢模組定義、是否為可指派權限）
// 用途說明：
//   管理「業務模組」。分兩層：
//     · 系統層「模組清單」：平台有哪些模組可用。部署新模組後，開發者在
//       GAS 編輯器執行一次「登記所有模組」寫入（系統管理員與精舍管理員都不用操作）。
//     · 精舍層「精舍模組開通」：哪個精舍開通了哪個模組、主控台在哪。
//       由精舍管理員在精舍設定頁開通或關閉（權限「平台.管理模組」）。
//
//   每個模組在自己的檔案裡寫下列固定名稱的函式，平台會自動找到，不必修改核心：
//
//     ① 模組定義（必要）
//     function 模組定義_event() {
//       return {
//         str模組名稱: '法會活動',
//         str說明: '報名資料整理、大車點名、法會報到',   // 精舍設定頁顯示
//         str型態: '活動型',                            // 活動型 或 持續型
//         str版本: '1.0.0',                             // 選填，登記到模組清單
//         arr可指派權限: [                              // 精舍管理員可指派給承辦人的項目
//           { str項目: '整理資料', str說明: '下載報名資料、檢查重複' }
//         ]
//       };
//     }
//
//     ② 主控台結構（必要）：格式與 obj精舍設定結構 相同，開通時依此建立主控台
//     function 主控台結構_event() {
//       return {
//         活動清單: { str分頁: '活動清單', arr欄位: ['活動ID', '活動名稱', '日期', '狀態'] }
//       };
//     }
//
//     ③ 開通後處理（選用）：主控台建好、正式登記前執行，例如寫入預設資料。
//        丟出錯誤時整個開通會取消，主控台移到垃圾桶。
//     function 開通後處理_event(str精舍代號, obj主控台) { … }
//
//   模組代號：英文小寫、數字、底線；test 開頭保留給測試程式。
//
// 相依檔案：核心_錯誤、核心_試算表存取、核心_工具、核心_結構定義、核心_租戶解析、
//           核心_權限、核心_日誌
// ============================================================================


// ----------------------------------------------------------------------------
// 本檔常數
// ----------------------------------------------------------------------------

// 模組型態
const obj模組型態 = Object.freeze({
  活動型: '活動型',
  持續型: '持續型'
});

// 精舍設定頁顯示的開通狀態
const obj開通狀態 = Object.freeze({
  未開通: '未開通',
  已開通: '啟用',
  已關閉: '停用'
});

// 本檔使用的權限項目（只有精舍管理員具備，不能指派給承辦人）
const str模組管理權限 = '平台.管理模組';


/**
 * ============================================================================
 * 函式名稱：取得模組定義
 * 版本：v1.1.0（2026-10-25）
 *   v1.1.0：多傳回 str說明、str版本
 * ----------------------------------------------------------------------------
 * 用途：
 *   找出某模組的定義（模組名稱、說明、型態、可指派權限）。
 *   模組代號只允許英文小寫、數字與底線，避免被拿來呼叫其他函式。
 *
 * 參數：
 *   str模組代號   {string} 例如 'event'
 *
 * 傳回：
 *   {Object|null} { str模組代號, str模組名稱, str說明, str型態, str版本, arr可指派權限 }；
 *                 程式中沒有這個模組時傳回 null
 * ============================================================================
 */
function 取得模組定義(str模組代號) {
  const str代號 = String(str模組代號 || '').trim();

  // 格式檢查：只允許 a–z、0–9、底線
  if (!/^[a-z0-9_]+$/.test(str代號)) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `模組代號「${str模組代號}」格式不正確，請通知系統管理員。`);
  }

  // 依固定名稱找出模組定義函式
  const fn定義 = globalThis[`模組定義_${str代號}`];
  if (typeof fn定義 !== 'function') return null;

  // 取得定義並補齊預設值
  const obj定義 = fn定義() || {};
  return {
    str模組代號: str代號,
    str模組名稱: obj定義.str模組名稱 || str代號,
    str說明: obj定義.str說明 || '',
    str型態: obj定義.str型態 || obj模組型態.持續型,
    str版本: obj定義.str版本 || '',
    arr可指派權限: Array.isArray(obj定義.arr可指派權限) ? obj定義.arr可指派權限 : []
  };
}


/**
 * ============================================================================
 * 函式名稱：是否為可指派權限
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：檢查「模組代號.項目」是否為該模組允許指派給承辦人的項目。
 *
 * 參數：
 *   str權限項目   {string} 例如 'event.整理資料'
 *
 * 傳回：{boolean}
 * ============================================================================
 */
function 是否為可指派權限(str權限項目) {
  // 拆成「模組代號」與「項目」
  const str完整 = String(str權限項目 || '').trim();
  const int分隔位置 = str完整.indexOf('.');
  if (int分隔位置 <= 0) return false;

  const str模組代號 = str完整.substring(0, int分隔位置);
  const str項目 = str完整.substring(int分隔位置 + 1);

  // 系統與平台項目不可指派給承辦人
  if (str模組代號 === '系統' || str模組代號 === '平台') return false;

  // 模組代號格式不對、或程式中沒有這個模組：不可指派
  if (!/^[a-z0-9_]+$/.test(str模組代號)) return false;
  const obj定義 = 取得模組定義(str模組代號);
  if (!obj定義) return false;

  // 在模組的可指派清單中
  return obj定義.arr可指派權限.some(function (obj權限) { return obj權限.str項目 === str項目; });
}


/**
 * ============================================================================
 * 函式名稱：取得主控台結構_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：找出模組的主控台結構（「主控台結構_模組代號」函式的結果），並檢查格式。
 *
 * 參數：
 *   obj定義   {Object} 「取得模組定義」的結果
 *
 * 傳回：{Object} 結構，格式同 obj精舍設定結構
 * ============================================================================
 */
function 取得主控台結構_(obj定義) {
  const fn結構 = globalThis[`主控台結構_${obj定義.str模組代號}`];

  // 模組沒有提供結構：無法建立主控台
  if (typeof fn結構 !== 'function') {
    throw new 平台錯誤(
      obj錯誤代碼.設定缺漏,
      `「${obj定義.str模組名稱}」尚未設定主控台格式，暫時無法開通。請通知系統管理員。`,
      { str模組代號: obj定義.str模組代號 }
    );
  }

  // 每一個分頁定義都要有分頁名稱與欄位清單
  const obj結構 = fn結構() || {};
  const arr鍵 = Object.keys(obj結構);
  const bool格式正確 = arr鍵.length > 0 && arr鍵.every(function (str鍵) {
    const obj分頁 = obj結構[str鍵];
    return obj分頁 && typeof obj分頁.str分頁 === 'string' && obj分頁.str分頁.trim() !== ''
      && Array.isArray(obj分頁.arr欄位) && obj分頁.arr欄位.length > 0;
  });
  if (!bool格式正確) {
    throw new 平台錯誤(
      obj錯誤代碼.設定缺漏,
      `「${obj定義.str模組名稱}」的主控台格式不完整，暫時無法開通。請通知系統管理員。`,
      { str模組代號: obj定義.str模組代號 }
    );
  }

  return obj結構;
}


/**
 * ============================================================================
 * 函式名稱：登記所有模組
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   部署新模組或模組改版後，在 Apps Script 編輯器執行一次（不開放給網頁呼叫）。
 *   掃描程式中所有「模組定義_」函式，寫入系統主控的「模組清單」：
 *     · 新模組：新增一列，狀態「啟用」
 *     · 既有模組：更新名稱、型態、版本；狀態維持原樣
 *       （系統管理員若在模組清單手動改成「停用」，重新登記不會把它打開）
 *     · 模組清單有、程式中已找不到的模組：只在記錄中提醒，不自動停用
 *   可重複執行。
 *
 * 參數：
 *   bool含測試   {boolean} 選填，只有測試程式傳 true（連 test 開頭的模組一起登記）
 *
 * 傳回：
 *   {Object} { arr新增: [代號], arr更新: [代號], arr程式中已無: [代號] }
 * ============================================================================
 */
function 登記所有模組(bool含測試) {
  // 程式中的全部模組（缺少主控台結構的也登記，但提醒開發者）
  const arr代號 = 列出具名函式('模組定義_', bool含測試 === true);
  const obj結果 = { arr新增: [], arr更新: [], arr程式中已無: [] };

  執行並鎖定(function () {
    const obj定義 = obj系統主控結構.模組清單;
    const obj分頁 = 取得工作表(取得系統主控(), obj定義.str分頁);
    const arr既有 = 讀取全部資料列(obj分頁, obj定義.arr欄位);

    // 逐一新增或更新
    arr代號.forEach(function (str代號) {
      const obj模組 = 取得模組定義(str代號);
      const obj內容 = { '模組代號': str代號, '模組名稱': obj模組.str模組名稱, '型態': obj模組.str型態, '版本': obj模組.str版本 };
      const arr符合 = arr既有.filter(function (obj列) { return String(obj列.obj值['模組代號']).trim() === str代號; });

      if (arr符合.length > 0) {
        更新資料列(obj分頁, arr符合[0].int列號, obj內容);
        obj結果.arr更新.push(str代號);
      } else {
        新增資料列(obj分頁, Object.assign({ '狀態': obj狀態.啟用 }, obj內容));
        obj結果.arr新增.push(str代號);
      }

      // 提醒：沒有主控台結構的模組，精舍開通時會失敗
      if (typeof globalThis[`主控台結構_${str代號}`] !== 'function') {
        console.warn(`⚠ 模組「${str代號}」沒有「主控台結構_${str代號}」，精舍將無法開通，請補上。`);
      }
    });

    // 模組清單有、程式中已找不到的
    arr既有.forEach(function (obj列) {
      const str代號 = String(obj列.obj值['模組代號']).trim();
      if (str代號 !== '' && arr代號.indexOf(str代號) === -1) obj結果.arr程式中已無.push(str代號);
    });
  }, '登記所有模組');

  // 寫在執行記錄中，方便在編輯器確認
  console.log(`新增 ${obj結果.arr新增.length} 個：${obj結果.arr新增.join('、') || '無'}`);
  console.log(`更新 ${obj結果.arr更新.length} 個：${obj結果.arr更新.join('、') || '無'}`);
  if (obj結果.arr程式中已無.length > 0) {
    console.warn(`⚠ 模組清單中有、但程式裡已找不到：${obj結果.arr程式中已無.join('、')}。`
      + '若已不再使用，請在系統主控「模組清單」把狀態改為「停用」。');
  }

  寫入操作日誌(null, '登記所有模組',
    `新增：${obj結果.arr新增.join('、') || '無'}；更新：${obj結果.arr更新.join('、') || '無'}`);
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：讀取精舍開通紀錄_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：讀出某精舍在「精舍模組開通」分頁的所有紀錄（不分啟用或停用）。
 *
 * 參數：
 *   str精舍代號   {string} 已正規化的精舍代號
 *
 * 傳回：
 *   {Object} { obj分頁, obj依模組: { 模組代號: { int列號, obj值 } } }
 * ============================================================================
 */
function 讀取精舍開通紀錄_(str精舍代號) {
  const obj定義 = obj系統主控結構.精舍模組開通;
  const obj分頁 = 取得工作表(取得系統主控(), obj定義.str分頁);
  const obj依模組 = {};

  依條件尋找資料列(obj分頁, obj定義.arr欄位, function (obj值) {
    return String(obj值['精舍代號']).trim().toUpperCase() === str精舍代號;
  }).forEach(function (obj列) {
    // 同一模組若有多列（理論上不會發生），以第一列為準
    const str模組代號 = String(obj列.obj值['模組代號']).trim();
    if (!obj依模組[str模組代號]) obj依模組[str模組代號] = obj列;
  });

  return { obj分頁: obj分頁, obj依模組: obj依模組 };
}


/**
 * ============================================================================
 * 函式名稱：讀取可用模組_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   讀出「模組清單」中狀態為啟用、且程式中仍有定義的模組。
 *
 * 參數：無
 *
 * 傳回：{Object[]} 「取得模組定義」的結果陣列，依模組清單的順序
 * ============================================================================
 */
function 讀取可用模組_() {
  const obj定義 = obj系統主控結構.模組清單;
  return 依條件尋找資料列(取得工作表(取得系統主控(), obj定義.str分頁), obj定義.arr欄位, function (obj值) {
    return String(obj值['狀態']).trim() === obj狀態.啟用;
  }).map(function (obj列) {
    const str代號 = String(obj列.obj值['模組代號']).trim();
    // 代號格式不對（例如有人手動輸入）就當作不存在，不讓整頁壞掉
    if (!/^[a-z0-9_]+$/.test(str代號)) return null;
    return 取得模組定義(str代號);
  }).filter(function (obj模組) { return obj模組 !== null; });
}


/**
 * ============================================================================
 * 函式名稱：列出模組
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：精舍設定頁「功能開通」區塊：平台可用的模組，以及本精舍的開通狀態。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} 不需要
 *
 * 傳回：
 *   {Object} { bool成功, arr模組: [ { str模組代號, str模組名稱, str說明, str型態,
 *                                     str狀態（未開通／啟用／停用）, str開通日期 } ] }
 * ============================================================================
 */
function 列出模組(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str模組管理權限, '查看功能開通');
  const str精舍代號 = obj工作階段.str精舍代號;

  const obj開通 = 讀取精舍開通紀錄_(str精舍代號).obj依模組;
  const arr模組 = 讀取可用模組_().map(function (obj模組) {
    const obj紀錄 = obj開通[obj模組.str模組代號];
    return {
      str模組代號: obj模組.str模組代號,
      str模組名稱: obj模組.str模組名稱,
      str說明: obj模組.str說明,
      str型態: obj模組.str型態,
      // 沒有紀錄＝未開通；有紀錄就照紀錄的狀態（啟用／停用）
      str狀態: obj紀錄 ? String(obj紀錄.obj值['狀態']).trim() : obj開通狀態.未開通,
      str開通日期: obj紀錄 ? 格式化日期(obj紀錄.obj值['開通日期'], 'yyyy-MM-dd') : ''
    };
  });

  return { bool成功: true, arr模組: arr模組 };
}


/**
 * ============================================================================
 * 函式名稱：開通模組
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   精舍管理員為自家精舍開通一個模組：
 *     ① 檢查：模組在模組清單中且啟用、程式中有定義
 *     ② 曾經開通又關閉：直接重新開通，沿用原本的主控台（資料都還在）
 *     ③ 第一次開通：在精舍資料夾建立「模組名稱主控台－精舍名稱」，依主控台結構
 *        建立分頁；有「開通後處理」就執行；最後登記到「精舍模組開通」
 *     ④ 任何一步失敗：把剛建立的主控台移到垃圾桶，不留半套資料
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str模組代號 }
 *
 * 傳回：{Object} { bool成功, str訊息, bool重新開通 }
 * ============================================================================
 */
function 開通模組(obj工作階段, obj參數) {
  // ── ① 權限與資料檢查 ──
  檢查權限(obj工作階段, str模組管理權限, '開通功能');
  檢查必要參數(obj參數, ['str模組代號'], '開通功能');

  const str精舍代號 = obj工作階段.str精舍代號;
  const obj精舍 = 取得精舍資訊(str精舍代號);
  const obj模組 = 檢查模組可開通_(obj參數.str模組代號);

  // ── ② 已有紀錄：已開通就告知；已關閉就重新開通 ──
  const obj既有 = 讀取精舍開通紀錄_(str精舍代號).obj依模組[obj模組.str模組代號];
  if (obj既有) {
    if (String(obj既有.obj值['狀態']).trim() === obj狀態.啟用) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${obj模組.str模組名稱}」已經開通了。`);
    }
    return 重新開通模組_(obj工作階段, obj精舍, obj模組, obj既有);
  }

  // ── ③ 第一次開通：主控台結構先檢查好，避免白白建立檔案 ──
  const obj結構 = 取得主控台結構_(obj模組);

  // 建立主控台（耗時較久，不放在鎖定中以免擋住其他人）
  let obj精舍資料夾;
  try {
    obj精舍資料夾 = DriveApp.getFolderById(obj精舍.str精舍資料夾ID);
  } catch (err) {
    throw new 平台錯誤(
      obj錯誤代碼.檔案無法開啟,
      `找不到「${obj精舍.str精舍名稱}」的資料夾，可能已被刪除。請通知系統管理員。`
    );
  }
  const obj主控台 = SpreadsheetApp.create(`${obj模組.str模組名稱}主控台－${obj精舍.str精舍名稱}`);
  const obj主控台檔 = DriveApp.getFileById(obj主控台.getId());

  try {
    obj主控台檔.moveTo(obj精舍資料夾);
    建立整份結構(obj主控台, obj結構);

    // 模組自訂的開通後處理（選用），失敗就整個取消
    const fn開通後處理 = globalThis[`開通後處理_${obj模組.str模組代號}`];
    if (typeof fn開通後處理 === 'function') fn開通後處理(str精舍代號, obj主控台);

    // ── 登記（鎖定中再確認一次，避免兩位管理員同時按開通而重複建立） ──
    執行並鎖定(function () {
      if (讀取精舍開通紀錄_(str精舍代號).obj依模組[obj模組.str模組代號]) {
        throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${obj模組.str模組名稱}」剛剛已被開通（可能是另一位管理員同時操作），請重新整理頁面。`);
      }
      新增資料列(取得工作表(取得系統主控(), obj系統主控結構.精舍模組開通.str分頁), {
        '精舍代號': str精舍代號, '模組代號': obj模組.str模組代號, '主控台ID': obj主控台.getId(),
        '狀態': obj狀態.啟用, '開通日期': new Date()
      });
    }, '開通功能');
  } catch (err) {
    // ── ④ 失敗：主控台移到垃圾桶，不留半套資料 ──
    try { obj主控台檔.setTrashed(true); } catch (errIgnore) { /* 已無法處理則略過 */ }
    throw err;
  }

  寫入操作日誌(obj工作階段, '開通模組', `${obj模組.str模組名稱}（${obj模組.str模組代號}），主控台 ${obj主控台.getId()}`);
  return {
    bool成功: true,
    bool重新開通: false,
    str訊息: `已開通「${obj模組.str模組名稱}」。接著可到「人員與權限」指派承辦人。`
  };
}


/**
 * ============================================================================
 * 函式名稱：重新開通模組_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   曾開通又關閉的模組，改回啟用並沿用原主控台。先確認主控台還打得開，
 *   找不到就說明原因（不自動另建一份，以免以為資料還在）。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj精舍       {Object} 精舍資訊
 *   obj模組       {Object} 模組定義
 *   obj既有       {Object} 開通紀錄 { int列號, obj值 }
 *
 * 傳回：{Object} { bool成功, str訊息, bool重新開通 }
 * ============================================================================
 */
function 重新開通模組_(obj工作階段, obj精舍, obj模組, obj既有) {
  const str主控台ID = String(obj既有.obj值['主控台ID']).trim();

  // 原主控台必須還在（開啟試算表 找不到時會丟出白話錯誤，這裡改成更明確的說明）
  try {
    開啟試算表(str主控台ID, `${obj模組.str模組名稱}主控台`);
  } catch (err) {
    throw new 平台錯誤(
      obj錯誤代碼.檔案無法開啟,
      `「${obj模組.str模組名稱}」原本的主控台找不到了（可能已被刪除），無法重新開通。請通知系統管理員協助處理。`,
      { str主控台ID: str主控台ID }
    );
  }

  執行並鎖定(function () {
    更新資料列(取得工作表(取得系統主控(), obj系統主控結構.精舍模組開通.str分頁), obj既有.int列號, { '狀態': obj狀態.啟用 });
  }, '重新開通功能');

  寫入操作日誌(obj工作階段, '重新開通模組', `${obj模組.str模組名稱}（${obj模組.str模組代號}），沿用主控台 ${str主控台ID}`, obj精舍.str精舍代號);
  return {
    bool成功: true,
    bool重新開通: true,
    str訊息: `已重新開通「${obj模組.str模組名稱}」，原有資料與承辦人權限都保留。`
  };
}


/**
 * ============================================================================
 * 函式名稱：關閉模組
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   精舍管理員關閉已開通的模組。只改狀態為「停用」：
 *     · 主控台與所有資料保留，日後重新開通即可沿用
 *     · 承辦人的權限指派保留，但模組關閉期間無法進入
 *   ※ 已建立的活動副本仍維持原本的共享（副本是獨立的試算表）。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str模組代號 }
 *
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 關閉模組(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str模組管理權限, '關閉功能');
  檢查必要參數(obj參數, ['str模組代號'], '關閉功能');

  const str精舍代號 = obj工作階段.str精舍代號;
  const str模組代號 = String(obj參數.str模組代號).trim();
  const obj模組 = 取得模組定義(str模組代號);    // 格式不對會丟出錯誤
  const str名稱 = obj模組 ? obj模組.str模組名稱 : str模組代號;   // 程式已移除的模組也允許關閉

  執行並鎖定(function () {
    const obj紀錄 = 讀取精舍開通紀錄_(str精舍代號);
    const obj既有 = obj紀錄.obj依模組[str模組代號];
    if (!obj既有 || String(obj既有.obj值['狀態']).trim() !== obj狀態.啟用) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${str名稱}」目前沒有開通，不需要關閉。`);
    }
    更新資料列(obj紀錄.obj分頁, obj既有.int列號, { '狀態': obj狀態.停用 });
  }, '關閉功能');

  寫入操作日誌(obj工作階段, '關閉模組', `${str名稱}（${str模組代號}）`);
  return {
    bool成功: true,
    str訊息: `已關閉「${str名稱}」。資料與承辦人權限都保留，日後重新開通即可繼續使用。`
  };
}


/**
 * ============================================================================
 * 函式名稱：檢查模組可開通_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：確認模組在程式中有定義、且已登記在模組清單並啟用。
 *
 * 參數：
 *   str模組代號   {string} 前端送來的模組代號
 *
 * 傳回：{Object} 模組定義
 * ============================================================================
 */
function 檢查模組可開通_(str模組代號) {
  const str代號 = String(str模組代號 || '').trim();
  const obj模組 = 取得模組定義(str代號);    // 格式不對會丟出錯誤

  // 程式中沒有這個模組
  if (!obj模組) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `系統中沒有「${str代號}」這個功能，請重新整理頁面後再試。`);
  }

  // 必須已登記在模組清單且啟用
  const bool可用 = 讀取可用模組_().some(function (obj) { return obj.str模組代號 === str代號; });
  if (!bool可用) {
    throw new 平台錯誤(
      obj錯誤代碼.權限不足,
      `「${obj模組.str模組名稱}」目前尚未開放使用。如有需要請洽系統管理員。`,
      { str模組代號: str代號 }
    );
  }

  return obj模組;
}
