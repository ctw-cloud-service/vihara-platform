// ============================================================================
// 檔案名稱：核心_路由.gs
// 所屬層級：平台核心／入口層
// 檔案版本：v1.1.0（2026-10-25）
//   v1.1.0：核心路由表加入 精舍.列出模組、精舍.開通模組、精舍.關閉模組、精舍.列出主檔種類
// 用途說明：
//   GAS 網頁應用程式的唯一入口。前端（GitHub Pages）以 POST 送來：
//
//     { "action": "精舍.列出人員", "token": "工作階段代碼", "參數": { … } }
//
//   處理順序：解析請求 → 找出 action 對應的函式 → 需要登入就取回工作階段 →
//   執行 → 統一包裝成 { bool成功: true, … } 或 { bool成功: false, str錯誤代碼, str訊息 }。
//
//   ※ 前端請以 Content-Type: text/plain 送出（內容仍是 JSON 文字），
//     可避開瀏覽器的跨網域預檢，GAS 才能正常回應。
//
//   action 命名：「分類.動作」
//     · 驗證.／系統.／精舍.  由本檔的核心路由表處理
//     · 其他（例如 event.新增活動）  交給模組：平台自動呼叫「路由定義_模組代號」
//       取得該模組的路由表，新增模組不必修改本檔。
//
//   模組路由定義的寫法（放在模組自己的檔案中）：
//     function 路由定義_event() {
//       return {
//         'event.列出活動': { fn: 列出活動 },                       // 預設需要登入
//         'event.報到碼登入': { fn: 報到碼登入, bool需登入: false }  // 不需登入
//       };
//     }
//   處理函式一律為 function (obj工作階段, obj參數)，傳回一個物件。
//
// 相依檔案：平台核心全部檔案
// ============================================================================


// ----------------------------------------------------------------------------
// 本檔常數
// ----------------------------------------------------------------------------
const str平台版本 = '1.1.0';               // 每次部署新版時一併更新，前端可顯示
const int請求大小上限 = 1024 * 1024;        // 1MB，避免異常的超大請求


/**
 * ============================================================================
 * 函式名稱：取得核心路由表
 * 版本：v1.1.0（2026-10-25）
 *   v1.1.0：加入功能開通與主檔種類
 * ----------------------------------------------------------------------------
 * 用途：平台核心提供的所有 action 與對應函式。權限檢查在各函式內部進行。
 * 參數：無
 * 傳回：{Object} { action: { fn, bool需登入 } }
 * ============================================================================
 */
function 取得核心路由表() {
  return {
    // ── 驗證 ──
    '驗證.Google登入': { fn: function (obj工作階段, obj參數) { return 執行Google登入(obj參數); }, bool需登入: false },
    '驗證.登出': { fn: 執行登出_ },
    '驗證.我的資訊': { fn: 取得我的資訊_ },

    // ── 系統管理員（總管理頁） ──
    '系統.列出精舍': { fn: 列出精舍 },
    '系統.開通精舍': { fn: 開通精舍 },
    '系統.更新精舍': { fn: 更新精舍 },
    '系統.新增精舍管理員': { fn: 新增精舍管理員 },
    '系統.停用精舍管理員': { fn: 停用精舍管理員 },

    // ── 精舍管理員（精舍設定頁） ──
    '精舍.列出人員': { fn: 列出人員 },
    '精舍.新增人員': { fn: 新增人員 },
    '精舍.更新人員': { fn: 更新人員 },
    '精舍.設定人員權限': { fn: 設定人員權限 },
    '精舍.取得權限選項': { fn: 取得權限選項 },
    '精舍.重新同步副本共享': { fn: 重新同步副本共享 },
    '精舍.列出外部檔案': { fn: 列出外部檔案 },
    '精舍.登記外部檔案': { fn: 登記外部檔案 },

    // ── 功能開通（精舍管理員，權限「平台.管理模組」） ──
    '精舍.列出模組': { fn: 列出模組 },
    '精舍.開通模組': { fn: 開通模組 },
    '精舍.關閉模組': { fn: 關閉模組 },

    // ── 共用主檔（讀取：精舍內已登入者；儲存：精舍管理員） ──
    '精舍.列出主檔種類': { fn: 列出主檔種類 },
    '精舍.列出主檔': { fn: 列出主檔 },
    '精舍.儲存主檔項目': { fn: 儲存主檔項目 }
  };
}


/**
 * ============================================================================
 * 函式名稱：doPost
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：網頁應用程式收到 POST 請求時，由 Google 自動呼叫。（名稱固定，不可改）
 * 參數：
 *   e   {Object} Google 傳入的請求資料，內容在 e.postData.contents
 * 傳回：{TextOutput} JSON 文字
 * ============================================================================
 */
function doPost(e) {
  const str內容 = (e && e.postData && e.postData.contents) ? e.postData.contents : '';
  return 輸出JSON_(處理請求文字(str內容));
}


/**
 * ============================================================================
 * 函式名稱：doGet
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   用瀏覽器直接打開網址時的回應，用來確認部署是否成功（健康檢查）。
 *   不提供任何資料存取。（名稱固定，不可改）
 * 參數：
 *   e   {Object} Google 傳入的請求資料
 * 傳回：{TextOutput} JSON 文字
 * ============================================================================
 */
function doGet(e) {
  return 輸出JSON_({ bool成功: true, str訊息: '精舍雲端服務平台運作中。', str版本: str平台版本 });
}


/**
 * ============================================================================
 * 函式名稱：處理請求文字
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：把前端送來的 JSON 文字解析後交給「處理請求」。拆出來方便測試。
 * 參數：
 *   str內容   {string} 請求內容（JSON 文字）
 * 傳回：{Object} 回應物件
 * ============================================================================
 */
function 處理請求文字(str內容) {
  try {
    // 空的或過大的請求
    if (!str內容) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, '沒有收到任何請求內容，請重新操作一次。');
    }
    if (str內容.length > int請求大小上限) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, '送出的資料太大，請分批處理。');
    }

    // 解析 JSON
    let obj請求;
    try {
      obj請求 = JSON.parse(str內容);
    } catch (err) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, '請求格式不正確，請重新整理頁面後再試。');
    }

    return 處理請求(obj請求);
  } catch (err) {
    return 建立錯誤回應(err, '處理請求');
  }
}


/**
 * ============================================================================
 * 函式名稱：處理請求
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：依 action 找出處理函式，視需要驗證登入後執行，並統一回應格式。
 *
 * 參數：
 *   obj請求   {Object} { action, token, 參數 }
 *
 * 傳回：
 *   成功：{ bool成功: true, …處理函式傳回的內容 }
 *   失敗：{ bool成功: false, str錯誤代碼, str訊息 }
 * ============================================================================
 */
function 處理請求(obj請求) {
  const str動作 = (obj請求 && typeof obj請求.action === 'string') ? obj請求.action.trim() : '';
  const int開始 = new Date().getTime();

  try {
    // ── 1. 找出處理函式 ──
    const obj路由 = 尋找路由_(str動作);

    // ── 2. 需要登入就取回工作階段（逾時會丟出「登入逾時」，前端據此導回登入頁） ──
    const obj工作階段 = (obj路由.bool需登入 === false) ? null : 取得工作階段(obj請求.token);

    // ── 3. 執行 ──
    const obj參數 = (obj請求.參數 && typeof obj請求.參數 === 'object') ? obj請求.參數 : {};
    const obj結果 = obj路由.fn(obj工作階段, obj參數) || {};

    // ── 4. 統一成功格式 ──
    console.log(`[${str動作}] 完成，${new Date().getTime() - int開始} 毫秒`);
    return Object.assign({ bool成功: true }, obj結果);
  } catch (err) {
    console.log(`[${str動作 || '未指定'}] 失敗，${new Date().getTime() - int開始} 毫秒`);
    return 建立錯誤回應(err, str動作 ? `執行「${str動作}」` : '處理請求');
  }
}


/**
 * ============================================================================
 * 函式名稱：尋找路由_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   依 action 找出 { fn, bool需登入 }。先查核心路由表；
 *   查不到再依「分類」找模組的「路由定義_分類」。
 *
 * 參數：
 *   str動作   {string} action，例如「精舍.列出人員」「event.新增活動」
 *
 * 傳回：{Object} { fn, bool需登入 }
 * ============================================================================
 */
function 尋找路由_(str動作) {
  // 沒有 action
  if (str動作 === '') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '請求中沒有指定要做什麼（action），請重新整理頁面後再試。');
  }

  // 格式：「分類.動作」
  const int分隔 = str動作.indexOf('.');
  if (int分隔 <= 0 || int分隔 === str動作.length - 1) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `無法辨識的操作「${str動作}」，請重新整理頁面後再試。`);
  }

  // 先查核心路由表
  const obj核心 = 取得核心路由表();
  if (Object.prototype.hasOwnProperty.call(obj核心, str動作)) {
    return obj核心[str動作];
  }

  // 再查模組路由表（分類就是模組代號，只允許英文小寫、數字、底線）
  const str分類 = str動作.substring(0, int分隔);
  if (/^[a-z0-9_]+$/.test(str分類)) {
    const fn路由定義 = globalThis[`路由定義_${str分類}`];
    if (typeof fn路由定義 === 'function') {
      const obj模組路由 = fn路由定義() || {};
      if (Object.prototype.hasOwnProperty.call(obj模組路由, str動作)
        && typeof obj模組路由[str動作].fn === 'function') {
        return obj模組路由[str動作];
      }
    }
  }

  throw new 平台錯誤(
    obj錯誤代碼.參數錯誤,
    `系統不認得「${str動作}」這項操作，可能是頁面版本太舊，請重新整理頁面後再試。`
  );
}


/**
 * ============================================================================
 * 函式名稱：執行登出_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：action「驗證.登出」，刪除工作階段。
 * 參數：
 *   obj工作階段   {Object} 目前的工作階段
 *   obj參數       {Object} 不需要
 * 傳回：{Object} { str訊息 }
 * ============================================================================
 */
function 執行登出_(obj工作階段, obj參數) {
  結束工作階段(obj工作階段.str工作階段代碼);
  return { str訊息: '已登出。' };
}


/**
 * ============================================================================
 * 函式名稱：取得我的資訊_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「驗證.我的資訊」。前端每次開啟頁面時呼叫，取得身分與可進入的模組，
 *   用來決定畫面顯示哪些功能（實際權限仍由各函式在伺服器端檢查）。
 *
 * 參數：
 *   obj工作階段   {Object} 目前的工作階段
 *   obj參數       {Object} 不需要
 *
 * 傳回：
 *   {Object} { obj身分: { str帳號, str角色, str精舍代號, str精舍名稱, str姓名, arr權限 },
 *              arr模組: [ { str模組代號, str模組名稱 } ] }
 * ============================================================================
 */
function 取得我的資訊_(obj工作階段, obj參數) {
  const obj身分 = {
    str帳號: obj工作階段.str帳號,
    str角色: obj工作階段.str角色,
    str精舍代號: obj工作階段.str精舍代號 || '',
    str精舍名稱: obj工作階段.str精舍名稱 || '',
    str姓名: obj工作階段.str姓名 || '',
    arr權限: obj工作階段.arr權限 || []
  };

  // 系統管理員不屬於任何精舍，沒有模組
  if (!obj身分.str精舍代號) return { obj身分: obj身分, arr模組: [] };

  // 精舍已開通的模組（不回傳主控台代號等內部資訊）
  const arr模組 = 取得已開通模組(obj身分.str精舍代號).map(function (obj模組) {
    return { str模組代號: obj模組.str模組代號, str模組名稱: obj模組.str模組名稱 };
  });

  return { obj身分: obj身分, arr模組: arr模組 };
}


/**
 * ============================================================================
 * 函式名稱：輸出JSON_（內部使用）
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：把回應物件轉成 Google 網頁應用程式的 JSON 輸出。
 * 參數：
 *   obj回應   {Object} 回應物件
 * 傳回：{TextOutput}
 * ============================================================================
 */
function 輸出JSON_(obj回應) {
  return ContentService
    .createTextOutput(JSON.stringify(obj回應))
    .setMimeType(ContentService.MimeType.JSON);
}
