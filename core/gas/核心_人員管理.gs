// ============================================================================
// 檔案名稱：核心_人員管理.gs
// 所屬層級：平台核心／服務層
// 檔案版本：v1.2.0（2026-10-25）
//   v1.2.0：設定人員權限只取代「已開通模組」的指派，已關閉模組的指派保留（重新開通後恢復）
//   v1.1.0：人員停用或重新啟用後，自動同步精舍所有副本的共享名單；新增「重新同步副本共享」
//   v1.0.0：初版
// 用途說明：
//   精舍管理員的工作：在自己精舍的「精舍設定」中增修承辦人，並指派權限項目。
//   資料一律寫在該精舍自己的精舍設定試算表，不經系統管理員。
//
//   權限：所有函式都需要「平台.管理人員」，只有精舍管理員具備（不可指派給承辦人）。
//   精舍管理員本身由系統管理員登記在系統主控（見 核心_精舍管理.gs），此處只能查看。
//
// 相依檔案：核心_錯誤、核心_試算表存取、核心_工具、核心_結構定義、核心_租戶解析、
//           核心_權限、核心_日誌、核心_模組管理、核心_副本管理、
//           核心_精舍管理（共用檢查函式）
// ============================================================================


// ----------------------------------------------------------------------------
// 本檔使用的權限項目
// ----------------------------------------------------------------------------
const str人員管理權限 = '平台.管理人員';


/**
 * ============================================================================
 * 函式名稱：列出人員
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：精舍設定頁的人員清單，含每位承辦人的權限；另列出精舍管理員供參考。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} 不需要
 *
 * 傳回：
 *   {Object} {
 *     bool成功,
 *     arr管理員: [ { str帳號, str姓名 } ],                              // 啟用中的精舍管理員
 *     arr人員:   [ { str帳號, str姓名, str狀態, str建立日期, arr權限 } ] // 承辦人
 *   }
 * ============================================================================
 */
function 列出人員(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str人員管理權限, '查看人員');
  const str精舍代號 = obj工作階段.str精舍代號;
  const obj設定 = 取得精舍設定試算表(str精舍代號);

  // 精舍管理員（系統主控，只讀啟用中的）
  const obj管理員定義 = obj系統主控結構.精舍管理員;
  const arr管理員 = 依條件尋找資料列(取得工作表(取得系統主控(), obj管理員定義.str分頁), obj管理員定義.arr欄位, function (obj值) {
    return String(obj值['精舍代號']).trim().toUpperCase() === str精舍代號
      && String(obj值['狀態']).trim() === obj狀態.啟用;
  }).map(function (obj列) {
    return { str帳號: 正規化帳號(obj列.obj值['Google帳號']), str姓名: String(obj列.obj值['姓名']).trim() };
  });

  // 權限指派：一次讀出，依帳號分組
  const obj指派定義 = obj精舍設定結構.權限指派;
  const obj權限分組 = {};
  讀取全部資料列(取得工作表(obj設定, obj指派定義.str分頁), obj指派定義.arr欄位).forEach(function (obj列) {
    const str帳號 = 正規化帳號(obj列.obj值['Google帳號']);
    const str項目 = `${String(obj列.obj值['模組代號']).trim()}.${String(obj列.obj值['權限項目']).trim()}`;
    const arr清單 = (obj權限分組[str帳號] = obj權限分組[str帳號] || []);
    if (arr清單.indexOf(str項目) === -1) arr清單.push(str項目);
  });

  // 承辦人
  const obj人員定義 = obj精舍設定結構.人員;
  const arr人員 = 讀取全部資料列(取得工作表(obj設定, obj人員定義.str分頁), obj人員定義.arr欄位).map(function (obj列) {
    const str帳號 = 正規化帳號(obj列.obj值['Google帳號']);
    return {
      str帳號: str帳號,
      str姓名: String(obj列.obj值['姓名']).trim(),
      str狀態: String(obj列.obj值['狀態']).trim(),
      str建立日期: 格式化日期(obj列.obj值['建立日期'], 'yyyy-MM-dd'),
      arr權限: obj權限分組[str帳號] || []
    };
  });

  return { bool成功: true, arr管理員: arr管理員, arr人員: arr人員 };
}


/**
 * ============================================================================
 * 函式名稱：新增人員
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：新增一位承辦人。帳號若曾被停用，會重新啟用並更新姓名（原有權限保留）。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str帳號, str姓名 }
 *
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 新增人員(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str人員管理權限, '新增人員');
  檢查必要參數(obj參數, ['str帳號', 'str姓名'], '新增人員');

  const str精舍代號 = obj工作階段.str精舍代號;
  const str帳號 = 正規化帳號(obj參數.str帳號);
  const str姓名 = String(obj參數.str姓名).trim();
  檢查電子郵件_(str帳號, 'Google 帳號');

  // 已是本精舍的精舍管理員：不需再加為承辦人
  const obj管理員定義 = obj系統主控結構.精舍管理員;
  const bool是管理員 = 依條件尋找資料列(取得工作表(取得系統主控(), obj管理員定義.str分頁), obj管理員定義.arr欄位, function (obj值) {
    return String(obj值['精舍代號']).trim().toUpperCase() === str精舍代號
      && 正規化帳號(obj值['Google帳號']) === str帳號
      && String(obj值['狀態']).trim() === obj狀態.啟用;
  }).length > 0;
  if (bool是管理員) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `${str帳號} 已經是精舍管理員，擁有全部權限，不需要再加為承辦人。`);
  }

  let str結果 = '';
  執行並鎖定(function () {
    const obj定義 = obj精舍設定結構.人員;
    const obj分頁 = 取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁);
    const arr既有 = 依條件尋找資料列(obj分頁, obj定義.arr欄位, function (obj值) {
      return 正規化帳號(obj值['Google帳號']) === str帳號;
    });

    if (arr既有.length > 0) {
      // 已存在：啟用中就告知，停用中就重新啟用
      if (String(arr既有[0].obj值['狀態']).trim() === obj狀態.啟用) {
        throw new 平台錯誤(obj錯誤代碼.參數錯誤, `${str帳號} 已經在人員名單中。`);
      }
      更新資料列(obj分頁, arr既有[0].int列號, { '姓名': str姓名, '狀態': obj狀態.啟用 });
      str結果 = '已重新啟用';
    } else {
      新增資料列(obj分頁, { 'Google帳號': str帳號, '姓名': str姓名, '狀態': obj狀態.啟用, '建立日期': new Date() });
      str結果 = '已新增';
    }
  }, '新增人員');

  寫入操作日誌(obj工作階段, '新增人員', `${str姓名}（${str帳號}）${str結果}`);

  // 重新啟用的人可能原本就被指派到某些副本，要把共享補回來
  const str提醒 = (str結果 === '已重新啟用') ? 人員異動後同步副本(str精舍代號) : '';
  return { bool成功: true, str訊息: `${str姓名}（${str帳號}）${str結果}。請記得指派權限。${str提醒}` };
}


/**
 * ============================================================================
 * 函式名稱：更新人員
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：修改承辦人姓名，或停用／重新啟用。停用後最晚 10 分鐘內失去登入資格。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str帳號, str姓名（選填）, str狀態（選填：啟用／停用） }
 *
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 更新人員(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str人員管理權限, '修改人員');
  檢查必要參數(obj參數, ['str帳號'], '修改人員');

  const str精舍代號 = obj工作階段.str精舍代號;
  const str帳號 = 正規化帳號(obj參數.str帳號);
  const obj更新 = {};

  if (obj參數.str姓名 !== undefined && String(obj參數.str姓名).trim() !== '') {
    obj更新['姓名'] = String(obj參數.str姓名).trim();
  }
  if (obj參數.str狀態 !== undefined && obj參數.str狀態 !== '') {
    obj更新['狀態'] = 檢查狀態值_(obj參數.str狀態);
  }
  if (Object.keys(obj更新).length === 0) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '沒有要修改的內容，請填寫姓名或選擇狀態。');
  }

  執行並鎖定(function () {
    const obj定義 = obj精舍設定結構.人員;
    const obj分頁 = 取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁);
    const obj列 = 找出唯一資料列_(obj分頁, obj定義.arr欄位, function (obj值) {
      return 正規化帳號(obj值['Google帳號']) === str帳號;
    }, `人員名單中找不到 ${str帳號}。`);
    更新資料列(obj分頁, obj列.int列號, obj更新);
  }, '修改人員');

  寫入操作日誌(obj工作階段, '修改人員', `${str帳號}：${JSON.stringify(obj更新)}`);

  // 狀態有變動：同步副本共享（停用者移除、重新啟用者補回）
  const str提醒 = obj更新['狀態'] ? 人員異動後同步副本(str精舍代號) : '';
  return { bool成功: true, str訊息: `人員資料已更新。${str提醒}` };
}


/**
 * ============================================================================
 * 函式名稱：重新同步副本共享
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   精舍管理員在畫面上手動觸發，重新檢查本精舍所有啟用中副本的共享名單。
 *   用於自動同步曾經失敗、或有人在雲端硬碟手動改過共享的情況。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} 不需要
 *
 * 傳回：{Object} { bool成功, str訊息, arr問題 }
 * ============================================================================
 */
function 重新同步副本共享(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str人員管理權限, '重新同步副本共享');

  const obj彙總 = 同步精舍全部副本(obj工作階段.str精舍代號);
  寫入操作日誌(obj工作階段, '重新同步副本共享', `副本 ${obj彙總.int副本數} 份，異動 ${obj彙總.int異動數} 筆`);

  return {
    bool成功: true,
    str訊息: `已檢查 ${obj彙總.int副本數} 份副本，調整 ${obj彙總.int異動數} 筆共享。`
      + (obj彙總.arr問題.length > 0 ? ` 有 ${obj彙總.arr問題.length} 項未完成，請查看下方說明。` : ''),
    arr問題: obj彙總.arr問題
  };
}


/**
 * ============================================================================
 * 函式名稱：設定人員權限
 * 版本：v1.1.0（2026-10-25）
 *   v1.1.0：只取代已開通模組的指派；已關閉模組的指派保留不動
 * ----------------------------------------------------------------------------
 * 用途：
 *   以「整組取代」方式設定某位承辦人在「已開通模組」中的權限：
 *   傳入的清單就是他在這些模組最後擁有的全部權限。
 *   每一項都必須是本精舍已開通模組中、允許指派給承辦人的項目。
 *   傳入空清單表示取消已開通模組的全部權限。
 *
 *   精舍管理員關閉某模組時，該模組的指派會保留（畫面上看不到、也改不到），
 *   重新開通後自動恢復，不必重新指派。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str帳號, arr權限: ['event.整理資料', ...] }
 *
 * 傳回：{Object} { bool成功, str訊息, arr權限 }
 * ============================================================================
 */
function 設定人員權限(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str人員管理權限, '指派權限');
  檢查必要參數(obj參數, ['str帳號'], '指派權限');
  if (!Array.isArray(obj參數.arr權限)) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '「指派權限」沒有收到權限清單，請重新操作一次。');
  }

  const str精舍代號 = obj工作階段.str精舍代號;
  const str帳號 = 正規化帳號(obj參數.str帳號);

  // 去除空白與重複
  const arr權限 = obj參數.arr權限
    .map(function (str項目) { return String(str項目 || '').trim(); })
    .filter(function (str項目, int索引, arr) { return str項目 !== '' && arr.indexOf(str項目) === int索引; });

  // 本精舍已開通的模組代號
  const arr已開通 = 取得已開通模組(str精舍代號).map(function (obj模組) { return obj模組.str模組代號; });

  // 逐項檢查：必須是可指派項目，且模組已開通
  const arr不合格 = arr權限.filter(function (str項目) {
    const str模組代號 = str項目.split('.')[0];
    return !是否為可指派權限(str項目) || arr已開通.indexOf(str模組代號) === -1;
  });
  if (arr不合格.length > 0) {
    throw new 平台錯誤(
      obj錯誤代碼.參數錯誤,
      `以下權限無法指派（模組未開通，或該項目只限精舍管理員）：${arr不合格.join('、')}。`,
      { arr不合格: arr不合格 }
    );
  }

  執行並鎖定(function () {
    const obj設定 = 取得精舍設定試算表(str精舍代號);

    // 人員必須已在名單中
    const obj人員定義 = obj精舍設定結構.人員;
    找出唯一資料列_(取得工作表(obj設定, obj人員定義.str分頁), obj人員定義.arr欄位, function (obj值) {
      return 正規化帳號(obj值['Google帳號']) === str帳號;
    }, `人員名單中找不到 ${str帳號}，請先新增人員。`);

    // 刪除此人在「已開通模組」的舊指派，再寫入新指派
    // （已關閉模組的指派不刪，重新開通後恢復）
    const obj指派定義 = obj精舍設定結構.權限指派;
    const obj指派分頁 = 取得工作表(obj設定, obj指派定義.str分頁);
    const arr舊列號 = 依條件尋找資料列(obj指派分頁, obj指派定義.arr欄位, function (obj值) {
      return 正規化帳號(obj值['Google帳號']) === str帳號
        && arr已開通.indexOf(String(obj值['模組代號']).trim()) !== -1;
    }).map(function (obj列) { return obj列.int列號; });
    刪除資料列(obj指派分頁, arr舊列號);

    const dat現在 = new Date();
    批次新增資料列(obj指派分頁, arr權限.map(function (str項目) {
      const int分隔 = str項目.indexOf('.');
      return {
        'Google帳號': str帳號,
        '模組代號': str項目.substring(0, int分隔),
        '權限項目': str項目.substring(int分隔 + 1),
        '指派日期': dat現在
      };
    }));
  }, '指派權限');

  寫入操作日誌(obj工作階段, '指派權限', `${str帳號}：${arr權限.join('、') || '（全部取消）'}`);
  return { bool成功: true, str訊息: '權限已更新，最晚 10 分鐘內生效。', arr權限: arr權限 };
}


/**
 * ============================================================================
 * 函式名稱：取得權限選項
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：指派權限畫面用，列出本精舍已開通模組各有哪些可指派的權限項目。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} 不需要
 *
 * 傳回：
 *   {Object} { bool成功, arr模組: [ { str模組代號, str模組名稱,
 *                                      arr可指派權限: [ { str權限項目, str項目, str說明 } ] } ] }
 * ============================================================================
 */
function 取得權限選項(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str人員管理權限, '查看權限選項');

  const arr模組 = 取得已開通模組(obj工作階段.str精舍代號).map(function (obj模組) {
    const obj定義 = 取得模組定義(obj模組.str模組代號);
    return {
      str模組代號: obj模組.str模組代號,
      str模組名稱: obj模組.str模組名稱,
      arr可指派權限: (obj定義 ? obj定義.arr可指派權限 : []).map(function (obj權限) {
        return {
          str權限項目: `${obj模組.str模組代號}.${obj權限.str項目}`,
          str項目: obj權限.str項目,
          str說明: obj權限.str說明 || ''
        };
      })
    };
  });

  return { bool成功: true, arr模組: arr模組 };
}
