// ============================================================================
// 檔案名稱：測試_核心_學員名冊.gs
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.1.0（2026-10-25）
//   v1.1.0：改測自訂格式（自訂分頁名稱、欄位順序、多餘欄位、多個分頁符合時的處理）
//   v1.0.0：初版
// 用途說明：
//   在 Apps Script 編輯器中執行「測試_核心_學員名冊」。
//   建立暫存的系統主控、精舍與一份假的學員名冊（虛構姓名），
//   測試外部檔案登記、依編號查詢、姓名＋法名比對與臨時編號配發。
//   最後把暫存檔與資料夾移到垃圾桶。不會讀取正式的學員名冊。
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：測試_核心_學員名冊
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：自動測試核心_學員名冊與核心_外部檔案。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_核心_學員名冊() {
  const arr結果 = [];
  const arr暫存檔 = [];
  let obj暫存根資料夾 = null;

  const str系統管理員 = 'admin.test@example.com';
  const str住持 = 'abbot.test@example.com';
  const str承辦人 = 'staff.test@example.com';

  function 記錄(str項目, bool通過, str補充) {
    arr結果.push({ str項目: str項目, bool通過: bool通過 });
    console.log(`${bool通過 ? '✔' : '✘'} ${str項目}${str補充 ? '：' + str補充 : ''}`);
  }
  function 預期錯誤(str項目, str預期代碼, fn執行) {
    try {
      fn執行();
      記錄(str項目, false, '應該要出錯，但沒有出錯');
    } catch (err) {
      記錄(str項目, (err instanceof 平台錯誤) && err.str錯誤代碼 === str預期代碼, err.message);
    }
  }
  // 建立一份暫存試算表，第一個分頁改名並寫入資料
  function 建立暫存表(str檔名, str分頁, arr資料) {
    const obj表 = SpreadsheetApp.create(`平台測試_${str檔名}_${new Date().getTime()}`);
    arr暫存檔.push(obj表.getId());
    const obj分頁 = obj表.getSheets()[0];
    obj分頁.setName(str分頁);
    obj分頁.getRange(1, 1, arr資料.length, arr資料[0].length).setValues(arr資料);
    return obj表;
  }

  try {
    // ── 準備：系統主控、精舍、承辦人 ──
    const obj主控 = SpreadsheetApp.create(`平台測試_系統主控_${new Date().getTime()}`);
    arr暫存檔.push(obj主控.getId());
    建立整份結構(obj主控, obj系統主控結構);
    obj暫存根資料夾 = DriveApp.createFolder(`平台測試_精舍資料_${new Date().getTime()}`);
    設定測試用系統主控_(obj主控.getId());
    str測試用系統管理員帳號_ = str系統管理員;
    str測試用精舍資料根ID_ = obj暫存根資料夾.getId();

    開通精舍(判定身分_(str系統管理員, ''), { str精舍代號: 'TC', str精舍名稱: '測試台中精舍', str管理員帳號: str住持, str管理員姓名: '測試住持' });
    const obj住持 = 判定身分_(str住持, 'TC');
    新增人員(obj住持, { str帳號: str承辦人, str姓名: '測試承辦人' });
    const obj承辦 = 判定身分_(str承辦人, 'TC');

    // ── 假名冊（虛構資料）：自訂分頁名稱、欄位順序不同、多一個「地址」欄、
    //    編號存成數字、姓名中間有空白、同名同法名、沒有法名 ──
    const obj名冊 = 建立暫存表('學員名冊', '學員資料', [
      ['姓名', '學員編號', '地址', '法名', '手機號碼', '性別'],
      ['王小明', 100000001, '台中', '傳一', 912345678, '男'],
      ['李 小華', 100000002, '', '傳二', '', '女'],
      ['陳大同', 100000003, '', '傳三', '0911-222333', '男'],
      ['陳大同', 100000004, '', '傳三', '', '男'],
      ['林美', 100000005, '', '', '', '女']
    ]);
    const obj格式錯誤名冊 = 建立暫存表('格式錯誤名冊', '明細', [['學員編號', '姓名', '性別'], [1, '甲', '男']]);

    // 兩個分頁都符合、且都不叫「明細」：需要指定
    const obj兩個分頁 = 建立暫存表('兩個分頁', '本期', [['學員編號', '姓名', '法名'], [1, '甲', '乙']]);
    obj兩個分頁.insertSheet('上期').getRange(1, 1, 2, 3).setValues([['學員編號', '姓名', '法名'], [2, '丙', '丁']]);

    // 兩個分頁都符合、其中一個叫「明細」：自動選明細
    const obj含明細 = 建立暫存表('含明細', '明細', [['學員編號', '姓名', '法名'], [1, '甲', '乙']]);
    obj含明細.insertSheet('備份').getRange(1, 1, 2, 3).setValues([['學員編號', '姓名', '法名'], [2, '丙', '丁']]);

    // ── 外部檔案登記 ──
    記錄('從網址取出檔案代號',
      解析檔案代號(`https://docs.google.com/spreadsheets/d/${obj名冊.getId()}/edit#gid=0`) === obj名冊.getId());
    預期錯誤('無法辨識的網址', obj錯誤代碼.參數錯誤, function () { 解析檔案代號('abc'); });
    預期錯誤('缺少「法名」標題的名冊不能登記', obj錯誤代碼.欄位缺漏, function () {
      登記外部檔案(obj住持, { str項目: '學員名冊', str檔案: obj格式錯誤名冊.getId() });
    });
    預期錯誤('多個分頁符合時要求指定', obj錯誤代碼.參數錯誤, function () {
      登記外部檔案(obj住持, { str項目: '學員名冊', str檔案: obj兩個分頁.getId() });
    });
    記錄('指定分頁後可登記',
      登記外部檔案(obj住持, { str項目: '學員名冊', str檔案: obj兩個分頁.getId(), str分頁名稱: '上期' }).str分頁名稱 === '上期');
    預期錯誤('指定不存在的分頁', obj錯誤代碼.工作表不存在, function () {
      登記外部檔案(obj住持, { str項目: '學員名冊', str檔案: obj兩個分頁.getId(), str分頁名稱: '沒有這頁' });
    });
    記錄('多個分頁符合時優先使用「明細」',
      登記外部檔案(obj住持, { str項目: '學員名冊', str檔案: obj含明細.getId() }).str分頁名稱 === '明細');
    預期錯誤('不可登記未定義的項目', obj錯誤代碼.參數錯誤, function () {
      登記外部檔案(obj住持, { str項目: '其他檔案', str檔案: obj名冊.getId() });
    });
    預期錯誤('承辦人不能登記外部檔案', obj錯誤代碼.權限不足, function () {
      登記外部檔案(obj承辦, { str項目: '學員名冊', str檔案: obj名冊.getId() });
    });
    const obj登記 = 登記外部檔案(obj住持, {
      str項目: '學員名冊', str檔案: `https://docs.google.com/spreadsheets/d/${obj名冊.getId()}/edit`
    });
    記錄('以網址登記自訂格式的學員名冊',
      obj登記.bool成功 && obj登記.str分頁名稱 === '學員資料' && obj登記.str訊息.indexOf('5 位') !== -1, obj登記.str訊息);
    const arr外部 = 列出外部檔案(obj住持, {}).arr項目;
    記錄('列出外部檔案狀態', arr外部.filter(function (o) { return o.str項目 === '學員名冊'; })[0].bool已登記);

    // ── 依編號查詢 ──
    const obj甲 = 依編號查詢學員('TC', '100000001');
    記錄('以文字編號查詢', obj甲 !== null && obj甲.str姓名 === '王小明');
    記錄('以數字編號查詢（QR code 或試算表數字）', 依編號查詢學員('TC', 100000001) !== null);
    記錄('編號前後有空白仍可查詢', 依編號查詢學員('TC', ' 100000001 ') !== null);
    記錄('手機號碼自動補 0 並格式化', obj甲.str手機號碼 === '0912-345678', obj甲.str手機號碼);
    記錄('查無此編號傳回 null', 依編號查詢學員('TC', '999') === null);

    // ── 姓名＋法名比對 ──
    const arr比對 = 比對學員編號('TC', [
      { str姓名: '王小明', str法名: '傳一' },
      { str姓名: '李小華', str法名: '傳 二' },
      { str姓名: '陳大同', str法名: '傳三' },
      { str姓名: '林美', str法名: '' },
      { str姓名: '不在名冊', str法名: '傳九' }
    ]);
    記錄('姓名法名相符', arr比對[0].str比對結果 === '符合' && arr比對[0].str學員編號 === '100000001');
    記錄('忽略姓名法名中的空白', arr比對[1].str比對結果 === '符合' && arr比對[1].str學員編號 === '100000002');
    記錄('同名同法名不自動選，列出候選', arr比對[2].str比對結果 === '多筆符合' && arr比對[2].arr候選編號.length === 2);
    記錄('沒有法名也能比對', arr比對[3].str比對結果 === '符合');
    記錄('名冊沒有的人為找不到', arr比對[4].str比對結果 === '找不到' && arr比對[4].str學員編號 === '');

    // ── 配發臨時編號 ──
    const arr配發 = 比對並配發臨時編號('TC', [
      { str姓名: '新朋友甲', str法名: '' },
      { str姓名: '新朋友甲', str法名: '' },      // 同一批重複報名：同一個號碼
      { str姓名: '新朋友乙', str法名: '傳十' },
      { str姓名: '王小明', str法名: '傳一' },     // 名冊有的人：保留正式編號
      { str姓名: '陳大同', str法名: '傳三' }      // 多筆：不配發
    ]);
    記錄('找不到者配發臨時編號，同一人只配一個',
      arr配發[0].str學員編號 === 'T-TC-0001' && arr配發[1].str學員編號 === 'T-TC-0001' && arr配發[2].str學員編號 === 'T-TC-0002',
      arr配發.map(function (o) { return o.str學員編號 || '（未配發）'; }).join('、'));
    記錄('名冊有的人保留正式編號', arr配發[3].str學員編號 === '100000001' && !arr配發[3].bool臨時編號);
    記錄('多筆符合者不配發', arr配發[4].str學員編號 === '' && !arr配發[4].bool臨時編號);
    const arr再配發 = 比對並配發臨時編號('TC', [{ str姓名: '新朋友丙', str法名: '' }]);
    記錄('臨時編號接續不重複', arr再配發[0].str學員編號 === 'T-TC-0003');

  } catch (err) {
    記錄('測試流程中斷', false, err.message);
  } finally {
    設定測試用系統主控_(null);
    str測試用系統管理員帳號_ = null;
    str測試用精舍資料根ID_ = null;
    arr暫存檔.forEach(function (str檔案ID) {
      try { DriveApp.getFileById(str檔案ID).setTrashed(true); } catch (err) { /* 略過 */ }
    });
    if (obj暫存根資料夾) {
      try { obj暫存根資料夾.setTrashed(true); } catch (err) { /* 略過 */ }
    }
    console.log('（暫存試算表與資料夾已移到垃圾桶）');
  }

  const arr失敗 = arr結果.filter(function (obj) { return !obj.bool通過; });
  console.log(`==== 測試完成：通過 ${arr結果.length - arr失敗.length} 項，失敗 ${arr失敗.length} 項 ====`);
  return {
    int通過: arr結果.length - arr失敗.length,
    int失敗: arr失敗.length,
    arr失敗項目: arr失敗.map(function (obj) { return obj.str項目; })
  };
}
