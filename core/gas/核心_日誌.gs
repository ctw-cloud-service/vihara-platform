// ============================================================================
// 檔案名稱：核心_日誌.gs
// 所屬層級：平台核心／共用
// 檔案版本：v1.0.0（2026-10-25）
// 用途說明：
//   把重要操作（開通精舍、新增人員、調整權限…）記錄到系統主控的「操作日誌」，
//   日後可查「誰在什麼時候做了什麼」。
//   記錄失敗只在執行紀錄留下警告，不會讓原本的作業失敗。
// 相依檔案：核心_錯誤、核心_試算表存取、核心_結構定義、核心_租戶解析
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：寫入操作日誌
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：記錄一筆操作。使用 Google 的追加功能，多人同時寫入也不會互相覆蓋。
 *
 * 參數：
 *   obj工作階段   {Object} 由「取得工作階段」取得；系統內部作業可傳 null
 *   str動作       {string} 簡短動作名稱，例如「開通精舍」
 *   str說明       {string} 補充說明，例如「TC 台中精舍，管理員 a@b.com」
 *   str精舍代號   {string} 選填；不給時用工作階段中的精舍代號
 *
 * 傳回：無
 * ============================================================================
 */
function 寫入操作日誌(obj工作階段, str動作, str說明, str精舍代號) {
  try {
    const obj定義 = obj系統主控結構.操作日誌;
    const obj分頁 = 取得工作表(取得系統主控(), obj定義.str分頁);

    // 精舍代號：優先用參數，其次用工作階段
    const str代號 = str精舍代號 || (obj工作階段 && obj工作階段.str精舍代號) || '';

    附加資料列(obj分頁, {
      '時間': new Date(),
      '精舍代號': str代號,
      '帳號': (obj工作階段 && obj工作階段.str帳號) || '系統',
      '動作': str動作 || '',
      '說明': str說明 || ''
    });
  } catch (err) {
    // 日誌只是輔助紀錄：失敗不影響主要作業，只留下警告
    console.warn(`寫入操作日誌失敗（${str動作}）：${err && err.message ? err.message : err}`);
  }
}
