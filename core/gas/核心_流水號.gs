// ============================================================================
// 檔案名稱：核心_流水號.gs
// 所屬層級：平台核心／服務層
// 檔案版本：v1.0.0（2026-10-25）
// 用途說明：
//   每個精舍各自的流水號（記在精舍設定的「流水號」分頁），用於：
//     · 共用主檔的自動代號（例如護法會組別 G001）
//     · 學員的臨時編號（例如 T-TC-0001）
//   ※ 所有函式都必須在「執行並鎖定」範圍內呼叫，才不會發出重複號碼。
// 相依檔案：核心_錯誤、核心_試算表存取、核心_結構定義、核心_租戶解析
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：取得流水號區段
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   一次保留連續的多個號碼（例如一次給 30 位學員臨時編號），只讀寫一次試算表。
 *   ※ 請在鎖定範圍內呼叫。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   str名稱       {string} 流水號名稱，例如「臨時編號」「主檔_護法會組別」
 *   int數量       {number} 要保留幾個號碼，預設 1
 *
 * 傳回：
 *   {number} 第一個號碼（之後的號碼依序加 1）
 * ============================================================================
 */
function 取得流水號區段(str精舍代號, str名稱, int數量) {
  const int保留數 = int數量 || 1;

  // 數量必須是正整數
  if (!Number.isInteger(int保留數) || int保留數 < 1) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `流水號數量必須是正整數，收到的是「${int數量}」。`);
  }

  const obj定義 = obj精舍設定結構.流水號;
  const obj分頁 = 取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁);

  // 找出這個名稱的流水號
  const arr符合 = 依條件尋找資料列(obj分頁, obj定義.arr欄位, function (obj值) {
    return String(obj值['名稱']).trim() === str名稱;
  });

  // 第一次使用：新增一列，號碼從 1 開始，目前值記為已用掉的最後一號
  if (arr符合.length === 0) {
    新增資料列(obj分頁, { '名稱': str名稱, '目前值': int保留數 });
    return 1;
  }

  // 已存在：目前值往後推
  const int目前值 = Number(arr符合[0].obj值['目前值']) || 0;
  更新資料列(obj分頁, arr符合[0].int列號, { '目前值': int目前值 + int保留數 });
  return int目前值 + 1;
}


/**
 * ============================================================================
 * 函式名稱：產生臨時編號
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   替比對不到學員編號的人產生臨時編號，格式「T-精舍代號-流水號」，
 *   流水號至少 4 位（T-TC-0001）；超過 9999 會自動變成 5 位，不會重複。
 *   ※ 請在鎖定範圍內呼叫。
 *
 * 參數：
 *   str精舍代號   {string} 精舍代號
 *   int數量       {number} 要產生幾個，預設 1
 *
 * 傳回：
 *   {string[]} 臨時編號清單
 * ============================================================================
 */
function 產生臨時編號(str精舍代號, int數量) {
  const str代號 = 正規化精舍代號(str精舍代號);
  const int個數 = int數量 || 1;
  const int起始 = 取得流水號區段(str代號, '臨時編號', int個數);

  const arr編號 = [];
  for (let int序 = 0; int序 < int個數; int序 += 1) {
    // 補零到 4 位
    arr編號.push(`T-${str代號}-${String(int起始 + int序).padStart(4, '0')}`);
  }
  return arr編號;
}
