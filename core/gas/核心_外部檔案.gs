// ============================================================================
// 檔案名稱：核心_外部檔案.gs
// 所屬層級：平台核心／服務層
// 檔案版本：v1.3.0（2026-10-27）
//   v1.3.0：大車點名試算表登記時檢查格式（呼叫法會活動模組的 檢查大車點名試算表格式_）
//   v1.2.0：列出外部檔案多傳回檔名與分頁名稱，畫面可顯示目前登記的檔案
//   v1.1.0：登記時可指定分頁名稱，並記下實際使用的分頁（學員名冊格式由各精舍自訂）
//   v1.0.0：初版
// 用途說明：
//   精舍自有、需共享給系統帳號的檔案（學員名冊、大車點名試算表），
//   由精舍管理員在畫面上登記到精舍設定的「外部檔案」分頁。
//   登記時會先開檔檢查：檔案要已共享給 ctw.cloud.service，格式也要正確。
// 相依檔案：核心_錯誤、核心_試算表存取、核心_結構定義、核心_租戶解析、
//           核心_權限、核心_日誌、核心_學員名冊
// ============================================================================


// ----------------------------------------------------------------------------
// 可登記的外部檔案項目：項目名稱 → { 說明, 檢查函式 }
// 檢查函式收到（已開啟的試算表, 指定分頁名稱），格式不對時丟出平台錯誤；
// 傳回 { str訊息, str分頁名稱 }。
// 大車點名試算表的格式檢查由法會活動模組提供（檢查大車點名試算表格式_）。
// ----------------------------------------------------------------------------
const obj外部檔案項目 = Object.freeze({
  學員名冊: {
    str說明: '學員基本資料（唯讀，請以「檢視者」共享給系統帳號）。格式自訂，但第 1 列一定要有「學員編號」「姓名」「法名」三個標題',
    fn檢查: function (obj試算表, str指定分頁) {
      const obj結果 = 檢查學員名冊結構(obj試算表, str指定分頁);
      return {
        str訊息: `使用「${obj結果.str分頁名稱}」分頁，共 ${obj結果.int學員數} 位學員。`,
        str分頁名稱: obj結果.str分頁名稱
      };
    }
  },
  大車點名試算表: {
    str說明: '大車點名系統（請以「編輯者」共享給系統帳號）。必須有「活動配置」分頁，且含「活動名稱」「大車名單工作表」「報到紀錄工作表」「狀態」欄',
    fn檢查: function (obj試算表, str指定分頁) {
      // 格式規則由法會活動模組提供（法會_大車匯出.gs）；模組尚未部署時只確認可以開啟
      if (typeof 檢查大車點名試算表格式_ === 'function') {
        return { str訊息: 檢查大車點名試算表格式_(obj試算表).str訊息, str分頁名稱: str指定分頁 || '' };
      }
      return { str訊息: '已可開啟。', str分頁名稱: str指定分頁 || '' };
    }
  }
});

const str外部檔案管理權限 = '平台.管理外部檔案';


/**
 * ============================================================================
 * 函式名稱：解析檔案代號
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   使用者可以貼整個試算表網址或只貼檔案代號，這裡統一取出檔案代號。
 *   例：https://docs.google.com/spreadsheets/d/1AbC…xyz/edit#gid=0 → 1AbC…xyz
 *
 * 參數：
 *   str輸入   {string} 網址或檔案代號
 *
 * 傳回：{string} 檔案代號
 * ============================================================================
 */
function 解析檔案代號(str輸入) {
  const str值 = String(str輸入 || '').trim();

  // 網址：取 /d/ 後面那一段
  const arr比對 = str值.match(/\/d\/([a-zA-Z0-9_-]+)/);
  if (arr比對) return arr比對[1];

  // 只有代號：檢查字元是否合理
  if (/^[a-zA-Z0-9_-]{20,}$/.test(str值)) return str值;

  throw new 平台錯誤(
    obj錯誤代碼.參數錯誤,
    '看不出這是哪個檔案。請貼上試算表的完整網址（瀏覽器網址列上那一串）。'
  );
}


/**
 * ============================================================================
 * 函式名稱：列出外部檔案
 * 版本：v1.1.0（2026-10-25）
 *   v1.1.0：多傳回 str檔名（登記時的試算表名稱）、str分頁名稱
 * ----------------------------------------------------------------------------
 * 用途：精舍設定頁顯示各外部檔案是否已登記、登記的是哪個檔案與分頁。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} 不需要
 *
 * 傳回：
 *   {Object} { bool成功, arr項目: [ { str項目, str說明, bool已登記, str檔案網址,
 *                                     str檔名, str分頁名稱 } ] }
 *   ※ 檔名是登記當時的名稱；之後在雲端硬碟改名，要重新登記才會更新。
 * ============================================================================
 */
function 列出外部檔案(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str外部檔案管理權限, '查看外部檔案');

  // 讀「項目、檔案ID、說明」三個原有欄位；「分頁名稱」是 v1.3.0 結構才加的，
  // 舊版精舍設定可能還沒有，另外查欄號，沒有就當空白
  const obj定義 = obj精舍設定結構.外部檔案;
  const obj分頁 = 取得工作表(取得精舍設定試算表(obj工作階段.str精舍代號), obj定義.str分頁);
  const arr登記 = 讀取全部資料列(obj分頁, ['項目', '檔案ID', '說明']);
  const int分頁欄 = 查找欄號(取得欄位對照(obj分頁), '分頁名稱');

  const arr項目 = Object.keys(obj外部檔案項目).map(function (str項目) {
    const arr符合 = arr登記.filter(function (obj列) {
      return String(obj列.obj值['項目']).trim() === str項目 && String(obj列.obj值['檔案ID']).trim() !== '';
    });
    const obj列 = arr符合.length > 0 ? arr符合[0] : null;
    const str檔案ID = obj列 ? String(obj列.obj值['檔案ID']).trim() : '';
    // 分頁名稱：欄位存在才讀
    const str分頁名稱 = (obj列 && int分頁欄 > 0)
      ? String(obj分頁.getRange(obj列.int列號, int分頁欄).getValue() || '').trim()
      : '';
    return {
      str項目: str項目,
      str說明: obj外部檔案項目[str項目].str說明,
      bool已登記: str檔案ID !== '',
      str檔案網址: str檔案ID ? `https://docs.google.com/spreadsheets/d/${str檔案ID}/edit` : '',
      str檔名: obj列 ? String(obj列.obj值['說明'] || '').trim() : '',   // 登記時寫入的試算表名稱
      str分頁名稱: str分頁名稱
    };
  });

  return { bool成功: true, arr項目: arr項目 };
}


/**
 * ============================================================================
 * 函式名稱：登記外部檔案
 * 版本：v1.0.0（2026-10-25）
 * ----------------------------------------------------------------------------
 * 用途：
 *   登記或更換外部檔案。先開檔並檢查格式，通過才寫入，避免登記錯檔案。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str項目: '學員名冊', str檔案: 網址或檔案代號,
 *                            str分頁名稱（選填：有多個分頁符合時指定） }
 *
 * 傳回：{Object} { bool成功, str訊息, str分頁名稱 }
 * ============================================================================
 */
function 登記外部檔案(obj工作階段, obj參數) {
  檢查權限(obj工作階段, str外部檔案管理權限, '登記外部檔案');
  檢查必要參數(obj參數, ['str項目', 'str檔案'], '登記外部檔案');

  const str項目 = String(obj參數.str項目).trim();
  const obj項目 = obj外部檔案項目[str項目];
  if (!obj項目) {
    throw new 平台錯誤(
      obj錯誤代碼.參數錯誤,
      `「${str項目}」不是可登記的項目。可登記：${Object.keys(obj外部檔案項目).join('、')}。`
    );
  }

  // 開檔（沒共享時會說明原因）並檢查格式
  const str檔案ID = 解析檔案代號(obj參數.str檔案);
  const obj試算表 = 開啟試算表(str檔案ID, str項目);
  const obj檢查 = obj項目.fn檢查(obj試算表, obj參數.str分頁名稱 ? String(obj參數.str分頁名稱).trim() : '');

  // 寫入：已有就更新，沒有就新增
  const str精舍代號 = obj工作階段.str精舍代號;
  執行並鎖定(function () {
    const obj定義 = obj精舍設定結構.外部檔案;
    // 先補齊分頁結構（舊版精舍設定沒有「分頁名稱」欄時自動補上）
    const obj分頁 = 建立結構分頁(取得精舍設定試算表(str精舍代號), obj定義);
    const arr既有 = 依條件尋找資料列(obj分頁, ['項目'], function (obj值) {
      return String(obj值['項目']).trim() === str項目;
    });
    const obj內容 = { '項目': str項目, '檔案ID': str檔案ID, '分頁名稱': obj檢查.str分頁名稱, '說明': obj試算表.getName() };
    if (arr既有.length > 0) {
      更新資料列(obj分頁, arr既有[0].int列號, obj內容);
    } else {
      新增資料列(obj分頁, obj內容);
    }
  }, '登記外部檔案');

  // 名冊已更換：清除本次執行的名冊快取
  if (typeof obj學員名冊快取_ !== 'undefined') delete obj學員名冊快取_[str精舍代號];

  寫入操作日誌(obj工作階段, '登記外部檔案', `${str項目}：${obj試算表.getName()}（${obj檢查.str分頁名稱 || '未指定分頁'}）`);
  return {
    bool成功: true,
    str訊息: `已登記「${str項目}」：${obj試算表.getName()}。${obj檢查.str訊息}`,
    str分頁名稱: obj檢查.str分頁名稱
  };
}
