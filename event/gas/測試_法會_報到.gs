// ============================================================================
// 檔案名稱：測試_法會_報到.gs
// 所屬模組：法會活動（event）
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.1.0（2026-11-07）　v1.1.0：取消參加、場次取消、取消活動路由（9 項）
// 用途說明：
//   在 Apps Script 編輯器執行：
//     · 測試_法會_報到純邏輯（數秒）：目前時段判斷、人員鍵、報到狀態（最後一筆為準、取消、現場報到者）、
//       報名狀態、刷碼比對（名冊編號、學員名冊同姓名、查不到）、表格資料（排序、現場區、人數）、
//       時段序檢查、報到方式、路由。不碰任何檔案。
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：測試_法會_報到純邏輯
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：自動測試不碰檔案的報到規則（本機模擬與 GAS 編輯器皆可執行）。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_報到純邏輯() {
  const t = 建立法會測試記錄器_();
  const arr時段 = 解析時段設定_('第一支香 14:00-14:40；第二支香 14:50-15:30；第三支香 15:40-16:20');
  const fn分 = function (h, m) { return h * 60 + m; };

  // ── 一、目前時段（決策 AA） ──
  t.記錄('時段：開始前 → 第一', 判斷目前時段_(arr時段, fn分(13, 30)) === 0);
  t.記錄('時段：第一時段內 → 第一', 判斷目前時段_(arr時段, fn分(14, 20)) === 0);
  t.記錄('時段：兩個時段之間 → 下一個', 判斷目前時段_(arr時段, fn分(14, 45)) === 1);
  t.記錄('時段：剛好結束時 → 下一個', 判斷目前時段_(arr時段, fn分(14, 40)) === 1);
  t.記錄('時段：最後一個結束後 → 最後一個', 判斷目前時段_(arr時段, fn分(17, 0)) === 2);
  t.記錄('時段：不分時段 → 0', 判斷目前時段_([], fn分(9, 0)) === 0);

  // ── 二、人員鍵 ──
  t.記錄('人員鍵：有編號用編號', 取得人員鍵_(' P0001 ', '王冠羣') === 'P0001');
  t.記錄('人員鍵：沒有編號用姓名', 取得人員鍵_('', ' 王冠羣 ') === 'N:王冠羣');

  // ── 三、報到狀態（最後一筆為準） ──
  const fn紀錄 = function (str鍵, int時段, str動作, str時間, str場次, str姓名) {
    return { '場次': str場次 || 'S1', '人員鍵': str鍵, '時段序': int時段, '動作': str動作 || '報到', '報到時間': str時間 || '13:50',
      '報到方式': '表格', '姓名': str姓名 || '', '學員編號': '', '法名': '' };
  };
  const arr紀錄 = [
    fn紀錄('P0001', 0, '報到', '13:50'), fn紀錄('P0001', 0, '報到', '13:51'),       // 重複
    fn紀錄('P0002', 0, '報到', '13:52'), fn紀錄('P0002', 0, '取消報到', '13:53'),    // 取消
    fn紀錄('P0003', 1, '報到', '14:45'), fn紀錄('P0003', 1, '取消報到'), fn紀錄('P0003', 1, '報到', '14:47'),   // 取消後再報到
    fn紀錄('T-1', 0, '報到', '13:55', 'S1', '現場甲'),
    fn紀錄('P0001', 0, '取消報到', '', 'S2')                                         // 別的場次
  ];
  const obj狀態 = 計算報到狀態_(arr紀錄, 'S1');
  t.記錄('狀態：已報到、重複記錄只算一格', obj狀態.obj格['P0001'][0] && obj狀態.obj格['P0001'][0].str時間 === '13:51');
  t.記錄('狀態：取消後沒有勾', !obj狀態.obj格['P0002'][0]);
  t.記錄('狀態：取消後再報到＝已報到', obj狀態.obj格['P0003'][1].str時間 === '14:47');
  t.記錄('狀態：別的場次不影響', obj狀態.int紀錄數 === 8);
  t.記錄('狀態：紀錄中出現的人（含現場）', obj狀態.obj人員['T-1'].str姓名 === '現場甲' && obj狀態.obj人員['T-1'].int首次序 === 7);

  // ── 四、報名狀態 ──
  t.記錄('報名狀態：報了這個時段', 判斷報名狀態_({ arr報名序: [0, 1] }, 1) === '已報名');
  t.記錄('報名狀態：沒報這個時段', 判斷報名狀態_({ arr報名序: [0] }, 2) === '未報名（本時段）');
  t.記錄('報名狀態：名冊沒有', 判斷報名狀態_(null, 0) === '未報名');
  t.記錄('報名狀態：報名內容對不到時段時視為已報名', 判斷報名狀態_({ arr報名序: [] }, 1) === '已報名');

  // ── 五、刷碼比對（決策 R） ──
  const arr名冊 = [
    { str鍵: 'P0001', str學員編號: 'P0001', str姓名: '王冠羣', str法名: '傳塵', arr報名序: [0, 1, 2] },
    { str鍵: 'T-PUCHUAN-0003', str學員編號: 'T-PUCHUAN-0003', str姓名: '呂佳純', str法名: '法城', arr報名序: [0, 1] },
    { str鍵: 'N:蔡聿書', str學員編號: '', str姓名: '蔡聿書', str法名: '', arr報名序: [0] }
  ];
  const obj甲 = 比對報到人員_('p0001', arr名冊, null);
  t.記錄('刷碼：名冊編號相同（大小寫不拘）', obj甲.obj名冊人員 && obj甲.str鍵 === 'P0001', JSON.stringify(obj甲.str鍵));
  const obj乙 = 比對報到人員_('P0099', arr名冊, { str學員編號: 'P0099', str姓名: '呂佳純', str法名: '法城' });
  t.記錄('刷碼：正式學員證、名冊是臨時編號 → 依姓名對到名冊那一列', obj乙.obj名冊人員 && obj乙.str鍵 === 'T-PUCHUAN-0003');
  const obj丙 = 比對報到人員_('P0100', arr名冊, { str學員編號: 'P0100', str姓名: '林小明', str法名: '' });
  t.記錄('刷碼：學員名冊有、名冊沒有 → 未報名、帶姓名', !obj丙.obj名冊人員 && obj丙.str姓名 === '林小明' && obj丙.str鍵 === 'P0100' && !obj丙.bool待補姓名);
  const obj丁 = 比對報到人員_('X9999', arr名冊, null);
  t.記錄('刷碼：都查不到 → 姓名空白、待補姓名', !obj丁.obj名冊人員 && obj丁.str姓名 === '' && obj丁.bool待補姓名 && obj丁.str鍵 === 'X9999');

  // ── 六、表格資料 ──
  const obj表 = 組合報到表格資料_([
    { str姓名: '蔡聿書', str法名: '', str學員編號: '', arr報名序: [0], str報名登記: '14:00-14:40', str提醒: '' },
    { str姓名: '王冠羣', str法名: '傳塵', str學員編號: 'P0001', arr報名序: [0, 1, 2], str報名登記: '全部時段', str提醒: '備註提到取消' }
  ], arr時段, 計算報到狀態_([
    fn紀錄('P0001', 0), fn紀錄('N:蔡聿書', 0), fn紀錄('N:蔡聿書', 1),
    fn紀錄('T-2', 1, '報到', '14:50', 'S1', '現場乙'), fn紀錄('T-1', 0, '報到', '13:40', 'S1', '現場甲')
  ], 'S1'));
  t.記錄('表格：排序同紙本（全部時段在前）、序號', obj表.arr列[0].str姓名 === '王冠羣' && obj表.arr列[0].int序號 === 1 && obj表.arr列[1].str姓名 === '蔡聿書');
  t.記錄('表格：沒有編號的人用姓名鍵', obj表.arr列[1].str鍵 === 'N:蔡聿書' && !!obj表.arr列[1].obj勾[1]);
  t.記錄('表格：現場報到區依第一次報到先後', obj表.arr列[2].bool現場 && obj表.arr列[2].str姓名 === '現場乙' && obj表.arr列[3].str姓名 === '現場甲' && obj表.arr列[3].int序號 === 4);
  t.記錄('表格：提醒簡稱', obj表.arr列[0].str提醒 === '取消？');
  t.記錄('表格：各時段報名／已到人數', JSON.stringify(obj表.arr人數.map(function (o) { return [o.int報名, o.int已到]; })) === '[[2,3],[1,2],[1,0]]',
    JSON.stringify(obj表.arr人數));
  const obj單 = 組合報到表格資料_([{ str姓名: '甲', str法名: '', str學員編號: 'A1', arr報名序: [0], str報名登記: '參加', str提醒: '' }], [], 計算報到狀態_([], 'S1'));
  t.記錄('表格：不分時段只有一欄「報到」', obj單.arr人數.length === 1 && obj單.arr人數[0].str名稱 === '報到' && obj單.arr人數[0].int報名 === 1);

  // ── 七、檢查 ──
  t.記錄('時段序：範圍內', 檢查報到時段序_(2, arr時段) === 2 && 檢查報到時段序_('1', arr時段) === 1);
  t.預期錯誤('時段序：超出範圍', obj錯誤代碼.參數錯誤, function () { 檢查報到時段序_(3, arr時段); });
  t.預期錯誤('時段序：不分時段只能是 0', obj錯誤代碼.參數錯誤, function () { 檢查報到時段序_(1, []); });
  t.預期錯誤('姓名：空白', obj錯誤代碼.參數錯誤, function () { 檢查報到姓名_('  '); });
  t.記錄('報到方式：志工只能表格／搜尋姓名／臨時', 決定報到方式_({ bool志工: true, str預設方式: '表格' }, '紙本') === '表格'
    && 決定報到方式_({ bool志工: true, str預設方式: '表格' }, '搜尋姓名') === '搜尋姓名');
  t.記錄('報到方式：補登預設紙本、可改表格', 決定報到方式_({ bool志工: false, str預設方式: '紙本' }, '') === '紙本'
    && 決定報到方式_({ bool志工: false, str預設方式: '紙本' }, '表格') === '表格' && 決定報到方式_({ bool志工: false, str預設方式: '紙本' }, '刷碼') === '紙本');

  // ── 七之一、取消（v1.1.0） ──
  const fn紀 = function (str鍵, str動作, str時段名, int時段序, str備註) {
    return { '場次': 'S1', '人員鍵': str鍵, '動作': str動作, '時段': str時段名 || '', '時段序': int時段序 || 0, '報到時間': '2026-11-15 14:05', '報到人員': '志工甲', '備註': str備註 || '' };
  };
  const obj取 = 計算報到狀態_([fn紀('A1', '取消參加', '', 0, '生病'), fn紀('B2', '取消參加'), fn紀('B2', '恢復參加'), fn紀('A1', '報到', '第一支香', 0)], 'S1');
  t.記錄('取消參加：最後一筆為準（B2 恢復後不算）', !!obj取.obj取消參加['A1'] && !obj取.obj取消參加['B2'] && obj取.obj取消參加['A1'].str原因 === '生病');
  t.記錄('取消參加：不影響報到格、紀錄數照算', !!obj取.obj格['A1'][0] && !obj取.obj格['B2'] && obj取.int紀錄數 === 4);
  const obj現 = 計算報到狀態_([fn紀('N:路人', '取消參加')], 'S1');
  t.記錄('只有取消參加紀錄的人不列入現場報到者', !obj現.obj人員['N:路人']);
  const obj場 = 計算報到狀態_([fn紀('＊', '場次取消', '', 0, '颱風')], 'S1');
  t.記錄('場次取消：記原因、人員', obj場.obj場次取消 && obj場.obj場次取消.str原因 === '颱風' && obj場.obj場次取消.str人員 === '志工甲' && !obj場.obj人員['＊']);
  t.記錄('場次恢復：取消失效', 計算報到狀態_([fn紀('＊', '場次取消'), fn紀('＊', '場次恢復')], 'S1').obj場次取消 === null);
  t.記錄('場次取消說明：白話', 組合場次取消說明_('S1', { str原因: '颱風', str時間: '13:00', str人員: '甸' }) === '場次「S1」已取消（颱風，13:00 甸）');
  const obj表取 = 組合報到表格資料_([
    { str姓名: '甲', str法名: '', str學員編號: 'A1', arr報名序: [0, 1], str報名登記: '', str提醒: '' },
    { str姓名: '乙', str法名: '', str學員編號: 'B2', arr報名序: [1], str報名登記: '', str提醒: '' }
  ], arr時段, 計算報到狀態_([fn紀('B2', '取消參加'), fn紀('A1', '取消參加')], 'S1'));
  t.記錄('表格：每列帶取消參加、各時段取消參加人數（只算報了該時段的人）',
    obj表取.int取消參加 === 2 && obj表取.arr列.every(function (o) { return !!o.obj取消參加; })
    && obj表取.arr人數[0].int取消參加 === 1 && obj表取.arr人數[1].int取消參加 === 2, JSON.stringify(obj表取.arr人數));
  t.記錄('取消原因：合併空白、限長度', 整理取消原因_('  颱風   停課 ') === '颱風 停課' && 整理取消原因_('字'.repeat(80)).length === obj報到格式.int原因最長);

  // ── 八、路由 ──
  const obj路由 = 路由定義_event();
  t.記錄('路由：報到碼登入不需登入', obj路由['event.報到碼登入'] && obj路由['event.報到碼登入'].bool需登入 === false);
  t.記錄('狀態：結束與取消都算停止', arr法會停止狀態.indexOf('結束') !== -1 && arr法會停止狀態.indexOf(obj法會活動狀態.取消) !== -1 && arr法會可同步狀態.indexOf('取消') === -1);
  t.記錄('路由：報到動作需登入', ['event.開放報到', 'event.暫停報到', 'event.更換報到碼', 'event.報到資訊', 'event.讀取報到表格', 'event.讀取報到異動',
    'event.表格報到', 'event.刷碼報到', 'event.查詢報到人員', 'event.新增現場報到', 'event.讀取時段', 'event.儲存時段', 'event.列印報到表',
    'event.取消參加', 'event.取消場次', 'event.取消活動']
    .every(function (k) { return obj路由[k] && typeof obj路由[k].fn === 'function' && obj路由[k].bool需登入 !== false; }));
  t.記錄('權限：報到志工只能做 event.報到', 是否具備權限({ str角色: obj角色.報到志工, arr權限: [obj法會權限.報到] }, obj法會權限.報到)
    && !是否具備權限({ str角色: obj角色.報到志工, arr權限: [obj法會權限.報到] }, obj法會權限.整理資料));

  return t.結算();
}
