// ============================================================================

/**
 * ============================================================================
 * 函式名稱：預覽補齊副本活動類型
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：在 GAS 編輯器執行。列出每個副本目前的活動類型標記狀態，不改任何資料。
 * 參數：無
 * 傳回：{Object} 見 處理副本活動類型_
 * ============================================================================
 */
function 預覽補齊副本活動類型() {
  return 處理副本活動類型_(false);
}


/**
 * ============================================================================
 * 函式名稱：補齊副本活動類型
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   在 GAS 編輯器執行。替所有精舍、所有法會活動的整理副本寫入「法會活動類型」標記
 *   （值取自主控台活動清單的「活動類型」）。可重複執行：已正確的副本不會變動。
 *   副本較多、超過約 5 分鐘時會先停下，執行記錄會提醒再執行一次（已補上的會被略過）。
 * 參數：無
 * 傳回：{Object} 見 處理副本活動類型_
 * ============================================================================
 */
function 補齊副本活動類型() {
  return 處理副本活動類型_(true);
}


/**
 * ============================================================================
 * 函式名稱：處理副本活動類型_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   預覽與執行共用：
 *     ① 讀系統主控「精舍清單」，逐一開啟精舍的法會活動主控台（沒開通法會活動的精舍略過）
 *     ② 逐一檢查活動清單中每場活動的副本：
 *          · 沒有副本ID → 略過
 *          · 活動類型不是對內／對外 → 列為問題（請在主控台更正後再執行）
 *          · 副本打不開（被刪除、未共享給系統帳號）→ 列為問題
 *          · 預覽：只回報「已正確／需補上／需更正」；執行：寫入標記
 *     ③ 接近 GAS 時間上限時停下，提醒再執行一次
 *   單一副本或單一精舍出錯不影響其他，最後一併列出。
 * 參數：
 *   bool執行   {boolean} false＝預覽（不改資料）；true＝寫入標記
 * 傳回：{Object} { int已正確, int已補上, int已更正, int略過, arr問題: string[], bool未完成 }
 * ============================================================================
 */
function 處理副本活動類型_(bool執行) {
  const obj統計 = { int已正確: 0, int已補上: 0, int已更正: 0, int略過: 0, arr問題: [], bool未完成: false };
  const arr記錄 = [bool執行 ? '【補齊副本活動類型】' : '【預覽補齊副本活動類型，沒有改任何資料】'];
  const obj計時 = 建立計時器_();
  const str鍵 = obj法會設定.str副本類型鍵;

  // ① 所有精舍
  const obj定義 = obj系統主控結構.精舍清單;
  const arr精舍 = 讀取全部資料列(取得工作表(取得系統主控(), obj定義.str分頁), obj定義.arr欄位);

  for (let i = 0; i < arr精舍.length && !obj統計.bool未完成; i++) {
    const str精舍代號 = 正規化精舍代號(arr精舍[i].obj值['精舍代號']);
    if (str精舍代號 === '') continue;
    const str精舍 = `${str精舍代號} ${String(arr精舍[i].obj值['精舍名稱'] || '').trim()}`;

    // 沒開通法會活動（或主控台打不開）→ 略過此精舍
    let arr活動;
    try {
      arr活動 = 讀取法會活動清單_(開啟法會主控台_(str精舍代號));
    } catch (err) {
      arr記錄.push(`・${str精舍}：略過（${err && err.message ? err.message : err}）`);
      continue;
    }
    arr記錄.push(`■ ${str精舍}：${arr活動.length} 場活動`);
    let int本精舍變動 = 0;

    // ② 逐場活動
    for (let j = 0; j < arr活動.length; j++) {
      if (obj計時.bool已逾時()) { obj統計.bool未完成 = true; break; }
      const obj值 = arr活動[j].obj值;
      const str活動 = `${String(obj值['活動ID']).trim()} ${String(obj值['活動名稱']).trim()}`;
      const str副本ID = String(obj值['副本ID'] || '').trim();
      const str類型 = String(obj值['活動類型'] || '').trim();
      if (str副本ID === '') { obj統計.int略過 += 1; arr記錄.push(`　・${str活動}：沒有副本，略過`); continue; }
      if (str類型 !== obj法會活動類型.對內 && str類型 !== obj法會活動類型.對外) {
        obj統計.arr問題.push(`${str精舍} ${str活動}：活動類型「${str類型}」不是對內或對外`);
        arr記錄.push(`　✘ ${str活動}：活動類型「${str類型}」不是對內或對外，請在主控台更正後再執行`);
        continue;
      }
      try {
        const obj副本 = 開啟試算表(str副本ID, `「${String(obj值['活動名稱']).trim()}」的整理副本`);
        if (bool執行) {
          const str結果 = 標記副本活動類型_(obj副本, str類型);
          if (str結果 === '已正確') obj統計.int已正確 += 1;
          if (str結果 === '已補上') { obj統計.int已補上 += 1; int本精舍變動 += 1; }
          if (str結果 === '已更正') { obj統計.int已更正 += 1; int本精舍變動 += 1; }
          arr記錄.push(`　${str結果 === '已正確' ? '・' : '✔'} ${str活動}（${str類型}）：${str結果}`);
        } else {
          // 預覽：只讀標記
          const arr既有 = obj副本.createDeveloperMetadataFinder().withKey(str鍵).find();
          let str狀態 = '需補上';
          if (arr既有.length === 1 && arr既有[0].getValue() === str類型) str狀態 = '已正確';
          else if (arr既有.length > 0) str狀態 = `需更正（目前：${arr既有.map(function (o) { return o.getValue(); }).join('、')}）`;
          if (str狀態 === '已正確') obj統計.int已正確 += 1;
          else if (str狀態 === '需補上') obj統計.int已補上 += 1;
          else obj統計.int已更正 += 1;
          arr記錄.push(`　${str狀態 === '已正確' ? '・' : '→'} ${str活動}（${str類型}）：${str狀態}`);
        }
      } catch (err) {
        const str原因 = err && err.message ? err.message : String(err);
        obj統計.arr問題.push(`${str精舍} ${str活動}：${str原因}`);
        arr記錄.push(`　✘ ${str活動}：${str原因}`);
      }
    }
    if (bool執行 && int本精舍變動 > 0) {
      寫入操作日誌(null, '補齊副本活動類型', `${int本精舍變動} 份副本補上或更正活動類型標記`, str精舍代號);
    }
  }

  // ③ 總結
  const str動詞 = bool執行 ? ['已補上', '已更正'] : ['需補上', '需更正'];
  arr記錄.push(`==== ${bool執行 ? '完成' : '預覽完成'}：已正確 ${obj統計.int已正確} 份、${str動詞[0]} ${obj統計.int已補上} 份、`
    + `${str動詞[1]} ${obj統計.int已更正} 份、沒有副本 ${obj統計.int略過} 場、問題 ${obj統計.arr問題.length} 件 ====`);
  if (obj統計.bool未完成) arr記錄.push('⚠ 副本較多，已接近執行時間上限而先停下，請再執行一次（已處理的會被略過）。');
  if (!bool執行 && obj統計.int已補上 + obj統計.int已更正 > 0) arr記錄.push('確認無誤後，請執行「補齊副本活動類型」。');
  if (bool執行 && obj統計.int已補上 + obj統計.int已更正 > 0) arr記錄.push('已補上的副本，承辦人重新開啟（或重新整理）後選單就會依活動類型顯示。');
  console.log(arr記錄.join('\n'));
  return obj統計;
}
