// ============================================================================
// 檔案名稱：法會_維護工具.gs
// 所屬模組：法會活動（event）
// 所屬層級：模組／維護（只在 GAS 編輯器由系統管理員執行，不提供網頁動作）
// 檔案版本：v1.0.0（2026-10-27）
// 用途說明：
//   測試結束、要改用正式報名資料時，把某個精舍的法會活動資料「歸零」：
//     ① 精舍資料夾「法會活動副本」中由系統建立的整理副本 → 移到系統帳號的垃圾桶（30 天內可還原）
//     ② 法會活動主控台「活動清單」「已同步紀錄」「修改提醒」→ 清空資料列（保留標題）
//     ③ 精舍設定「副本清單」中法會活動的列 → 刪除（其他模組的列保留）
//     ④ 精舍設定「流水號」的「法會活動」→ 歸零，下一場活動從 A0001 開始
//   不會動到：Google 表單與回覆試算表（屬於精舍自己的檔案，請自行刪除）、
//             大車點名試算表、精舍設定的人員與權限、模組開通狀態、操作日誌。
//
// 使用方式（GAS 編輯器）：
//   1. 把下方 str重置精舍代號 改成要重置的精舍代號（例如 PUCHUAN）
//   2. 執行「預覽重置法會資料」→ 看執行記錄列出的活動與副本，確認無誤
//   3. 把 str重置確認文字 改成「確定重置」→ 執行「執行重置法會資料」
//   4. 完成後把 str重置確認文字 改回空字串，避免日後誤按
//
//   安全措施：
//     · 有活動曾匯出到大車點名試算表時拒絕執行（請先在網頁「清除點名資料」）
//     · 有人正在同步或整理（活動作業鎖）時拒絕執行
//     · 預覽不改任何資料；執行時必須填確認文字
//
// 相依檔案：平台核心、法會_模組定義
// ============================================================================


// ----------------------------------------------------------------------------
// 執行前設定（只在本檔使用）
// ----------------------------------------------------------------------------
const str重置精舍代號 = 'PUCHUAN';     // 要重置的精舍代號
const str重置確認文字 = '';            // 要真的執行時改成「確定重置」，用完改回空字串


/**
 * ============================================================================
 * 函式名稱：盤點法會資料_（內部使用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：讀出要重置的內容（不改資料），預覽與執行共用。
 * 參數：
 *   str精舍代號   {string}
 * 傳回：{Object} {
 *   obj主控台, arr活動: [ { str活動ID, str活動名稱, str活動狀態, str副本ID, bool有匯出 } ],
 *   int同步紀錄數, int提醒數, int副本清單列數, int流水號目前值 }
 * ============================================================================
 */
function 盤點法會資料_(str精舍代號) {
  const obj主控台 = 開啟法會主控台_(str精舍代號);

  // 活動清單
  const arr活動 = 讀取法會活動清單_(obj主控台).map(function (obj列) {
    return {
      str活動ID: String(obj列.obj值['活動ID']).trim(),
      str活動名稱: String(obj列.obj值['活動名稱']).trim(),
      str活動狀態: String(obj列.obj值['活動狀態']).trim(),
      str副本ID: String(obj列.obj值['副本ID'] || '').trim(),
      bool有匯出: String(obj列.obj值['匯出試算表ID'] || '').trim() !== ''
    };
  });

  // 已同步紀錄、修改提醒的資料列數（標題列不算）
  const fn資料列數 = function (str結構鍵) {
    return Math.max(取得法會分頁_(obj主控台, str結構鍵).obj分頁.getLastRow() - 1, 0);
  };

  // 副本清單中法會活動的列
  const obj清單 = 讀取精舍副本清單_(str精舍代號);
  const int副本清單列數 = obj清單.arr列.filter(function (arr) {
    return String(arr[obj清單.int模組欄]).trim() === obj法會設定.str模組代號;
  }).length;

  // 流水號目前值
  const obj流水 = obj精舍設定結構.流水號;
  const arr流水 = 依條件尋找資料列(取得工作表(取得精舍設定試算表(str精舍代號), obj流水.str分頁), obj流水.arr欄位,
    function (obj值) { return String(obj值['名稱']).trim() === obj法會設定.str活動流水號名稱; });

  return {
    obj主控台: obj主控台,
    arr活動: arr活動,
    int同步紀錄數: fn資料列數('已同步紀錄'),
    int提醒數: fn資料列數('修改提醒'),
    int副本清單列數: int副本清單列數,
    int流水號目前值: arr流水.length > 0 ? (Number(arr流水[0].obj值['目前值']) || 0) : 0
  };
}


/**
 * ============================================================================
 * 函式名稱：讀取精舍副本清單_（內部使用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：讀精舍設定「副本清單」全部資料列（原始值），並找出「模組代號」欄的位置。
 * 參數：str精舍代號 {string}
 * 傳回：{Object} { obj分頁, int欄數, int模組欄（0 起算）, arr列: Array[] }
 * ============================================================================
 */
function 讀取精舍副本清單_(str精舍代號) {
  const obj分頁 = 取得工作表(取得精舍設定試算表(str精舍代號), obj精舍設定結構.副本清單.str分頁);
  const int欄數 = Math.max(obj分頁.getLastColumn(), 1);
  const arr標題 = obj分頁.getRange(1, 1, 1, int欄數).getValues()[0].map(function (v) { return String(v).trim(); });
  const int模組欄 = arr標題.indexOf('模組代號');
  if (int模組欄 < 0) {
    throw new 平台錯誤(obj錯誤代碼.欄位缺漏, '精舍設定「副本清單」找不到「模組代號」欄，請通知系統管理員。');
  }
  const int最後列 = obj分頁.getLastRow();
  const arr列 = int最後列 >= 2 ? obj分頁.getRange(2, 1, int最後列 - 1, int欄數).getValues() : [];
  return { obj分頁: obj分頁, int欄數: int欄數, int模組欄: int模組欄, arr列: arr列 };
}


/**
 * ============================================================================
 * 函式名稱：清空資料列_（內部使用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：清除分頁第 2 列以後的內容（保留標題列與欄寬格式）。
 *       用清除內容而不是刪列：Google 試算表不允許刪光所有非凍結列。
 * 參數：obj分頁 {Sheet}
 * 傳回：{number} 清除的列數
 * ============================================================================
 */
function 清空資料列_(obj分頁) {
  const int最後列 = obj分頁.getLastRow();
  if (int最後列 < 2) return 0;
  obj分頁.getRange(2, 1, int最後列 - 1, Math.max(obj分頁.getLastColumn(), 1)).clearContent();
  return int最後列 - 1;
}


/**
 * ============================================================================
 * 函式名稱：說明盤點結果_（內部使用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：把盤點結果整理成給人看的幾行文字。
 * 參數：str精舍代號 {string}；obj盤點 {Object}
 * 傳回：{string[]}
 * ============================================================================
 */
function 說明盤點結果_(str精舍代號, obj盤點) {
  const arr = [`精舍：${str精舍代號}`, `活動 ${obj盤點.arr活動.length} 場：`];
  obj盤點.arr活動.forEach(function (o) {
    arr.push(`  · ${o.str活動ID} ${o.str活動名稱}（${o.str活動狀態}）${o.str副本ID ? '，有整理副本' : ''}${o.bool有匯出 ? '，⚠ 曾匯出大車點名' : ''}`);
  });
  arr.push(`已同步紀錄 ${obj盤點.int同步紀錄數} 列、修改提醒 ${obj盤點.int提醒數} 列`);
  arr.push(`精舍設定「副本清單」中法會活動 ${obj盤點.int副本清單列數} 列`);
  arr.push(`活動流水號目前值 ${obj盤點.int流水號目前值}（重置後下一場為 ${obj法會設定.str活動ID前綴}0001）`);
  return arr;
}


/**
 * ============================================================================
 * 函式名稱：預覽重置法會資料
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：在 GAS 編輯器執行。列出將被清除的活動、副本與紀錄，不改任何資料。
 * 參數：無（精舍代號取本檔上方的 str重置精舍代號）
 * 傳回：{string[]} 說明文字
 * ============================================================================
 */
function 預覽重置法會資料() {
  const str精舍代號 = 正規化精舍代號(str重置精舍代號);
  const obj盤點 = 盤點法會資料_(str精舍代號);
  const arr說明 = ['【預覽，沒有改任何資料】'].concat(說明盤點結果_(str精舍代號, obj盤點));
  if (obj盤點.arr活動.some(function (o) { return o.bool有匯出; })) {
    arr說明.push('⚠ 有活動曾匯出到大車點名試算表：請先在法會活動頁把它設為結束並「清除點名資料」，才能重置。');
  }
  arr說明.push('確認無誤後，把本檔的 str重置確認文字 改成「確定重置」，再執行「執行重置法會資料」。');
  console.log(arr說明.join('\n'));
  return arr說明;
}


/**
 * ============================================================================
 * 函式名稱：執行重置法會資料
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：
 *   在 GAS 編輯器執行。必須先把 str重置確認文字 改成「確定重置」。
 *   步驟：檢查 → 整理副本移到垃圾桶 → （鎖定中）清空主控台三分頁、刪副本清單的法會列、流水號歸零 → 寫日誌。
 *   副本移到垃圾桶失敗（例如已被手動刪除）不中斷，最後一併列出。
 * 參數：無
 * 傳回：{string[]} 說明文字
 * ============================================================================
 */
function 執行重置法會資料() {
  return 重置法會資料_(str重置精舍代號, str重置確認文字);
}


/**
 * ============================================================================
 * 函式名稱：重置法會資料_（內部使用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：執行重置法會資料 的實際處理（分開寫，方便自動測試傳入測試精舍）。
 * 參數：str精舍代號輸入 {string}；str確認文字 {string} 必須是「確定重置」
 * 傳回：{string[]} 說明文字
 * ============================================================================
 */
function 重置法會資料_(str精舍代號輸入, str確認文字) {
  // ① 確認文字
  if (str確認文字 !== '確定重置') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤,
      '為避免誤按，請先執行「預覽重置法會資料」確認，再把本檔的 str重置確認文字 改成「確定重置」後執行。');
  }
  const str精舍代號 = 正規化精舍代號(str精舍代號輸入);
  const obj盤點 = 盤點法會資料_(str精舍代號);

  // ② 安全檢查：曾匯出大車點名、或有人正在作業
  const arr有匯出 = obj盤點.arr活動.filter(function (o) { return o.bool有匯出; });
  if (arr有匯出.length > 0) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤,
      `${arr有匯出.map(function (o) { return o.str活動名稱; }).join('、')} 曾匯出到大車點名試算表。` +
      '請先在法會活動頁設為結束並「清除點名資料」，再重置（否則點名試算表會留下無人管理的分頁）。');
  }
  const obj快取 = CacheService.getScriptCache();
  const arr作業中 = obj盤點.arr活動.filter(function (o) {
    return obj快取.get(`${str法會作業鎖前綴}${str精舍代號}_${o.str活動ID}`) !== null;
  });
  if (arr作業中.length > 0) {
    throw new 平台錯誤(obj錯誤代碼.系統忙碌,
      `${arr作業中.map(function (o) { return o.str活動名稱; }).join('、')} 目前有人正在同步或整理，請約 5 分鐘後再執行。`);
  }

  // ③ 整理副本移到垃圾桶（系統帳號是副本擁有者；移到垃圾桶 30 天內可從雲端硬碟還原）
  const arr明細 = [];
  obj盤點.arr活動.forEach(function (o) {
    if (!o.str副本ID) return;
    try {
      DriveApp.getFileById(o.str副本ID).setTrashed(true);
      arr明細.push(`✔ ${o.str活動ID} ${o.str活動名稱}：整理副本已移到垃圾桶`);
    } catch (err) {
      arr明細.push(`・${o.str活動ID} ${o.str活動名稱}：整理副本無法移到垃圾桶（可能已被刪除）：${err.message}`);
    }
  });

  // ④ 寫入的部分在鎖定中完成（很快，不會長時間佔用平台）
  執行並鎖定(function () {
    ['活動清單', '已同步紀錄', '修改提醒'].forEach(function (str鍵) {
      const int列數 = 清空資料列_(取得法會分頁_(obj盤點.obj主控台, str鍵).obj分頁);
      arr明細.push(`✔ 主控台「${str鍵}」清除 ${int列數} 列`);
    });

    // 副本清單：只留其他模組的列
    const obj清單 = 讀取精舍副本清單_(str精舍代號);
    const arr保留 = obj清單.arr列.filter(function (arr) {
      return String(arr[obj清單.int模組欄]).trim() !== obj法會設定.str模組代號
        && arr.join('').trim() !== '';
    });
    清空資料列_(obj清單.obj分頁);
    if (arr保留.length > 0) obj清單.obj分頁.getRange(2, 1, arr保留.length, obj清單.int欄數).setValues(arr保留);
    arr明細.push(`✔ 精舍設定「副本清單」刪除法會活動 ${obj清單.arr列.length - arr保留.length} 列，保留其他模組 ${arr保留.length} 列`);

    // 流水號歸零
    const obj流水 = obj精舍設定結構.流水號;
    const obj流水分頁 = 取得工作表(取得精舍設定試算表(str精舍代號), obj流水.str分頁);
    const arr流水 = 依條件尋找資料列(obj流水分頁, obj流水.arr欄位,
      function (obj值) { return String(obj值['名稱']).trim() === obj法會設定.str活動流水號名稱; });
    if (arr流水.length > 0) 更新資料列(obj流水分頁, arr流水[0].int列號, { '目前值': 0 });
    arr明細.push(`✔ 活動流水號歸零，下一場活動為 ${obj法會設定.str活動ID前綴}0001`);
  }, '重置法會資料');

  寫入操作日誌(null, '重置法會資料',
    `清除 ${obj盤點.arr活動.length} 場活動：${obj盤點.arr活動.map(function (o) { return o.str活動ID; }).join('、') || '（無）'}`, str精舍代號);

  const arr說明 = [`【已重置 ${str精舍代號} 的法會活動資料】`].concat(arr明細).concat([
    '請記得：① 把本檔 str重置確認文字 改回空字串 ② 自行刪除測試用的 Google 表單與回覆試算表 ③ 已登入的法會活動頁請重新整理'
  ]);
  console.log(arr說明.join('\n'));
  return arr說明;
}
