// ============================================================================
// 檔案名稱：測試_法會_報到表.gs
// 所屬模組：法會活動（event）
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.0.2（2026-11-07）　v1.0.2：全部時段一律「全部時段」
// 用途說明：
//   在 Apps Script 編輯器執行：
//     · 測試_法會_報到表純邏輯（數秒）：報到時段設定的解析與錯誤、報名內容的時段解析（上午／下午、全形符號）、
//       建議時段、對應報名時段、報名登記（三支香）、報到表排序（組別＋姓名筆畫）、補滿空白列、
//       提醒簡稱、民國日期、報到表內容（灰底、欄寬、字級）、名冊時段欄（報名登記、✓、標題順序）、列印網址。
//       不碰任何檔案。
//   測試資料取自精舍提供的紙本「普泉一支香點名表」（18 位報名者）與一支香表單的實際格內值。
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：測試_法會_報到表純邏輯
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：自動測試不碰檔案的報到時段與報到表計算規則（本機模擬與 GAS 編輯器皆可執行）。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_報到表純邏輯() {
  const t = 建立法會測試記錄器_();
  const str一支香 = '第一支香 14:00-14:40；第二支香 14:50-15:30；第三支香 15:40-16:20';
  const arr時段 = 解析時段設定_(str一支香);
  const str三支香_ = '下午2:00-2:40, 下午2:50-3:30, 下午3:40-4:20';
  const fn名 = function (arr) { return arr.map(function (o) { return `${o.str名稱} ${o.str起迄}`; }).join('|'); };

  // ── 一、報到時段設定 ──
  t.記錄('設定：一支香三個時段', fn名(arr時段) === '第一支香 14:00-14:40|第二支香 14:50-15:30|第三支香 15:40-16:20', fn名(arr時段));
  t.記錄('設定：分鐘數', arr時段[0].int起 === 840 && arr時段[2].int迄 === 980);
  t.記錄('設定：空白＝不分時段', 解析時段設定_('').length === 0 && 解析時段設定_(null).length === 0 && 解析時段設定_('  ').length === 0);
  t.記錄('設定：全形冒號、波浪號、換行與半形分號', fn名(解析時段設定_('甲 9：00～9:40\n乙 10:00~10:40;丙 11:00 至 11:30')) === '甲 09:00-09:40|乙 10:00-10:40|丙 11:00-11:30');
  t.記錄('設定：名稱省略時自動「第一時段」', fn名(解析時段設定_('14:00-14:40；14:50-15:30')) === '第一時段 14:00-14:40|第二時段 14:50-15:30');
  t.記錄('設定：依開始時間排序', 解析時段設定_('晚 19:00-20:00；早 08:00-09:00')[0].str名稱 === '早');
  t.記錄('設定：標準寫法（存回主控台）', 格式化時段設定_(解析時段設定_('第一支香 14:00-14:40;第二支香 14:50-15:30;第三支香 15:40-16:20')) === str一支香);
  t.預期錯誤('設定：看不出時間', obj錯誤代碼.參數錯誤, function () { 解析時段設定_('第一支香 下午兩點；第二支香 14:50-15:30'); });
  t.預期錯誤('設定：開始沒有早於結束（下午寫成 2:00）', obj錯誤代碼.參數錯誤, function () { 解析時段設定_('甲 14:00-2:40；乙 14:50-15:30'); });
  t.預期錯誤('設定：時段重疊', obj錯誤代碼.參數錯誤, function () { 解析時段設定_('甲 14:00-14:40；乙 14:30-15:30'); });
  t.預期錯誤('設定：名稱重複', obj錯誤代碼.參數錯誤, function () { 解析時段設定_('甲 14:00-14:40；甲 14:50-15:30'); });
  t.預期錯誤('設定：只有 1 個時段', obj錯誤代碼.參數錯誤, function () { 解析時段設定_('全天 09:00-17:00'); });
  t.預期錯誤('設定：超過 6 個', obj錯誤代碼.參數錯誤, function () {
    解析時段設定_('8:00-8:30；9:00-9:30；10:00-10:30；11:00-11:30；12:00-12:30；13:00-13:30；14:00-14:30');
  });
  t.預期錯誤('設定：時間不存在（25 點）', obj錯誤代碼.參數錯誤, function () { 解析時段設定_('甲 25:00-25:30；乙 14:50-15:30'); });

  // ── 二、報名內容的時段 ──
  const fn區間 = function (any) { return 解析報名時段值_(any).arr區間.map(function (o) { return `${時刻轉文字_(o.int起)}-${時刻轉文字_(o.int迄)}`; }).join('|'); };
  t.記錄('報名：「下午2:00-2:40, 下午2:50-3:30」', fn區間('下午2:00-2:40, 下午2:50-3:30') === '14:00-14:40|14:50-15:30');
  t.記錄('報名：三個時段', fn區間('下午2:00-2:40, 下午2:50-3:30, 下午3:40-4:20') === '14:00-14:40|14:50-15:30|15:40-16:20');
  t.記錄('報名：已是 24 小時制', fn區間('14:00-14:40') === '14:00-14:40');
  t.記錄('報名：上午、全形符號、頓號', fn區間('上午9：00～9:40、上午10:00-10:40') === '09:00-09:40|10:00-10:40');
  t.記錄('報名：上午 11:30 到 12:10（結束跨中午）', fn區間('上午11:30-12:10') === '11:30-12:10');
  t.記錄('報名：結束早於開始時加 12 小時（11:30-1:00）', fn區間('11:30-1:00') === '11:30-13:00');
  t.記錄('報名：「中午12:00-1:00」', fn區間('中午12:00-1:00') === '12:00-13:00');
  t.記錄('報名：「晚上7:00-8:30」', fn區間('晚上7:00-8:30') === '19:00-20:30');
  t.記錄('報名：「參加」看不懂、不是錯誤', 解析報名時段值_('參加').arr區間.length === 0 && 解析報名時段值_('參加').arr看不懂[0] === '參加');
  t.記錄('報名：空白', 解析報名時段值_('').arr區間.length === 0 && 解析報名時段值_('').arr看不懂.length === 0);

  // ── 三、建議時段 ──
  const arr建議 = 建議報到時段_(['下午2:00-2:40, 下午2:50-3:30, 下午3:40-4:20', '下午2:00-2:40', '', '下午2:50-3:30, 下午3:40-4:20']);
  t.記錄('建議：一支香找到 3 個、依時間排序、預設名稱', fn名(arr建議) === '第一時段 14:00-14:40|第二時段 14:50-15:30|第三時段 15:40-16:20', fn名(arr建議));
  t.記錄('建議：共修「參加」→ 不分時段', 建議報到時段_(['參加', '參加', '']).length === 0);
  t.記錄('建議：只找到 1 個時段 → 不分時段', 建議報到時段_(['下午2:00-4:00', '下午2:00-4:00']).length === 0);
  t.記錄('建議：只有兩個互相重疊的區間 → 不建議（由承辦人設定）', 建議報到時段_(['下午2:00-3:00', '下午2:30-3:30']).length === 0);
  t.記錄('建議：少數人手填的重疊時間不列入（多數優先）',
    fn名(建議報到時段_(['下午2:00-2:40, 下午2:50-3:30', '下午2:00-2:40', '下午2:50-3:30', '下午2:00-2:45'])) === '第一時段 14:00-14:40|第二時段 14:50-15:30');
  t.記錄('建議：可直接存成設定再解析回來', fn名(解析時段設定_(格式化時段設定_(arr建議))) === fn名(arr建議));

  // ── 四、對應報名時段與報名登記 ──
  const fn序 = function (any) { return 對應報名時段_(any, arr時段).arr報名序.join(','); };
  t.記錄('對應：三支香', fn序('下午2:00-2:40, 下午2:50-3:30, 下午3:40-4:20') === '0,1,2');
  t.記錄('對應：第二＋第三', fn序('下午2:50-3:30, 下午3:40-4:20') === '1,2');
  t.記錄('對應：順序打亂、重複只算一次', fn序('下午3:40-4:20, 下午2:00-2:40, 下午2:00-2:40') === '0,2');
  t.記錄('對應：對不到的時間列出來', 對應報名時段_('下午2:00-2:45', arr時段).arr對不到.join() === '14:00-14:45' && fn序('下午2:00-2:45') === '');
  t.記錄('對應：不分時段，有值＝報名', 對應報名時段_('參加', []).arr報名序.join() === '0' && 對應報名時段_('', []).arr報名序.length === 0);
  t.記錄('登記：一支香三個時段全報＝「全部時段」', 產生報名登記_([0, 1, 2], arr時段, 'x') === '全部時段');
  t.記錄('登記：時段名稱用預設「第一時段」也顯示「全部時段」', 產生報名登記_([0, 1, 2], 建議報到時段_([str三支香_]), 'x') === '全部時段');
  t.記錄('登記：兩個時段全報＝「全部時段」', 產生報名登記_([0, 1], 解析時段設定_('甲 09:00-10:00；乙 10:10-11:00'), 'x') === '全部時段');
  t.記錄('登記：部分時段列出起迄', 產生報名登記_([0, 1], arr時段, 'x') === '14:00-14:40、14:50-15:30');
  t.記錄('登記：不分時段照錄報名內容', 產生報名登記_([0], [], '參加') === '參加');
  t.記錄('登記：一個都對不到照錄', 產生報名登記_([], arr時段, '下午5:00-6:00') === '下午5:00-6:00');

  // ── 五、排序（紙本範本 18 人） ──
  const str三 = '下午2:00-2:40, 下午2:50-3:30, 下午3:40-4:20';
  const arr範本 = [
    ['王冠羣', '傳塵', str三], ['蔡美池', '法隆', str三], ['林維瑭', '法如', str三], ['黃馨潁', '', str三], ['林月素', '傳日', str三],
    ['彭水珠', '傳晶', str三], ['陳月麗', '傳質', str三], ['吳婉瑄', '傳瑄', str三], ['林敏惠', '法淙', str三], ['許詠程', '', str三],
    ['魏瓊珠', '傳教', str三], ['吳聿華', '傳仲', str三], ['葉莉慧', '傳榕', str三],
    ['王儷蓉', '', '下午2:00-2:40'], ['蔡聿書', '', '下午2:00-2:40'], ['陳文福', '法立', '下午2:00-2:40'],
    ['呂佳純', '法城', '下午2:00-2:40, 下午2:50-3:30'], ['洪林從德', '傳毓', '下午2:50-3:30, 下午3:40-4:20']
  ].map(function (a) {
    const arr序 = 對應報名時段_(a[2], arr時段).arr報名序;
    return { str姓名: a[0], str法名: a[1], arr報名序: arr序, str報名登記: 產生報名登記_(arr序, arr時段, a[2]), str提醒: '' };
  });
  t.記錄('排序：組別比較（全部 → [0] → [0,1] → [1,2] → 對不到）',
    比較報名組別_([0, 1, 2], [0], 3) < 0 && 比較報名組別_([0], [0, 1], 3) < 0 && 比較報名組別_([0, 1], [0, 2], 3) < 0
    && 比較報名組別_([0, 2], [1], 3) < 0 && 比較報名組別_([1, 2], [2], 3) < 0 && 比較報名組別_([2], [], 3) < 0);
  const obj排序 = 排序報到人員_(arr範本.slice().reverse(), 3);
  const str順序 = obj排序.arr人員.map(function (o) { return o.str姓名; }).join(' ');
  t.記錄('排序：三支香在前、再只報第一、第一＋第二、第二＋第三',
    obj排序.arr人員.slice(0, 13).every(function (o) { return o.arr報名序.length === 3; })
    && obj排序.arr人員.slice(13, 16).every(function (o) { return o.arr報名序.join() === '0'; })
    && obj排序.arr人員[16].str姓名 === '呂佳純' && obj排序.arr人員[17].str姓名 === '洪林從德', str順序);
  t.記錄('排序：同組依姓名筆畫（主機支援時）', !obj排序.bool筆畫 || str順序.indexOf('王冠羣 吳聿華 吳婉瑄 林月素 林敏惠 林維瑭 許詠程 陳月麗 彭水珠 黃馨潁 葉莉慧 蔡美池 魏瓊珠') === 0,
    obj排序.bool筆畫 ? '筆畫' : '內碼');
  console.log('（姓名排序方式：' + (obj排序.bool筆畫 ? '中文筆畫' : '電腦內碼——這台主機不支援筆畫排序') + '）');
  t.記錄('排序：第一支香組依筆畫「王儷蓉、陳文福、蔡聿書」', !obj排序.bool筆畫 || obj排序.arr人員.slice(13, 16).map(function (o) { return o.str姓名; }).join() === '王儷蓉,陳文福,蔡聿書');

  // ── 六、版面 ──
  const int每頁 = obj報到表格式.int每頁列數;
  t.記錄('列數：18 人 → 1 頁、7 列空白（與紙本範本相同）', JSON.stringify(計算報到表列數_(18)) === JSON.stringify({ int總列數: 25, int頁數: 1, int空白列: 7 }));
  t.記錄('列數：剛好 25 人 → 1 頁、不加空白頁', 計算報到表列數_(int每頁).int頁數 === 1 && 計算報到表列數_(int每頁).int空白列 === 0);
  t.記錄('列數：26 人 → 2 頁、24 列空白', 計算報到表列數_(int每頁 + 1).int頁數 === 2 && 計算報到表列數_(int每頁 + 1).int空白列 === int每頁 - 1);
  t.記錄('列數：0 人 → 1 頁空白', 計算報到表列數_(0).int頁數 === 1 && 計算報到表列數_(0).int空白列 === int每頁);
  t.記錄('提醒簡稱', 提醒簡稱_('備註提到取消：「取消」，請確認後自行刪除這一列；同名但法名不同（甲、乙）') === '取消？、同名'
    && 提醒簡稱_('學員名冊中有 2 位同名同法名（A、B），請填寫學員編號') === '編號待填' && 提醒簡稱_('') === '');
  t.記錄('日期：民國年與星期「115/11/15（日）」', 報到表日期文字_(new Date(2026, 10, 15)) === '115/11/15（日）');
  t.記錄('日期：不是日期時空白', 報到表日期文字_(null) === '');

  const obj內容 = 組合報到表內容_({ str標題: '普泉一支香點名表', str日期: '115/11/15（日）', arr時段: arr時段, arr人員: arr範本 });
  t.記錄('報到表：欄名與紙本範本相同 8 欄', obj內容.arr欄名.join('|') === '序號|姓名|法名|報名登記|第一支香\n14:00-14:40|第二支香\n14:50-15:30|第三支香\n15:40-16:20|備註',
    obj內容.arr欄名.join('|'));
  t.記錄('報到表：2 列標題＋25 列（18 人＋7 空白）', obj內容.arr值.length === 27 && obj內容.int人數 === 18 && obj內容.int空白列 === 7);
  t.記錄('報到表：標題在 A1、日期在時段第一欄', obj內容.arr值[0][0] === '普泉一支香點名表' && obj內容.arr值[0][4] === '115/11/15（日）');
  t.記錄('報到表：序號連空白列一起編到 25', obj內容.arr值[2][0] === 1 && obj內容.arr值[26][0] === 25 && obj內容.arr值[26][1] === '');
  t.記錄('報到表：三支香沒有灰底', obj內容.arr底色[2].slice(4, 7).every(function (s) { return s === null; }) && obj內容.arr值[2][3] === '全部時段');
  const int只第一 = obj內容.arr值.findIndex(function (a) { return a[1] === '王儷蓉'; });
  t.記錄('報到表：只報第一支香 → 第二、三支香灰底', obj內容.arr底色[int只第一][4] === null
    && obj內容.arr底色[int只第一][5] === obj報到表格式.str淺灰 && obj內容.arr底色[int只第一][6] === obj報到表格式.str淺灰);
  const int洪 = obj內容.arr值.findIndex(function (a) { return a[1] === '洪林從德'; });
  t.記錄('報到表：第二＋第三 → 報名登記兩行小字、第一支香灰底', obj內容.arr值[int洪][3] === '14:50-15:30\n15:40-16:20'
    && obj內容.arr字級[int洪][3] === obj報到表格式.int小字級 && obj內容.arr底色[int洪][4] === obj報到表格式.str淺灰);
  t.記錄('報到表：空白列沒有灰底', obj內容.arr底色[26].every(function (s) { return s === null; }));
  t.記錄('報到表：欄寬合計不超過可用寬度', obj內容.arr欄寬.reduce(function (a, b) { return a + b; }, 0) <= obj報到表格式.int可用寬度,
    String(obj內容.arr欄寬.reduce(function (a, b) { return a + b; }, 0)));
  const obj單一 = 組合報到表內容_({ str標題: '共修', str日期: '', arr時段: [], arr人員: [{ str姓名: '甲', str法名: '', arr報名序: [0], str報名登記: '參加', str提醒: '備註提到取消' }] });
  t.記錄('報到表：不分時段只有一欄「報到」、提醒印在備註', obj單一.arr欄名.join('|') === '序號|姓名|法名|報名登記|報到|備註' && obj單一.arr值[2][5] === '取消？');
  const obj對不到 = 組合報到表內容_({ str標題: '', str日期: '', arr時段: arr時段, arr人員: [{ str姓名: '乙', str法名: '', arr報名序: [], str報名登記: '下午5:00-6:00', str提醒: '報名內容對不到時段' }] });
  t.記錄('報到表：對不到時段的人不塗灰、備註「時段？」', obj對不到.arr底色[2].slice(4, 7).every(function (s) { return s === null; }) && obj對不到.arr值[2][7] === '時段？');

  // ── 七、名冊時段欄（法會_報到名冊 v1.2.0） ──
  const arr標題 = 組合名冊標題_(['禪修班班別 [日間]', '備註'], ['座位'], ['第一支香', '第二支香', '第三支香']);
  t.記錄('名冊標題：時段欄接在報名登記後面', arr標題.slice(5, 11).join('|') === '報名內容|報名登記|第一支香|第二支香|第三支香|提醒'
    && arr標題[arr標題.length - 1] === '座位', arr標題.join('|'));
  t.記錄('名冊標題：不分時段時與 v1.1.0 相同（加報名登記）', 組合名冊標題_([], []).join('|') === obj報到名冊格式.arr固定欄位.join('|'));
  const obj名冊列 = { str場次: '欲參加時段 [11/15 (日)]', dat場次日期: new Date(2026, 10, 15), str姓名: '呂佳純', str法名: '法城',
    str學員編號: 'A001', str報名內容: '下午2:00-2:40, 下午2:50-3:30', int來源列: 5, any報名時間: '手動', arr提醒: [], obj帶入: {} };
  t.記錄('名冊：補上時段（沒有對不到）', 補上名冊時段_([obj名冊列], arr時段) === 0 && obj名冊列.arr報名序.join() === '0,1');
  const obj名冊物件 = 轉為名冊物件_(obj名冊列, arr時段);
  t.記錄('名冊：報名登記與 ✓', obj名冊物件['報名登記'] === '14:00-14:40、14:50-15:30' && obj名冊物件['第一支香'] === '✓'
    && obj名冊物件['第二支香'] === '✓' && obj名冊物件['第三支香'] === '');
  const obj對不到列 = { str報名內容: '下午2:00-2:45', arr提醒: [] };
  t.記錄('名冊：報名內容對不到時段時提醒', 補上名冊時段_([obj對不到列], arr時段) === 1 && obj對不到列.arr提醒[0].indexOf('對不到時段') !== -1);
  t.記錄('名冊：不分時段不加時段欄、報名登記照錄', (function () {
    const o = 轉為名冊物件_({ str報名內容: '參加', arr提醒: [], obj帶入: {} });
    return o['報名登記'] === '參加' && !('第一支香' in o);
  })());
  t.記錄('名冊提醒在報到表的簡稱', 提醒簡稱_(obj對不到列.arr提醒[0]) === '時段？');

  // ── 八、列印網址 ──
  const str網址 = 產生報到表列印網址_('ABC123', 456);
  t.記錄('列印網址：A4 直式、100%、每頁重複凍結列、指定分頁', str網址.indexOf('/d/ABC123/export?format=pdf') !== -1 && str網址.indexOf('size=A4') !== -1
    && str網址.indexOf('portrait=true') !== -1 && str網址.indexOf('scale=1') !== -1 && str網址.indexOf('fzr=true') !== -1 && /&gid=456$/.test(str網址));

  // ── 九、路由 ──
  const obj路由 = 路由定義_event();
  t.記錄('路由：三個新 action 不需網頁登入', ['event.副本讀取時段', 'event.副本儲存時段', 'event.副本列印報到表'].every(function (k) {
    return obj路由[k] && typeof obj路由[k].fn === 'function' && obj路由[k].bool需登入 === false;
  }));
  t.記錄('主控台：活動清單有「報到時段」欄', 主控台結構_event().活動清單.arr欄位.indexOf(obj報到表格式.str時段欄位) !== -1);

  return t.結算();
}
