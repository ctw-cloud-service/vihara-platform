// ============================================================================
// 檔案名稱：法會_副本範本.gs
// 所屬模組：法會活動（event）
// 所屬層級：模組／系統管理員工具（在 Apps Script 編輯器執行，不開放給網頁）
// 檔案版本：v1.0.0（2026-10-26）
// 用途說明：
//   建立「法會活動副本範本」：每場活動的整理副本都從這份範本複製。
//   範本裡的「綁定指令碼」（副本選單）無法由程式建立，所以分兩步：
//     ① 在編輯器執行「建立法會副本範本」：在平台「範本」資料夾建立試算表，
//        並把檔案代號記到指令碼屬性「法會活動副本範本ID」
//     ② 系統管理員開啟範本 → 擴充功能 → Apps Script，貼上 event/副本範本/ 的
//        Code.gs、報表.gs、appsscript.json（見執行記錄的說明）
//   之後複製出的副本都帶有選單。範本改版只影響之後新建的副本。
//
// 相依檔案：平台核心（核心_結構定義、核心_試算表存取）、法會_模組定義
// ============================================================================


// 範本檔名與說明分頁內容
const str法會範本檔名 = '法會活動副本範本';
const arr法會範本說明 = Object.freeze([
  ['法會活動整理副本　使用說明'],
  [''],
  ['這份試算表由「精舍雲端服務平台」為每場法會自動建立，只共享給精舍管理員與這場活動的承辦人。'],
  [''],
  ['【分頁】'],
  ['有效資料：報名資料。可以直接整理：刪除重複、加欄位（例如車次、備註）、排序都可以；請不要修改表單題目的欄名。'],
  ['無效資料：「移除重複」移出的資料，需要時可複製回「有效資料」。'],
  ['重複檢查：公式自動列出姓名重複的人，點「前往」可跳到那一列。'],
  [''],
  ['【選單】（第一次使用時 Google 會要求授權：按「繼續」→ 選帳號 →「進階」→「前往…」→「允許」）'],
  ['下載資料 → 下載新資料：把表單新收到的報名加到「有效資料」最後（淺黃底色），已整理的資料不會被改動。'],
  ['檢查重複 → 查詢、跳到下一個、標示、清除標示、移除重複（移至「無效資料」，每組保留最晚的一筆）。'],
  ['大車點名 → 對外活動使用（下一階段開放）。'],
  ['報表 → 從「有效資料」篩選產生報表、列印。'],
  [''],
  ['【提醒】'],
  ['· 填寫人修改報名不會自動覆蓋這份資料，系統會在法會活動網頁「同步與整理」提醒您。'],
  ['· 新下載的資料最右側「系統_追加時間」記錄下載時間，方便辨認尚未整理的資料。']
]);


/**
 * ============================================================================
 * 函式名稱：建立法會副本範本檔_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：在指定資料夾建立範本試算表：說明、有效資料、無效資料三個分頁（測試程式也使用）。
 * 參數：
 *   obj資料夾   {Folder} 要放範本的資料夾
 * 傳回：{Spreadsheet} 範本
 * ============================================================================
 */
function 建立法會副本範本檔_(obj資料夾) {
  const obj範本 = SpreadsheetApp.create(`${str法會範本檔名} v${obj法會設定.str版本}`);
  DriveApp.getFileById(obj範本.getId()).moveTo(obj資料夾);

  // 說明分頁（改用預設的第一個分頁）
  const obj說明 = obj範本.getSheets()[0].setName(obj法會副本分頁.說明);
  obj說明.getRange(1, 1, arr法會範本說明.length, 1).setValues(arr法會範本說明);
  obj說明.getRange(1, 1).setFontWeight('bold').setFontSize(14);
  obj說明.setColumnWidth(1, 900);

  // 有效資料、無效資料（內容由系統在建立副本時寫入）
  obj範本.insertSheet(obj法會副本分頁.有效資料, 0);
  obj範本.insertSheet(obj法會副本分頁.無效資料);
  obj範本.setActiveSheet(obj範本.getSheetByName(obj法會副本分頁.有效資料));
  return obj範本;
}


/**
 * ============================================================================
 * 函式名稱：建立法會副本範本
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   系統管理員在 Apps Script 編輯器執行一次（不開放給網頁）。
 *     · 已有範本且檔案還在：不重建，只在執行記錄顯示範本網址
 *       （要重建請先在「專案設定 → 指令碼屬性」刪除「法會活動副本範本ID」）
 *     · 沒有：在平台「範本」資料夾建立，並記到指令碼屬性
 *   執行記錄會列出接著要貼上的副本選單程式。
 *
 * 參數：無
 * 傳回：{string} 範本網址
 * ============================================================================
 */
function 建立法會副本範本() {
  const obj屬性 = PropertiesService.getScriptProperties();
  const str既有ID = obj屬性.getProperty(obj法會設定.str範本屬性名稱);

  // 已有範本：確認檔案還在
  if (str既有ID) {
    try {
      const obj檔案 = DriveApp.getFileById(str既有ID);
      if (!obj檔案.isTrashed()) {
        console.log(`已有法會活動副本範本，不重建：${obj檔案.getUrl()}`);
        console.log('要重建請先到「專案設定 → 指令碼屬性」刪除「法會活動副本範本ID」，再執行一次。');
        return obj檔案.getUrl();
      }
    } catch (err) {
      console.warn('原本記錄的範本找不到了，將重新建立。');
    }
  }

  // 建立在平台「範本」資料夾
  const obj資料夾 = DriveApp.getFolderById(取得系統設定值(obj設定名稱.範本資料夾ID));
  const obj範本 = 建立法會副本範本檔_(obj資料夾);
  obj屬性.setProperty(obj法會設定.str範本屬性名稱, obj範本.getId());

  console.log(`✔ 已建立法會活動副本範本：${obj範本.getUrl()}`);
  console.log('接著請：');
  console.log('  1. 開啟上面的範本 → 擴充功能 → Apps Script');
  console.log('  2. 專案設定（齒輪）→ 勾選「在編輯器中顯示 appsscript.json」');
  console.log('  3. 把 event/副本範本/ 的 appsscript.json、Code.gs 整份貼上，並新增指令碼檔「報表」貼上 報表.gs');
  console.log('  4. 存檔後回到範本重新整理，確認上方出現「下載資料」「檢查重複」「大車點名」「報表」選單');
  寫入操作日誌(null, '建立法會副本範本', obj範本.getId());
  return obj範本.getUrl();
}
