// ============================================================================
// 檔案名稱：法會_資料同步與整理.gs
// 所屬模組：法會活動（event）
// 所屬層級：模組／控制層
// 檔案版本：v2.0.0（2026-10-27）
//   v2.0.0：改讀「報名回覆試算表」（系統帳號只需檢視者），以「列號＋時間戳記」判斷新報名與修改；
//           回覆試算表被刪列或排序時停止同步並說明
//   v1.1.0：讀取表單回應時權限不足白話說明
//   v1.0.0：初版（讀 Google 表單回應）
// 用途說明：
//   把報名回覆試算表的新報名下載到整理副本，並提醒承辦人留意的變化（沿用舊系統 07 號檔的原則）：
//     · 每一列報名以「回覆試算表列號」記在主控台「已同步紀錄」（回應ID 欄寫「列5」）：
//       承辦人在副本刪掉的重複資料不會再被加回來
//     · 依欄名對位追加，承辦人自己加的欄位（含公式）完全不碰；新列淺黃底
//     · 填寫人送出後又修改（同一列時間戳記變新）：不覆蓋副本，改寫一則「回應已修改」提醒
//     · 表單新增題目（回覆試算表多一欄）：副本最右側自動加欄，並寫一則提醒
//     · 回覆試算表被刪列或排序：這場活動停止同步並說明如何還原（見 法會_表單與副本 分類來源資料列_）
//     · 同一場活動同時只讓一人同步（活動作業鎖）
//   提醒寫在主控台「修改提醒」，在網頁「同步與整理」查看並標記已處理或忽略。
//
// 相依檔案：平台核心、法會_模組定義、法會_表單與副本
// ============================================================================


// 提醒清單一次最多傳回幾筆（最新的在前）
const int法會提醒顯示上限 = 200;


/**
 * ============================================================================
 * 函式名稱：讀取法會已同步紀錄_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：讀出主控台「已同步紀錄」，整理成「活動ID → 回應ID（列號，如『列5』）→ 紀錄」對照。
 * 參數：
 *   obj主控台   {Spreadsheet} 主控台
 *   str活動ID   {string}      選填；有給就只整理這一場
 * 傳回：
 *   {Object} { 活動ID: { 回應ID: { int列號, int最後修改毫秒 } } }
 * ============================================================================
 */
function 讀取法會已同步紀錄_(obj主控台, str活動ID) {
  const obj表 = 取得法會分頁_(obj主控台, '已同步紀錄');
  const obj結果 = {};
  讀取全部資料列(obj表.obj分頁, ['活動ID', '回應ID', '回應最後修改時間']).forEach(function (obj列) {
    const str活動 = String(obj列.obj值['活動ID']).trim();
    if (str活動ID && str活動 !== str活動ID) return;
    const any時間 = obj列.obj值['回應最後修改時間'];
    const int毫秒 = (Object.prototype.toString.call(any時間) === '[object Date]') ? any時間.getTime() : 0;
    (obj結果[str活動] = obj結果[str活動] || {})[String(obj列.obj值['回應ID']).trim()] = {
      int列號: obj列.int列號, int最後修改毫秒: int毫秒
    };
  });
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：建立法會提醒_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：組成一筆「修改提醒」資料，處理狀態預設「未處理」。
 * 參數：
 *   dat時間       {Date}   提醒時間
 *   obj活動值     {Object} 活動清單一列的 obj值
 *   str回應ID     {string} 相關的回覆試算表列（例如「列5」；沒有就空白）
 *   str類型       {string} obj法會提醒類型 之一
 *   str說明       {string} 給承辦人看的說明
 * 傳回：{Object} { 欄位名稱: 值 }
 * ============================================================================
 */
function 建立法會提醒_(dat時間, obj活動值, str回應ID, str類型, str說明) {
  return {
    '提醒ID': 'N' + 產生識別碼().substring(0, 12).toUpperCase(),
    '提醒時間': dat時間,
    '活動ID': String(obj活動值['活動ID']).trim(),
    '活動名稱': String(obj活動值['活動名稱']).trim(),
    '回應ID': str回應ID || '',
    '類型': str類型,
    '說明': str說明,
    '處理狀態': obj法會提醒狀態.未處理
  };
}


/**
 * ============================================================================
 * 函式名稱：同步單一法會活動_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：
 *   同步一場活動（呼叫者負責權限、狀態檢查與活動作業鎖）：
 *     ① 讀回覆試算表，分成新報名、已修改（見 分類來源資料列_）；列號錯開時停止並說明
 *     ② 新報名依列號順序追加到副本「有效資料」；追加成功後才登記
 *        （追加途中出錯，紀錄不會寫入，下次同步會重新嘗試）
 *     ③ 副本因表單新增題目而加欄 → 提醒
 *     ④ 已修改的報名 → 提醒，並更新紀錄中的時間（同一次修改只提醒一次）
 *     ⑤ 回填活動清單的同步時間與筆數
 *
 * 參數：
 *   obj主控台     {Spreadsheet} 主控台
 *   obj活動值     {Object}      活動清單一列的 obj值
 *   obj本活動紀錄 {Object}      { '列5': { int列號, int最後修改毫秒 } }
 * 傳回：{Object} { int新增筆數, int提醒筆數 }
 * ============================================================================
 */
function 同步單一法會活動_(obj主控台, obj活動值, obj本活動紀錄) {
  const str活動ID = String(obj活動值['活動ID']).trim();
  const dat現在 = new Date();

  // ① 分類
  const obj分類 = 分類來源資料列_(讀取來源資料_(開啟活動來源分頁_(obj活動值)), obj本活動紀錄);
  if (obj分類.str異常說明) throw new 平台錯誤(obj錯誤代碼.參數錯誤, obj分類.str異常說明);
  const arr新列 = obj分類.arr新列;
  const arr已修改 = obj分類.arr已修改;

  const arr提醒 = [];
  let int新增筆數 = 0;

  // ② 追加新報名
  if (arr新列.length > 0) {
    const obj副本 = 開啟活動副本_(obj活動值);
    const obj有效分頁 = obj副本.getSheetByName(obj法會副本分頁.有效資料);
    if (!obj有效分頁) {
      // 承辦人可能把分頁改名：這次不追加，寫提醒請人處理（下次同步會再試）
      arr提醒.push(建立法會提醒_(dat現在, obj活動值, '', obj法會提醒類型.找不到有效資料,
        `副本中找不到「${obj法會副本分頁.有效資料}」分頁（可能被改名）。請把分頁名稱改回後再同步；本次有 ${arr新列.length} 筆新報名尚未下載。`));
    } else {
      const obj追加 = 追加回應到副本_(obj有效分頁, arr新列.map(function (obj列) { return obj列.obj欄值; }));
      int新增筆數 = obj追加.int新增筆數;

      // 追加成功後才登記，確保「已登記＝已在副本中」
      執行並鎖定(function () {
        批次新增資料列(取得法會分頁_(obj主控台, '已同步紀錄').obj分頁, arr新列.map(function (obj列) {
          return {
            '活動ID': str活動ID, '回應ID': 來源列鍵_(obj列.int列號), '送出時間': obj列.dat時間,
            '回應最後修改時間': obj列.dat時間, '複製方式': '追加', '複製時間': dat現在
          };
        }));
      }, '登記已下載的報名');

      // ③ 新增欄位提醒（系統追加時間欄除外）
      obj追加.arr新增欄位.filter(function (str欄) { return str欄 !== obj法會設定.str系統追加時間欄名; })
        .forEach(function (str欄) {
          arr提醒.push(建立法會提醒_(dat現在, obj活動值, '', obj法會提醒類型.表單新增題目,
            `副本中沒有「${str欄}」欄，已新增在「有效資料」最右側。若只是副本的標題被改名，請把資料搬回原欄後刪除新欄。`));
        });
    }
  }

  // ④ 已修改的報名
  arr已修改.forEach(function (obj) {
    arr提醒.push(建立法會提醒_(dat現在, obj活動值, obj.str鍵, obj法會提醒類型.回應已修改,
      `${取得列摘要名稱_(obj.obj列)} 於 ${格式化日期(obj.obj列.dat時間, 'yyyy/MM/dd HH:mm')} 修改了報名（回覆試算表第 ${obj.obj列.int列號} 列），請對照原始回覆表更新副本。`));
  });

  // 提醒只追加，不需要鎖定；修改時間與活動清單要在鎖定中更新
  const obj提醒表 = 取得法會分頁_(obj主控台, '修改提醒');
  arr提醒.forEach(function (obj提醒) { 附加資料列(obj提醒表.obj分頁, obj提醒); });

  執行並鎖定(function () {
    const obj紀錄分頁 = 取得法會分頁_(obj主控台, '已同步紀錄').obj分頁;
    arr已修改.forEach(function (obj) {
      更新資料列(obj紀錄分頁, obj.obj紀錄.int列號, { '回應最後修改時間': obj.obj列.dat時間 });
    });
    // ⑤ 回填活動清單
    const obj活動 = 取得法會活動_(obj主控台, str活動ID);
    更新資料列(取得法會分頁_(obj主控台, '活動清單').obj分頁, obj活動.int列號, {
      '上次同步時間': dat現在,
      '已同步筆數': Object.keys(obj本活動紀錄).length + int新增筆數
    });
  }, '更新同步紀錄');

  return { int新增筆數: int新增筆數, int提醒筆數: arr提醒.length };
}


/**
 * ============================================================================
 * 函式名稱：同步法會資料
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.同步資料」。把報名回覆試算表的新報名下載到整理副本。
 *     · 指定活動：檢查權限與狀態，說清楚為什麼不能同步
 *     · 不指定：同步登入者可處理、且在「收件中／演練／報到中」的全部活動；
 *       某場失敗或有人正在處理，不影響其他場；時間快到上限就停下，請再按一次
 *
 * 參數：
 *   obj工作階段   {Object} 工作階段
 *   obj參數       {Object} { str活動ID（選填） }
 * 傳回：
 *   {Object} { bool成功, str訊息, arr明細, int新增筆數, int提醒筆數 }
 * ============================================================================
 */
function 同步法會資料(obj工作階段, obj參數) {
  檢查角色(obj工作階段, [obj角色.精舍管理員, obj角色.承辦人], '同步報名資料');
  const str精舍代號 = obj工作階段.str精舍代號;
  const obj主控台 = 開啟法會主控台_(str精舍代號);
  const str指定ID = String((obj參數 && obj參數.str活動ID) || '').trim();

  // ── 決定要同步哪些活動 ──
  let arr活動;
  if (str指定ID) {
    const obj指定 = 取得法會活動_(obj主控台, str指定ID).obj值;
    檢查活動權限_(obj工作階段, obj指定, obj法會權限.整理資料, '同步報名資料');
    檢查活動狀態_(obj指定, arr法會可同步狀態, '同步報名資料');
    arr活動 = [obj指定];
  } else {
    檢查權限(obj工作階段, obj法會權限.整理資料, '同步報名資料');
    arr活動 = 讀取法會活動清單_(obj主控台).map(function (obj列) { return obj列.obj值; })
      .filter(function (obj值) {
        return 可看見法會活動_(obj工作階段, obj值) && arr法會可同步狀態.indexOf(String(obj值['活動狀態']).trim()) !== -1;
      });
    if (arr活動.length === 0) {
      return { bool成功: true, str訊息: '沒有需要同步的活動（只有「收件中」「演練」「報到中」的活動會同步）。', arr明細: [], int新增筆數: 0, int提醒筆數: 0 };
    }
  }

  // ── 逐場同步 ──
  const obj計時 = 建立計時器_();
  const obj已同步 = 讀取法會已同步紀錄_(obj主控台, str指定ID);
  const arr明細 = [];
  let int總新增 = 0;
  let int總提醒 = 0;
  let int失敗 = 0;

  for (let i = 0; i < arr活動.length; i++) {
    const obj活動值 = arr活動[i];
    const str名稱 = obj活動值['活動名稱'];
    if (obj計時.bool已逾時()) {
      arr明細.push(`時間已到，尚有 ${arr活動.length - i} 場活動未同步，請再按一次「同步」。`);
      break;
    }
    try {
      const obj結果 = 以活動作業鎖執行_(str精舍代號, obj活動值['活動ID'], '同步報名資料', function () {
        return 同步單一法會活動_(obj主控台, obj活動值, obj已同步[String(obj活動值['活動ID']).trim()] || {});
      });
      int總新增 += obj結果.int新增筆數;
      int總提醒 += obj結果.int提醒筆數;
      arr明細.push(`✔ ${str名稱}：新增 ${obj結果.int新增筆數} 筆` + (obj結果.int提醒筆數 > 0 ? `，提醒 ${obj結果.int提醒筆數} 則` : ''));
    } catch (err) {
      int失敗 += 1;
      arr明細.push(`✘ ${str名稱}：${轉換為平台錯誤(err, '同步').str使用者訊息}`);
      // 指定單一活動時，直接把錯誤丟回去，畫面顯示得比較清楚
      if (str指定ID) throw err;
    }
  }

  寫入操作日誌(obj工作階段, '同步法會資料', `${str指定ID || '全部'}：新增 ${int總新增} 筆，提醒 ${int總提醒} 則`);
  return {
    bool成功: true,
    str訊息: `同步完成：新增 ${int總新增} 筆報名` + (int總提醒 > 0 ? `，${int總提醒} 則提醒請到「修改提醒」查看` : '')
      + (int失敗 > 0 ? `；${int失敗} 場未完成，請看明細。` : '。'),
    arr明細: arr明細,
    int新增筆數: int總新增,
    int提醒筆數: int總提醒
  };
}


/**
 * ============================================================================
 * 函式名稱：計算法會待同步筆數_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：只「查看」：回覆試算表中還有幾筆報名沒有下載到副本（不改任何資料）。
 *       回覆試算表被刪列或排序時丟出說明。
 * 參數：
 *   obj活動值     {Object} 活動清單一列的 obj值
 *   obj本活動紀錄 {Object} { '列5': 紀錄 }
 * 傳回：{number}
 * ============================================================================
 */
function 計算法會待同步筆數_(obj活動值, obj本活動紀錄) {
  const obj分類 = 分類來源資料列_(讀取來源資料_(開啟活動來源分頁_(obj活動值)), obj本活動紀錄);
  if (obj分類.str異常說明) throw new 平台錯誤(obj錯誤代碼.參數錯誤, obj分類.str異常說明);
  return obj分類.arr新列.length;
}


/**
 * ============================================================================
 * 函式名稱：檢查法會新回應
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.檢查新回應」。只讀不寫，所以不需要排隊，可隨時按：
 *   每場可同步的活動還有幾筆新報名尚未下載（讀回覆試算表）。
 *
 * 參數：
 *   obj工作階段   {Object} 工作階段
 *   obj參數       {Object} { str活動ID（選填） }
 * 傳回：
 *   {Object} { bool成功, str訊息, obj待同步: { 活動ID: 筆數 }, arr明細 }
 * ============================================================================
 */
function 檢查法會新回應(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.整理資料, '檢查新報名');
  const obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);
  const str指定ID = String((obj參數 && obj參數.str活動ID) || '').trim();

  const arr活動 = 讀取法會活動清單_(obj主控台).map(function (obj列) { return obj列.obj值; })
    .filter(function (obj值) {
      return (str指定ID === '' || String(obj值['活動ID']).trim() === str指定ID)
        && 可看見法會活動_(obj工作階段, obj值)
        && arr法會可同步狀態.indexOf(String(obj值['活動狀態']).trim()) !== -1;
    });

  const obj已同步 = 讀取法會已同步紀錄_(obj主控台, str指定ID);
  const obj待同步 = {};
  const arr明細 = [];
  let int總數 = 0;
  arr活動.forEach(function (obj值) {
    const str活動ID = String(obj值['活動ID']).trim();
    try {
      const int筆數 = 計算法會待同步筆數_(obj值, obj已同步[str活動ID] || {});
      obj待同步[str活動ID] = int筆數;
      int總數 += int筆數;
      arr明細.push((int筆數 > 0 ? '● ' : '✔ ') + obj值['活動名稱'] + '：' + (int筆數 > 0 ? `${int筆數} 筆新報名待下載` : '已是最新'));
    } catch (err) {
      arr明細.push(`✘ ${obj值['活動名稱']}：${轉換為平台錯誤(err, '檢查新報名').str使用者訊息}`);
    }
  });

  return {
    bool成功: true,
    str訊息: arr活動.length === 0 ? '沒有可檢查的活動。'
      : (int總數 > 0 ? `共有 ${int總數} 筆新報名尚未下載，請按「同步」。` : '所有活動都是最新的。'),
    obj待同步: obj待同步,
    arr明細: arr明細
  };
}


/**
 * ============================================================================
 * 函式名稱：計算未處理提醒數_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：每場活動還有幾則「未處理」的提醒（活動卡片上的紅色數字）。
 * 參數：
 *   obj主控台   {Spreadsheet} 主控台
 * 傳回：{Object} { 活動ID: 數量 }
 * ============================================================================
 */
function 計算未處理提醒數_(obj主控台) {
  const obj結果 = {};
  讀取全部資料列(取得法會分頁_(obj主控台, '修改提醒').obj分頁, ['活動ID', '處理狀態']).forEach(function (obj列) {
    if (String(obj列.obj值['處理狀態']).trim() !== obj法會提醒狀態.未處理) return;
    const str活動ID = String(obj列.obj值['活動ID']).trim();
    obj結果[str活動ID] = (obj結果[str活動ID] || 0) + 1;
  });
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：列出法會提醒
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.列出提醒」。列出登入者可整理之活動的提醒（最新的在前，最多 200 筆）。
 *
 * 參數：
 *   obj工作階段   {Object} 工作階段
 *   obj參數       {Object} { str活動ID（選填）, bool含已處理（選填，預設只列未處理） }
 * 傳回：
 *   {Object} { bool成功, arr提醒: [ { str提醒ID, str提醒時間, str活動ID, str活動名稱, str類型,
 *              str說明, str處理狀態, str處理人, str處理時間 } ], bool已截斷 }
 * ============================================================================
 */
function 列出法會提醒(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.整理資料, '查看修改提醒');
  const obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);
  const str指定ID = String((obj參數 && obj參數.str活動ID) || '').trim();
  const bool含已處理 = !!(obj參數 && obj參數.bool含已處理);

  // 登入者看得到的活動
  const obj可看 = {};
  讀取法會活動清單_(obj主控台).forEach(function (obj列) {
    if (可看見法會活動_(obj工作階段, obj列.obj值)) obj可看[String(obj列.obj值['活動ID']).trim()] = true;
  });

  const obj表 = 取得法會分頁_(obj主控台, '修改提醒');
  const arr全部 = 讀取全部資料列(obj表.obj分頁, obj表.arr欄位).filter(function (obj列) {
    const str活動ID = String(obj列.obj值['活動ID']).trim();
    if (!obj可看[str活動ID]) return false;
    if (str指定ID && str活動ID !== str指定ID) return false;
    return bool含已處理 || String(obj列.obj值['處理狀態']).trim() === obj法會提醒狀態.未處理;
  }).reverse();

  return {
    bool成功: true,
    bool已截斷: arr全部.length > int法會提醒顯示上限,
    arr提醒: arr全部.slice(0, int法會提醒顯示上限).map(function (obj列) {
      const obj值 = obj列.obj值;
      return {
        str提醒ID: String(obj值['提醒ID']).trim(),
        str提醒時間: 轉為日期文字_(obj值['提醒時間']),
        str活動ID: String(obj值['活動ID']).trim(),
        str活動名稱: String(obj值['活動名稱']).trim(),
        str類型: String(obj值['類型']).trim(),
        str說明: String(obj值['說明']).trim(),
        str處理狀態: String(obj值['處理狀態']).trim(),
        str處理人: String(obj值['處理人'] || '').trim(),
        str處理時間: 轉為日期文字_(obj值['處理時間'])
      };
    })
  };
}


/**
 * ============================================================================
 * 函式名稱：處理法會提醒
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.處理提醒」。承辦人看完並更新副本後，把提醒標為「已處理」或「忽略」，
 *   記下處理人與時間。
 *
 * 參數：
 *   obj工作階段   {Object} 工作階段
 *   obj參數       {Object} { str提醒ID, str處理狀態（已處理／忽略） }
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 處理法會提醒(obj工作階段, obj參數) {
  檢查必要參數(obj參數, ['str提醒ID', 'str處理狀態'], '處理提醒');
  const str處理狀態 = String(obj參數.str處理狀態).trim();
  if (str處理狀態 !== obj法會提醒狀態.已處理 && str處理狀態 !== obj法會提醒狀態.忽略) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '提醒只能標記為「已處理」或「忽略」。');
  }
  const obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);
  const str提醒ID = String(obj參數.str提醒ID).trim();

  return 執行並鎖定(function () {
    const obj表 = 取得法會分頁_(obj主控台, '修改提醒');
    const obj列 = 依條件尋找資料列(obj表.obj分頁, obj表.arr欄位, function (obj值) {
      return String(obj值['提醒ID']).trim() === str提醒ID;
    })[0];
    if (!obj列) {
      throw new 平台錯誤(obj錯誤代碼.資料列不存在, '找不到這則提醒，可能已被處理，請重新整理。');
    }

    // 必須是能整理這場活動的人
    const obj活動 = 取得法會活動_(obj主控台, obj列.obj值['活動ID']);
    檢查活動權限_(obj工作階段, obj活動.obj值, obj法會權限.整理資料, '處理提醒');

    更新資料列(obj表.obj分頁, obj列.int列號, {
      '處理狀態': str處理狀態,
      '處理人': obj工作階段.str姓名 || obj工作階段.str帳號,
      '處理時間': new Date()
    });
    return { bool成功: true, str訊息: `已標記為「${str處理狀態}」。` };
  }, '處理提醒');
}
