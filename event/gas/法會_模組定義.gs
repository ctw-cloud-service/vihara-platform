  str活動流水號名稱: '法會活動',
  str活動ID前綴: 'A',

  // 活動名稱限制（大車點名系統會以名稱建立分頁，分頁名稱不可含這些符號）
  int活動名稱最長: 40,
  reg活動名稱禁用字元: /[\[\]\*\?\/\\:]/,

