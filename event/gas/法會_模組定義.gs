/**
 * ============================================================================
 * 函式名稱：開啟法會主控台_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：開啟某精舍的法會活動主控台；精舍尚未開通時，平台會給出白話說明。
 * 參數：
 *   str精舍代號   {string} 精舍代號
 * 傳回：{Spreadsheet} 主控台
 * ============================================================================
 */
function 開啟法會主控台_(str精舍代號) {
  const str主控台ID = 取得模組主控台ID(str精舍代號, obj法會設定.str模組代號);
  return 開啟試算表(str主控台ID, '法會活動主控台');
}


/**
 * ============================================================================
 * 函式名稱：取得法會分頁_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：依主控台結構的鍵取得分頁與欄位定義，例如「活動清單」。
 * 參數：
 *   obj主控台   {Spreadsheet} 主控台
 *   str結構鍵   {string}      主控台結構_event 的鍵：活動清單／已同步紀錄／修改提醒
 * 傳回：{Object} { obj分頁, arr欄位 }
 * ============================================================================
 */
function 取得法會分頁_(obj主控台, str結構鍵) {
  const obj定義 = 主控台結構_event()[str結構鍵];
  return { obj分頁: 取得工作表(obj主控台, obj定義.str分頁), arr欄位: obj定義.arr欄位 };
}


/**
 * ============================================================================
 * 函式名稱：讀取法會活動清單_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：讀出主控台「活動清單」所有活動（活動ID 空白的列略過）。
 * 參數：
 *   obj主控台   {Spreadsheet} 主控台
 * 傳回：{Object[]} [ { int列號, obj值 } ]
 * ============================================================================
 */
function 讀取法會活動清單_(obj主控台) {
  const obj表 = 取得法會分頁_(obj主控台, '活動清單');
  return 讀取全部資料列(obj表.obj分頁, obj表.arr欄位).filter(function (obj列) {
    return String(obj列.obj值['活動ID']).trim() !== '';
  });
}


/**
 * ============================================================================
 * 函式名稱：取得法會活動_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：依活動ID 找出一場活動；找不到時給出白話說明。
 * 參數：
 *   obj主控台   {Spreadsheet} 主控台
 *   str活動ID   {string}      例如 A0001
 * 傳回：{Object} { int列號, obj值 }
 * ============================================================================
 */
function 取得法會活動_(obj主控台, str活動ID) {
  const str目標 = String(str活動ID || '').trim();
  if (str目標 === '') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '沒有指定是哪一場活動，請重新整理頁面後再試。');
  }
  const arr符合 = 讀取法會活動清單_(obj主控台).filter(function (obj列) {
    return String(obj列.obj值['活動ID']).trim() === str目標;
  });
  if (arr符合.length === 0) {
    throw new 平台錯誤(obj錯誤代碼.資料列不存在, `找不到活動「${str目標}」，可能已被移除，請重新整理頁面。`);
  }
  return arr符合[0];
}


/**
 * ============================================================================
 * 函式名稱：分割帳號清單_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：把「a@x.com, b@y.com」或陣列整理成不重複、小寫的帳號清單。
 * 參數：
 *   any帳號   {string|string[]} 逗號（全形、半形）、分號或換行分隔的文字，或陣列
 * 傳回：{string[]}
 * ============================================================================
 */
function 分割帳號清單_(any帳號) {
  const arr原始 = Array.isArray(any帳號) ? any帳號 : String(any帳號 || '').split(/[,，;；\s]+/);
  const arr結果 = [];
  arr原始.forEach(function (str帳號) {
    const str值 = 正規化帳號(str帳號);
    if (str值 !== '' && arr結果.indexOf(str值) === -1) arr結果.push(str值);
  });
  return arr結果;
}


/**
 * ============================================================================
 * 函式名稱：是否為活動承辦人_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：登入者的帳號是否列在這場活動的「承辦人」欄中。
 * 參數：
 *   obj工作階段   {Object} 工作階段
 *   obj活動值     {Object} 活動清單一列的 obj值
 * 傳回：{boolean}
 * ============================================================================
 */
function 是否為活動承辦人_(obj工作階段, obj活動值) {
  if (!obj工作階段 || !obj工作階段.str帳號) return false;
  return 分割帳號清單_(obj活動值['承辦人']).indexOf(正規化帳號(obj工作階段.str帳號)) !== -1;
}


/**
 * ============================================================================
 * 函式名稱：可看見法會活動_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：精舍管理員看得到全部活動；承辦人只看得到被指派的活動。
 * 參數：
 *   obj工作階段   {Object} 工作階段
 *   obj活動值     {Object} 活動清單一列的 obj值
 * 傳回：{boolean}
 * ============================================================================
 */
function 可看見法會活動_(obj工作階段, obj活動值) {
  if (!obj工作階段) return false;
  if (obj工作階段.str角色 === obj角色.精舍管理員) return true;
  if (obj工作階段.str角色 === obj角色.承辦人) return 是否為活動承辦人_(obj工作階段, obj活動值);
  return false;
}


/**
 * ============================================================================
 * 函式名稱：檢查活動權限_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   檢查登入者能不能對「這一場」活動做某件事：
 *     ① 先用平台的「檢查權限」確認有這個權限項目（精舍管理員一律有）
 *     ② 承辦人還必須是這場活動的承辦人
 *   不通過時丟出白話錯誤。
 *
 * 參數：
 *   obj工作階段   {Object} 工作階段
 *   obj活動值     {Object} 活動清單一列的 obj值
 *   str權限項目   {string} 例如 obj法會權限.整理資料
 *   str作業名稱   {string} 給使用者看的動作名稱，例如「同步報名資料」
 * 傳回：無
 * ============================================================================
 */
function 檢查活動權限_(obj工作階段, obj活動值, str權限項目, str作業名稱) {
  // ① 權限項目
  檢查權限(obj工作階段, str權限項目, str作業名稱);

  // ② 精舍管理員不限活動；承辦人要被指派到這場活動
  if (obj工作階段.str角色 === obj角色.精舍管理員) return;
  if (obj工作階段.str角色 === obj角色.承辦人 && 是否為活動承辦人_(obj工作階段, obj活動值)) return;

  throw new 平台錯誤(
    obj錯誤代碼.權限不足,
    `您不是「${obj活動值['活動名稱']}」的承辦人，無法「${str作業名稱}」。如需處理，請洽精舍管理員指派。`,
    { str活動ID: obj活動值['活動ID'], str帳號: obj工作階段.str帳號 }
  );
}


/**
 * ============================================================================
 * 函式名稱：檢查活動狀態_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：活動狀態不在允許清單中時，丟出說明「目前狀態、哪些狀態才能做」的錯誤。
 * 參數：
 *   obj活動值     {Object}   活動清單一列的 obj值
 *   arr允許狀態   {string[]} 例如 arr法會可同步狀態
 *   str作業名稱   {string}   給使用者看的動作名稱
 * 傳回：無
 * ============================================================================
 */
function 檢查活動狀態_(obj活動值, arr允許狀態, str作業名稱) {
  const str狀態 = String(obj活動值['活動狀態']).trim();
  if (arr允許狀態.indexOf(str狀態) !== -1) return;

  // 正式期與結束各有固定的說明，讓承辦人知道下一步
  let str補充 = '';
  if (str狀態 === obj法會活動狀態.正式) str補充 = '正式期的名單請直接在大車點名系統修改。';
  if (str狀態 === obj法會活動狀態.結束) str補充 = '活動已結束；如需再處理，請精舍管理員「重新開啟」。';

  throw new 平台錯誤(
    obj錯誤代碼.參數錯誤,
    `「${obj活動值['活動名稱']}」目前是「${str狀態}」，「${str作業名稱}」只能在「${arr允許狀態.join('」或「')}」時進行。${str補充}`
  );
}


/**
 * ============================================================================
 * 函式名稱：開啟活動副本_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：開啟活動的整理副本；活動沒有副本或副本打不開時給出白話說明。
 * 參數：
 *   obj活動值   {Object} 活動清單一列的 obj值
 * 傳回：{Spreadsheet} 副本
 * ============================================================================
 */
function 開啟活動副本_(obj活動值) {
  const str副本ID = String(obj活動值['副本ID'] || '').trim();
  if (str副本ID === '') {
    throw new 平台錯誤(obj錯誤代碼.設定缺漏, `「${obj活動值['活動名稱']}」沒有整理副本，請通知精舍管理員。`);
  }
  return 開啟試算表(str副本ID, `「${obj活動值['活動名稱']}」的整理副本`);
}


/**
 * ============================================================================
 * 函式名稱：取得副本分頁_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   取得副本中的分頁。副本是承辦人可以直接整理的試算表，分頁可能被改名，
 *   找不到時列出目前的分頁名稱，方便承辦人改回。
 * 參數：
 *   obj副本       {Spreadsheet} 副本
 *   str分頁名稱   {string}      例如「有效資料」
 * 傳回：{Sheet}
 * ============================================================================
 */
function 取得副本分頁_(obj副本, str分頁名稱) {
  const obj分頁 = obj副本.getSheetByName(str分頁名稱);
  if (obj分頁) return obj分頁;
  const str現有 = obj副本.getSheets().map(function (o) { return o.getName(); }).join('、');
  throw new 平台錯誤(
    obj錯誤代碼.工作表不存在,
    `副本中找不到「${str分頁名稱}」分頁（可能被改名了），請把分頁名稱改回「${str分頁名稱}」。目前的分頁有：${str現有}`
  );
}


/**
 * ============================================================================
 * 函式名稱：更新法會活動_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：在鎖定中更新活動清單的一列（只改指定欄位）。
 *       列號可能因其他人同時新增活動而不變（新增只加在最後），
 *       但為了保險，鎖定中再以活動ID 確認一次列號。
 * 參數：
 *   obj主控台     {Spreadsheet} 主控台
 *   str活動ID     {string}      活動ID
 *   obj欄位值     {Object}      { 欄位名稱: 新值 }
 * 傳回：無
 * ============================================================================
 */
function 更新法會活動_(obj主控台, str活動ID, obj欄位值) {
  執行並鎖定(function () {
    const obj活動 = 取得法會活動_(obj主控台, str活動ID);
    const obj表 = 取得法會分頁_(obj主控台, '活動清單');
    更新資料列(obj表.obj分頁, obj活動.int列號, obj欄位值);
  }, '更新活動資料');
}


/**
 * ============================================================================
 * 函式名稱：以活動作業鎖執行_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   同步報名、移除重複等「同一場活動不能兩人同時做」的長時間作業。
 *   作法：在平台鎖內「檢查並登記」這場活動正在執行（只花零點幾秒），
 *   接著放開平台鎖去做長時間的工作，做完再登記解除。
 *   因此只擋同一場活動，不會擋到其他活動、其他精舍與現場報到。
 *   作業異常中斷時，登記最晚 6 分鐘後自動失效。
 *
 * 參數：
 *   str精舍代號   {string}   精舍代號
 *   str活動ID     {string}   活動ID
 *   str作業名稱   {string}   例如「同步報名資料」，忙碌時顯示給使用者
 *   fn工作        {Function} 要執行的工作，其傳回值原樣傳回
 * 傳回：{*} fn工作 的傳回值
 * ============================================================================
 */
function 以活動作業鎖執行_(str精舍代號, str活動ID, str作業名稱, fn工作) {
  const obj快取 = CacheService.getScriptCache();
  const str鍵 = `${str法會作業鎖前綴}${正規化精舍代號(str精舍代號)}_${String(str活動ID).trim()}`;
  const str識別 = 產生識別碼();

  // ① 在平台鎖內檢查並登記
  執行並鎖定(function () {
    const str既有 = obj快取.get(str鍵);
    if (str既有) {
      let obj既有 = {};
      try { obj既有 = JSON.parse(str既有); } catch (err) { obj既有 = {}; }
      throw new 平台錯誤(
        obj錯誤代碼.系統忙碌,
        `這場活動目前有人正在「${obj既有.str作業名稱 || '處理資料'}」，請等一下（約一分鐘）再試。`
      );
    }
    obj快取.put(str鍵, JSON.stringify({ str識別: str識別, str作業名稱: str作業名稱 }), obj法會設定.int作業鎖秒數);
  }, str作業名稱);

  // ② 做長時間的工作；③ 不論成功失敗都解除（只解除自己登記的那一筆）
  try {
    return fn工作();
  } finally {
    try {
      const str目前 = obj快取.get(str鍵);
      if (str目前 && JSON.parse(str目前).str識別 === str識別) obj快取.remove(str鍵);
    } catch (err) {
      console.warn('解除活動作業鎖失敗：' + (err && err.message ? err.message : err));
    }
  }
}


/**
 * ============================================================================
 * 函式名稱：建立計時器_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：長時間作業用來判斷「是不是該停下來了」，避免超過 GAS 6 分鐘上限而中斷。
 * 參數：
 *   int秒數   {number} 選填，預設 obj法會設定.int作業秒數上限
 * 傳回：{Object} { bool已逾時: Function }
 * ============================================================================
 */
function 建立計時器_(int秒數) {
  const int開始 = new Date().getTime();
  const int上限毫秒 = (int秒數 || obj法會設定.int作業秒數上限) * 1000;
  return {
    bool已逾時: function () { return new Date().getTime() - int開始 > int上限毫秒; }
  };
}


/**
 * ============================================================================
 * 函式名稱：轉為日期文字_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：試算表讀出的日期（Date）轉成給前端看的文字；不是日期就轉成去空白的文字。
 * 參數：
 *   any值     {*}      儲存格的值
 *   str格式   {string} 選填，預設 'yyyy-MM-dd HH:mm'
 * 傳回：{string}
 * ============================================================================
 */
function 轉為日期文字_(any值, str格式) {
  if (Object.prototype.toString.call(any值) === '[object Date]' && !isNaN(any值.getTime())) {
    return 格式化日期(any值, str格式 || 'yyyy-MM-dd HH:mm');
  }
  return String(any值 === null || any值 === undefined ? '' : any值).trim();
}
