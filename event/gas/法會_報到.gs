/**
 * ============================================================================
 * 函式名稱：讀取報到異動
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：action「event.讀取報到異動」。表格每約 15 秒呼叫：紀錄筆數和畫面上的相同時只回「沒有異動」，
 *       不同時回傳整份表格（其他電腦打的勾、新增的現場報到者）。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID（補登）, str場次, int紀錄數 }
 * 傳回：{Object} { bool有異動, int紀錄數, …表格（有異動時） }
 * ============================================================================
 */
function 讀取報到異動(obj工作階段, obj參數) {
  const obj情境 = 取得報到情境_(obj工作階段, obj參數, '讀取報到異動');
  const arr紀錄 = 讀取報到紀錄_(obj情境.obj副本, obj情境.arr時段名);
  const str場次 = String(obj參數.str場次 || '').trim();
  const int數 = arr紀錄.filter(function (o) { return String(o['場次']).trim() === str場次; }).length;
  if (int數 === Number(obj參數.int紀錄數)) return { bool有異動: false, int紀錄數: int數 };
  return Object.assign({ bool有異動: true }, 讀取表格內容_(obj情境, 解析報到場次_(obj情境, str場次), arr紀錄));
}


/**
 * ============================================================================
 * 函式名稱：表格報到
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：action「event.表格報到」。表格點一格：報到或取消（bool取消）。
 *       志工記「表格」（刷碼頁以姓名搜尋到的記「搜尋姓名」）；補登預設「紙本」。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID（補登）, str場次, str人員鍵, int時段, bool取消, str方式, str裝置 }
 * 傳回：{Object} { str鍵, int時段, bool已報到, str時間, str方式, str報名狀態, str訊息 }
 * ============================================================================
 */
function 表格報到(obj工作階段, obj參數) {
  const obj情境 = 取得報到情境_(obj工作階段, obj參數, '報到');
  const obj場次 = 解析報到場次_(obj情境, obj參數.str場次);
  const int時段 = 檢查報到時段序_(obj參數.int時段, obj情境.arr時段);
  const arr紀錄 = 讀取報到紀錄_(obj情境.obj副本, obj情境.arr時段名);
  const obj人 = 找出表格人員_(obj場次, arr紀錄, obj參數.str人員鍵);
  const bool取消 = obj參數.bool取消 === true;
  const obj結果 = 寫入報到_(obj情境, obj場次, obj人, int時段, bool取消, 決定報到方式_(obj情境, obj參數.str方式), obj參數.str裝置, arr紀錄);

  const str時段 = obj情境.arr時段名[int時段];
  let str訊息;
  if (bool取消) str訊息 = obj結果.bool已寫入 ? `已取消 ${obj人.str姓名}「${str時段}」的報到。` : `${obj人.str姓名}「${str時段}」本來就沒有報到。`;
  else str訊息 = obj結果.bool已寫入 ? `${obj人.str姓名}「${str時段}」報到完成（${obj結果.str報名狀態}）。` : `${obj人.str姓名}「${str時段}」已報到（${obj結果.str時間}）。`;
  if (obj結果.bool恢復參加) str訊息 += '（原本登記取消參加，已自動恢復）';
  return {
    str鍵: obj人.str鍵, int時段: int時段, bool已報到: !bool取消, str時間: obj結果.str時間, str方式: obj結果.str方式,
    str報名狀態: obj結果.str報名狀態, bool重複: !bool取消 && !obj結果.bool已寫入, str訊息: str訊息
  };
}


/**
 * ============================================================================
 * 函式名稱：刷碼報到
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.刷碼報到」（決策 R、T、Q）。刷到學員編號 → 比對名冊 →
 *   記錄（不擋人：未報名、查不到的編號都照樣記錄）；同一時段重刷顯示「已報到（時間）」。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str場次, str學員編號, int時段, str裝置 }
 * 傳回：{Object} { str姓名, str法名, str學員編號, str報名狀態, str報名登記, str提醒, bool重複, str時間, bool待補姓名, str訊息, str鍵 }
 * ============================================================================
 */
function 刷碼報到(obj工作階段, obj參數) {
  const obj情境 = 取得報到情境_(obj工作階段, obj參數, '刷碼報到');
  const str編號 = 正規化學員編號(obj參數.str學員編號);
  if (str編號 === '') throw new 平台錯誤(obj錯誤代碼.參數錯誤, '沒有讀到學員編號，請再刷一次。');
  const obj場次 = 解析報到場次_(obj情境, obj參數.str場次);
  const int時段 = 檢查報到時段序_(obj參數.int時段, obj情境.arr時段);

  // 名冊編號相同就不必查學員名冊；查學員名冊失敗（例如尚未登記）時當作查不到
  let obj學員 = null;
  if (!obj場次.arr名冊.some(function (o) { return String(o.str學員編號).toUpperCase() === str編號.toUpperCase(); })) {
    try { obj學員 = 依編號查詢學員(obj工作階段.str精舍代號, str編號); } catch (err) { obj學員 = null; }
  }
  const obj比對 = 比對報到人員_(str編號, obj場次.arr名冊, obj學員);
  const obj人 = Object.assign({}, obj比對, { str備註: obj比對.bool待補姓名 ? '待補姓名' : '' });
  const obj結果 = 寫入報到_(obj情境, obj場次, obj人, int時段, false, obj報到格式.obj方式.刷碼, obj參數.str裝置);

  const str時段 = obj情境.arr時段名[int時段];
  const str名 = obj比對.str姓名 || `編號 ${str編號}`;
  return {
    str鍵: obj比對.str鍵, str姓名: obj比對.str姓名, str法名: obj比對.str法名, str學員編號: obj比對.str學員編號,
    str報名狀態: obj結果.str報名狀態,
    str報名登記: obj比對.obj名冊人員 ? obj比對.obj名冊人員.str報名登記 : '',
    str提醒: obj比對.obj名冊人員 ? 提醒簡稱_(obj比對.obj名冊人員.str提醒) : '',
    bool重複: obj結果.bool原本已報到, str時間: obj結果.str時間, bool待補姓名: obj比對.bool待補姓名, str時段: str時段,
    str訊息: obj結果.bool原本已報到 ? `${str名}「${str時段}」已報到（${obj結果.str時間}）。`
      : `${str名}「${str時段}」報到完成（${obj結果.str報名狀態}）。${obj比對.bool待補姓名 ? '學員名冊查不到這個編號，已記錄，請承辦人事後補姓名。' : ''}`
        + (obj結果.bool恢復參加 ? '（原本登記取消參加，已自動恢復）' : '')
  };
}


/**
 * ============================================================================
 * 函式名稱：查詢報到人員
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.查詢報到人員」。依姓名（部分文字）或學員編號找人（搜尋姓名報到、新增未報名者）：
 *     · arr表格：這個場次表格上的人（名冊＋現場報到區）
 *     · arr其他：表格上沒有的人——本活動其他場次的名冊、學員名冊（各帶學員編號與法名）
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID（補登）, str場次, str關鍵字 }
 * 傳回：{Object} { arr表格: [ { str鍵, str姓名, str法名, int序號 } ], arr其他: [ { str學員編號, str姓名, str法名, str來源 } ] }
 * ============================================================================
 */
function 查詢報到人員(obj工作階段, obj參數) {
  const str關鍵 = 正規化人名(obj參數.str關鍵字);
  if (str關鍵 === '') throw new 平台錯誤(obj錯誤代碼.參數錯誤, '請輸入姓名或學員編號。');
  const obj情境 = 取得報到情境_(obj工作階段, obj參數, '查詢報到人員');
  const obj場次 = 解析報到場次_(obj情境, obj參數.str場次);
  const int上限 = obj報到格式.int搜尋上限;
  const fn符合 = function (str姓名, str編號) { return String(str姓名 || '').indexOf(str關鍵) !== -1 || 正規化學員編號(str編號) === 正規化學員編號(str關鍵); };

  // ① 表格上的人
  const obj表格 = 讀取表格內容_(obj情境, obj場次);
  const arr表格 = obj表格.arr列.filter(function (o) { return fn符合(o.str姓名, o.str學員編號); }).slice(0, int上限)
    .map(function (o) { return { str鍵: o.str鍵, str姓名: o.str姓名, str法名: o.str法名, int序號: o.int序號, bool現場: o.bool現場 }; });

  // ② 其他：本活動其他場次的名冊、學員名冊（同一學員編號只列一次；表格上已有的不列）
  const obj已列 = {};
  obj表格.arr列.forEach(function (o) { if (o.str學員編號) obj已列[o.str學員編號] = true; });
  const arr其他 = [];
  const fn加入 = function (str編號, str姓名, str法名, str來源) {
    const str號 = 正規化學員編號(str編號);
    if (str號 === '' || obj已列[str號] || arr其他.length >= int上限) return;
    obj已列[str號] = true;
    arr其他.push({ str學員編號: str號, str姓名: 正規化人名(str姓名), str法名: 正規化人名(str法名), str來源: str來源 });
  };
  列出名冊分頁_(obj情境.obj副本).forEach(function (o) {
    if (o.str場次 === obj場次.str場次) return;
    讀取名冊分頁內容_(o.obj分頁).arr列.forEach(function (r) { if (fn符合(r['姓名'], r['學員編號'])) fn加入(r['學員編號'], r['姓名'], r['法名'], '本活動其他場次'); });
  });
  try {
    讀取學員名冊(obj工作階段.str精舍代號).arr學員.forEach(function (s) { if (fn符合(s.str姓名, s.str學員編號)) fn加入(s.str學員編號, s.str姓名, s.str法名, '學員名冊'); });
  } catch (err) {
    console.warn('查詢報到人員：學員名冊讀取失敗：' + (err && err.message ? err.message : err));
  }
  return { arr表格: arr表格, arr其他: arr其他 };
}


/**
 * ============================================================================
 * 函式名稱：新增現場報到
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.新增現場報到」（決策 AK、AL）。名冊沒有的人現場報到：
 *     · 有 str學員編號（從查詢結果選的）→ 用這個編號
 *     · 沒有 → 表格已有同名的人時停止並告知序號（避免重複）；本活動其他場次名冊同名 → 沿用編號；
 *       都沒有 → 以姓名＋法名比對學員名冊，找不到當場配發臨時編號；學員名冊有多位同名同法名時列出讓志工選
 *   接著把選的時段都記為報到（只寫報到紀錄，不改名冊）。志工記「臨時」，補登預設「紙本」。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID（補登）, str場次, str姓名, str法名, str學員編號, arr時段, str方式, str裝置 }
 * 傳回：{Object} { bool完成, str鍵, str學員編號, bool臨時編號, str訊息 } 或 { bool完成: false, bool已在表格, int序號, str鍵, str訊息 }
 *        或 { bool完成: false, arr候選: [ { str學員編號, str姓名, str法名 } ], str訊息 }
 * ============================================================================
 */
function 新增現場報到(obj工作階段, obj參數) {
  const str姓名 = 檢查報到姓名_(obj參數.str姓名, '姓名');
  const str法名 = 正規化人名(obj參數.str法名);
  const obj情境 = 取得報到情境_(obj工作階段, obj參數, '新增未報名者');
  const obj場次 = 解析報到場次_(obj情境, obj參數.str場次);
  const arr時段序 = (Array.isArray(obj參數.arr時段) ? obj參數.arr時段 : []).map(function (x) { return 檢查報到時段序_(x, obj情境.arr時段); })
    .filter(function (x, i, a) { return a.indexOf(x) === i; });
  if (arr時段序.length === 0) throw new 平台錯誤(obj錯誤代碼.參數錯誤, '請勾選要報到的時段。');
  const arr紀錄 = 讀取報到紀錄_(obj情境.obj副本, obj情境.arr時段名);

  // ① 決定學員編號
  let str編號 = 正規化學員編號(obj參數.str學員編號);
  let bool臨時 = false;
  if (str編號 === '') {
    const obj表格 = 讀取表格內容_(obj情境, obj場次, arr紀錄);
    const obj同名 = obj表格.arr列.filter(function (o) { return o.str姓名 === str姓名; })[0];
    if (obj同名) {
      return { bool完成: false, bool已在表格: true, int序號: obj同名.int序號, str鍵: obj同名.str鍵,
        str訊息: `表格第 ${obj同名.int序號} 列已有「${str姓名}」${obj同名.str法名 ? `（${obj同名.str法名}）` : ''}，請直接在那一列打勾。若是不同人，請加上法名或從搜尋結果選擇。` };
    }
    列出名冊分頁_(obj情境.obj副本).some(function (o) {
      const r = 讀取名冊分頁內容_(o.obj分頁).arr列.filter(function (x) { return 正規化人名(x['姓名']) === str姓名 && 正規化學員編號(x['學員編號']) !== ''; })[0];
      if (r) str編號 = 正規化學員編號(r['學員編號']);
      return !!r;
    });
    if (str編號 === '') {
      const obj比對 = 比對並配發臨時編號(obj工作階段.str精舍代號, [{ str姓名: str姓名, str法名: str法名 }])[0];
      if (obj比對.arr候選編號 && obj比對.arr候選編號.length > 1) {
        return { bool完成: false, arr候選: obj比對.arr候選編號.map(function (s) { return { str學員編號: s, str姓名: str姓名, str法名: str法名 }; }),
          str訊息: `學員名冊有 ${obj比對.arr候選編號.length} 位「${str姓名}${str法名 ? '（' + str法名 + '）' : ''}」，請選擇是哪一位。` };
      }
      str編號 = obj比對.str學員編號;
      bool臨時 = obj比對.bool臨時編號 === true;
    }
  }

  // ② 名冊其實有這個編號的人 → 記到名冊那一列
  const obj名冊 = obj場次.arr名冊.filter(function (o) { return o.str學員編號 === str編號; })[0] || null;
  const obj人 = obj名冊
    ? { str鍵: obj名冊.str鍵, str學員編號: str編號, str姓名: obj名冊.str姓名, str法名: obj名冊.str法名, obj名冊人員: obj名冊 }
    : { str鍵: 取得人員鍵_(str編號, str姓名), str學員編號: str編號, str姓名: str姓名, str法名: str法名, obj名冊人員: null };
  const str方式 = obj情境.bool志工 ? obj報到格式.obj方式.臨時 : 決定報到方式_(obj情境, obj參數.str方式);
  let arr已記 = 0;
  arr時段序.forEach(function (int時段) {
    if (寫入報到_(obj情境, obj場次, obj人, int時段, false, str方式, obj參數.str裝置).bool已寫入) arr已記 += 1;
  });
  return {
    bool完成: true, str鍵: obj人.str鍵, str學員編號: str編號, bool臨時編號: bool臨時,
    str訊息: `「${obj人.str姓名}」報到完成（${arr時段序.map(function (i) { return obj情境.arr時段名[i]; }).join('、')}）`
      + `${obj名冊 ? '：名冊上有這個人，已記在他那一列' : '：未報名'}${bool臨時 ? `，配發臨時編號 ${str編號}` : `，學員編號 ${str編號}`}。`
      + (arr已記 < arr時段序.length ? '（部分時段原本就已報到）' : '')
  };
}


// ============================================================================
// 己、動作：取消參加（學員請假）、場次取消（v1.1.0）
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：設定取消參加
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.取消參加」（決策 AS）。學員事先說不能來（請假）：在這個場次登記「取消參加」，
 *   之後不列在「未報到」清單；誤按或又能來了，用 bool恢復 改回。志工與補登都可以用。
 *     · 只限名冊上的人（現場報到者本來就不在未報到清單）
 *     · 已報到的人不能取消參加（點錯請先還原成未報到）
 *     · 已經是同樣狀態的人略過（不重複記）
 *   一次可處理多人（arr人員鍵），每人一筆紀錄。
 * 參數：
 *   obj工作階段 {Object}
 *   obj參數 {Object} { str活動ID（補登）, str場次, arr人員鍵（或 str人員鍵）, bool恢復, str原因（選填）, str裝置 }
 * 傳回：{Object} { int完成, arr略過: [ { str姓名, str原因 } ], str訊息 }
 * ============================================================================
 */
function 設定取消參加(obj工作階段, obj參數) {
  const obj情境 = 取得報到情境_(obj工作階段, obj參數, '取消參加');
  const obj場次 = 解析報到場次_(obj情境, obj參數.str場次);
  const bool恢復 = obj參數.bool恢復 === true;
  const str原因 = 整理取消原因_(obj參數.str原因);
  const arr鍵 = (Array.isArray(obj參數.arr人員鍵) ? obj參數.arr人員鍵 : [obj參數.str人員鍵])
    .map(function (k) { return String(k || '').trim(); })
    .filter(function (k, i, a) { return k !== '' && a.indexOf(k) === i; });
  if (arr鍵.length === 0) throw new 平台錯誤(obj錯誤代碼.參數錯誤, '請先勾選要' + (bool恢復 ? '恢復參加' : '取消參加') + '的人。');
  if (arr鍵.length > 200) throw new 平台錯誤(obj錯誤代碼.參數錯誤, '一次最多處理 200 人，請分批。');

  const arr紀錄 = 讀取報到紀錄_(obj情境.obj副本, obj情境.arr時段名);
  const obj狀態 = 計算報到狀態_(arr紀錄, obj場次.str場次);
  let int完成 = 0;
  const arr略過 = [];
  arr鍵.forEach(function (str鍵) {
    const obj名冊 = obj場次.arr名冊.filter(function (o) { return o.str鍵 === str鍵; })[0];
    if (!obj名冊) { arr略過.push({ str姓名: str鍵.replace(/^N:/, ''), str原因: '不在名冊上（現場報到者不必取消參加）' }); return; }
    const obj人 = { str鍵: str鍵, str學員編號: obj名冊.str學員編號, str姓名: obj名冊.str姓名, str法名: obj名冊.str法名, obj名冊人員: obj名冊 };
    const bool已請假 = !!obj狀態.obj取消參加[str鍵];
    if (bool恢復 ? !bool已請假 : bool已請假) { arr略過.push({ str姓名: obj人.str姓名, str原因: bool恢復 ? '本來就沒有取消參加' : '已經是取消參加' }); return; }
    if (!bool恢復 && Object.keys(obj狀態.obj格[str鍵] || {}).length > 0) {
      arr略過.push({ str姓名: obj人.str姓名, str原因: '已報到（點錯請先還原成未報到）' });
      return;
    }
    附加取消參加紀錄_(obj情境, obj場次, obj人, !bool恢復, str原因, obj參數.str裝置);
    int完成 += 1;
  });

  const str作業 = bool恢復 ? '恢復參加' : '取消參加';
  return {
    int完成: int完成, arr略過: arr略過,
    str訊息: `${str作業} ${int完成} 人${str原因 && !bool恢復 ? `（${str原因}）` : ''}。`
      + (arr略過.length > 0 ? `略過 ${arr略過.length} 人：${arr略過.slice(0, 5).map(function (o) { return `${o.str姓名}（${o.str原因}）`; }).join('、')}${arr略過.length > 5 ? '…' : ''}` : '')
  };
}


/**
 * ============================================================================
 * 函式名稱：設定場次取消
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.取消場次」（決策 AT）。某一場次不舉行（例如颱風停課）：記一筆「場次取消」，
 *   之後這個場次不能報到（刷碼、打勾、新增都擋下；取消報到仍可），已有的報到紀錄保留。
 *   bool恢復＝照常舉行（記「場次恢復」）。限承辦人／精舍管理員（權限 event.開放報到），志工不能用。
 *   名冊要已下載（場次清單才有這個場次）。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID, str場次, bool恢復, str原因（選填） }
 * 傳回：{Object} { bool取消, str訊息 }
 * ============================================================================
 */
function 設定場次取消(obj工作階段, obj參數) {
  if (obj工作階段 && obj工作階段.str角色 === obj角色.報到志工) {
    throw new 平台錯誤(obj錯誤代碼.權限不足, '取消場次要由承辦人在法會活動網頁操作。');
  }
  檢查權限(obj工作階段, obj法會權限.開放報到, '取消場次');
  const obj情境 = 取得報到情境_(obj工作階段, obj參數, '取消場次');
  檢查必要參數(obj參數, ['str場次'], '取消場次');
  const obj場次 = 解析報到場次_(obj情境, obj參數.str場次);
  const bool恢復 = obj參數.bool恢復 === true;
  const str原因 = 整理取消原因_(obj參數.str原因);
  const obj目前 = 計算報到狀態_(讀取報到紀錄_(obj情境.obj副本, obj情境.arr時段名), obj場次.str場次).obj場次取消;

  if (bool恢復 && !obj目前) return { bool取消: false, str訊息: `場次「${obj場次.str場次}」本來就沒有取消。` };
  if (!bool恢復 && obj目前) return { bool取消: true, str訊息: `${組合場次取消說明_(obj場次.str場次, obj目前)}。` };

  附加報到紀錄_(obj情境.obj副本, {
    '場次': obj場次.str場次, '場次日期': obj場次.str日期, '時段': '', '人員鍵': obj報到格式.str場次鍵,
    '動作': bool恢復 ? obj報到格式.obj動作.場次恢復 : obj報到格式.obj動作.場次取消,
    '報到時間': new Date(), '報到人員': obj情境.str報到人員, '備註': str原因
  });
  寫入操作日誌(obj工作階段, bool恢復 ? '恢復法會場次' : '取消法會場次',
    `${obj情境.obj活動值['活動ID']} ${obj情境.obj活動值['活動名稱']} ${obj場次.str場次}${str原因 ? '　原因：' + str原因 : ''}`);
  return {
    bool取消: !bool恢復,
    str訊息: bool恢復 ? `場次「${obj場次.str場次}」已恢復，可以照常報到。`
      : `場次「${obj場次.str場次}」已取消${str原因 ? `（${str原因}）` : ''}，這個場次不能再報到；已有的報到紀錄都保留，誤按可「恢復場次」。`
  };
}
