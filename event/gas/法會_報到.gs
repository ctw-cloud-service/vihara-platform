}


/**
 * ============================================================================
 * 函式名稱：報到碼登入
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.報到碼登入」（不需 Google 登入）。報到志工輸入報到碼＋本人姓名：
 *     找出本精舍「報到中」、報到碼相同的對內活動 → 發給只有 event.報到、只限這場活動的工作階段（6 小時）。
 *   同一精舍 10 分鐘內輸錯超過 20 次就暫停嘗試（防止亂猜報到碼）。
 * 參數：obj工作階段 {null}；obj參數 {Object} { str精舍代號, str報到碼, str姓名 }
 * 傳回：{Object} { str工作階段代碼, str活動名稱, str精舍名稱, str姓名 }
 * ============================================================================
 */
function 報到碼登入(obj工作階段, obj參數) {
  const cfg = obj報到格式;
  const str精舍代號 = 正規化精舍代號(obj參數 && obj參數.str精舍代號);
  const str碼 = String((obj參數 && obj參數.str報到碼) || '').replace(/\s/g, '');
  const str姓名 = 檢查報到姓名_(obj參數 && obj參數.str姓名, '您的姓名（報到人員）');
  if (str精舍代號 === '') throw new 平台錯誤(obj錯誤代碼.參數錯誤, '網址缺少精舍代號，請向承辦人索取正確的報到網址。');
  if (!new RegExp(`^[0-9]{${cfg.int報到碼位數}}$`).test(str碼)) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `報到碼是 ${cfg.int報到碼位數} 位數字，請再確認一次。`);
  }

  // 防止亂猜：輸錯次數
  const obj快取 = CacheService.getScriptCache();
  const str嘗試鍵 = cfg.str嘗試快取前綴 + str精舍代號;
  const int已錯 = Number(obj快取.get(str嘗試鍵) || 0);
  if (int已錯 >= cfg.int嘗試上限) throw new 平台錯誤(obj錯誤代碼.系統忙碌, '報到碼輸錯太多次，請 10 分鐘後再試。');

  const obj精舍 = 取得精舍資訊(str精舍代號);
  const obj主控台 = 開啟法會主控台_(str精舍代號);
  const obj活動 = 讀取法會活動清單_(obj主控台).filter(function (o) {
    return String(o.obj值['報到碼'] || '').trim() === str碼
      && String(o.obj值['活動狀態']).trim() === obj法會活動狀態.報到中
      && String(o.obj值['活動類型']).trim() === obj法會活動類型.對內;
  })[0];
  if (!obj活動) {
    obj快取.put(str嘗試鍵, String(int已錯 + 1), cfg.int嘗試秒數);
    throw new 平台錯誤(obj錯誤代碼.登入失敗, '報到碼不正確，或這場活動的報到已暫停。請向承辦人確認報到碼。');
  }

  const obj身分 = {
    str帳號: cfg.str志工帳號, str角色: obj角色.報到志工, str精舍代號: obj精舍.str精舍代號, str精舍名稱: obj精舍.str精舍名稱,
    str姓名: str姓名, arr權限: [obj法會權限.報到], str活動ID: String(obj活動.obj值['活動ID']).trim(), str報到碼: str碼
  };
  const str代碼 = 建立工作階段(obj身分);
  寫入操作日誌(obj身分, '報到碼登入', `${obj身分.str活動ID}：${str姓名}`);
  return {
    str工作階段代碼: str代碼, str活動名稱: String(obj活動.obj值['活動名稱']).trim(),
    str精舍名稱: obj精舍.str精舍名稱, str姓名: str姓名
  };
}


