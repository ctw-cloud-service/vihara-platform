/**
 * ============================================================================
 * 函式名稱：產生不重複報到碼_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：6 位數報到碼，與本精舍其他報到中的活動、以及舊碼都不同。
 * 參數：obj主控台 {Spreadsheet}；str舊碼 {string}
 * 傳回：{string}
 * ============================================================================
 */
function 產生不重複報到碼_(obj主控台, str舊碼) {
  const arr已用 = 讀取法會活動清單_(obj主控台).map(function (o) { return String(o.obj值['報到碼'] || '').trim(); });
  for (let i = 0; i < 50; i++) {
    const str碼 = 產生數字碼(obj報到格式.int報到碼位數);
    if (str碼 !== str舊碼 && arr已用.indexOf(str碼) === -1) return str碼;
  }
  throw new 平台錯誤(obj錯誤代碼.未預期錯誤, '暫時無法產生報到碼，請再試一次。');
}


/**
 * ============================================================================
 * 函式名稱：開放法會報到
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：action「event.開放報到」。對內活動「收件中」→「報到中」，產生報到碼。
 *       已在報到中時傳回目前的報到碼（不換碼）。權限 event.開放報到。
 *       報到中仍可下載新報名、下載場次名冊。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID }
 * 傳回：{Object} { str訊息, str報到碼 }
 * ============================================================================
 */
function 開放法會報到(obj工作階段, obj參數) {
  檢查必要參數(obj參數, ['str活動ID'], '開放報到');
  const obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);
  const obj值 = 取得法會活動_(obj主控台, obj參數.str活動ID).obj值;
  檢查活動權限_(obj工作階段, obj值, obj法會權限.開放報到, '開放報到');
  檢查是對內活動_(obj值);
  const str狀態 = String(obj值['活動狀態']).trim();
  if (str狀態 === obj法會活動狀態.報到中 && String(obj值['報到碼'] || '').trim() !== '') {
    return { str訊息: '報到已經開放。', str報到碼: String(obj值['報到碼']).trim() };
  }
  檢查活動狀態_(obj值, [obj法會活動狀態.收件中, obj法會活動狀態.報到中], '開放報到');

  const str碼 = 產生不重複報到碼_(obj主控台, '');
  更新法會活動_(obj主控台, obj值['活動ID'], { '活動狀態': obj法會活動狀態.報到中, '報到碼': str碼, '報到碼產生時間': new Date() });
  寫入操作日誌(obj工作階段, '開放報到', `${obj值['活動ID']}：報到碼 ${str碼}`);
  return { str訊息: `已開放「${obj值['活動名稱']}」報到，報到碼 ${str碼}。請把報到網址與報到碼交給報到志工。`, str報到碼: str碼 };
}


