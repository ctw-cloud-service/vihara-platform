// ============================================================================
// 檔案名稱：法會_報到.gs
// 所屬模組：法會活動（event）
// 所屬層級：模組／服務層＋控制層
// 檔案版本：v1.1.0（2026-11-07）
//   v1.1.0：取消（決策 AS～AU）：
//     · 學員取消參加（請假）：報到紀錄記「取消參加／恢復參加」（整個場次），不列入未報到；之後又來報到時自動恢復
//     · 場次取消：報到紀錄記「場次取消／場次恢復」（人員鍵「＊」），取消後這個場次不能再報到（已有紀錄保留）
//     · 點錯報到者還原成未報到：沿用「取消報到」（前端可一次勾選多人）
//     · 整場活動取消在 法會_活動管理（活動狀態「取消」）
// 用途說明：
//   法會報到第③-2、③-3 批：報到碼、報到紀錄、刷碼報到、表格打勾、新增未報名者、補登。
//
//   三種報到方式寫入同一份副本分頁「報到紀錄」（只新增、不刪除）：
//     ① 刷碼：報到志工在 checkin.html 刷學員證（報到方式「刷碼」；搜尋姓名找到的記「搜尋姓名」）
//     ② 表格：報到志工在 checkin.html 的表格直接打勾（「表格」）；名冊沒有的人用「新增未報名者」（「臨時」）
//     ③ 紙本：承辦人在法會活動網頁「補登」，照紙本打勾（預設「紙本」）
//   同一人同一場次同一時段：以報到紀錄的「最後一筆」為準（報到／取消報到），多台同時操作不互相覆蓋。
//
//   身分：
//     · 報到志工：精舍管理員或承辦人「開放報到」後產生 6 位數報到碼；志工在 checkin.html 輸入報到碼＋本人姓名，
//       取得只有 event.報到 權限、只限這一場活動的工作階段；每次動作都確認活動仍在「報到中」且報到碼沒有更換。
//       只能處理當天的場次。
//     · 承辦人／精舍管理員（補登）：Google 登入，權限 event.整理資料、須為活動承辦人，可處理任一已下載名冊的場次。
//
//   規劃與決策：06-01-01 法會活動\文件\法會活動_法會報到_規劃.md（v1.6，決策 O～T、Y、AA、AG～AM）
//
//   ※ GAS 依檔名排序載入，本檔頂層常數自給自足，不引用其他檔案的常數。
//
// 相依檔案：
//   平台核心（核心_錯誤、核心_工具、核心_驗證、核心_權限、核心_租戶解析、核心_日誌、核心_學員名冊）
//   法會_模組定義（活動、權限、狀態、更新活動）
//   法會_報到名冊（名冊分頁、取得對內活動_、取得場次基準日_、檢查是對內活動_）
//   法會_報到表（時段、取得名冊報到人員_、排序報到人員_、取得活動時段_、產生報名登記_）
//   法會_大車匯出（擷取月日_、推算月日日期_）
// ============================================================================


// ----------------------------------------------------------------------------
// 報到格式
// ----------------------------------------------------------------------------
const obj報到格式 = Object.freeze({
  str紀錄分頁: '報到紀錄',
  arr紀錄欄位: Object.freeze(['紀錄ID', '場次', '場次日期', '時段', '人員鍵', '學員編號', '姓名', '法名',
    '報名狀態', '報到方式', '動作', '報到時間', '報到人員', '使用裝置', '備註']),
  obj動作: Object.freeze({
    報到: '報到', 取消: '取消報到',
    取消參加: '取消參加', 恢復參加: '恢復參加',      // v1.1.0：學員請假（整個場次）
    場次取消: '場次取消', 場次恢復: '場次恢復'       // v1.1.0：整個場次取消（人員鍵＝str場次鍵）
  }),
  str場次鍵: '＊',                     // v1.1.0：場次取消紀錄的人員鍵
  int原因最長: 50,                     // v1.1.0：取消原因最多字數
  obj方式: Object.freeze({ 刷碼: '刷碼', 搜尋姓名: '搜尋姓名', 臨時: '臨時', 表格: '表格', 紙本: '紙本' }),
  obj報名狀態: Object.freeze({ 已報名: '已報名', 本時段未報名: '未報名（本時段）', 未報名: '未報名' }),
  arr志工方式: Object.freeze(['表格', '搜尋姓名', '臨時']),     // 志工可指定的報到方式（刷碼由刷碼動作自動記）
  arr補登方式: Object.freeze(['紙本', '表格']),                 // 補登可選的報到方式
  str單一時段名稱: '報到',
  int報到碼位數: 6,
  int嘗試上限: 20,                     // 同一精舍 10 分鐘內輸錯報到碼的上限（防止亂猜）
  int嘗試秒數: 600,
  str嘗試快取前綴: '法會報到嘗試_',
  int姓名最長: 20,
  int搜尋上限: 10,
  str志工帳號: '報到志工'
});


// ============================================================================
// 甲、純計算（不碰檔案）
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：判斷目前時段_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：刷碼時依目前時間自動選時段（決策 AA）：
 *   在某時段內 → 該時段；開始前或兩個時段之間 → 下一個時段；最後一個結束後 → 最後一個。
 *   不分時段 → 0。
 * 參數：arr時段 {Object[]}（解析時段設定_ 的結果）；int分鐘 {number} 一天中的第幾分鐘
 * 傳回：{number} 時段序（0 起算）
 * ============================================================================
 */
function 判斷目前時段_(arr時段, int分鐘) {
  if (!arr時段 || arr時段.length < 2) return 0;
  for (let i = 0; i < arr時段.length; i++) {
    if (int分鐘 < arr時段[i].int迄) return i;     // 還沒結束：在時段內或時段之前，都算這一個
  }
  return arr時段.length - 1;
}


/**
 * ============================================================================
 * 函式名稱：取得人員鍵_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：報到紀錄辨認「同一人」的鍵：有學員編號用編號；沒有（名冊同名同法名待填）用「N:姓名」。
 * 參數：str學員編號 {string}；str姓名 {string}
 * 傳回：{string}
 * ============================================================================
 */
function 取得人員鍵_(str學員編號, str姓名) {
  const str編號 = 正規化學員編號(str學員編號);
  return str編號 !== '' ? str編號 : `N:${正規化人名(str姓名)}`;
}


/**
 * ============================================================================
 * 函式名稱：時間轉時分_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：報到時間 → 「13:52」（不是日期時傳回原文字）。
 * 參數：any {*}
 * 傳回：{string}
 * ============================================================================
 */
function 時間轉時分_(any) {
  if (Object.prototype.toString.call(any) === '[object Date]' && !isNaN(any.getTime())) {
    return 格式化日期(any, 'HH:mm');
  }
  return String(any === null || any === undefined ? '' : any).trim();
}


/**
 * ============================================================================
 * 函式名稱：計算報到狀態_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   依報到紀錄（依列的先後）算出這個場次每人每時段目前是否已報到：同一人同一時段以最後一筆為準
 *   （決策 AI）。也記下紀錄中出現過的每個人（現場報到區要用）與第一次報到的時間。
 * 參數：
 *   arr紀錄   {Object[]} 報到紀錄每一列 { 欄名: 值 }
 *   str場次   {string}
 * 傳回：{Object} {
 *   obj格: { 人員鍵: { 時段序: { str時間, str方式 } } },   // 只列「目前已報到」的格
 *   obj人員: { 人員鍵: { str學員編號, str姓名, str法名, int首次序 } },
 *   obj取消參加: { 人員鍵: { str時間, str人員, str原因 } },   // v1.1.0：目前登記取消參加（請假）的人
 *   obj場次取消: { str時間, str人員, str原因 } | null,        // v1.1.0：這個場次目前是否取消
 *   int紀錄數   // 這個場次的紀錄筆數（含取消），前端用來判斷有沒有異動
 * }
 * 版本記錄：v1.1.0 加入取消參加、場次取消（不影響報到格；也不把只有取消參加紀錄的人列入現場報到區）
 * ============================================================================
 */
function 計算報到狀態_(arr紀錄, str場次) {
  const obj結果 = { obj格: {}, obj人員: {}, obj取消參加: {}, obj場次取消: null, int紀錄數: 0 };
  const obj動 = obj報到格式.obj動作;
  (arr紀錄 || []).forEach(function (o, i) {
    if (String(o['場次'] === undefined ? '' : o['場次']).trim() !== str場次) return;
    obj結果.int紀錄數 += 1;
    const str鍵 = String(o['人員鍵'] || '').trim();
    if (str鍵 === '') return;
    const str動作 = String(o['動作'] || '').trim();
    const obj說明 = { str時間: 時間轉時分_(o['報到時間']), str人員: String(o['報到人員'] || '').trim(), str原因: String(o['備註'] || '').trim() };

    // v1.1.0：場次取消／恢復（最後一筆為準）
    if (str動作 === obj動.場次取消) { obj結果.obj場次取消 = obj說明; return; }
    if (str動作 === obj動.場次恢復) { obj結果.obj場次取消 = null; return; }
    // v1.1.0：學員取消參加／恢復參加（最後一筆為準）
    if (str動作 === obj動.取消參加) { obj結果.obj取消參加[str鍵] = obj說明; return; }
    if (str動作 === obj動.恢復參加) { delete obj結果.obj取消參加[str鍵]; return; }
    const int時段 = Number(o['時段序'] !== undefined ? o['時段序'] : 0) || 0;

    // 記下這個人（姓名以最後一筆有寫的為準，例如待補姓名事後補上）
    const obj人 = obj結果.obj人員[str鍵] || { str學員編號: '', str姓名: '', str法名: '', int首次序: i };
    if (String(o['學員編號'] || '').trim() !== '') obj人.str學員編號 = String(o['學員編號']).trim();
    if (String(o['姓名'] || '').trim() !== '') obj人.str姓名 = String(o['姓名']).trim();
    if (String(o['法名'] || '').trim() !== '') obj人.str法名 = String(o['法名']).trim();
    obj結果.obj人員[str鍵] = obj人;

    // 最後一筆為準
    const obj人格 = obj結果.obj格[str鍵] || {};
    if (String(o['動作']).trim() === obj報到格式.obj動作.取消) delete obj人格[int時段];
    else obj人格[int時段] = { str時間: 時間轉時分_(o['報到時間']), str方式: String(o['報到方式'] || '').trim() };
    obj結果.obj格[str鍵] = obj人格;
  });
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：判斷報名狀態_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：已報名／未報名（本時段）／未報名。
 * 參數：obj名冊人員 {Object|null} { arr報名序 }；int時段 {number}
 * 傳回：{string}
 * ============================================================================
 */
function 判斷報名狀態_(obj名冊人員, int時段) {
  const obj狀態 = obj報到格式.obj報名狀態;
  if (!obj名冊人員) return obj狀態.未報名;
  const arr = obj名冊人員.arr報名序 || [];
  // 一個時段都對不到（報名內容對不到時段）時，視為已報名，避免誤判
  if (arr.length === 0 || arr.indexOf(int時段) !== -1) return obj狀態.已報名;
  return obj狀態.本時段未報名;
}


/**
 * ============================================================================
 * 函式名稱：比對報到人員_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：刷到的編號是名冊上的誰（決策 R）：
 *   ① 編號＝名冊的學員編號 → 那一位
 *   ② 學員名冊查得到（obj學員）→ 以姓名比對名冊 → 那一位（例如名冊配發了臨時編號、本人持正式學員證）
 *   ③ 都對不到 → 名冊外的人（人員鍵＝刷到的編號；學員名冊也查不到時姓名空白，待補姓名）
 * 參數：
 *   str編號     {string}
 *   arr名冊     {Object[]} 名冊人員 { str鍵, str姓名, str法名, str學員編號, arr報名序 }
 *   obj學員     {Object|null} 學員名冊查到的 { str學員編號, str姓名, str法名 }
 * 傳回：{Object} { obj名冊人員（或 null）, str鍵, str學員編號, str姓名, str法名, bool待補姓名 }
 * ============================================================================
 */
function 比對報到人員_(str編號, arr名冊, obj學員) {
  // 學員證條碼可能是大寫或小寫，比對時不分大小寫
  const str目標 = 正規化學員編號(str編號);
  const str比對 = str目標.toUpperCase();
  let obj人 = (arr名冊 || []).filter(function (o) { return o.str學員編號 !== '' && String(o.str學員編號).toUpperCase() === str比對; })[0] || null;
  if (!obj人 && obj學員) {
    obj人 = (arr名冊 || []).filter(function (o) { return o.str姓名 === 正規化人名(obj學員.str姓名); })[0] || null;
  }
  if (obj人) {
    return { obj名冊人員: obj人, str鍵: obj人.str鍵, str學員編號: obj人.str學員編號 || str目標, str姓名: obj人.str姓名, str法名: obj人.str法名, bool待補姓名: false };
  }
  return {
    obj名冊人員: null, str鍵: str目標, str學員編號: str目標,
    str姓名: obj學員 ? 正規化人名(obj學員.str姓名) : '', str法名: obj學員 ? 正規化人名(obj學員.str法名) : '',
    bool待補姓名: !obj學員
  };
}


/**
 * ============================================================================
 * 函式名稱：組合報到表格資料_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   表格畫面的資料（決策 AH）：名冊的人依紙本相同的順序（排序報到人員_）、序號；
 *   後面接「現場報到（未報名）」區：報到紀錄中名冊沒有的人，依第一次報到的先後。
 *   每人每時段目前是否已報到、各時段「報名／已到」人數。
 * 參數：
 *   arr名冊     {Object[]} 名冊人員（取得名冊報到人員_ 的 arr人員）
 *   arr時段     {Object[]}
 *   obj狀態     {Object}   計算報到狀態_ 的結果
 * 傳回：{Object} {
 *   arr列: [ { int序號, str鍵, str姓名, str法名, str學員編號, arr報名序, str報名登記, str提醒, bool現場, obj勾, obj取消參加 } ],
 *   arr人數: [ { str名稱, int報名, int已到, int取消參加 } ], bool筆畫, int取消參加
 * }
 * 版本記錄：v1.1.0 每列加 obj取消參加（null＝沒有請假）；人數加取消參加（報了這個時段、請假、沒報到的人）
 * ============================================================================
 */
function 組合報到表格資料_(arr名冊, arr時段, obj狀態) {
  const int時段數 = arr時段 && arr時段.length >= 2 ? arr時段.length : 1;
  const obj排序 = 排序報到人員_(arr名冊 || [], int時段數);
  const arr列 = obj排序.arr人員.map(function (o, i) {
    const str鍵 = o.str鍵 || 取得人員鍵_(o.str學員編號, o.str姓名);
    return {
      int序號: i + 1, str鍵: str鍵, str姓名: o.str姓名, str法名: o.str法名, str學員編號: o.str學員編號,
      arr報名序: o.arr報名序 || [], str報名登記: o.str報名登記 || '', str提醒: 提醒簡稱_(o.str提醒),
      bool現場: false, obj勾: (obj狀態.obj格[str鍵] || {}),
      obj取消參加: (obj狀態.obj取消參加 || {})[str鍵] || null
    };
  });

  // 現場報到區：紀錄中有、名冊沒有的人
  const obj名冊鍵 = {};
  arr列.forEach(function (o) { obj名冊鍵[o.str鍵] = true; });
  Object.keys(obj狀態.obj人員)
    .filter(function (k) { return !obj名冊鍵[k]; })
    .sort(function (a, b) { return obj狀態.obj人員[a].int首次序 - obj狀態.obj人員[b].int首次序; })
    .forEach(function (k) {
      const o = obj狀態.obj人員[k];
      arr列.push({
        int序號: arr列.length + 1, str鍵: k, str姓名: o.str姓名, str法名: o.str法名, str學員編號: o.str學員編號,
        arr報名序: [], str報名登記: '未報名', str提醒: o.str姓名 === '' ? '待補姓名' : '', bool現場: true,
        obj勾: (obj狀態.obj格[k] || {}), obj取消參加: null
      });
    });

  // 各時段人數
  const arr名稱 = int時段數 >= 2 ? arr時段.map(function (t) { return t.str名稱; }) : [obj報到格式.str單一時段名稱];
  const arr人數 = arr名稱.map(function (str名稱, j) {
    return {
      str名稱: str名稱,
      int報名: arr列.filter(function (o) { return !o.bool現場 && (int時段數 < 2 || o.arr報名序.indexOf(j) !== -1); }).length,
      int已到: arr列.filter(function (o) { return o.obj勾[j]; }).length,
      int取消參加: arr列.filter(function (o) {
        return o.obj取消參加 && !o.obj勾[j] && (int時段數 < 2 || o.arr報名序.length === 0 || o.arr報名序.indexOf(j) !== -1);
      }).length
    };
  });
  return {
    arr列: arr列, arr人數: arr人數, bool筆畫: obj排序.bool筆畫,
    int取消參加: arr列.filter(function (o) { return !!o.obj取消參加; }).length
  };
}


/**
 * ============================================================================
 * 函式名稱：檢查報到時段序_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：前端送來的時段序要是整數、在範圍內。
 * 參數：any {*}；arr時段 {Object[]}
 * 傳回：{number}
 * ============================================================================
 */
function 檢查報到時段序_(any, arr時段) {
  const int數 = arr時段 && arr時段.length >= 2 ? arr時段.length : 1;
  const int = Number(any);
  if (!Number.isInteger(int) || int < 0 || int >= int數) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '沒有指定是哪一個時段，請重新整理頁面後再試。');
  }
  return int;
}


/**
 * ============================================================================
 * 函式名稱：檢查報到姓名_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：姓名必填、去空白、不超過 20 字。
 * 參數：any {*}；str欄位 {string} 給使用者看的欄位名稱
 * 傳回：{string}
 * ============================================================================
 */
function 檢查報到姓名_(any, str欄位) {
  const str = 正規化人名(any);
  if (str === '') throw new 平台錯誤(obj錯誤代碼.參數錯誤, `請輸入${str欄位 || '姓名'}。`);
  if (str.length > obj報到格式.int姓名最長) throw new 平台錯誤(obj錯誤代碼.參數錯誤, `${str欄位 || '姓名'}太長了（最多 ${obj報到格式.int姓名最長} 字）。`);
  return str;
}


/**
 * ============================================================================
 * 函式名稱：整理取消原因_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：取消參加、場次取消的原因：選填，合併空白，最多 int原因最長 字（記在報到紀錄的「備註」）。
 * 參數：any {*}
 * 傳回：{string}
 * ============================================================================
 */
function 整理取消原因_(any) {
  return String(any === undefined || any === null ? '' : any).replace(/\s+/g, ' ').trim().slice(0, obj報到格式.int原因最長);
}


/**
 * ============================================================================
 * 函式名稱：組合場次取消說明_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：「這個場次已取消（原因，時間 人員）」的白話說明。
 * 參數：str場次 {string}；obj取消 {Object} { str時間, str人員, str原因 }
 * 傳回：{string}
 * ============================================================================
 */
function 組合場次取消說明_(str場次, obj取消) {
  const arr = [obj取消.str原因, [obj取消.str時間, obj取消.str人員].filter(Boolean).join(' ')].filter(Boolean);
  return `場次「${str場次}」已取消${arr.length > 0 ? `（${arr.join('，')}）` : ''}`;
}


// ============================================================================
// 乙、報到紀錄分頁（碰檔案）
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：取得報到紀錄分頁_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：副本的「報到紀錄」分頁；沒有時建立（標題列粗體、凍結、加註解）。
 * 參數：obj副本 {Spreadsheet}；bool建立 {boolean} 沒有時是否建立
 * 傳回：{Sheet|null}
 * ============================================================================
 */
function 取得報到紀錄分頁_(obj副本, bool建立) {
  const cfg = obj報到格式;
  let obj分頁 = obj副本.getSheetByName(cfg.str紀錄分頁);
  if (obj分頁 || !bool建立) return obj分頁;
  obj分頁 = obj副本.insertSheet(cfg.str紀錄分頁, obj副本.getSheets().length);
  obj分頁.getRange(1, 1, 1, cfg.arr紀錄欄位.length).setValues([cfg.arr紀錄欄位.slice()]).setFontWeight('bold');
  obj分頁.setFrozenRows(1);
  obj分頁.getRange(1, 1).setNote(
    '法會報到的紀錄（刷碼、表格打勾、紙本補登都寫在這裡），只新增、不刪除。\n'
    + '同一人同一場次同一時段以最後一筆為準：「動作」是「取消報到」就表示取消。\n'
    + '要更正請在法會活動網頁補登（打勾或取消），不要直接改這裡。');
  return obj分頁;
}


/**
 * ============================================================================
 * 函式名稱：讀取報到紀錄_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：讀出報到紀錄每一列（依標題名稱，欄位順序被調整也讀得到）；
 *       「時段」欄存時段名稱，另以 時段序 換回 0 起算的序號。
 * 參數：obj副本 {Spreadsheet}；arr時段名 {string[]} 目前的時段名稱（不分時段時為 ['報到']）
 * 傳回：{Object[]} [ { 欄名: 值, 時段序 } ]
 * ============================================================================
 */
function 讀取報到紀錄_(obj副本, arr時段名) {
  const obj分頁 = 取得報到紀錄分頁_(obj副本, false);
  if (!obj分頁 || obj分頁.getLastRow() < 2) return [];
  const arr全部 = obj分頁.getRange(1, 1, obj分頁.getLastRow(), Math.max(obj分頁.getLastColumn(), 1)).getValues();
  const arr標題 = arr全部[0].map(function (s) { return String(s).trim(); });
  return arr全部.slice(1).map(function (arr列) {
    const o = {};
    arr標題.forEach(function (s, j) { if (s !== '') o[s] = arr列[j]; });
    const int序 = (arr時段名 || []).indexOf(String(o['時段'] || '').trim());
    o['時段序'] = int序 === -1 ? 0 : int序;
    return o;
  });
}


/**
 * ============================================================================
 * 函式名稱：附加報到紀錄_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：在報到紀錄最後加一列（appendRow 一次寫入，多台同時報到不互相覆蓋，不必鎖定）。
 * 參數：obj副本 {Spreadsheet}；obj紀錄 {Object} { 欄名: 值 }
 * 傳回：無
 * ============================================================================
 */
function 附加報到紀錄_(obj副本, obj紀錄) {
  const obj分頁 = 取得報到紀錄分頁_(obj副本, true);
  const arr標題 = obj分頁.getRange(1, 1, 1, obj分頁.getLastColumn()).getValues()[0].map(function (s) { return String(s).trim(); });
  const obj = Object.assign({ '紀錄ID': 產生識別碼(), '報到時間': new Date() }, obj紀錄);
  obj分頁.appendRow(arr標題.map(function (s) { return obj[s] === undefined || obj[s] === null ? '' : obj[s]; }));
}


// ============================================================================
// 丙、報到情境（誰、哪場活動、哪個場次）
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：取得報到情境_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   報到相關動作共用的前置：
 *     · 報到志工：權限 event.報到；活動要仍在「報到中」、報到碼與登入時相同（暫停或更換後立即失效）
 *     · 承辦人／精舍管理員（補登）：str活動ID、權限 event.整理資料、須為承辦人、對內活動、收件中或報到中
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID（補登） }；str作業名稱 {string}
 * 傳回：{Object} { bool志工, obj主控台, obj活動值, obj副本, arr時段, arr時段名, str預設方式, str報到人員 }
 * ============================================================================
 */
function 取得報到情境_(obj工作階段, obj參數, str作業名稱) {
  let obj主控台;
  let obj活動值;
  const bool志工 = obj工作階段 && obj工作階段.str角色 === obj角色.報到志工;

  if (bool志工) {
    檢查權限(obj工作階段, obj法會權限.報到, str作業名稱);
    obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);
    let obj列 = null;
    try { obj列 = 取得法會活動_(obj主控台, obj工作階段.str活動ID); } catch (err) { obj列 = null; }
    obj活動值 = obj列 ? obj列.obj值 : null;
    if (!obj活動值 || String(obj活動值['活動狀態']).trim() !== obj法會活動狀態.報到中
      || String(obj活動值['報到碼'] || '').trim() !== String(obj工作階段.str報到碼 || '')) {
      throw new 平台錯誤(obj錯誤代碼.登入逾時, '報到已暫停或報到碼已更換，請向承辦人確認後重新輸入報到碼。');
    }
  } else {
    檢查必要參數(obj參數, ['str活動ID'], str作業名稱);
    const obj = 取得對內活動_(obj工作階段, obj參數.str活動ID, str作業名稱);
    obj主控台 = obj.obj主控台;
    obj活動值 = obj.obj活動值;
  }

  const arr時段 = 取得活動時段_(obj活動值);
  return {
    bool志工: bool志工, obj主控台: obj主控台, obj活動值: obj活動值,
    obj副本: 開啟活動副本_(obj活動值),
    arr時段: arr時段,
    arr時段名: arr時段.length >= 2 ? arr時段.map(function (t) { return t.str名稱; }) : [obj報到格式.str單一時段名稱],
    str預設方式: bool志工 ? obj報到格式.obj方式.表格 : obj報到格式.obj方式.紙本,
    str報到人員: String(obj工作階段.str姓名 || obj工作階段.str帳號 || '').trim()
  };
}


/**
 * ============================================================================
 * 函式名稱：列出可報到場次_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * 注意：法會_報到名冊.gs 已有「列出報到場次_」（列出有效資料的場次欄），本函式名稱不可與它相同
 * ----------------------------------------------------------------------------
 * 用途：已下載名冊的場次與日期；志工只列今天的（決策 P）。
 * 參數：obj情境 {Object} 取得報到情境_ 的結果；dat今天 {Date}
 * 傳回：{Object[]} [ { str場次, str日期, int人數, obj分頁, bool今天 } ]（依日期排序）
 * 註：場次是否取消由 標示場次取消_ 另外加上（需讀報到紀錄）
 * ============================================================================
 */
function 列出可報到場次_(obj情境, dat今天) {
  const dat基準 = 取得場次基準日_(obj情境.obj活動值);
  const str今天 = 格式化日期(dat今天, 'yyyy-MM-dd');
  return 列出名冊分頁_(obj情境.obj副本).map(function (o) {
    const arr月日 = 擷取月日_(o.str場次);
    const dat = arr月日.length > 0 ? 推算月日日期_(arr月日[0], dat基準) : null;
    return {
      str場次: o.str場次, dat日期: dat, str日期: dat ? 格式化日期(dat, 'M/d') : '',
      int人數: Math.max((o.obj分頁.getLastRow() || 1) - 1, 0), obj分頁: o.obj分頁,
      bool今天: dat ? 格式化日期(dat, 'yyyy-MM-dd') === str今天 : false
    };
  }).filter(function (o) { return !obj情境.bool志工 || o.bool今天; })
    .sort(function (a, b) { return (a.dat日期 ? a.dat日期.getTime() : 0) - (b.dat日期 ? b.dat日期.getTime() : 0); });
}


/**
 * ============================================================================
 * 函式名稱：解析報到場次_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   這次要處理哪個場次：
 *     · 有指定 str場次：必須是已下載名冊的場次（志工只限今天的）；
 *       志工在「今天沒有已下載的場次」時，場次＝今天日期「11/15」（決策 P），沒有名冊
 *     · 沒指定：今天（或補登時第一個）場次
 * 參數：obj情境 {Object}；any場次 {*}
 * 傳回：{Object} { str場次, str日期, obj名冊分頁（或 null）, arr名冊（名冊人員，含 str鍵） }
 * ============================================================================
 */
/**
 * ============================================================================
 * 函式名稱：標示場次取消_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：在場次清單每一項加上 obj取消（null＝沒有取消），讀一次報到紀錄。
 * 參數：obj情境 {Object}；arr場次 {Object[]} [ { str場次, … } ]；arr紀錄 {Object[]=}
 * 傳回：{Object[]} 同一個陣列（每項加 obj取消）
 * ============================================================================
 */
function 標示場次取消_(obj情境, arr場次, arr紀錄) {
  const arr = arr紀錄 || 讀取報到紀錄_(obj情境.obj副本, obj情境.arr時段名);
  arr場次.forEach(function (o) {
    const obj取消 = 計算報到狀態_(arr, o.str場次).obj場次取消;
    o.obj取消 = obj取消 ? Object.assign({ str說明: 組合場次取消說明_(o.str場次, obj取消) }, obj取消) : null;
  });
  return arr場次;
}


function 解析報到場次_(obj情境, any場次) {
  const dat今天 = new Date();
  const arr場次 = 列出可報到場次_(obj情境, dat今天);
  const str指定 = String(any場次 === undefined || any場次 === null ? '' : any場次).trim();
  const str今天 = 格式化日期(dat今天, 'M/d');

  let obj = null;
  if (str指定 !== '') {
    obj = arr場次.filter(function (o) { return o.str場次 === str指定; })[0] || null;
    if (!obj && !(obj情境.bool志工 && arr場次.length === 0 && str指定 === str今天)) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, obj情境.bool志工
        ? `「${str指定}」不是今天的場次，請重新整理頁面。`
        : `場次「${str指定}」還沒有下載名冊，請先下載場次名冊。`);
    }
  } else {
    obj = arr場次[0] || null;
    if (!obj && !obj情境.bool志工) throw new 平台錯誤(obj錯誤代碼.參數錯誤, '還沒有下載任何場次的名冊，請先下載場次名冊。');
  }

  if (!obj) return { str場次: str今天, str日期: str今天, obj名冊分頁: null, arr名冊: [] };
  const arr名冊 = 取得名冊報到人員_(obj.obj分頁, obj情境.arr時段).arr人員.map(function (o) {
    return Object.assign({}, o, { str鍵: 取得人員鍵_(o.str學員編號, o.str姓名) });
  });
  return { str場次: obj.str場次, str日期: obj.str日期, obj名冊分頁: obj.obj分頁, arr名冊: arr名冊 };
}


/**
 * ============================================================================
 * 函式名稱：讀取表格內容_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：組出表格畫面要的全部資料（讀取表格與讀取異動共用）。
 * 參數：obj情境 {Object}；obj場次 {Object} 解析報到場次_ 的結果；arr紀錄 {Object[]=} 已讀好的紀錄
 * 傳回：{Object}
 * ============================================================================
 */
function 讀取表格內容_(obj情境, obj場次, arr紀錄) {
  const obj狀態 = 計算報到狀態_(arr紀錄 || 讀取報到紀錄_(obj情境.obj副本, obj情境.arr時段名), obj場次.str場次);
  const obj表格 = 組合報到表格資料_(obj場次.arr名冊, obj情境.arr時段, obj狀態);
  return {
    str場次: obj場次.str場次, str日期: obj場次.str日期, bool有名冊: !!obj場次.obj名冊分頁,
    arr時段: obj情境.arr時段名.map(function (s, i) {
      return { str名稱: s, str起迄: obj情境.arr時段[i] ? obj情境.arr時段[i].str起迄 : '' };
    }),
    arr列: obj表格.arr列, arr人數: obj表格.arr人數, int紀錄數: obj狀態.int紀錄數, bool筆畫: obj表格.bool筆畫,
    int取消參加: obj表格.int取消參加,
    // v1.1.0：場次取消（null＝沒有取消）
    obj場次取消: obj狀態.obj場次取消 ? Object.assign({ str說明: 組合場次取消說明_(obj場次.str場次, obj狀態.obj場次取消) }, obj狀態.obj場次取消) : null
  };
}


/**
 * ============================================================================
 * 函式名稱：寫入報到_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   報到或取消一格（同一人、同一場次、同一時段）。先看目前狀態：
 *     · 要報到但已報到 → 不重複記，傳回第一次報到的時間
 *     · 要取消但本來就沒報到 → 不記
 *   其餘新增一筆紀錄。
 *   v1.1.0：場次已取消時不能報到（取消報到仍可以）；登記取消參加的人來報到時，先記一筆「恢復參加」。
 * 參數：
 *   obj情境   {Object}
 *   obj場次   {Object}
 *   obj人     {Object} { str鍵, str學員編號, str姓名, str法名, obj名冊人員（或 null）, str備註 }
 *   int時段   {number}
 *   bool取消  {boolean}
 *   str方式   {string}
 *   str裝置   {string}
 *   arr紀錄   {Object[]=} 已讀好的紀錄（省一次讀取）
 * 傳回：{Object} { bool已寫入, bool原本已報到, str時間, str方式, str報名狀態, bool恢復參加 }
 * ============================================================================
 */
function 寫入報到_(obj情境, obj場次, obj人, int時段, bool取消, str方式, str裝置, arr紀錄) {
  const obj狀態 = 計算報到狀態_(arr紀錄 || 讀取報到紀錄_(obj情境.obj副本, obj情境.arr時段名), obj場次.str場次);
  const obj目前 = (obj狀態.obj格[obj人.str鍵] || {})[int時段] || null;
  const str報名狀態 = 判斷報名狀態_(obj人.obj名冊人員, int時段);

  if (!bool取消 && obj目前) return { bool已寫入: false, bool原本已報到: true, str時間: obj目前.str時間, str方式: obj目前.str方式, str報名狀態: str報名狀態 };
  if (bool取消 && !obj目前) return { bool已寫入: false, bool原本已報到: false, str時間: '', str方式: '', str報名狀態: str報名狀態 };
  if (!bool取消 && obj狀態.obj場次取消) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `${組合場次取消說明_(obj場次.str場次, obj狀態.obj場次取消)}，不能報到。如果場次照常舉行，請承辦人按「恢復場次」。`);
  }

  // v1.1.0：請假的人來了 → 先恢復參加
  const bool恢復參加 = !bool取消 && !!obj狀態.obj取消參加[obj人.str鍵];
  if (bool恢復參加) 附加取消參加紀錄_(obj情境, obj場次, obj人, false, '來報到，自動恢復', str裝置);

  const dat現在 = new Date();
  附加報到紀錄_(obj情境.obj副本, {
    '場次': obj場次.str場次, '場次日期': obj場次.str日期, '時段': obj情境.arr時段名[int時段],
    '人員鍵': obj人.str鍵, '學員編號': obj人.str學員編號 || '', '姓名': obj人.str姓名 || '', '法名': obj人.str法名 || '',
    '報名狀態': str報名狀態, '報到方式': str方式, '動作': bool取消 ? obj報到格式.obj動作.取消 : obj報到格式.obj動作.報到,
    '報到時間': dat現在, '報到人員': obj情境.str報到人員, '使用裝置': String(str裝置 || '').slice(0, 60),
    '備註': (obj情境.bool志工 ? '' : '補登') + (obj人.str備註 ? (obj情境.bool志工 ? '' : '；') + obj人.str備註 : '')
  });
  return { bool已寫入: true, bool原本已報到: !!obj目前, str時間: bool取消 ? '' : 格式化日期(dat現在, 'HH:mm'), str方式: bool取消 ? '' : str方式, str報名狀態: str報名狀態, bool恢復參加: bool恢復參加 };
}


/**
 * ============================================================================
 * 函式名稱：附加取消參加紀錄_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：記一筆「取消參加」或「恢復參加」（整個場次，時段欄空白；原因記在備註）。
 * 參數：obj情境 {Object}；obj場次 {Object}；obj人 {Object}；bool取消參加 {boolean}；str原因 {string}；str裝置 {string}
 * 傳回：無
 * ============================================================================
 */
function 附加取消參加紀錄_(obj情境, obj場次, obj人, bool取消參加, str原因, str裝置) {
  附加報到紀錄_(obj情境.obj副本, {
    '場次': obj場次.str場次, '場次日期': obj場次.str日期, '時段': '',
    '人員鍵': obj人.str鍵, '學員編號': obj人.str學員編號 || '', '姓名': obj人.str姓名 || '', '法名': obj人.str法名 || '',
    '報名狀態': obj人.obj名冊人員 ? obj報到格式.obj報名狀態.已報名 : obj報到格式.obj報名狀態.未報名, '報到方式': '',
    '動作': bool取消參加 ? obj報到格式.obj動作.取消參加 : obj報到格式.obj動作.恢復參加,
    '報到時間': new Date(), '報到人員': obj情境.str報到人員, '使用裝置': String(str裝置 || '').slice(0, 60),
    '備註': 整理取消原因_(str原因)
  });
}


/**
 * ============================================================================
 * 函式名稱：決定報到方式_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：志工可指定表格／搜尋姓名／臨時；補登可選紙本／表格；其他值改用預設。
 * 參數：obj情境 {Object}；any方式 {*}
 * 傳回：{string}
 * ============================================================================
 */
function 決定報到方式_(obj情境, any方式) {
  const str = String(any方式 || '').trim();
  const arr允許 = obj情境.bool志工 ? obj報到格式.arr志工方式 : obj報到格式.arr補登方式;
  return arr允許.indexOf(str) !== -1 ? str : obj情境.str預設方式;
}


/**
 * ============================================================================
 * 函式名稱：找出表格人員_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：依人員鍵找人：名冊的人或已在報到紀錄中的現場報到者；找不到時說明。
 * 參數：obj場次 {Object}；arr紀錄 {Object[]}；any鍵 {*}
 * 傳回：{Object} { str鍵, str學員編號, str姓名, str法名, obj名冊人員 }
 * ============================================================================
 */
function 找出表格人員_(obj場次, arr紀錄, any鍵) {
  const str鍵 = String(any鍵 || '').trim();
  const obj名冊 = obj場次.arr名冊.filter(function (o) { return o.str鍵 === str鍵; })[0];
  if (obj名冊) return { str鍵: str鍵, str學員編號: obj名冊.str學員編號, str姓名: obj名冊.str姓名, str法名: obj名冊.str法名, obj名冊人員: obj名冊 };
  const obj人 = 計算報到狀態_(arr紀錄, obj場次.str場次).obj人員[str鍵];
  if (obj人) return { str鍵: str鍵, str學員編號: obj人.str學員編號, str姓名: obj人.str姓名, str法名: obj人.str法名, obj名冊人員: null };
  throw new 平台錯誤(obj錯誤代碼.資料列不存在, '名冊中找不到這個人（名冊可能剛重新下載），請重新整理表格。');
}


