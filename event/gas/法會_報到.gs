/**
 * ============================================================================
 * 函式名稱：讀取報到資訊
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：action「event.報到資訊」。報到頁開啟時讀：活動、報到人員、可選的場次（志工只有今天的）、
 *       時段、目前時段；今天沒有下載名冊時提醒（仍可報到，全部記「未報名」）。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID（補登） }
 * 傳回：{Object} { str活動名稱, str精舍名稱, str報到人員, bool志工, arr場次, arr時段, int目前時段, str提醒, str預設方式 }
 * ============================================================================
 */
function 讀取報到資訊(obj工作階段, obj參數) {
  const obj情境 = 取得報到情境_(obj工作階段, obj參數, '報到');
  const dat現在 = new Date();
  const arr場次 = 標示場次取消_(obj情境, 列出可報到場次_(obj情境, dat現在).map(function (o) {
    return { str場次: o.str場次, str日期: o.str日期, int人數: o.int人數, bool今天: o.bool今天 };
  }));
  const arr時分 = 格式化日期(dat現在, 'HH:mm').split(':');   // 台灣時間
  const int分鐘 = Number(arr時分[0]) * 60 + Number(arr時分[1]);
  let str提醒 = '';
  if (obj情境.bool志工 && arr場次.length > 0 && arr場次.every(function (o) { return o.obj取消; })) {
    str提醒 = `今天的場次已取消：${arr場次.map(function (o) { return o.obj取消.str說明; }).join('；')}。不能報到；可以查看表格。`;
  } else if (obj情境.bool志工 && arr場次.length === 0) {
    str提醒 = `今天（${格式化日期(dat現在, 'M/d')}）的場次尚未下載名冊：仍可報到，但每個人都會記為「未報名」。請通知承辦人下載今天的場次名冊。`;
  }
  return {
    str活動名稱: String(obj情境.obj活動值['活動名稱']).trim(),
    str精舍名稱: String(obj工作階段.str精舍名稱 || ''),
    str報到人員: obj情境.str報到人員, bool志工: obj情境.bool志工,
    arr場次: arr場次,
    str今天: 格式化日期(dat現在, 'M/d'),
    arr時段: obj情境.arr時段名.map(function (s, i) { return { str名稱: s, str起迄: obj情境.arr時段[i] ? obj情境.arr時段[i].str起迄 : '' }; }),
    int目前時段: 判斷目前時段_(obj情境.arr時段, int分鐘),
    str提醒: str提醒, str預設方式: obj情境.str預設方式
  };
}


