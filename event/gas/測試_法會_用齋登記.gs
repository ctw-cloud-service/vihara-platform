// ============================================================================
// 檔案名稱：測試_法會_用齋登記.gs
// 所屬模組：法會活動（event）
// 所屬層級：測試
// 檔案版本：v1.0.0（2026-11-07）
// 用途說明：用齋登記表判讀與合併的純邏輯測試（不碰檔案；GAS 編輯器執行 測試_法會_用齋登記純邏輯）。
//   表格內容取自「普泉用齋登記表」的實際格式（簡化）。
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：測試_法會_用齋登記純邏輯
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：自動測試用齋登記表的判讀（日期、餐別、組別、份數、略過字樣）與合併名冊的規則。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_用齋登記純邏輯() {
  const t = 建立法會測試記錄器_();

  // ── 一、格子判讀 ──
  t.記錄('組別：大寮(B) 算大寮、日初是班別、青推組結尾是組', 是用齋組別_('大寮(B)') === '大寮' && 是用齋組別_('日初') === '日初' && 是用齋組別_('青推組') === '青推組');
  t.記錄('組別：人名不是組別', 是用齋組別_('黃月英') === '');
  const o份 = 解析用齋姓名格_('李戎俊*2');
  t.記錄('姓名：李戎俊*2 → 2 份', o份 && o份.str姓名 === '李戎俊' && o份.int份數 === 2);
  const o註 = 解析用齋姓名格_('呂亭萱(苾)');
  t.記錄('姓名：呂亭萱(苾) → 姓名呂亭萱、註記苾', o註 && o註.str姓名 === '呂亭萱' && o註.str註記 === '苾' && o註.int份數 === 1);
  t.記錄('姓名：略過水電行、序號、✔️、禪修班、已登記', ['水電行*不用', '12', '✔️', '禪修班(  )人', '已登記(49)份', '水電*不用', ''].every(function (s) { return 解析用齋姓名格_(s) === null; }));
  t.記錄('姓名：四字姓名（高周明麗）', 解析用齋姓名格_('高周明麗').str姓名 === '高周明麗');

  // ── 二、一頁的判讀 ──
  const arr午齋 = [
    ['11/9(ㄧ)午齋     已登記(    )份', '', '', '', '', '', ''],
    ['領取請打✔️', '', '', '', '', '', ''],
    ['', '✔️', '照客', '', '✔️', '其他', ''],
    ['1', '', '王照客', '1', '', '甲其他*2', '17'],
    ['', '', '大寮', '7', '', '', '23'],
    ['1', '', '黃月英', '8', '', '', '24'],
    ['2', '', '黃月英', '9', '', '', '25'],
    ['4', '', '行堂', '11', '', '', '27'],
    ['5', '', '鄭淑玲', '12', '', '水電行*不用', '28']
  ];
  const p1 = 解析用齋分頁_('一午齋', arr午齋);
  t.記錄('一頁：日期 11/9、餐別午齋（看標題）', p1.int月 === 11 && p1.int日 === 9 && p1.str餐別 === '午齋');
  t.記錄('一頁：4 人（同名只算一次）', p1.arr人員.length === 4, JSON.stringify(p1.arr人員));
  const fn找 = function (p, s) { return p.arr人員.filter(function (o) { return o.str姓名 === s; })[0] || {}; };
  t.記錄('一頁：組別依上方最近的組別（照客→大寮→行堂）', fn找(p1, '王照客').str組別 === '照客' && fn找(p1, '黃月英').str組別 === '大寮' && fn找(p1, '鄭淑玲').str組別 === '行堂');
  t.記錄('一頁：其他欄、份數', fn找(p1, '甲其他').str組別 === '其他' && fn找(p1, '甲其他').int份數 === 2);

  // 共修頁：標題沒有午齋 → 看分頁名稱；組別在姓名左邊一欄；大寮欄距 2
  const arr共修 = [
    ['11/7（六)共修法會       已登記( 49)份', '', '', '', '', '', '', '', '', '', ''],
    ['', '照客', '', '機動', '', '梵唄', '', '大寮', '', '', '心燈'],
    ['1', '', '蔡宗坤', '', '江冠輝', '', '陳建臻', '', '', '黃天行', '', '莊秀鏡'],
    ['12', '司儀', '', 'PPT', '', '', '', '', '', '陳月麗'],
    ['13', '', '陳玥鴦', '', '', '', '', '', '', '', '']
  ];
  const p2 = 解析用齋分頁_('共修/六午齋', arr共修);
  t.記錄('共修頁：標題沒寫午齋 → 看分頁名稱', p2.str餐別 === '午齋' && p2.int月 === 11 && p2.int日 === 7);
  t.記錄('共修頁：照客、機動、梵唄、大寮（欄距 2）、心燈、司儀', fn找(p2, '蔡宗坤').str組別 === '照客' && fn找(p2, '江冠輝').str組別 === '機動'
    && fn找(p2, '陳建臻').str組別 === '梵唄' && fn找(p2, '黃天行').str組別 === '大寮' && fn找(p2, '莊秀鏡').str組別 === '心燈' && fn找(p2, '陳玥鴦').str組別 === '司儀');
  t.記錄('沒有日期的範本頁：月日為 0', 解析用齋分頁_('無共修週六午齋', [['(週六)午齋   已登記(    )'], ['', '照客', '']]).int月 === 0);
  t.記錄('藥石頁：標題寫藥石', 解析用齋分頁_('二藥石', [['11/10（二)藥石     已登記(      )份']]).str餐別 === '藥石');
  t.記錄('日期看起來不像日期（1010(六)）：月日為 0', 解析用齋分頁_('六藥石', [['1010(六)藥石便當']]).int月 === 0);

  // ── 三、篩選與合併 ──
  const p藥 = { str分頁名: '一藥石', int月: 11, int日: 9, str餐別: '藥石', arr人員: [{ str姓名: '藥石人', str組別: '大寮', int份數: 1 }] };
  const p午2 = { str分頁名: '一午齋(2)', int月: 11, int日: 9, str餐別: '午齋', arr人員: [{ str姓名: '黃月英', str組別: '', int份數: 3 }, { str姓名: '新人', str組別: '環保', int份數: 1 }] };
  const obj篩 = 篩選用齋人員_([p1, p2, p藥, p午2], 11, 9, '午齋');
  t.記錄('篩選：同日同餐別的兩頁合併、別天與藥石不算', obj篩.arr分頁名.length === 2 && obj篩.arr人員.length === 5 && !obj篩.arr人員.some(function (o) { return o.str姓名 === '藥石人' || o.str姓名 === '蔡宗坤'; }));
  t.記錄('篩選：同名份數取大、組別沿用第一次', obj篩.arr人員.filter(function (o) { return o.str姓名 === '黃月英'; })[0].int份數 === 3
    && obj篩.arr人員.filter(function (o) { return o.str姓名 === '黃月英'; })[0].str組別 === '大寮');

  const arr名冊 = [{ str場次: 'S', str姓名: '黃月英', str法名: '傳英', str報名內容: '參加', arr提醒: [], obj帶入: {} }];
  const arr時段 = 解析時段設定_('第一支香 14:00-14:40；第二支香 14:50-15:30');
  const obj合 = 合併用齋人員_(arr名冊, obj篩.arr人員, { str場次: 'S', dat日期: new Date(2026, 10, 9) }, arr時段);
  t.記錄('合併：已報名 1 人補上用齋、沒報名 4 人新增', obj合.int已在名冊 === 1 && obj合.int新增 === 4 && arr名冊.length === 5);
  t.記錄('合併：已報名的人報名內容不變、帶用齋', arr名冊[0].str報名內容 === '參加' && arr名冊[0].obj用齋.int份數 === 3 && arr名冊[0].obj用齋.str餐別 === '午齋');
  const o新 = arr名冊.filter(function (o) { return o.str姓名 === '新人'; })[0];
  t.記錄('合併：新增的義工報名內容「義工（環保）」、分時段標全部時段', o新.str報名內容 === '義工（環保）' && o新.arr報名序.join(',') === '0,1' && o新.arr來源.join(',') === '用齋登記' && o新.obj標準['義工組別'] === '環保');
  t.記錄('用齋說明：大寮・午齋×2／份數 1 不寫／沒有用齋空白', 組合用齋說明_('大寮', '午齋', 2) === '大寮・午齋×2' && 組合用齋說明_('', '藥石', '1') === '藥石' && 組合用齋說明_('大寮', '', 1) === '');

  // ── 四、設定 ──
  t.記錄('試算表網址 → ID', 解析試算表ID_('https://docs.google.com/spreadsheets/d/1oXizvJ56RBymG04NTA919TjlCUNT6woBlI654QRuraU/edit?gid=63719611#gid=63719611') === '1oXizvJ56RBymG04NTA919TjlCUNT6woBlI654QRuraU'
    && 解析試算表ID_('隨便') === '');
  t.記錄('活動合併用齋：空白＝午齋（預設合併）、藥石、不合併', 取得活動用齋餐別_({}) === '午齋' && 取得活動用齋餐別_({ '合併用齋': '藥石' }) === '藥石' && 取得活動用齋餐別_({ '合併用齋': '不合併' }) === '不合併');
  const obj路由 = 路由定義_event();
  t.記錄('路由：設定用齋登記表、設定合併用齋', ['event.設定用齋登記表', 'event.設定合併用齋'].every(function (k) { return obj路由[k] && typeof obj路由[k].fn === 'function'; }));
  t.記錄('活動清單有「合併用齋」欄、結構版本 5 以上', 主控台結構_event().活動清單.arr欄位.indexOf('合併用齋') !== -1 && Number(obj法會設定.str主控台結構版本) >= 5);

  return t.結算();
}
