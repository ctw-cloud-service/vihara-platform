// ============================================================================
// 檔案名稱：測試_法會_大車點名.gs
// 所屬模組：法會活動（event）
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.0.0（2026-10-27）
// 用途說明：
//   在 Apps Script 編輯器執行：
//     · 測試_法會_大車點名純邏輯（數秒）：手機、領隊、交通、拆趟、設定推測等計算規則
//     · 測試_法會_大車點名（約 1～3 分鐘）：產生點名資料 → 承辦人填寫後重新產生 →
//       匯出（首次／再次）→ 轉為正式 → 退回演練 → 結束停用 → 清除點名資料，
//       以及權限、對內活動、狀態限制。使用 測試_法會_活動與同步.gs 的共用測試環境，
//       另建一份暫存「大車點名試算表」，測完全部移到垃圾桶。
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：測試_法會_大車點名純邏輯
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：自動測試不碰檔案的大車點名計算規則。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_大車點名純邏輯() {
  const t = 建立法會測試記錄器_();
  const dat報名 = new Date(2026, 9, 20, 10, 0, 0);
  const fn日 = function (d) { return d ? `${d.getMonth() + 1}/${d.getDate()}` : '無'; };

  // ── 一、手機與領隊 ──
  t.記錄('手機：9 碼補 0 並加橫線', 格式化點名手機_(912345678).str值 === '0912-345678');
  t.記錄('手機：已有橫線或空白也統一', 格式化點名手機_('0912 345 678').str值 === '0912-345678');
  t.記錄('手機：市話保留原樣並標問題', 格式化點名手機_('04-22223333').bool有問題 === true);
  t.記錄('手機：空白不算問題', 格式化點名手機_('').bool有問題 === false);
  const obj預設 = obj大車點名設定.obj預設領隊代號;
  t.記錄('領隊：數字 2 → 總領隊', 換算領隊_(2, obj預設).str值 === '總領隊');
  t.記錄('領隊：「2.0」也可以', 換算領隊_('2.0', obj預設).str值 === '總領隊');
  t.記錄('領隊：已填名稱接受', 換算領隊_('法師', obj預設).bool有問題 === false);
  t.記錄('領隊：找不到的代號標問題', 換算領隊_(9, obj預設).bool有問題 === true && 換算領隊_(9, obj預設).str值 === '9');

  // ── 二、交通方式 ──
  const obj一 = 解析交通文字_('去程搭大車 08:00、回程自行', null, null);
  t.記錄('交通：去搭車上午、回自行', obj一.obj去程.str模式 === '搭車' && obj一.obj去程.str時段 === '上午' && obj一.obj回程.str模式 === '自行');
  const obj二 = 解析交通文字_('去程、回程(自行)', null, null);
  t.記錄('交通：「去程、回程(自行)」兩方向都是自行', obj二.obj去程.str模式 === '自行' && obj二.obj回程.str模式 === '自行');
  const obj三 = 解析交通文字_('來回搭大車', null, null);
  t.記錄('交通：來回＝兩方向相同', obj三.obj去程.str模式 === '搭車' && obj三.obj回程.str模式 === '搭車');
  const obj四 = 解析交通文字_(null, '自行開車', '15:30 搭車');
  t.記錄('交通：分兩欄各自判斷', obj四.obj去程.str模式 === '自行' && obj四.obj回程.str模式 === '搭車' && obj四.obj回程.str時段 === '下午');
  t.記錄('交通：只寫「自行」兩方向相同', 解析交通文字_('自行', null, null).obj回程.str模式 === '自行');

  // ── 三、拆趟 ──
  const arr日期欄 = [
    { int索引: 0, str標題: '護七_行程 [11/28 (六)]' }, { int索引: 1, str標題: '護七_行程 [11/29 (日)]' },
    { int索引: 2, str標題: '護七_行程 [11/30 (一)]' }, { int索引: 3, str標題: '護七_行程 [12/1 (二)]' }
  ];
  const arr連續 = 拆趟_逐日勾選_(['是', '是', '是', ''], arr日期欄, dat報名);
  t.記錄('逐日：連續三天併成一趟', arr連續.length === 1 && fn日(arr連續[0].dat起) === '11/28' && fn日(arr連續[0].dat迄) === '11/30');
  const arr中斷 = 拆趟_逐日勾選_(['是', '', '是', '是'], arr日期欄, dat報名);
  t.記錄('逐日：中間空一天拆成兩趟', arr中斷.length === 2 && fn日(arr中斷[1].dat起) === '11/30' && fn日(arr中斷[1].dat迄) === '12/1',
    arr中斷.map(function (o) { return fn日(o.dat起) + '-' + fn日(o.dat迄); }).join(','));
  t.記錄('逐日：「否」不算勾選', 拆趟_逐日勾選_(['否', '', '', ''], arr日期欄, dat報名).length === 0);
  const arr梯 = 拆趟_梯次_(['11/28～11/29', '', '參加'], [
    { int索引: 0, str標題: '第一梯' }, { int索引: 1, str標題: '第二梯 12/5' }, { int索引: 2, str標題: '第三梯 12/12' }], dat報名);
  t.記錄('梯次：內容日期優先、沒有就用標題', arr梯.length === 2 && fn日(arr梯[0].dat迄) === '11/29' && fn日(arr梯[1].dat起) === '12/12');
  t.記錄('跨年：12 月報名、1 月出發算隔年', 推算月日日期_({ int月: 1, int日: 3 }, new Date(2026, 11, 1)).getFullYear() === 2027);

  // ── 四、設定推測 ──
  const arr標題 = ['時間戳記', '姓名', '法名', '手機號碼', '緊急聯絡人電話', '護七_行程 [11/28 (六)]', '護七_行程 [11/29 (日)]',
    '交通方式', '義工組別', '領隊'];
  const obj推測 = 推測大車點名設定_(arr標題);
  t.記錄('推測：逐日勾選、關鍵字「護七_行程」', obj推測['日期型態'] === '逐日勾選' && obj推測['日期欄關鍵字'] === '護七_行程', JSON.stringify(obj推測));
  t.記錄('推測：手機不選緊急聯絡人', obj推測['手機號碼欄'] === '手機號碼');
  t.記錄('推測：交通一欄、組別、領隊同名', obj推測['交通方式欄'] === '交通方式' && obj推測['義工組別欄'] === '義工組別' && obj推測['領隊欄'] === '領隊');
  t.記錄('推測：有「梯」＝梯次', 推測大車點名設定_(['姓名', '第一梯', '第二梯']).日期型態 === '梯次');
  t.記錄('推測：沒有日期欄＝無', 推測大車點名設定_(['姓名', '交通']).日期型態 === '無');
  t.記錄('推測：兩個交通欄分去回', (function () {
    const o = 推測大車點名設定_(['姓名', '去程交通', '回程交通']);
    return o['去程交通欄'] === '去程交通' && o['回程交通欄'] === '回程交通' && o['交通方式欄'] === '';
  })());

  // ── 五、設定解析錯誤 ──
  t.預期錯誤('解析：欄位被改名時白話說明', obj錯誤代碼.欄位缺漏, function () {
    解析大車設定欄位_({ '日期型態': '無', '姓名欄': '姓名', '手機號碼欄': '手機' }, ['姓名', '手機號碼']);
  });
  t.預期錯誤('解析：日期型態打錯', obj錯誤代碼.參數錯誤, function () {
    解析大車設定欄位_({ '日期型態': '每日', '姓名欄': '姓名' }, ['姓名']);
  });
  t.預期錯誤('解析：沒選姓名欄', obj錯誤代碼.參數錯誤, function () {
    解析大車設定欄位_({ '日期型態': '無', '姓名欄': '' }, ['姓名']);
  });

  // ── 六、一人拆成多列 ──
  const arr列標題 = ['時間戳記', '姓名', '法名', '手機號碼', '護七_行程 [11/28 (六)]', '護七_行程 [11/29 (日)]', '護七_行程 [11/30 (一)]', '交通方式', '義工組別', '領隊', '身份別'];
  const obj欄 = 解析大車設定欄位_(Object.assign(推測大車點名設定_(arr列標題)), arr列標題);
  obj欄.obj領隊代號 = obj預設;
  const arr趟 = 計算個人趟次_([dat報名, '李大華', '', '0922333444', '是', '', '是', '去程 11/28 搭車、回程 11/30 自行', '香積', 3, '義工'], obj欄);
  t.記錄('個人：兩趟、領隊與身份別每趟相同', arr趟.length === 2 && arr趟.every(function (o) { return o.obj值['領隊'] === '副總領隊' && o.obj覆寫['身份別'] === '義工'; }));
  t.記錄('個人：交通日期只套到對應那一趟', arr趟[0].obj預填['回程'] === '' && arr趟[1].obj預填['回程'] === '自行',
    JSON.stringify(arr趟.map(function (o) { return o.obj預填; })));
  t.記錄('個人：兩趟的趟次鍵不同', arr趟[0].str鍵 !== arr趟[1].str鍵);
  const arr無日期 = 計算個人趟次_([dat報名, '林志明', '', '', '', '', '', '', '', '', ''], obj欄);
  t.記錄('個人：沒勾日期 → 一趟、日期標問題', arr無日期.length === 1 && arr無日期[0].arr問題欄.indexOf('日期-起') >= 0);

  return t.結算();
}


/**
 * ============================================================================
 * 函式名稱：寫入測試有效資料_（測試共用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：把副本「有效資料」整份換成指定內容（模擬承辦人整理好的資料）。
 * 參數：obj副本 {Spreadsheet}；arr資料 {Array[]} 含標題列
 * 傳回：無
 * ============================================================================
 */
function 寫入測試有效資料_(obj副本, arr資料) {
  const obj有效 = obj副本.getSheetByName('有效資料');
  obj有效.getRange(1, 1, obj有效.getMaxRows(), obj有效.getMaxColumns()).clearContent();
  const int欄數 = arr資料[0].length;
  if (int欄數 > obj有效.getMaxColumns()) obj有效.insertColumnsAfter(obj有效.getMaxColumns(), int欄數 - obj有效.getMaxColumns());
  obj有效.getRange(1, 1, arr資料.length, int欄數).setValues(arr資料);
  SpreadsheetApp.flush();
}


/**
 * ============================================================================
 * 函式名稱：讀取點名列_（測試共用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：把分頁讀成物件陣列（依標題，顯示值）。
 * 參數：obj分頁 {Sheet}
 * 傳回：{Object[]}
 * ============================================================================
 */
function 讀取點名列_(obj分頁) {
  if (!obj分頁 || obj分頁.getLastRow() < 2) return [];
  const arr值 = obj分頁.getRange(1, 1, obj分頁.getLastRow(), obj分頁.getLastColumn()).getDisplayValues();
  const arr標題 = arr值[0];
  return arr值.slice(1).filter(function (arr) { return arr.join('') !== ''; }).map(function (arr) {
    const obj = {};
    arr標題.forEach(function (s, i) { obj[s] = arr[i]; });
    return obj;
  });
}


/**
 * ============================================================================
 * 函式名稱：測試_法會_大車點名
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：自動測試大車點名的完整流程。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_大車點名() {
  const t = 建立法會測試記錄器_();
  let obj環境 = null;

  try {
    obj環境 = 建立法會測試環境_();
    const obj住持 = obj環境.obj住持;
    const obj主控台 = 開啟法會主控台_('TC');

    // 準備：一場對外活動、一場對內活動
    const obj表單 = 建立法會測試表單_(obj環境, '大車測試');
    送出法會測試回應_(obj表單, [{ 姓名: '王小明', 法名: '傳甲', 手機號碼: '0912345678', 參加日期: ['11/28'] }]);
    const str活動ID = 新增法會活動(obj住持, { str活動名稱: '測試大車法會', str活動類型: '對外', str來源網址: obj表單.obj回覆表.getUrl(), arr承辦人: [obj環境.str承辦甲] }).obj活動.str活動ID;
    const obj副本 = SpreadsheetApp.openById(取得法會活動_(obj主控台, str活動ID).obj值['副本ID']);
    obj環境.arr暫存檔.push(obj副本.getId());
    const obj內表單 = 建立法會測試表單_(obj環境, '對內測試');
    送出法會測試回應_(obj內表單, [{ 姓名: '陳美麗', 法名: '', 手機號碼: '0933444555', 參加日期: ['11/28'] }]);
    const str內部ID = 新增法會活動(obj住持, { str活動名稱: '測試對內法會', str活動類型: '對內', str來源網址: obj內表單.obj回覆表.getUrl() }).obj活動.str活動ID;
    obj環境.arr暫存檔.push(取得法會活動_(obj主控台, str內部ID).obj值['副本ID']);

    // 承辦人整理好的有效資料
    const dat報名 = new Date(2026, 9, 20, 9, 30, 0);
    const arr標題 = ['時間戳記', '姓名', '法名', '手機號碼', '護七_行程 [11/28 (六)]', '護七_行程 [11/29 (日)]', '護七_行程 [11/30 (一)]', '交通方式', '義工組別', '領隊'];
    const arr資料 = [arr標題,
      [dat報名, '王小明', '傳甲', 912345678, '是', '是', '', '去程搭大車 08:00、回程自行', '香積', 2],
      [new Date(2026, 9, 20, 9, 31, 0), '李大華', '', '0922333444', '是', '', '是', '來回搭大車', '', ''],
      [new Date(2026, 9, 20, 9, 32, 0), '陳美麗', '', '12345', '', '是', '', '自行', '', 9],
      [new Date(2026, 9, 20, 9, 33, 0), '林志明', '', '', '', '', '', '', '', '']];
    寫入測試有效資料_(obj副本, arr資料);

    // ── 一、權限與限制 ──
    const obj甲 = obj環境.重新判定(obj環境.str承辦甲);
    t.預期錯誤('承辦人沒有匯出權限不能產生', obj錯誤代碼.權限不足, function () { 產生法會點名資料(obj甲, { str活動ID: str活動ID }); });
    t.預期錯誤('對內活動不需要大車點名', obj錯誤代碼.參數錯誤, function () { 產生法會點名資料(obj住持, { str活動ID: str內部ID }); });
    t.預期錯誤('還沒產生就匯出', obj錯誤代碼.參數錯誤, function () { 匯出法會點名(obj住持, { str活動ID: str活動ID }); });

    // ── 二、第一次產生：只建立設定 ──
    設定人員權限(obj住持, { str帳號: obj環境.str承辦甲, arr權限: ['event.整理資料', 'event.匯出大車點名'] });
    const obj甲二 = obj環境.重新判定(obj環境.str承辦甲);
    const obj第一次 = 產生法會點名資料(obj甲二, { str活動ID: str活動ID });
    const obj設定分頁 = obj副本.getSheetByName('點名欄位設定');
    t.記錄('第一次：建立點名欄位設定並停下', obj第一次.bool需確認設定 === true && !!obj設定分頁 && !obj副本.getSheetByName('大車報到點名資料'), obj第一次.str訊息);
    const obj設定 = 讀取大車點名設定_(obj設定分頁);
    t.記錄('設定：推測逐日勾選、交通、組別、領隊', obj設定['日期型態'] === '逐日勾選' && obj設定['交通方式欄'] === '交通方式'
      && obj設定['領隊欄'] === '領隊' && obj設定['手機號碼欄'] === '手機號碼', JSON.stringify(obj設定));

    // ── 三、第二次產生 ──
    const obj產生 = 產生法會點名資料(obj甲二, { str活動ID: str活動ID });
    const obj點名分頁 = obj副本.getSheetByName('大車報到點名資料');
    let arr點名 = 讀取點名列_(obj點名分頁);
    t.記錄('產生：5 趟（李大華兩趟）', obj產生.int趟數 === 5 && arr點名.length === 5, obj產生.str訊息 + ' ' + (obj產生.arr明細 || []).join('｜'));
    const obj王 = arr點名.filter(function (o) { return o['姓名'] === '王小明'; })[0];
    t.記錄('產生：王小明手機、領隊、日期、組別', obj王['手機號碼'] === '0912-345678' && obj王['領隊'] === '總領隊'
      && obj王['日期-起'] === '11/28' && obj王['日期-迄'] === '11/29' && obj王['義工組別'] === '香積', JSON.stringify(obj王));
    t.記錄('產生：王小明回程自行、去程上午、去程待填', obj王['回程'] === '自行' && obj王['去程時段'] === '上午' && obj王['去程'] === '');
    t.記錄('產生：待分車 4 趟', obj產生.int待分車 === 4, String(obj產生.int待分車));
    t.記錄('產生：手機、領隊、日期問題共 4 格黃底', obj產生.int問題格 === 4, String(obj產生.int問題格));
    const obj標題索引 = 取得副本標題索引_(obj點名分頁);
    t.記錄('產生：系統欄位在最後兩欄', obj標題索引['系統_趟次鍵'] === 17 && obj標題索引['系統_狀態'] === 18);
    t.記錄('產生：上次產生點名時間已記錄', String(取得法會活動_(obj主控台, str活動ID).obj值['上次產生點名時間']).trim() !== '');

    // 承辦人填車次、修改有效資料後重新產生
    const int王列 = arr點名.map(function (o) { return o['姓名']; }).indexOf('王小明') + 2;
    obj點名分頁.getRange(int王列, obj標題索引['去程']).setValue('1');
    obj點名分頁.getRange(int王列, obj標題索引['車號']).setValue('A-01');
    obj副本.getSheetByName('有效資料').getRange(3, 7).setValue('');                 // 李大華取消 11/30
    obj副本.getSheetByName('有效資料').appendRow([new Date(2026, 9, 21, 8, 0, 0), '吳大同', '傳丁', '0988999000', '', '', '是', '自行', '', 1]);
    const obj重產 = 產生法會點名資料(obj甲二, { str活動ID: str活動ID });
    arr點名 = 讀取點名列_(obj點名分頁);
    const obj王二 = arr點名.filter(function (o) { return o['姓名'] === '王小明'; })[0];
    t.記錄('重新產生：承辦人填的車次與車號保留', obj王二['去程'] === '1' && obj王二['車號'] === 'A-01', JSON.stringify(obj王二));
    t.記錄('重新產生：取消的那一趟標「已消失」', obj重產.int已消失 === 1 && arr點名.filter(function (o) { return o['系統_狀態'] === '已消失'; }).length === 1);
    t.記錄('重新產生：新報名加在最後', obj重產.int新增 === 1 && arr點名[arr點名.length - 1]['姓名'] === '吳大同' && arr點名[arr點名.length - 1]['領隊'] === '法師');

    // 領隊代號表
    const obj代號 = 建立法會領隊代號表(obj甲二, { str活動ID: str活動ID });
    t.記錄('領隊代號表：建立並填入預設', obj代號.bool新建 === true && obj副本.getSheetByName('領隊代號').getLastRow() === 7);
    obj副本.getSheetByName('領隊代號').appendRow(['9', '護法']);
    t.記錄('領隊代號表：再按一次不覆蓋', 建立法會領隊代號表(obj甲二, { str活動ID: str活動ID }).bool新建 === false);
    產生法會點名資料(obj甲二, { str活動ID: str活動ID });
    t.記錄('領隊代號表：自訂代號 9 換算成護法', 讀取點名列_(obj點名分頁).filter(function (o) { return o['姓名'] === '陳美麗'; })[0]['領隊'] === '護法');

    // ── 四、匯出 ──
    t.預期錯誤('未登記大車點名試算表', obj錯誤代碼.設定缺漏, function () { 匯出法會點名(obj甲二, { str活動ID: str活動ID, bool僅預覽: true }); });
    const obj點名表 = SpreadsheetApp.create('法會測試_大車點名系統');
    obj環境.arr暫存檔.push(obj點名表.getId());
    const obj不是 = SpreadsheetApp.create('法會測試_不是點名表');
    obj環境.arr暫存檔.push(obj不是.getId());
    t.預期錯誤('格式檢查：沒有活動配置分頁', obj錯誤代碼.工作表不存在, function () { 檢查大車點名試算表格式_(obj不是); });
    obj點名表.getSheets()[0].setName('活動配置');
    obj點名表.getSheetByName('活動配置').getRange(1, 1, 1, 6).setValues([['活動名稱', '大車名單工作表', '報到紀錄工作表', '狀態', '回饋表單', '回饋表單編輯']]);
    obj點名表.getSheetByName('活動配置').appendRow(['其他活動', '大車名單-其他活動', '報到紀錄-其他活動', '啟用', '', '']);
    登記外部檔案(obj住持, { str項目: '大車點名試算表', str檔案: obj點名表.getUrl() });

    const obj預覽 = 匯出法會點名(obj甲二, { str活動ID: str活動ID });
    t.記錄('匯出預覽：5 筆（不含已消失）、首次、不改資料', obj預覽.bool預覽 === true && obj預覽.int筆數 === 5 && obj預覽.bool首次 === true
      && obj預覽.str名單分頁名 === '大車名單-測試大車法會' && !obj點名表.getSheetByName('大車名單-測試大車法會'), JSON.stringify(obj預覽));
    const obj匯出 = 匯出法會點名(obj甲二, { str活動ID: str活動ID, bool僅預覽: false });
    const obj名單 = obj點名表.getSheetByName('大車名單-測試大車法會');
    const arr名單 = 讀取點名列_(obj名單);
    t.記錄('首次匯出：名單 5 筆、16 欄', obj匯出.int筆數 === 5 && arr名單.length === 5 && obj名單.getLastColumn() === 16, obj匯出.str訊息);
    t.記錄('首次匯出：系統欄位沒有匯出、狀態欄空白', !('系統_趟次鍵' in arr名單[0]) && arr名單.every(function (o) { return o['狀態'] === '' && o['去程狀態'] === ''; }));
    t.記錄('首次匯出：手機保留 0', arr名單.filter(function (o) { return o['姓名'] === '王小明'; })[0]['手機號碼'] === '0912-345678');
    t.記錄('首次匯出：建立報到紀錄分頁', !!obj點名表.getSheetByName('報到紀錄-測試大車法會'));
    const arr配置 = 讀取點名列_(obj點名表.getSheetByName('活動配置'));
    t.記錄('首次匯出：活動配置新增一列啟用、其他活動不動', arr配置.length === 2 && arr配置[1]['大車名單工作表'] === '大車名單-測試大車法會'
      && arr配置[1]['狀態'] === '啟用' && arr配置[0]['狀態'] === '啟用');
    let obj活動 = 取得法會活動_(obj主控台, str活動ID).obj值;
    t.記錄('首次匯出：活動進入演練並記下匯出試算表', obj活動['活動狀態'] === '演練' && obj活動['匯出試算表ID'] === obj點名表.getId()
      && obj活動['匯出分頁名稱'] === '大車名單-測試大車法會' && String(obj活動['首次匯出時間']).trim() !== '');

    const obj再次 = 匯出法會點名(obj甲二, { str活動ID: str活動ID, bool僅預覽: false });
    const arr備份 = obj點名表.getSheets().filter(function (o) { return o.getName().indexOf('大車名單-測試大車法會_備份_') === 0; });
    t.記錄('再次匯出：先備份原名單', arr備份.length === 1 && obj再次.str訊息.indexOf('已備份') !== -1, obj再次.str訊息);
    t.記錄('再次匯出：活動配置沒有重複新增', 讀取點名列_(obj點名表.getSheetByName('活動配置')).length === 2);

    // ── 五、轉為正式／退回演練 ──
    t.預期錯誤('承辦人不能轉為正式', obj錯誤代碼.權限不足, function () { 轉法會點名為正式(obj甲二, { str活動ID: str活動ID }); });
    obj點名表.getSheetByName('報到紀錄-測試大車法會').appendRow(['11/28', '去程', '出發', '上午', '1', '', '王小明', '傳甲', '0912-345678', '', '08:01', '已報到']);
    const obj轉正 = 轉法會點名為正式(obj住持, { str活動ID: str活動ID });
    obj活動 = 取得法會活動_(obj主控台, str活動ID).obj值;
    t.記錄('轉為正式：狀態正式、記下時間', obj活動['活動狀態'] === '正式' && String(obj活動['轉正式時間']).trim() !== '', obj轉正.str訊息);
    t.記錄('轉為正式：演練報到紀錄清空並備份', obj點名表.getSheetByName('報到紀錄-測試大車法會').getLastRow() === 1
      && obj點名表.getSheets().some(function (o) { return o.getName().indexOf('報到紀錄-測試大車法會_備份_') === 0; }));
    t.預期錯誤('正式期不能再產生點名', obj錯誤代碼.參數錯誤, function () { 產生法會點名資料(obj甲二, { str活動ID: str活動ID }); });
    t.預期錯誤('正式期不能再匯出', obj錯誤代碼.參數錯誤, function () { 匯出法會點名(obj甲二, { str活動ID: str活動ID, bool僅預覽: false }); });
    退回法會演練(obj住持, { str活動ID: str活動ID });
    obj活動 = 取得法會活動_(obj主控台, str活動ID).obj值;
    t.記錄('退回演練：狀態演練、清掉轉正式時間', obj活動['活動狀態'] === '演練' && String(obj活動['轉正式時間']).trim() === '');
    轉法會點名為正式(obj住持, { str活動ID: str活動ID });

    // ── 六、結束與清除 ──
    t.預期錯誤('活動未結束不能清除', obj錯誤代碼.參數錯誤, function () { 清除法會點名資料(obj住持, { str活動ID: str活動ID }); });
    結束法會活動(obj住持, { str活動ID: str活動ID });
    t.記錄('結束：活動配置改為停用', 讀取點名列_(obj點名表.getSheetByName('活動配置'))[1]['狀態'] === '停用');
    重新開啟法會活動(obj住持, { str活動ID: str活動ID });
    obj活動 = 取得法會活動_(obj主控台, str活動ID).obj值;
    t.記錄('重新開啟：回到正式、活動配置改回啟用', obj活動['活動狀態'] === '正式' && 讀取點名列_(obj點名表.getSheetByName('活動配置'))[1]['狀態'] === '啟用');
    結束法會活動(obj住持, { str活動ID: str活動ID });

    const int分頁數 = obj點名表.getSheets().length;
    const obj清除預覽 = 清除法會點名資料(obj住持, { str活動ID: str活動ID });
    t.記錄('清除預覽：列出名單、報到與備份分頁，不刪資料', obj清除預覽.bool預覽 === true && obj清除預覽.arr分頁.length >= 5
      && obj清除預覽.int配置列數 === 1 && obj點名表.getSheets().length === int分頁數, obj清除預覽.arr分頁.join('、'));
    t.預期錯誤('清除：確認名稱不符不刪', obj錯誤代碼.參數錯誤, function () {
      清除法會點名資料(obj住持, { str活動ID: str活動ID, bool僅預覽: false, str確認名稱: '測試大車' });
    });
    const obj清除 = 清除法會點名資料(obj住持, { str活動ID: str活動ID, bool僅預覽: false, str確認名稱: '測試大車法會' });
    const arr剩下 = obj點名表.getSheets().map(function (o) { return o.getName(); });
    t.記錄('清除：只剩活動配置分頁、其他活動保留', arr剩下.length === 1 && arr剩下[0] === '活動配置'
      && 讀取點名列_(obj點名表.getSheetByName('活動配置')).length === 1, arr剩下.join('、') + '｜' + obj清除.str訊息);
    obj活動 = 取得法會活動_(obj主控台, str活動ID).obj值;
    t.記錄('清除：活動清單的匯出紀錄已清空', obj活動['匯出試算表ID'] === '' && obj活動['匯出分頁名稱'] === '');
    t.預期錯誤('清除：再按一次說明沒有匯出紀錄', obj錯誤代碼.參數錯誤, function () { 清除法會點名資料(obj住持, { str活動ID: str活動ID }); });

    // ── 七、經由路由 ──
    const str住持代碼 = 建立工作階段(obj住持);
    const obj路由 = 處理請求文字(JSON.stringify({ action: 'event.產生點名', token: str住持代碼, 參數: { str活動ID: str內部ID } }));
    t.記錄('路由：event.產生點名 回白話錯誤', obj路由.bool成功 === false && obj路由.str訊息.indexOf('對內') !== -1, obj路由.str訊息);

  } catch (err) {
    t.記錄('測試流程中斷', false, (err && err.message ? err.message : err) + (err && err.stack ? '\n' + err.stack : ''));
  } finally {
    清除法會測試環境_(obj環境);
  }
  return t.結算();
}
