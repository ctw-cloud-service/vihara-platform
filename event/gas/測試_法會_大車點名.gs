// ============================================================================
// 檔案名稱：測試_法會_大車點名.gs
// 所屬模組：法會活動（event）
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v2.2.0（2026-11-04）
//   v2.2.0：領隊代號轉中文（預設與自訂「領隊代號」分頁）、匯出換回代號
//   v2.1.0：缺欄仍產生（該欄空白、標題黃底、明細提醒）；只有缺「姓名」才停止；重複欄用最左邊那一欄
//   v2.0.0：配合 法會_大車匯出 v2.0.0 改測「產生出車資料」（依欄名直接對應），移除拆趟、領隊代號測試
//   v1.0.0（2026-10-27）：初版
// 用途說明：
//   在 Apps Script 編輯器執行：
//     · 測試_法會_大車點名純邏輯（數秒）：手機、日期、欄名比對、缺欄與重複欄提醒、整理出車資料
//     · 測試_法會_大車點名（約 1～3 分鐘）：缺欄仍產生 → 沒有姓名停止 → 產生出車資料 → 修改後重新產生（備份）→
//       匯出（首次／再次）→ 轉為正式 → 退回演練 → 結束停用 → 清除點名資料，
//       以及權限、對內活動、狀態限制。使用 測試_法會_活動與同步.gs 的共用測試環境，
//       另建一份暫存「大車點名試算表」，測完全部移到垃圾桶。
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：測試_法會_大車點名純邏輯
 * 版本：v2.2.0（2026-11-04）
 * ----------------------------------------------------------------------------
 * 用途：自動測試不碰檔案的出車資料計算規則（本機模擬與 GAS 編輯器皆可執行）。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_大車點名純邏輯() {
  const t = 建立法會測試記錄器_();
  const dat五月 = new Date(2026, 4, 1, 10, 0, 0);
  const fn日 = function (d) { return 是日期值_(d) ? `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}` : String(d); };
  const arr範本 = obj出車資料格式.arr欄位;

  // ── 一、手機 ──
  t.記錄('手機：9 碼補 0 並加橫線', 格式化點名手機_(912345678).str值 === '0912-345678');
  t.記錄('手機：已有橫線或空白也統一', 格式化點名手機_('0912 345 678').str值 === '0912-345678');
  t.記錄('手機：範本格式不變', 格式化點名手機_('0972-387915').str值 === '0972-387915');
  t.記錄('手機：市話保留原樣並標問題', 格式化點名手機_('04-22223333').bool有問題 === true);
  t.記錄('手機：空白不算問題', 格式化點名手機_('').bool有問題 === false);

  // ── 二、日期 ──
  t.記錄('月日：「5月22日」', JSON.stringify(擷取月日_('5月22日')) === JSON.stringify([{ int月: 5, int日: 22 }]));
  t.記錄('月日：「11/28 (六)」仍可用', 擷取月日_('11/28 (六)')[0].int日 === 28);
  t.記錄('日期：日期值去掉時間', fn日(整理出車日期_(new Date(2026, 4, 22, 8, 30), dat五月).any值) === '2026/5/22'
    && 整理出車日期_(new Date(2026, 4, 22, 8, 30), dat五月).any值.getHours() === 0);
  t.記錄('日期：文字「5月22日」轉日期', fn日(整理出車日期_('5月22日', dat五月).any值) === '2026/5/22');
  t.記錄('日期：文字「5/23(六)」轉日期', fn日(整理出車日期_('5/23(六)', dat五月).any值) === '2026/5/23');
  t.記錄('日期：「2026-05-24」照年份', fn日(整理出車日期_('2026-05-24', dat五月).any值) === '2026/5/24');
  t.記錄('日期：12 月報名、1 月出發算隔年', fn日(整理出車日期_('1月3日', new Date(2026, 11, 1)).any值) === '2027/1/3');
  t.記錄('日期：空白不算問題', 整理出車日期_('', dat五月).any值 === '' && 整理出車日期_(null, dat五月).bool有問題 === false);
  t.記錄('日期：看不懂保留原文並標問題', 整理出車日期_('下週', dat五月).any值 === '下週' && 整理出車日期_('下週', dat五月).bool有問題 === true);
  t.記錄('日期：兩個日期標問題', 整理出車日期_('5/22、5/23', dat五月).bool有問題 === true);
  t.記錄('日期：2/30 不存在標問題', 整理出車日期_('2026/2/30', dat五月).bool有問題 === true);

  // ── 三、一般值與欄名 ──
  t.記錄('一般值：數字 1 →「1」', 出車一般值轉文字_(1) === '1');
  t.記錄('一般值：「2.0」→「2」', 出車一般值轉文字_('2.0') === '2');
  t.記錄('一般值：只有空格＝空白', 出車一般值轉文字_(' ') === '' && 出車一般值轉文字_('\u3000') === '');
  t.記錄('一般值：尾端空白去掉', 出車一般值轉文字_('BUZ-5801 ') === 'BUZ-5801');
  t.記錄('一般值：「自行」不變', 出車一般值轉文字_('自行') === '自行');
  t.記錄('欄名：前後全形空白去掉', 正規化出車欄名_('　車號 ') === '車號');

  // ── 三之二、領隊代號 ──
  const obj預設領隊 = 讀取領隊代號表_(null).obj表;
  t.記錄('領隊：沒有副本時用預設 1～6', Object.keys(obj預設領隊).length === 6 && obj預設領隊['1'] === '法師');
  t.記錄('領隊：數字 2 → 總領隊', 換算領隊名稱_(2, obj預設領隊).str值 === '總領隊');
  t.記錄('領隊：文字「5」「5.0」→ 副領隊', 換算領隊名稱_('5', obj預設領隊).str值 === '副領隊' && 換算領隊名稱_('5.0', obj預設領隊).str值 === '副領隊');
  t.記錄('領隊：已填名稱照用、不算問題', 換算領隊名稱_('法師', obj預設領隊).str值 === '法師' && 換算領隊名稱_('法師', obj預設領隊).bool有問題 === false);
  t.記錄('領隊：找不到的代號保留原值並標問題', 換算領隊名稱_(9, obj預設領隊).str值 === '9' && 換算領隊名稱_(9, obj預設領隊).bool有問題 === true);
  t.記錄('領隊：空白與空格不算問題', 換算領隊名稱_(' ', obj預設領隊).str值 === '' && 換算領隊名稱_('', obj預設領隊).bool有問題 === false);
  t.記錄('領隊：匯出時名稱換回代號', 換回領隊代號_('總領隊', obj預設領隊) === '2' && 換回領隊代號_('9', obj預設領隊) === '9' && 換回領隊代號_('', obj預設領隊) === '');

  // ── 四、欄位檢查 ──
  const arr齊全 = arr範本.filter(function (s) { return s !== '序號' && obj出車資料格式.arr點名系統欄位.indexOf(s) < 0; });
  const obj齊 = 檢查出車必要欄位_(['時間戳記'].concat(arr齊全));
  t.記錄('檢查：必要 13 欄齊全即可（不需序號、點名系統欄位）', arr齊全.length === 13 && obj齊.arr缺少.length === 0 && obj齊.arr重複.length === 0,
    JSON.stringify(obj齊.arr缺少));
  t.記錄('檢查：索引對到正確欄', obj齊.obj索引['姓名'] === 1 && obj齊.obj索引['車號說明'] === 13);
  const obj缺 = 檢查出車必要欄位_(['姓名', '法名', '手機號碼']);
  t.記錄('檢查：缺欄依範本順序列出', obj缺.arr缺少[0] === '身份別' && obj缺.arr缺少[obj缺.arr缺少.length - 1] === '車號說明' && obj缺.arr缺少.length === 10,
    obj缺.arr缺少.join('、'));
  t.記錄('檢查：欄名多空白也算有', 檢查出車必要欄位_(arr齊全.map(function (s) { return s === '車號' ? '車號 ' : s; })).arr缺少.length === 0);
  t.記錄('檢查：只差一字不算（「手機」≠「手機號碼」）', 檢查出車必要欄位_(arr齊全.map(function (s) { return s === '手機號碼' ? '手機' : s; })).arr缺少.join() === '手機號碼');
  const obj重 = 檢查出車必要欄位_(arr齊全.concat(['去程']));
  t.記錄('檢查：重複欄列出欄字母', obj重.arr重複.length === 1 && obj重.arr重複[0].str欄名 === '去程' && obj重.arr重複[0].arr欄字母.join() === 'H,N',
    JSON.stringify(obj重.arr重複));
  t.記錄('檢查：點名系統欄位重複不擋', 檢查出車必要欄位_(arr齊全.concat(['狀態', '狀態'])).arr重複.length === 0);
  const arr缺提醒 = 說明出車欄位問題_(obj缺);
  t.記錄('檢查：缺欄不停止，提醒列出缺少的欄名', arr缺提醒.length === 1 && arr缺提醒[0].indexOf('車號說明') >= 0, arr缺提醒.join('｜'));
  const arr重提醒 = 說明出車欄位問題_(obj重);
  t.記錄('檢查：重複欄不停止，用最左邊那一欄並提醒', obj重.obj索引['去程'] === 7 && arr重提醒.length === 1 && arr重提醒[0].indexOf('第 H 欄') >= 0, arr重提醒.join('｜'));
  t.記錄('檢查：欄位齊全沒有提醒', 說明出車欄位問題_(obj齊).length === 0);
  t.預期錯誤('檢查：沒有「姓名」欄才停止', obj錯誤代碼.欄位缺漏, function () { 說明出車欄位問題_(檢查出車必要欄位_(['法名', '手機號碼'])); });

  t.記錄('匯出：點名系統名單 16 欄、第一欄姓名、不含序號', obj大車點名格式.arr名單欄位.length === 16
    && obj大車點名格式.arr名單欄位[0] === '姓名' && obj大車點名格式.arr名單欄位.indexOf('序號') < 0);

  // ── 五、整理出車資料 ──
  const arr標題 = ['時間戳記', '交通方式'].concat(arr範本.filter(function (s) { return s !== '序號'; }));   // 含點名系統欄位
  const fn列 = function (obj) { return arr標題.map(function (s) { return s in obj ? obj[s] : ''; }); };
  const arr全部 = [arr標題,
    fn列({ 時間戳記: dat五月, 姓名: '見甸法師', 手機號碼: '0972-387915', 身份別: '法師', 領隊: 1, '日期-起': new Date(2026, 4, 22), '日期-迄': new Date(2026, 4, 23), 去程: 1, 回程: 1, 狀態: '舊值' }),
    fn列({ 時間戳記: dat五月, 姓名: '蔡宗坤', 法名: '法俊', 手機號碼: 961289788, 身份別: '義工', 領隊: 2, '日期-起': '5月22日', '日期-迄': new Date(2026, 4, 24), 去程: 1, 回程: '自行', 義工組別: '男巡' }),
    fn列({ 姓名: '  ' }),
    fn列({ 時間戳記: dat五月, 姓名: '莊秀鏡', 法名: '傳鏡', 手機號碼: '12345', 身份別: 'V', 領隊: ' ', '日期-起': '5月23日', '日期-迄': '5月22日', 去程: 2, 車號: 'BUZ-5801 ' })
  ];
  const obj整理 = 整理出車資料_(arr全部, dat五月);
  t.記錄('整理：3 筆、略過 1 列、序號連號', obj整理.arr資料.length === 3 && obj整理.int略過 === 1
    && obj整理.arr資料.map(function (a) { return a[0]; }).join() === '1,2,3');
  t.記錄('整理：每列 17 欄、順序同範本', obj整理.arr資料.every(function (a) { return a.length === 17; }) && obj整理.arr資料[1][arr範本.indexOf('姓名')] === '蔡宗坤');
  t.記錄('整理：表單原欄不帶入', obj整理.arr資料[0].indexOf('交通方式') < 0);
  t.記錄('整理：點名系統欄位一律空白（來源有值也清空）', obj整理.arr資料[0][arr範本.indexOf('狀態')] === '');
  t.記錄('整理：手機補 0、日期轉換', obj整理.arr資料[1][arr範本.indexOf('手機號碼')] === '0961-289788'
    && fn日(obj整理.arr資料[1][arr範本.indexOf('日期-起')]) === '2026/5/22');
  t.記錄('整理：領隊代號換中文（1 法師、2 總領隊）', obj整理.arr資料[0][arr範本.indexOf('領隊')] === '法師' && obj整理.arr資料[1][arr範本.indexOf('領隊')] === '總領隊');
  const obj自訂 = 整理出車資料_(arr全部, dat五月, { '1': '住持', '2': '總領隊' });
  t.記錄('整理：可用自訂對照表', obj自訂.arr資料[0][arr範本.indexOf('領隊')] === '住持' && obj自訂.int領隊問題 === 0);
  const obj錯代號 = 整理出車資料_([['姓名', '領隊'], ['王小明', 9]], dat五月);
  t.記錄('整理：找不到的代號算領隊問題', obj錯代號.int領隊問題 === 1 && obj錯代號.arr資料[0][arr範本.indexOf('領隊')] === '9');
  t.記錄('整理：領隊空格＝空白、車號去空白', obj整理.arr資料[2][arr範本.indexOf('領隊')] === '' && obj整理.arr資料[2][arr範本.indexOf('車號')] === 'BUZ-5801');
  t.記錄('整理：問題 3 格（手機、迄早於起兩格）', obj整理.arr問題.length === 3 && obj整理.arr問題.every(function (o) { return o.int列 === 2; }),
    JSON.stringify(obj整理.arr問題));
  t.記錄('整理：待分車 1 筆（莊秀鏡回程空白）', obj整理.int待分車 === 1);
  t.預期錯誤('整理：只有標題', obj錯誤代碼.參數錯誤, function () { 整理出車資料_([arr標題], dat五月); });
  t.預期錯誤('整理：全部沒有姓名', obj錯誤代碼.參數錯誤, function () { 整理出車資料_([arr標題, fn列({ 法名: '傳甲' })], dat五月); });
  const obj只有姓名 = 整理出車資料_([['姓名', '去程'], ['王小明', 1]], dat五月);
  t.記錄('整理：只有姓名、去程也產生，其他欄空白', obj只有姓名.arr資料.length === 1 && obj只有姓名.arr資料[0].length === 17
    && obj只有姓名.arr資料[0][arr範本.indexOf('去程')] === '1' && obj只有姓名.arr資料[0][arr範本.indexOf('車號')] === ''
    && obj只有姓名.arr缺少欄.length === 11 && obj只有姓名.arr欄位提醒.length === 1, obj只有姓名.arr缺少欄.join('、'));
  t.預期錯誤('整理：沒有姓名欄停止', obj錯誤代碼.欄位缺漏, function () { 整理出車資料_([['法名'], ['傳甲']], dat五月); });

  return t.結算();
}


/**
 * ============================================================================
 * 函式名稱：寫入測試有效資料_（測試共用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：把副本「有效資料」整份換成指定內容（模擬承辦人整理好的資料）。
 * 參數：obj副本 {Spreadsheet}；arr資料 {Array[]} 含標題列
 * 傳回：無
 * ============================================================================
 */
function 寫入測試有效資料_(obj副本, arr資料) {
  const obj有效 = obj副本.getSheetByName('有效資料');
  obj有效.getRange(1, 1, obj有效.getMaxRows(), obj有效.getMaxColumns()).clearContent();
  const int欄數 = arr資料[0].length;
  if (int欄數 > obj有效.getMaxColumns()) obj有效.insertColumnsAfter(obj有效.getMaxColumns(), int欄數 - obj有效.getMaxColumns());
  obj有效.getRange(1, 1, arr資料.length, int欄數).setValues(arr資料);
  SpreadsheetApp.flush();
}


/**
 * ============================================================================
 * 函式名稱：讀取點名列_（測試共用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：把分頁讀成物件陣列（依標題，顯示值）。
 * 參數：obj分頁 {Sheet}
 * 傳回：{Object[]}
 * ============================================================================
 */
function 讀取點名列_(obj分頁) {
  if (!obj分頁 || obj分頁.getLastRow() < 2) return [];
  const arr值 = obj分頁.getRange(1, 1, obj分頁.getLastRow(), obj分頁.getLastColumn()).getDisplayValues();
  const arr標題 = arr值[0];
  return arr值.slice(1).filter(function (arr) { return arr.join('') !== ''; }).map(function (arr) {
    const obj = {};
    arr標題.forEach(function (s, i) { obj[s] = arr[i]; });
    return obj;
  });
}


/**
 * ============================================================================
 * 函式名稱：測試_法會_大車點名
 * 版本：v2.2.0（2026-11-04）　v2.2.0：領隊代號換中文、自訂分頁、匯出換回代號
 * ----------------------------------------------------------------------------
 * 用途：自動測試大車點名的完整流程。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_大車點名() {
  const t = 建立法會測試記錄器_();
  let obj環境 = null;

  try {
    obj環境 = 建立法會測試環境_();
    const obj住持 = obj環境.obj住持;
    const obj主控台 = 開啟法會主控台_('TC');

    // 準備：一場對外活動、一場對內活動
    const obj表單 = 建立法會測試表單_(obj環境, '大車測試');
    送出法會測試回應_(obj表單, [{ 姓名: '王小明', 法名: '傳甲', 手機號碼: '0912345678', 參加日期: ['11/28'] }]);
    const str活動ID = 新增法會活動(obj住持, { str活動名稱: '測試大車法會', str活動類型: '對外', str來源網址: obj表單.obj回覆表.getUrl(), arr承辦人: [obj環境.str承辦甲] }).obj活動.str活動ID;
    const obj副本 = SpreadsheetApp.openById(取得法會活動_(obj主控台, str活動ID).obj值['副本ID']);
    obj環境.arr暫存檔.push(obj副本.getId());
    const obj內表單 = 建立法會測試表單_(obj環境, '對內測試');
    送出法會測試回應_(obj內表單, [{ 姓名: '陳美麗', 法名: '', 手機號碼: '0933444555', 參加日期: ['11/28'] }]);
    const str內部ID = 新增法會活動(obj住持, { str活動名稱: '測試對內法會', str活動類型: '對內', str來源網址: obj內表單.obj回覆表.getUrl() }).obj活動.str活動ID;
    obj環境.arr暫存檔.push(取得法會活動_(obj主控台, str內部ID).obj值['副本ID']);

    // 承辦人整理好的有效資料：表單原有欄位＋右側新增的出車欄位（欄名與出車範本相同）
    const arr標題 = ['時間戳記', '姓名', '法名', '手機號碼', '交通方式（表單原欄）', '身份別', '領隊', '日期-起', '日期-迄',
      '去程', '回程', '去程時段', '義工組別', '車號', '車號說明'];
    const arr資料 = [arr標題,
      [new Date(2026, 4, 1, 9, 30, 0), '王小明', '傳甲', 912345678, '來回搭車', '義工', 2, new Date(2026, 4, 22, 8, 0, 0), '5月23日', 1, 1, '上午', '香積', '', ''],
      [new Date(2026, 4, 1, 9, 31, 0), '李大華', '', '0922 333 444', '去搭回自行', '信眾', '', '5/22', '5/23', 2, '自行', '', '', '', ''],
      [new Date(2026, 4, 1, 9, 32, 0), '陳美麗', '', '12345', '自行', 'V', ' ', '下週', '5/23', '自行', '', '', '', 'BUZ-5801 ', '車主'],
      ['', '', '', '', '', '', '', '', '', '', '', '', '', '', ''],
      [new Date(2026, 4, 1, 9, 33, 0), '林志明', '', '0933444555', '', '法師', 1, '5月24日', '5月23日', 3, 3, '', '', '', '']];
    寫入測試有效資料_(obj副本, arr資料);

    // ── 一、權限與限制 ──
    const obj甲 = obj環境.重新判定(obj環境.str承辦甲);
    t.預期錯誤('承辦人沒有匯出權限不能產生', obj錯誤代碼.權限不足, function () { 產生法會點名資料(obj甲, { str活動ID: str活動ID }); });
    t.預期錯誤('對內活動不需要大車點名', obj錯誤代碼.參數錯誤, function () { 產生法會點名資料(obj住持, { str活動ID: str內部ID }); });
    t.預期錯誤('還沒產生就匯出', obj錯誤代碼.參數錯誤, function () { 匯出法會點名(obj住持, { str活動ID: str活動ID }); });
    t.預期錯誤('舊副本的「領隊代號對照表」回覆停用說明', obj錯誤代碼.參數錯誤, function () { 副本選單_領隊代號表(null, {}); });

    // ── 二、缺欄位：仍然產生，缺的欄空白、標題黃底、明細提醒 ──
    設定人員權限(obj住持, { str帳號: obj環境.str承辦甲, arr權限: ['event.整理資料', 'event.匯出大車點名'] });
    const obj甲二 = obj環境.重新判定(obj環境.str承辦甲);
    寫入測試有效資料_(obj副本, arr資料.map(function (arr列) { return arr列.slice(0, 13); }));     // 少了車號、車號說明
    const obj缺欄 = 產生法會點名資料(obj甲二, { str活動ID: str活動ID });
    const obj缺欄分頁 = obj副本.getSheetByName('出車資料');
    t.記錄('缺欄位：仍然產生 4 筆', obj缺欄.int筆數 === 4 && !!obj缺欄分頁, obj缺欄.str訊息);
    t.記錄('缺欄位：明細第一項列出缺少的車號、車號說明', obj缺欄.arr缺少欄.join() === '車號,車號說明'
      && obj缺欄.arr明細[0].indexOf('車號、車號說明') >= 0, (obj缺欄.arr明細 || []).join('｜'));
    t.記錄('缺欄位：車號欄空白、標題黃底', 讀取點名列_(obj缺欄分頁).every(function (o) { return o['車號'] === '' && o['車號說明'] === ''; })
      && obj缺欄分頁.getRange(1, 15).getBackground() === obj出車資料格式.str缺欄標題底色);
    寫入測試有效資料_(obj副本, arr資料.map(function (arr列) { return arr列.slice(2); }));                // 連姓名都沒有
    t.預期錯誤('沒有姓名欄：停止', obj錯誤代碼.欄位缺漏, function () { 產生法會點名資料(obj甲二, { str活動ID: str活動ID }); });
    寫入測試有效資料_(obj副本, arr資料);

    // ── 三、產生出車資料 ──
    const obj產生 = 產生法會點名資料(obj甲二, { str活動ID: str活動ID });
    const obj出車分頁 = obj副本.getSheetByName('出車資料');
    let arr出車 = 讀取點名列_(obj出車分頁);
    t.記錄('產生：4 筆（空白列略過）、欄位齊全沒有缺欄提醒', obj產生.int筆數 === 4 && arr出車.length === 4 && obj產生.int略過 === 1
      && obj產生.arr缺少欄.length === 0 && obj出車分頁.getRange(1, 15).getBackground() !== obj出車資料格式.str缺欄標題底色,
      obj產生.str訊息 + ' ' + (obj產生.arr明細 || []).join('｜'));
    t.記錄('產生：欄位與順序同出車範本（17 欄）', obj出車分頁.getLastColumn() === 17
      && obj出車分頁.getRange(1, 1, 1, 17).getValues()[0].join(',') === obj出車資料格式.arr欄位.join(','));
    t.記錄('產生：序號 1～4', arr出車.map(function (o) { return o['序號']; }).join(',') === '1,2,3,4');
    const obj王 = arr出車[0];
    t.記錄('產生：王小明手機、領隊（2→總領隊）、日期、組別', obj王['手機號碼'] === '0912-345678' && obj王['領隊'] === '總領隊'
      && obj王['日期-起'] === '5/22' && obj王['日期-迄'] === '5/23' && obj王['義工組別'] === '香積' && obj王['去程時段'] === '上午', JSON.stringify(obj王));
    t.記錄('產生：表單原欄沒有帶入', !('交通方式（表單原欄）' in obj王));
    t.記錄('產生：陳美麗車號去空白、領隊空格視為空白', arr出車[2]['車號'] === 'BUZ-5801' && arr出車[2]['領隊'] === '', JSON.stringify(arr出車[2]));
    t.記錄('產生：林志明領隊 1 → 法師', arr出車[3]['領隊'] === '法師', arr出車[3]['領隊']);
    t.記錄('產生：點名系統欄位空白', arr出車.every(function (o) { return o['去程狀態'] === '' && o['回程狀態'] === '' && o['狀態'] === ''; }));
    t.記錄('產生：待分車 1 筆（陳美麗回程空白）', obj產生.int待分車 === 1, String(obj產生.int待分車));
    t.記錄('產生：問題格 4 格（陳美麗手機與日期、林志明迄早於起兩格）', obj產生.int問題格 === 4, String(obj產生.int問題格));
    t.記錄('產生：手機欄為純文字', obj出車分頁.getRange(2, 4).getNumberFormat() === '@');
    t.記錄('產生：上次產生點名時間已記錄', String(取得法會活動_(obj主控台, str活動ID).obj值['上次產生點名時間']).trim() !== '');

    // 修改有效資料、新報名後重新產生：整份重建、舊的備份隱藏，只留 3 份
    obj副本.getSheetByName('有效資料').getRange(3, 11).setValue('1');                  // 李大華回程改搭 1 車
    obj副本.getSheetByName('有效資料').appendRow([new Date(2026, 4, 2, 8, 0, 0), '吳大同', '傳丁', '0988999000', '', '信眾', '', '5/22', '5/23', 1, 1, '', '', '', '']);
    const obj重產 = 產生法會點名資料(obj甲二, { str活動ID: str活動ID });
    arr出車 = 讀取點名列_(obj出車分頁);
    t.記錄('重新產生：5 筆、新報名在最後、序號 5', obj重產.int筆數 === 5 && arr出車[4]['姓名'] === '吳大同' && arr出車[4]['序號'] === '5');
    t.記錄('重新產生：修改已反映', arr出車[1]['回程'] === '1');
    t.記錄('重新產生：舊的出車資料已備份並隱藏', !!obj重產.str備份名 && obj副本.getSheetByName(obj重產.str備份名).isSheetHidden(), obj重產.str備份名);
    for (let i = 0; i < 3; i += 1) 產生法會點名資料(obj甲二, { str活動ID: str活動ID });     // 同一分鐘內的備份名稱會加 _2、_3
    const int備份數 = obj副本.getSheets().filter(function (o) { return o.getName().indexOf('出車資料_備份_') === 0; }).length;
    t.記錄('重新產生：備份最多保留 3 份', int備份數 <= 3, String(int備份數));

    // 自訂「領隊代號」分頁
    const obj代號分頁 = obj副本.insertSheet('領隊代號');
    obj代號分頁.getRange(1, 1, 3, 2).setValues([['領隊代號', '名稱'], ['1', '住持'], ['2', '總領隊']]);
    const obj自訂產生 = 產生法會點名資料(obj甲二, { str活動ID: str活動ID });
    t.記錄('領隊代號分頁：1 換成住持', 讀取點名列_(obj出車分頁)[3]['領隊'] === '住持', (obj自訂產生.arr明細 || []).join('｜'));
    obj代號分頁.getRange(2, 2).setValue('');
    t.預期錯誤('領隊代號分頁：代號沒填名稱時說明', obj錯誤代碼.參數錯誤, function () { 產生法會點名資料(obj甲二, { str活動ID: str活動ID }); });
    obj副本.deleteSheet(obj代號分頁);
    產生法會點名資料(obj甲二, { str活動ID: str活動ID });                         // 改回預設

    // ── 四、匯出 ──
    t.預期錯誤('未登記大車點名試算表', obj錯誤代碼.設定缺漏, function () { 匯出法會點名(obj甲二, { str活動ID: str活動ID, bool僅預覽: true }); });
    const obj點名表 = SpreadsheetApp.create('法會測試_大車點名系統');
    obj環境.arr暫存檔.push(obj點名表.getId());
    const obj不是 = SpreadsheetApp.create('法會測試_不是點名表');
    obj環境.arr暫存檔.push(obj不是.getId());
    t.預期錯誤('格式檢查：沒有活動配置分頁', obj錯誤代碼.工作表不存在, function () { 檢查大車點名試算表格式_(obj不是); });
    obj點名表.getSheets()[0].setName('活動配置');
    obj點名表.getSheetByName('活動配置').getRange(1, 1, 1, 6).setValues([['活動名稱', '大車名單工作表', '報到紀錄工作表', '狀態', '回饋表單', '回饋表單編輯']]);
    obj點名表.getSheetByName('活動配置').appendRow(['其他活動', '大車名單-其他活動', '報到紀錄-其他活動', '啟用', '', '']);
    登記外部檔案(obj住持, { str項目: '大車點名試算表', str檔案: obj點名表.getUrl() });

    const obj預覽 = 匯出法會點名(obj甲二, { str活動ID: str活動ID });
    t.記錄('匯出預覽：5 筆、首次、不改資料', obj預覽.bool預覽 === true && obj預覽.int筆數 === 5 && obj預覽.bool首次 === true
      && obj預覽.str名單分頁名 === '大車名單-測試大車法會' && !obj點名表.getSheetByName('大車名單-測試大車法會'), JSON.stringify(obj預覽));
    const obj匯出 = 匯出法會點名(obj甲二, { str活動ID: str活動ID, bool僅預覽: false });
    const obj名單 = obj點名表.getSheetByName('大車名單-測試大車法會');
    const arr名單 = 讀取點名列_(obj名單);
    t.記錄('首次匯出：名單 5 筆、16 欄不含序號（點名系統原格式）', obj匯出.int筆數 === 5 && arr名單.length === 5 && obj名單.getLastColumn() === 16
      && !('序號' in arr名單[0]) && obj名單.getRange(1, 1).getValue() === '姓名', obj匯出.str訊息);
    t.記錄('首次匯出：狀態欄空白', arr名單.every(function (o) { return o['狀態'] === '' && o['去程狀態'] === '' && o['回程狀態'] === ''; }));
    t.記錄('首次匯出：手機保留 0', arr名單.filter(function (o) { return o['姓名'] === '王小明'; })[0]['手機號碼'] === '0912-345678');
    t.記錄('首次匯出：領隊換回代號（總領隊→2）', arr名單.filter(function (o) { return o['姓名'] === '王小明'; })[0]['領隊'] === '2');
    t.記錄('首次匯出：建立報到紀錄分頁', !!obj點名表.getSheetByName('報到紀錄-測試大車法會'));
    const arr配置 = 讀取點名列_(obj點名表.getSheetByName('活動配置'));
    t.記錄('首次匯出：活動配置新增一列啟用、其他活動不動', arr配置.length === 2 && arr配置[1]['大車名單工作表'] === '大車名單-測試大車法會'
      && arr配置[1]['狀態'] === '啟用' && arr配置[0]['狀態'] === '啟用');
    let obj活動 = 取得法會活動_(obj主控台, str活動ID).obj值;
    t.記錄('首次匯出：活動進入演練並記下匯出試算表', obj活動['活動狀態'] === '演練' && obj活動['匯出試算表ID'] === obj點名表.getId()
      && obj活動['匯出分頁名稱'] === '大車名單-測試大車法會' && String(obj活動['首次匯出時間']).trim() !== '');

    const obj再次 = 匯出法會點名(obj甲二, { str活動ID: str活動ID, bool僅預覽: false });
    const arr備份 = obj點名表.getSheets().filter(function (o) { return o.getName().indexOf('大車名單-測試大車法會_備份_') === 0; });
    t.記錄('再次匯出：先備份原名單', arr備份.length === 1 && obj再次.str訊息.indexOf('已備份') !== -1, obj再次.str訊息);
    t.記錄('再次匯出：活動配置沒有重複新增', 讀取點名列_(obj點名表.getSheetByName('活動配置')).length === 2);

    // ── 五、轉為正式／退回演練 ──
    t.預期錯誤('承辦人不能轉為正式', obj錯誤代碼.權限不足, function () { 轉法會點名為正式(obj甲二, { str活動ID: str活動ID }); });
    obj點名表.getSheetByName('報到紀錄-測試大車法會').appendRow(['11/28', '去程', '出發', '上午', '1', '', '王小明', '傳甲', '0912-345678', '', '08:01', '已報到']);
    const obj轉正 = 轉法會點名為正式(obj住持, { str活動ID: str活動ID });
    obj活動 = 取得法會活動_(obj主控台, str活動ID).obj值;
    t.記錄('轉為正式：狀態正式、記下時間', obj活動['活動狀態'] === '正式' && String(obj活動['轉正式時間']).trim() !== '', obj轉正.str訊息);
    t.記錄('轉為正式：演練報到紀錄清空並備份', obj點名表.getSheetByName('報到紀錄-測試大車法會').getLastRow() === 1
      && obj點名表.getSheets().some(function (o) { return o.getName().indexOf('報到紀錄-測試大車法會_備份_') === 0; }));
    t.預期錯誤('正式期不能再產生出車資料', obj錯誤代碼.參數錯誤, function () { 產生法會點名資料(obj甲二, { str活動ID: str活動ID }); });
    t.預期錯誤('正式期不能再匯出', obj錯誤代碼.參數錯誤, function () { 匯出法會點名(obj甲二, { str活動ID: str活動ID, bool僅預覽: false }); });
    退回法會演練(obj住持, { str活動ID: str活動ID });
    obj活動 = 取得法會活動_(obj主控台, str活動ID).obj值;
    t.記錄('退回演練：狀態演練、清掉轉正式時間', obj活動['活動狀態'] === '演練' && String(obj活動['轉正式時間']).trim() === '');
    轉法會點名為正式(obj住持, { str活動ID: str活動ID });

    // ── 六、結束與清除 ──
    t.預期錯誤('活動未結束不能清除', obj錯誤代碼.參數錯誤, function () { 清除法會點名資料(obj住持, { str活動ID: str活動ID }); });
    結束法會活動(obj住持, { str活動ID: str活動ID });
    t.記錄('結束：活動配置改為停用', 讀取點名列_(obj點名表.getSheetByName('活動配置'))[1]['狀態'] === '停用');
    重新開啟法會活動(obj住持, { str活動ID: str活動ID });
    obj活動 = 取得法會活動_(obj主控台, str活動ID).obj值;
    t.記錄('重新開啟：回到正式、活動配置改回啟用', obj活動['活動狀態'] === '正式' && 讀取點名列_(obj點名表.getSheetByName('活動配置'))[1]['狀態'] === '啟用');
    結束法會活動(obj住持, { str活動ID: str活動ID });

    const int分頁數 = obj點名表.getSheets().length;
    const obj清除預覽 = 清除法會點名資料(obj住持, { str活動ID: str活動ID });
    t.記錄('清除預覽：列出名單、報到與備份分頁，不刪資料', obj清除預覽.bool預覽 === true && obj清除預覽.arr分頁.length >= 5
      && obj清除預覽.int配置列數 === 1 && obj點名表.getSheets().length === int分頁數, obj清除預覽.arr分頁.join('、'));
    t.預期錯誤('清除：確認名稱不符不刪', obj錯誤代碼.參數錯誤, function () {
      清除法會點名資料(obj住持, { str活動ID: str活動ID, bool僅預覽: false, str確認名稱: '測試大車' });
    });
    const obj清除 = 清除法會點名資料(obj住持, { str活動ID: str活動ID, bool僅預覽: false, str確認名稱: '測試大車法會' });
    const arr剩下 = obj點名表.getSheets().map(function (o) { return o.getName(); });
    t.記錄('清除：只剩活動配置分頁、其他活動保留', arr剩下.length === 1 && arr剩下[0] === '活動配置'
      && 讀取點名列_(obj點名表.getSheetByName('活動配置')).length === 1, arr剩下.join('、') + '｜' + obj清除.str訊息);
    obj活動 = 取得法會活動_(obj主控台, str活動ID).obj值;
    t.記錄('清除：活動清單的匯出紀錄已清空', obj活動['匯出試算表ID'] === '' && obj活動['匯出分頁名稱'] === '');
    t.預期錯誤('清除：再按一次說明沒有匯出紀錄', obj錯誤代碼.參數錯誤, function () { 清除法會點名資料(obj住持, { str活動ID: str活動ID }); });

    // ── 七、經由路由 ──
    const str住持代碼 = 建立工作階段(obj住持);
    const obj路由 = 處理請求文字(JSON.stringify({ action: 'event.產生點名', token: str住持代碼, 參數: { str活動ID: str內部ID } }));
    t.記錄('路由：event.產生點名 回白話錯誤', obj路由.bool成功 === false && obj路由.str訊息.indexOf('對內') !== -1, obj路由.str訊息);

  } catch (err) {
    t.記錄('測試流程中斷', false, (err && err.message ? err.message : err) + (err && err.stack ? '\n' + err.stack : ''));
  } finally {
    清除法會測試環境_(obj環境);
  }
  return t.結算();
}
