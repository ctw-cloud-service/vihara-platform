// ============================================================================
// 檔案名稱：測試_法會_報到名冊.gs
// 所屬模組：法會活動（event）
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.1.0（2026-11-05）
//   v1.1.0：配合 法會_報到名冊 v1.1.0（一場一頁）：改測分頁名稱、自加欄位帶回、一次一個場次；移除合併測試
//   v1.0.0：初版（含副本活動類型標記，以模擬試算表測試，不碰檔案）
// 用途說明：
//   在 Apps Script 編輯器執行：
//     · 測試_法會_報到名冊純邏輯（數秒）：時間戳記、報名先後、場次欄判斷、場次去重、
//       取消與同名不同法名提醒、名冊標題、分頁名稱、自加欄位帶回、一次一個場次、對內活動檢查、副本活動類型標記。不碰任何檔案。
//   測試資料取自三份實際表單的欄名與典型情況（一支香 7-12、共修三昧水懺、10–12 月組別培訓）。
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：測試_法會_報到名冊純邏輯
 * 版本：v1.1.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：自動測試不碰檔案的場次名冊計算規則（本機模擬與 GAS 編輯器皆可執行）。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_報到名冊純邏輯() {
  const t = 建立法會測試記錄器_();
  const dat七月 = new Date(2026, 6, 5);
  const dat十月 = new Date(2026, 9, 10);
  const fn時 = function (o) { return o.dat時間 ? 格式化日期(o.dat時間, 'yyyy/M/d HH:mm:ss') : (o.bool空白 ? '空白' : '看不懂'); };

  // ── 一、時間戳記 ──
  t.記錄('時間：日期值直接使用', fn時(解析報名時間_(new Date(2026, 8, 1, 6, 8, 39))) === '2026/9/1 06:08:39');
  t.記錄('時間：「2026/9/1 上午 6:08:39」', fn時(解析報名時間_('2026/9/1 上午 6:08:39')) === '2026/9/1 06:08:39');
  t.記錄('時間：「2026/9/1 下午 2:16:04」→ 14 點', fn時(解析報名時間_('2026/9/1 下午 2:16:04')) === '2026/9/1 14:16:04');
  t.記錄('時間：下午 12 點仍是 12 點', fn時(解析報名時間_('2026/10/28 下午 12:14:45')) === '2026/10/28 12:14:45');
  t.記錄('時間：上午 12 點是 0 點', fn時(解析報名時間_('2026/10/28 上午 12:13:18')) === '2026/10/28 00:13:18');
  t.記錄('時間：只有日期「2026/4/1」', fn時(解析報名時間_('2026/4/1')) === '2026/4/1 00:00:00');
  t.記錄('時間：空白＝手動加入', 解析報名時間_('').bool空白 === true && 解析報名時間_(null).bool空白 === true);
  t.記錄('時間：看不懂的文字', 解析報名時間_('昨天').bool看不懂 === true);
  t.記錄('時間：不存在的日期 2/30 看不懂', 解析報名時間_('2026/2/30').bool看不懂 === true);

  // ── 二、報名先後 ──
  const fn筆 = function (any時間, int列) { return { obj時間: 解析報名時間_(any時間), int來源列: int列 }; };
  t.記錄('先後：時間晚的較新', 比較報名先後_(fn筆('2026/9/2', 2), fn筆('2026/9/1', 3)) > 0);
  t.記錄('先後：沒有時間戳記視為最新', 比較報名先後_(fn筆('', 2), fn筆('2026/12/31', 9)) > 0);
  t.記錄('先後：時間相同時下面的列較新', 比較報名先後_(fn筆('2026/11/2 下午 4:47:37', 145), fn筆('2026/11/2 下午 4:47:37', 144)) > 0);
  t.記錄('先後：兩筆都沒有時間時下面的列較新', 比較報名先後_(fn筆('', 10), fn筆('', 12)) < 0);

  // ── 三、場次欄判斷（三份表單的實際欄名） ──
  const arr一支香標題 = ['時間戳記', '姓名', '法名', '禪修班班別 [日間]', '禪修班班別 [夜間]',
    '欲參加時段 [7/5 (日)]', '欲參加時段 [7/19 (日)]', '欲參加時段 [8/2 (日)]', '欲參加時段 [8/16 (日)]', '欲參加時段 [9/20(日)]',
    '欲參加時段 [11/1 (日)]', '欲參加時段 [11/15 (日)]', '欲參加時段 [12/6 (日)]', '欲參加時段 [12/20(日)]', '申請禪凳', '備註', '系統_追加時間'];
  const obj一支香 = 找出報到名冊欄位_(arr一支香標題, dat七月);
  t.記錄('一支香：9 個場次', obj一支香.arr場次.length === 9, String(obj一支香.arr場次.length));
  t.記錄('一支香：時間戳記不算場次', obj一支香.arr場次.every(function (o) { return o.str場次 !== '時間戳記'; }));
  t.記錄('一支香：第一個場次 7/5、最後 12/20', obj一支香.arr場次[0].int日 === 5 && obj一支香.arr場次[8].int月 === 12 && obj一支香.arr場次[8].int日 === 20);
  t.記錄('一支香：場次年份依活動日期', obj一支香.arr場次[8].dat日期.getFullYear() === 2026);
  t.記錄('一支香：備註欄找到', obj一支香.arr備註欄.length === 1 && obj一支香.arr備註欄[0] === 15);
  t.記錄('一支香：系統_ 欄不帶入', obj一支香.arr帶入.every(function (o) { return o.str欄名.indexOf('系統_') !== 0; }));
  t.記錄('一支香：帶入班別、禪凳、備註', obj一支香.arr帶入.map(function (o) { return o.str欄名; }).join('|') === '禪修班班別 [日間]|禪修班班別 [夜間]|申請禪凳|備註');

  const arr共修標題 = ['時間戳記', '姓名', '法名', '性別', '禪修班班別 [日間]', '禪修班班別 [夜間]',
    '報名 10/10 (六)下午2-4點 - 三昧水懺_上卷', '報名 10/24 (六)下午2-4點 - 三昧水懺_中卷', '報名 10/31 (六)下午2-4點 - 三昧水懺_下卷',
    '報名 11/7 (六)下午2-4點 - 三昧水懺_上卷', '報名 11/14 (六)下午2-4點 - 三昧水懺_中卷', '報名 11/21 (六)下午2-4點 - 三昧水懺_下卷',
    '義工 (請註明  日期/執事。多場次義工時，請以 "，" 分隔)', '填寫表單者姓名', '需要坐椅子', '備註'];
  const obj共修 = 找出報到名冊欄位_(arr共修標題, dat十月);
  t.記錄('共修：6 個場次', obj共修.arr場次.length === 6, String(obj共修.arr場次.length));
  t.記錄('共修：義工欄（說明文字沒有日期）不算場次', obj共修.arr帶入.some(function (o) { return o.str欄名.indexOf('義工') === 0; }));

  const arr培訓標題 = ['NO', '時間戳記', '姓名', '法名', '性別', '您來自哪個精舍', '精舍班別', '大乘班別', '精舍名稱', '大乘班別',
    '11/29(日) 心燈組培訓 10:00 ~ 12:00', '12/13(日) 照客組培訓 13:00 ~ 17:00', '10/18(日) 庶務組培訓 14:00 ~ 16:00',
    '12/20(日) 司儀組培訓 10:00 ~ 12:00', '備註', '《個人資料保護法》同意書', '手機號碼', '精舍-整合', '大乘班-整合'];
  const obj培訓 = 找出報到名冊欄位_(arr培訓標題, new Date(2026, 9, 18));
  t.記錄('培訓：4 個場次', obj培訓.arr場次.length === 4);
  t.記錄('培訓：場次依日期排序（10/18 排第一）', obj培訓.arr場次[0].str場次.indexOf('10/18') === 0);
  t.記錄('培訓：場次時間「10:00 ~ 12:00」不影響日期', obj培訓.arr場次[0].int月 === 10 && obj培訓.arr場次[0].int日 === 18);
  t.記錄('培訓：「大乘班別」重複 → 用最左邊並提醒', obj培訓.arr欄位提醒.some(function (s) { return s.indexOf('2 個「大乘班別」欄') !== -1 && s.indexOf('第 H 欄') !== -1; }));
  t.記錄('培訓：重複欄只帶入一次', obj培訓.arr帶入.filter(function (o) { return o.str欄名 === '大乘班別'; }).length === 1);

  t.預期錯誤('欄位：沒有「姓名」欄停止', obj錯誤代碼.欄位缺漏, function () { 找出報到名冊欄位_(['時間戳記', '名字', '7/5'], dat七月); });
  t.記錄('欄位：沒有時間戳記也可以（提醒）', 找出報到名冊欄位_(['姓名', '7/5'], dat七月).arr欄位提醒.some(function (s) { return s.indexOf('時間戳記') !== -1; }));
  t.記錄('欄位：與名冊固定欄同名改為「原_」', 找出報到名冊欄位_(['姓名', '提醒', '7/5'], dat七月).arr帶入[0].str欄名 === '原_提醒');
  t.記錄('欄位：12 月活動、1 月場次算隔年', 找出報到名冊欄位_(['姓名', '1/3 (日)'], new Date(2026, 11, 1)).arr場次[0].dat日期.getFullYear() === 2027);
  t.記錄('欄位：欄名兩個日期用第一個並提醒', (function () {
    const o = 找出報到名冊欄位_(['姓名', '10/10、10/24 兩場'], dat十月);
    return o.arr場次[0].int日 === 10 && o.arr場次[0].bool多個日期 && o.arr欄位提醒.some(function (s) { return s.indexOf('有 2 個日期') !== -1; });
  })());
  t.記錄('欄位：「10月10日 共修」也算場次', 找出報到名冊欄位_(['姓名', '10月10日 共修'], dat十月).arr場次.length === 1);

  // ── 四、每場次去重（共修欄位，模擬典型情況） ──
  // 欄：0 時間戳記 1 姓名 2 法名 3 性別 4 日間 5 夜間 6～11 六個場次 12 義工 13 填表者 14 椅子 15 備註
  const fn共修列 = function (str時間, str姓名, str法名, arr場次, str備註) {
    const arr = [str時間, str姓名, str法名, '女', '', '研經班'];
    for (let i = 0; i < 6; i++) arr.push(arr場次.indexOf(i) !== -1 ? '參加' : '');
    return arr.concat(['', '本人', '', str備註 || '']);
  };
  const arr共修資料 = [
    fn共修列('2026/10/4 下午 10:16:30', '楊連宗', '傳訊', [0]),               // 列 2：分次追加
    fn共修列('2026/10/13 下午 10:14:44', '楊連宗', '傳訊', [1]),              // 列 3
    fn共修列('2026/10/26 上午 10:52:54', '楊連宗', '傳訊', [2]),              // 列 4
    fn共修列('2026/9/5 上午 10:16:49', '李清洲', '傳澈', [0, 1, 2]),         // 列 5：兩筆都有 10/31
    fn共修列('2026/10/22 下午 3:51:14', '李清洲', '傳澈', [1, 2]),            // 列 6
    fn共修列('2026/10/25 下午 11:26:48', '張美娜', '傳昇', [2, 3]),           // 列 7：43 秒內重送
    fn共修列('2026/10/25 下午 11:27:30', '張美娜', '傳昇', [2, 3]),           // 列 8
    fn共修列('2026/9/20 上午 9:39:13', '彭水珠', '傳晶', [0, 2]),            // 列 9：之後用備註取消 10/10
    fn共修列('2026/10/5 下午 4:08:11', '彭水珠', '傳晶', [], '10月10日法會取消'), // 列 10
    fn共修列('2026/10/1', '葉明璿', '蘇淑靖', [2]),                          // 列 11：法名填錯
    fn共修列('2026/10/2', '葉明璿 ', '傳璿', [2]),                           // 列 12：姓名後有空白、改正法名
    fn共修列('', '林嘉莉', '傳湛', [2]),                                     // 列 13：手動加入（沒有時間戳記）
    fn共修列('2026/12/31', '林嘉莉', '傳湛', [2]),                           // 列 14
    fn共修列('2026/10/3', '賈秀清', '傳清', [0, 1], '取消'),                  // 列 15：備註只寫取消
    fn共修列('2026/10/3', '', '', [0, 1, 2])                                 // 列 16：姓名空白
  ];
  const obj取消 = 整理取消備註_(arr共修資料, obj共修);
  const fn場次 = function (int) { return 整理場次名冊_(arr共修資料, obj共修, obj共修.arr場次[int], obj取消); };
  const fn找 = function (obj, str姓名) { return obj.arr列.filter(function (o) { return o.str姓名 === str姓名; }); };
  const obj1010 = fn場次(0);
  const obj1024 = fn場次(1);
  const obj1031 = fn場次(2);

  t.記錄('去重：楊連宗分次報名，10/10 用第 2 列', fn找(obj1010, '楊連宗').length === 1 && fn找(obj1010, '楊連宗')[0].int來源列 === 2);
  t.記錄('去重：楊連宗 10/24 用第 3 列、10/31 用第 4 列', fn找(obj1024, '楊連宗')[0].int來源列 === 3 && fn找(obj1031, '楊連宗')[0].int來源列 === 4);
  t.記錄('去重：李清洲兩筆都有 10/31，取較晚的第 6 列', fn找(obj1031, '李清洲').length === 1 && fn找(obj1031, '李清洲')[0].int來源列 === 6);
  t.記錄('去重：李清洲 10/10 只有第 5 列有，用第 5 列', fn找(obj1010, '李清洲')[0].int來源列 === 5);
  t.記錄('去重：張美娜重送兩筆只列一人（第 8 列）', fn找(obj1031, '張美娜').length === 1 && fn找(obj1031, '張美娜')[0].int來源列 === 8);
  t.記錄('去重：姓名後的空白不影響（葉明璿只列一人）', fn找(obj1031, '葉明璿').length === 1 && fn找(obj1031, '葉明璿')[0].int來源列 === 12);
  t.記錄('去重：沒有時間戳記的列視為最新（林嘉莉第 13 列）', fn找(obj1031, '林嘉莉')[0].int來源列 === 13 && fn找(obj1031, '林嘉莉')[0].any報名時間 === '手動');
  t.記錄('去重：姓名空白的列略過', obj1031.arr列.every(function (o) { return o.str姓名 !== ''; }));
  t.記錄('去重：10/31 有填 10 筆、名冊 6 人、合併 4 筆', obj1031.int有填筆數 === 10 && obj1031.arr列.length === 6 && obj1031.int去重筆數 === 4,
    `${obj1031.int有填筆數}/${obj1031.arr列.length}/${obj1031.int去重筆數}`);
  t.記錄('去重：名冊依來源列排序', obj1031.arr列.map(function (o) { return o.int來源列; }).join(',') === '4,6,8,9,12,13',
    obj1031.arr列.map(function (o) { return o.int來源列; }).join(','));
  t.記錄('去重：報名內容照錄', fn找(obj1031, '李清洲')[0].str報名內容 === '參加');
  t.記錄('去重：帶入取用那一列的備註', fn找(obj1010, '賈秀清')[0].obj帶入['備註'] === '取消');

  // ── 五、提醒 ──
  t.記錄('取消：彭水珠 10/10 有提醒（備註寫 10月10日）', fn找(obj1010, '彭水珠')[0].arr提醒.some(function (s) { return s.indexOf('取消') !== -1; }));
  t.記錄('取消：彭水珠 10/31 沒有取消提醒（日期不同）', fn找(obj1031, '彭水珠')[0].arr提醒.length === 0);
  t.記錄('取消：彭水珠仍列在 10/10（用第 9 列，空白那筆不算）', fn找(obj1010, '彭水珠')[0].int來源列 === 9);
  t.記錄('取消：備註只寫「取消」→ 每個場次都提醒', fn找(obj1010, '賈秀清')[0].arr提醒.length === 1 && fn找(obj1024, '賈秀清')[0].arr提醒.length === 1);
  t.記錄('取消：結果列出取消姓名', obj1010.arr取消姓名.join(',') === '彭水珠,賈秀清', obj1010.arr取消姓名.join(','));
  t.記錄('同名不同法名：葉明璿提醒並列出兩個法名', fn找(obj1031, '葉明璿')[0].arr提醒.some(function (s) { return s.indexOf('蘇淑靖') !== -1 && s.indexOf('傳璿') !== -1; })
    && obj1031.arr同名不同法名.join(',') === '葉明璿');
  t.記錄('同名不同法名：名冊用最新那一列的法名', fn找(obj1031, '葉明璿')[0].str法名 === '傳璿');
  t.記錄('時間看不懂：提醒並視為最新', (function () {
    const arr = [fn共修列('2026/10/1', '王小明', '法一', [0]), fn共修列('不明', '王小明', '法一', [0])];
    const o = 整理場次名冊_(arr, obj共修, obj共修.arr場次[0]);
    return o.arr列[0].int來源列 === 3 && o.arr列[0].arr提醒.some(function (s) { return s.indexOf('看不懂') !== -1; });
  })());

  // ── 六、一支香：格內是時段 ──
  const arr一支香資料 = [
    ['2026/4/1', '吳婉瑄', '傳瑄', '研經班', '', '下午2:00-2:40, 下午2:50-3:30, 下午3:40-4:20', '', '', '', '', '', '', '', '', '', '', ''],
    ['2026/6/16', '吳婉瑄', '傳瑄', '研經班', '', '', '下午2:00-2:40', '', '', '', '', '', '', '', '', '', '']
  ];
  const obj七五 = 整理場次名冊_(arr一支香資料, obj一支香, obj一支香.arr場次[0]);
  const obj七一九 = 整理場次名冊_(arr一支香資料, obj一支香, obj一支香.arr場次[1]);
  t.記錄('一支香：7/5 用 4/1 那筆（6/16 沒勾 7/5）', obj七五.arr列.length === 1 && obj七五.arr列[0].int來源列 === 2);
  t.記錄('一支香：報名內容是勾選的時段', obj七五.arr列[0].str報名內容 === '下午2:00-2:40, 下午2:50-3:30, 下午3:40-4:20');
  t.記錄('一支香：7/19 只有 6/16 那筆', obj七一九.arr列[0].int來源列 === 3 && obj七一九.arr列[0].str報名內容 === '下午2:00-2:40');

  // ── 七、名冊標題、分頁名稱、自加欄位、單一場次 ──
  const arr標題 = 組合名冊標題_(['性別', '備註'], ['場次', '姓名', '座位', '備註']);
  t.記錄('標題：固定欄在前、帶入欄、承辦人自加的「座位」保留', arr標題.join('|') === obj報到名冊格式.arr固定欄位.join('|') + '|性別|備註|座位', arr標題.join('|'));
  // 分頁名稱：一個場次一頁（v1.1.0）
  t.記錄('分頁名稱：「名冊_10月18日」', 產生名冊分頁名稱_({ int月: 10, int日: 18 }, ['有效資料']) === '名冊_10月18日');
  t.記錄('分頁名稱：同一天第二場加「_2」', 產生名冊分頁名稱_({ int月: 10, int日: 18 }, ['名冊_10月18日']) === '名冊_10月18日_2');
  t.記錄('分頁名稱：一支香欄名有 [ ] / 也不影響', 產生名冊分頁名稱_(obj一支香.arr場次[0], []) === '名冊_7月5日');

  // 自加欄位的值依姓名帶回（v1.1.0）
  const arr新名冊 = [{ '姓名': '王小明' }, { '姓名': '李大華' }, { '姓名': '新報名' }];
  const arr舊名冊 = [{ '姓名': '王 小明', '座位': 'A1', '分組': '一' }, { '姓名': '李大華', '座位': '', '分組': '' }, { '姓名': '已取消', '座位': 'C3' }];
  const int帶回 = 帶回自加欄位值_(arr新名冊, arr舊名冊, ['座位', '分組']);
  t.記錄('帶回：姓名去空白後比對，帶回座位與分組', arr新名冊[0]['座位'] === 'A1' && arr新名冊[0]['分組'] === '一');
  t.記錄('帶回：新報名的人沒有值', arr新名冊[2]['座位'] === undefined);
  t.記錄('帶回：只計算有值的人數（1 人）', int帶回 === 1, String(int帶回));
  t.記錄('帶回：沒有自加欄位時不動', 帶回自加欄位值_([{ '姓名': '甲' }], arr舊名冊, []) === 0);

  // 一次一個場次（v1.1.0）
  t.記錄('單一場次：str場次', 取得單一場次參數_({ str場次: ' 7/5 ' }) === '7/5');
  t.記錄('單一場次：舊寫法 arr場次 只有一個也可以', 取得單一場次參數_({ arr場次: ['10/10'] }) === '10/10');
  t.預期錯誤('單一場次：選兩個停止', obj錯誤代碼.參數錯誤, function () { 取得單一場次參數_({ arr場次: ['10/10', '10/24'] }); });
  t.預期錯誤('單一場次：沒有選停止', obj錯誤代碼.參數錯誤, function () { 取得單一場次參數_({}); });
  const obj物件 = 轉為名冊物件_(Object.assign({}, fn找(obj1010, '彭水珠')[0], { str學員編號: 'T-PUCHUAN-0001' }));
  t.記錄('名冊物件：固定欄位齊全、提醒合成一格', obj物件['學員編號'] === 'T-PUCHUAN-0001' && obj物件['來源列'] === 9
    && obj物件['提醒'].indexOf('取消') !== -1 && obj物件['性別'] === '女');

  // ── 八、動作前置 ──
  t.預期錯誤('對外活動不能下載場次名冊', obj錯誤代碼.參數錯誤, function () { 檢查是對內活動_({ '活動類型': '對外', '活動名稱': '測試' }); });
  t.記錄('對內活動可以', (function () { try { 檢查是對內活動_({ '活動類型': '對內', '活動名稱': '測試' }); return true; } catch (e) { return false; } })());
  t.預期錯誤('沒有選擇場次時停止（不讀副本）', obj錯誤代碼.參數錯誤, function () { 產生場次名冊_(null, 'TEST', '', dat十月); });
  t.記錄('場次基準日：活動日期', 取得場次基準日_({ '活動日期': dat十月 }) === dat十月);
  t.記錄('場次基準日：沒有活動日期用今天', 是日期值_(取得場次基準日_({ '活動日期': '' })));

  // ── 九、副本活動類型標記（以模擬的試算表測試，不碰檔案） ──
  const fn模擬副本 = function (arr初始) {
    const arr標記 = (arr初始 || []).map(function (v) { return { 鍵: obj法會設定.str副本類型鍵, 值: v }; });
    return {
      arr標記: arr標記,
      createDeveloperMetadataFinder: function () {
        return { withKey: function (k) { return { find: function () {
          return arr標記.filter(function (o) { return o.鍵 === k; }).map(function (o) {
            return { getValue: function () { return o.值; }, remove: function () { arr標記.splice(arr標記.indexOf(o), 1); } };
          });
        } }; } };
      },
      addDeveloperMetadata: function (k, v) { arr標記.push({ 鍵: k, 值: v }); }
    };
  };
  t.記錄('類型標記：鍵名與副本工具相同（法會活動類型）', obj法會設定.str副本類型鍵 === '法會活動類型');
  const obj副本甲 = fn模擬副本([]);
  t.記錄('類型標記：沒有標記 → 已補上', 標記副本活動類型_(obj副本甲, '對內') === '已補上' && obj副本甲.arr標記.length === 1 && obj副本甲.arr標記[0].值 === '對內');
  t.記錄('類型標記：再執行一次 → 已正確、不重複', 標記副本活動類型_(obj副本甲, '對內') === '已正確' && obj副本甲.arr標記.length === 1);
  const obj副本乙 = fn模擬副本(['對外', '對內']);
  t.記錄('類型標記：值不同或重複 → 已更正、只留一筆', 標記副本活動類型_(obj副本乙, '對內') === '已更正' && obj副本乙.arr標記.length === 1 && obj副本乙.arr標記[0].值 === '對內');
  t.預期錯誤('類型標記：不是對內／對外時停止', obj錯誤代碼.參數錯誤, function () { 標記副本活動類型_(fn模擬副本([]), '其他'); });

  return t.結算();
}
