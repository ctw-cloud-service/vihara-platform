// ============================================================================
// 檔案名稱：法會_表單與副本.gs
// 所屬模組：法會活動（event）
// 所屬層級：模組／服務層
// 檔案版本：v2.0.1（2026-10-28）
//   v2.0.1：回覆分頁的「時間戳記」不一定在 A 欄（精舍可能在前面插入「NO」等欄），改為第 1 列任一欄
//   v2.0.0（2026-10-27）：改為只讀「回覆試算表」（系統帳號只需「檢視者」），不再開啟 Google 表單：
//           表單不必共用給精舍以外的帳號。以「回覆試算表的列號＋時間戳記」辨認每筆報名
//   v1.1.0：表單權限不足時白話說明
//   v1.0.0：初版（讀 Google 表單回應）
// 用途說明：
//   報名回覆試算表與整理副本之間的資料搬運：
//     · 找出回覆試算表中接收表單回應的分頁（第 1 列有「時間戳記」）
//     · 讀出每一列報名：列號、時間戳記、{ 欄名: 值 }（補回手機開頭的 0）
//     · 判斷哪些列是新報名、哪些被填寫人修改過（2026-10-27 定案的規則，見 分類來源資料列_）
//     · 建立副本時，把原始回覆整份貼進副本「有效資料」
//     · 同步時，依欄名把新報名追加到「有效資料」最後（不碰承辦人自己加的欄位）
//
//   為什麼用「列號＋時間戳記」：
//     Google 表單把每筆回應寫在回覆試算表的一列，之後只往下新增；
//     填寫人修改報名時，同一列的內容與「時間戳記」會更新成修改時間。
//     所以：列號相同、時間相同＝已下載；列號相同、時間變新＝已修改；記錄以外的新列號＝新報名。
//     精舍若在回覆試算表刪列或排序，列號會錯開——系統偵測到就停止同步並說明，不會亂加資料。
//
//   副本是承辦人可以直接整理的試算表（可插欄、排序、刪列），
//   因此一律「依第 1 列標題文字」找欄位，不依欄位位置。
//   原始回覆試算表由精舍自有，系統只讀不寫。
//
// 相依檔案：平台核心（核心_錯誤、核心_試算表存取、核心_外部檔案）、法會_模組定義
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：取得系統帳號文字_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：錯誤訊息中要提示「共用給哪個帳號」時使用（即系統管理員帳號＝系統帳號）。
 *       讀不到設定時改用固定說法，不讓錯誤訊息本身再出錯。
 * 參數：無
 * 傳回：{string}
 * ============================================================================
 */
function 取得系統帳號文字_() {
  try {
    return 取得系統設定值(obj設定名稱.系統管理員帳號, false) || '系統帳號';
  } catch (err) {
    return '系統帳號';
  }
}


/**
 * ============================================================================
 * 函式名稱：開啟回覆試算表_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：以系統帳號開啟回覆試算表；打不開時說明「用『選擇回覆試算表』自動共用，
 *       或手動把系統帳號加為『檢視者』」。
 * 參數：
 *   str試算表ID   {string} 回覆試算表的檔案代號
 *   str活動名稱   {string} 選填，同步時放進訊息
 * 傳回：{Spreadsheet}
 * ============================================================================
 */
function 開啟回覆試算表_(str試算表ID, str活動名稱) {
  try {
    return SpreadsheetApp.openById(str試算表ID);
  } catch (err) {
    throw new 平台錯誤(
      obj錯誤代碼.檔案無法開啟,
      `系統打不開${str活動名稱 ? `「${str活動名稱}」的` : '這份'}報名回覆試算表。` +
      `請在新增活動時按「選擇回覆試算表」由系統自動共用；或開啟回覆試算表，右上角「共用」，把 ${取得系統帳號文字_()} 加為「檢視者」後再試。`,
      { str原始訊息: err && err.message ? err.message : String(err), str試算表ID: str試算表ID }
    );
  }
}


/**
 * ============================================================================
 * 函式名稱：找出回覆分頁_（內部使用）
 * 版本：v2.0.1（2026-10-28）　v2.0.1：時間戳記可以在第 1 列任一欄
 * ----------------------------------------------------------------------------
 * 用途：
 *   在回覆試算表中找出接收表單回應的分頁：第 1 列有「時間戳記」欄的分頁
 *   （通常在 A 欄；精舍若在前面插入「NO」等欄也可以）。有多個時用第一個。
 *   有指定分頁名稱（同步時用活動清單記下的名稱）就直接用那一個。
 * 參數：
 *   obj試算表     {Spreadsheet} 回覆試算表
 *   str指定分頁   {string}      選填
 * 傳回：{Sheet}
 * ============================================================================
 */
function 找出回覆分頁_(obj試算表, str指定分頁) {
  const str時間欄 = obj法會設定.str時間戳記欄名;
  if (str指定分頁) {
    const obj指定 = obj試算表.getSheetByName(str指定分頁);
    if (!obj指定) {
      throw new 平台錯誤(obj錯誤代碼.工作表不存在,
        `報名回覆試算表「${obj試算表.getName()}」找不到「${str指定分頁}」分頁（可能被改名）。請把分頁名稱改回「${str指定分頁}」。`);
    }
    return obj指定;
  }
  const obj分頁 = obj試算表.getSheets().filter(function (o) {
    if (o.getLastRow() < 1 || o.getLastColumn() < 1) return false;
    return o.getRange(1, 1, 1, o.getLastColumn()).getValues()[0].some(function (v) { return String(v).trim() === str時間欄; });
  })[0];
  if (!obj分頁) {
    throw new 平台錯誤(obj錯誤代碼.工作表不存在,
      `「${obj試算表.getName()}」中找不到表單回應的分頁（第 1 列應有「${str時間欄}」欄）。` +
      '請到 Google 表單的「回覆」頁籤，按「在試算表中查看」開啟正確的回覆試算表，再選擇或複製它的網址。');
  }
  return obj分頁;
}


/**
 * ============================================================================
 * 函式名稱：開啟報名來源_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：新增活動時檢查貼上（或選擇）的回覆試算表：網址看得懂、打得開、找得到回覆分頁。
 *       全部通過才傳回，之後才建立副本、用掉活動編號。
 * 參數：
 *   str網址   {string} 回覆試算表的網址或檔案代號
 * 傳回：{Object} { str來源ID, obj來源, obj來源分頁 }
 * ============================================================================
 */
function 開啟報名來源_(str網址) {
  const str來源ID = 解析檔案代號(str網址);
  const obj來源 = 開啟回覆試算表_(str來源ID);
  const obj來源分頁 = 找出回覆分頁_(obj來源, '');
  return { str來源ID: str來源ID, obj來源: obj來源, obj來源分頁: obj來源分頁 };
}


/**
 * ============================================================================
 * 函式名稱：開啟活動來源分頁_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：同步時開啟活動的回覆試算表與分頁（依活動清單記下的「來源試算表ID」「來源分頁」）。
 * 參數：
 *   obj活動值   {Object} 活動清單一列的 obj值
 * 傳回：{Sheet}
 * ============================================================================
 */
function 開啟活動來源分頁_(obj活動值) {
  const str來源ID = String(obj活動值['來源試算表ID'] || '').trim();
  if (str來源ID === '') {
    throw new 平台錯誤(obj錯誤代碼.設定缺漏, `「${obj活動值['活動名稱']}」沒有記錄報名回覆試算表，請通知系統管理員。`);
  }
  return 找出回覆分頁_(開啟回覆試算表_(str來源ID, String(obj活動值['活動名稱'])), String(obj活動值['來源分頁'] || '').trim());
}


/**
 * ============================================================================
 * 函式名稱：是日期_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：判斷是否為有效日期（Object.prototype.toString 比 instanceof 穩定）。
 * 參數：any值 {*}
 * 傳回：{boolean}
 * ============================================================================
 */
function 是日期_(any值) {
  return Object.prototype.toString.call(any值) === '[object Date]' && !isNaN(any值.getTime());
}


/**
 * ============================================================================
 * 函式名稱：整理來源值_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：
 *   回覆試算表一格的值轉成寫進副本的值：
 *     · 標題含「電話、手機」：轉文字；9 碼且 9 開頭的數字是被吃掉 0 的手機，補回 0
 *     · 其他：原樣（日期維持日期、數字維持數字）
 * 參數：
 *   str標題   {string}
 *   any值     {*}
 * 傳回：{*}
 * ============================================================================
 */
function 整理來源值_(str標題, any值) {
  if (!是否為文字格式欄_(str標題)) return any值;
  let str值 = (any值 === null || any值 === undefined) ? '' : String(any值);
  if (typeof any值 === 'number' && /^9\d{8}$/.test(str值)) str值 = '0' + str值;
  return str值;
}


/**
 * ============================================================================
 * 函式名稱：讀取來源資料_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：
 *   一次讀出回覆分頁全部內容，整理成：
 *     arr標題：第 1 列
 *     arr列：每一筆報名 { int列號, dat時間, obj欄值 }（時間戳記空白的列略過）
 * 參數：
 *   obj來源分頁   {Sheet}
 * 傳回：{Object} { arr標題, arr列, int最後列 }
 * ============================================================================
 */
function 讀取來源資料_(obj來源分頁) {
  const int最後列 = obj來源分頁.getLastRow();
  const int最後欄 = obj來源分頁.getLastColumn();
  if (int最後列 < 1 || int最後欄 < 1) return { arr標題: [], arr列: [], int最後列: 0 };
  const arr值 = obj來源分頁.getRange(1, 1, int最後列, int最後欄).getValues();
  const arr標題 = arr值[0].map(function (v) { return String(v).trim(); });
  const int時間欄 = arr標題.indexOf(obj法會設定.str時間戳記欄名);
  const arr列 = [];
  for (let i = 1; i < arr值.length; i++) {
    const any時間 = int時間欄 >= 0 ? arr值[i][int時間欄] : '';
    if (!是日期_(any時間)) continue;   // 空白列、或不是表單寫入的列
    const obj欄值 = {};
    arr標題.forEach(function (str標題, j) {
      if (str標題 !== '') obj欄值[str標題] = 整理來源值_(str標題, arr值[i][j]);
    });
    arr列.push({ int列號: i + 1, dat時間: any時間, obj欄值: obj欄值 });
  }
  return { arr標題: arr標題, arr列: arr列, int最後列: int最後列 };
}


/**
 * ============================================================================
 * 函式名稱：來源列鍵_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：已同步紀錄「回應ID」欄的寫法：回覆試算表第 5 列 →「列5」。
 * 參數：int列號 {number}
 * 傳回：{string}
 * ============================================================================
 */
function 來源列鍵_(int列號) {
  return '列' + int列號;
}


/**
 * ============================================================================
 * 函式名稱：分類來源資料列_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：
 *   比對回覆試算表與「已同步紀錄」，把每一列分成：
 *     · 已下載：這個列號有紀錄，時間相同（回覆試算表的時間只到秒，比對到秒）
 *     · 已修改：這個列號有紀錄，時間變新，且這個新時間不是其他列的紀錄時間
 *     · 新報名：這個列號沒有紀錄
 *   以下情況表示回覆試算表被刪列或排序過，列號已錯開，判斷不可靠 → 傳回異常說明，不同步：
 *     · 有紀錄的列號，時間卻變舊、或變成另一筆已下載報名的時間
 *       （刪掉中間一列時，下面各列往上移，第一個被移動的列就會符合這個條件）
 *     · 有紀錄的列號已經不存在或時間戳記變空白（刪掉最後幾列）
 *   不同人在同一秒送出是可能的，所以「新列號的時間與舊報名相同」不視為異常。
 * 參數：
 *   obj來源資料     {Object} 讀取來源資料_ 的結果
 *   obj本活動紀錄   {Object} { '列5': { int列號（紀錄所在列）, int最後修改毫秒 } }
 * 傳回：{Object} { arr新列, arr已修改: [ { obj列, obj紀錄, str鍵 } ], str異常說明 }
 * ============================================================================
 */
function 分類來源資料列_(obj來源資料, obj本活動紀錄) {
  const arr新列 = [];
  const arr已修改 = [];
  const arr異常 = [];

  // 所有已下載報名的時間（秒）→ 列鍵清單：用來辨認「別列的報名被搬到這一列」
  const obj已知秒 = {};
  Object.keys(obj本活動紀錄).forEach(function (str鍵) {
    const int秒 = Math.floor(obj本活動紀錄[str鍵].int最後修改毫秒 / 1000);
    (obj已知秒[int秒] = obj已知秒[int秒] || []).push(str鍵);
  });
  const fn是別列的時間 = function (dat, str本列鍵) {
    const arr = obj已知秒[Math.floor(dat.getTime() / 1000)] || [];
    return arr.some(function (k) { return k !== str本列鍵; });
  };

  const obj出現 = {};
  obj來源資料.arr列.forEach(function (obj列) {
    const str鍵 = 來源列鍵_(obj列.int列號);
    obj出現[str鍵] = true;
    const obj紀錄 = obj本活動紀錄[str鍵];
    const int秒 = Math.floor(obj列.dat時間.getTime() / 1000);
    if (obj紀錄) {
      const int差 = int秒 - Math.floor(obj紀錄.int最後修改毫秒 / 1000);
      if (int差 === 0) return;                                                       // 已下載、沒變
      if (int差 > 0 && !fn是別列的時間(obj列.dat時間, str鍵)) {
        arr已修改.push({ obj列: obj列, obj紀錄: obj紀錄, str鍵: str鍵 });            // 填寫人修改
      } else {
        arr異常.push(obj列.int列號);                                                 // 列號錯開
      }
    } else {
      arr新列.push(obj列);                                                           // 新報名
    }
  });

  // 有紀錄的列號消失（只算時間戳記空白或列數變少的情況）
  const arr消失 = Object.keys(obj本活動紀錄).filter(function (str鍵) { return !obj出現[str鍵]; });

  let str異常說明 = '';
  if (arr異常.length > 0 || arr消失.length > 0) {
    str異常說明 = '報名回覆試算表的資料列被刪除或重新排序過，系統無法確定哪些是新報名，這次沒有下載任何資料'
      + `（${arr異常.length > 0 ? `第 ${arr異常.slice(0, 5).join('、')}${arr異常.length > 5 ? '…' : ''} 列與先前不同` : ''}`
      + `${arr異常.length > 0 && arr消失.length > 0 ? '；' : ''}${arr消失.length > 0 ? `${arr消失.length} 筆已下載的列不見了` : ''}）。`
      + '請開啟回覆試算表「檔案 → 版本記錄」還原到刪除或排序之前；回覆試算表請不要刪列或排序，整理一律在整理副本中進行。';
  }
  arr新列.sort(function (a, b) { return a.int列號 - b.int列號; });
  return { arr新列: arr新列, arr已修改: arr已修改, str異常說明: str異常說明 };
}


/**
 * ============================================================================
 * 函式名稱：取得列摘要名稱_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：提醒訊息用的簡短識別，例如「王小明（傳慈）」。
 *       找標題含「姓名」「法名」的欄（排除緊急聯絡人、填寫人）；都沒有時用送出時間。
 * 參數：
 *   obj列   {Object} 讀取來源資料_ 的一列 { int列號, dat時間, obj欄值 }
 * 傳回：{string}
 * ============================================================================
 */
function 取得列摘要名稱_(obj列) {
  let str姓名 = '';
  let str法名 = '';
  Object.keys(obj列.obj欄值).forEach(function (str標題) {
    const str值 = String(obj列.obj欄值[str標題] == null ? '' : obj列.obj欄值[str標題]).trim();
    if (str姓名 === '' && str標題.indexOf('姓名') !== -1 && str標題.indexOf('緊急') === -1 && str標題.indexOf('填寫') === -1) str姓名 = str值;
    if (str法名 === '' && str標題.indexOf('法名') !== -1) str法名 = str值;
  });
  if (str姓名 === '') return `回覆試算表第 ${obj列.int列號} 列（${格式化日期(obj列.dat時間, 'yyyy/MM/dd HH:mm:ss')} 送出）`;
  return str法名 ? `${str姓名}（${str法名}）` : str姓名;
}


/**
 * ============================================================================
 * 函式名稱：取得副本標題索引_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：讀副本分頁第 1 列，建立「標題文字 → 欄號（1 起算）」對照。
 *       同名標題只記第一次出現的位置。
 * 參數：
 *   obj分頁   {Sheet} 副本分頁
 * 傳回：{Object} { 標題: 欄號 }
 * ============================================================================
 */
function 取得副本標題索引_(obj分頁) {
  const obj索引 = {};
  const int最後欄 = obj分頁.getLastColumn();
  if (int最後欄 < 1) return obj索引;
  obj分頁.getRange(1, 1, 1, int最後欄).getValues()[0].forEach(function (any標題, i) {
    const str標題 = String(any標題).trim();
    if (str標題 !== '' && !(str標題 in obj索引)) obj索引[str標題] = i + 1;
  });
  return obj索引;
}


/**
 * ============================================================================
 * 函式名稱：是否為文字格式欄_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：標題含「電話、手機」的欄位要設為純文字，避免開頭的 0 被試算表吃掉。
 * 參數：
 *   str標題   {string} 欄位標題
 * 傳回：{boolean}
 * ============================================================================
 */
function 是否為文字格式欄_(str標題) {
  return obj法會設定.arr文字格式欄關鍵字.some(function (str關鍵字) {
    return String(str標題).indexOf(str關鍵字) !== -1;
  });
}


/**
 * ============================================================================
 * 函式名稱：確保副本欄位存在_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：副本第 1 列缺少某些欄名時，依序補在最右側（通常是表單後來新增題目）。
 * 參數：
 *   obj分頁   {Sheet}    副本「有效資料」分頁
 *   arr欄名   {string[]} 需要存在的欄名
 * 傳回：{string[]} 這次新增的欄名
 * ============================================================================
 */
function 確保副本欄位存在_(obj分頁, arr欄名) {
  const obj索引 = 取得副本標題索引_(obj分頁);
  const arr缺少 = [];
  arr欄名.forEach(function (str欄名) {
    const str標題 = String(str欄名).trim();
    if (str標題 !== '' && !(str標題 in obj索引) && arr缺少.indexOf(str標題) === -1) arr缺少.push(str標題);
  });

  if (arr缺少.length > 0) {
    const int起始欄 = obj分頁.getLastColumn() + 1;
    // 欄數不夠時先加欄，避免寫入超出範圍
    const int需要欄數 = int起始欄 + arr缺少.length - 1;
    if (int需要欄數 > obj分頁.getMaxColumns()) {
      obj分頁.insertColumnsAfter(obj分頁.getMaxColumns(), int需要欄數 - obj分頁.getMaxColumns());
    }
    obj分頁.getRange(1, int起始欄, 1, arr缺少.length).setValues([arr缺少]).setFontWeight('bold');
  }
  return arr缺少;
}


/**
 * ============================================================================
 * 函式名稱：取得副本最後資料列_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   以指定欄（通常是時間戳記）由下往上找第一個有值的列。
 *   不直接用 getLastRow()，因為承辦人可能在其他欄放了公式或註記。
 * 參數：
 *   obj分頁   {Sheet}  副本分頁
 *   int欄號   {number} 1 起算
 * 傳回：{number} 列號；只有標題列時為 1
 * ============================================================================
 */
function 取得副本最後資料列_(obj分頁, int欄號) {
  const int最後列 = obj分頁.getLastRow();
  if (int最後列 < 2) return 1;
  const arr值 = obj分頁.getRange(1, int欄號, int最後列, 1).getValues();
  for (let i = arr值.length - 1; i >= 1; i--) {
    if (arr值[i][0] !== '' && arr值[i][0] !== null) return i + 1;
  }
  return 1;
}


/**
 * ============================================================================
 * 函式名稱：追加回應到副本_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把多筆回應（已轉成 { 欄名: 值 }）追加到副本「有效資料」最後：
 *     ① 補齊缺少的欄位（含「系統_追加時間」）
 *     ② 以時間戳記欄找出最後一筆資料的位置
 *     ③ 逐「欄」寫入：只寫有對應的欄，承辦人自己加的欄位（含公式）完全不碰
 *     ④ 電話、手機類欄位先設為純文字
 *     ⑤ 新列加上淺黃底色，方便辨認尚未整理的資料
 *
 * 參數：
 *   obj分頁   {Sheet}    副本「有效資料」分頁
 *   arr欄值   {Object[]} 每筆報名的 { 欄名: 值 }（讀取來源資料_ 的 obj欄值）
 * 傳回：
 *   {Object} { int新增筆數, arr新增欄位, int起始列 }
 * ============================================================================
 */
function 追加回應到副本_(obj分頁, arr欄值) {
  if (!arr欄值 || arr欄值.length === 0) return { int新增筆數: 0, arr新增欄位: [], int起始列: 0 };

  const str追加欄 = obj法會設定.str系統追加時間欄名;

  // ① 這批回應用到的所有欄名，補齊副本缺少的欄位
  const arr需要欄 = [];
  arr欄值.forEach(function (obj) {
    Object.keys(obj).forEach(function (str) { if (arr需要欄.indexOf(str) === -1) arr需要欄.push(str); });
  });
  const arr全部欄 = arr需要欄.concat([str追加欄]);
  const arr新增欄位 = 確保副本欄位存在_(obj分頁, arr全部欄);
  const obj索引 = 取得副本標題索引_(obj分頁);

  // ② 寫入起始列：以時間戳記欄為準；找不到時間戳記欄才用 getLastRow()
  const int時間欄 = obj索引[obj法會設定.str時間戳記欄名];
  const int最後列 = int時間欄 ? 取得副本最後資料列_(obj分頁, int時間欄) : Math.max(obj分頁.getLastRow(), 1);
  const int起始列 = int最後列 + 1;
  const int筆數 = arr欄值.length;
  const int需要列數 = int起始列 + int筆數 - 1;
  if (int需要列數 > obj分頁.getMaxRows()) {
    obj分頁.insertRowsAfter(obj分頁.getMaxRows(), int需要列數 - obj分頁.getMaxRows());
  }

  // ③ 逐欄寫入
  const dat現在 = new Date();
  arr全部欄.forEach(function (str欄名) {
    const int欄號 = obj索引[String(str欄名).trim()];
    if (!int欄號) return;   // 理論上不會發生（上面已補欄），保險起見略過
    const arr欄資料 = arr欄值.map(function (obj) {
      if (str欄名 === str追加欄) return [dat現在];
      const any值 = obj[str欄名];
      return [(any值 === undefined || any值 === null) ? '' : any值];
    });
    const obj範圍 = obj分頁.getRange(int起始列, int欄號, int筆數, 1);
    // ④ 電話、手機類欄位：先設純文字，避免 0912… 變成 912…
    if (是否為文字格式欄_(str欄名)) {
      obj範圍.setNumberFormat('@');
      arr欄資料.forEach(function (arr) { arr[0] = String(arr[0]); });
    }
    obj範圍.setValues(arr欄資料);
  });

  // ⑤ 新列上底色
  obj分頁.getRange(int起始列, 1, int筆數, obj分頁.getLastColumn()).setBackground(obj法會設定.str新列底色);

  return { int新增筆數: int筆數, arr新增欄位: arr新增欄位, int起始列: int起始列 };
}


/**
 * ============================================================================
 * 函式名稱：貼入原始資料_（內部使用）
 * 版本：v2.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：
 *   建立副本時，把原始回覆分頁的全部內容（標題列＋資料列）貼到副本「有效資料」A1 起。
 *     ① 一次讀取值與數值格式；標題含「電話、手機」的欄位設為純文字並補回開頭的 0
 *     ② 清除「有效資料」原有內容（只清內容，保留範本設定的格式）
 *     ③ 列數、欄數不足時自動補足；先套數值格式再寫值
 *     ④ 標題列粗體並凍結
 *   同時傳回這次貼入的每一列「列號＋時間戳記」，供登記已同步紀錄：
 *   用的是同一次讀到的內容，貼入與登記一定一致（不會漏記或多記）。
 *   v2.0.0：改為傳回登記資料（原本只傳回筆數）。
 *
 * 參數：
 *   obj來源分頁   {Sheet} 原始回覆分頁
 *   obj有效分頁   {Sheet} 副本「有效資料」分頁
 * 傳回：{Object} { int貼入筆數, arr登記: [ { str鍵, dat時間 } ] }
 * ============================================================================
 */
function 貼入原始資料_(obj來源分頁, obj有效分頁) {
  const int列數 = obj來源分頁.getLastRow();
  const int欄數 = obj來源分頁.getLastColumn();

  // ① 一次讀取值與數值格式（大量資料也只呼叫兩次）
  const obj來源範圍 = obj來源分頁.getRange(1, 1, int列數, int欄數);
  const arr值 = obj來源範圍.getValues();
  const arr格式 = obj來源範圍.getNumberFormats();
  const arr標題 = arr值[0].map(function (v) { return String(v).trim(); });
  arr標題.forEach(function (str標題, int欄) {
    if (!是否為文字格式欄_(str標題)) return;
    for (let int列 = 1; int列 < int列數; int列++) {
      arr格式[int列][int欄] = '@';
      arr值[int列][int欄] = 整理來源值_(str標題, arr值[int列][int欄]);
    }
  });

  // 登記資料：時間戳記有值的列
  const int時間欄 = arr標題.indexOf(obj法會設定.str時間戳記欄名);
  const arr登記 = [];
  for (let int列 = 1; int列 < int列數; int列++) {
    const any時間 = int時間欄 >= 0 ? arr值[int列][int時間欄] : '';
    if (是日期_(any時間)) arr登記.push({ str鍵: 來源列鍵_(int列 + 1), dat時間: any時間 });
  }

  // ② 清除既有內容
  obj有效分頁.clearContents();

  // ③ 列數、欄數不足時補足；先套格式、再寫值
  if (int列數 > obj有效分頁.getMaxRows()) {
    obj有效分頁.insertRowsAfter(obj有效分頁.getMaxRows(), int列數 - obj有效分頁.getMaxRows());
  }
  if (int欄數 > obj有效分頁.getMaxColumns()) {
    obj有效分頁.insertColumnsAfter(obj有效分頁.getMaxColumns(), int欄數 - obj有效分頁.getMaxColumns());
  }
  const obj目的範圍 = obj有效分頁.getRange(1, 1, int列數, int欄數);
  obj目的範圍.setNumberFormats(arr格式);
  obj目的範圍.setValues(arr值);

  // ④ 標題列粗體並凍結
  obj有效分頁.getRange(1, 1, 1, int欄數).setFontWeight('bold');
  obj有效分頁.setFrozenRows(1);
  SpreadsheetApp.flush();

  return { int貼入筆數: int列數 - 1, arr登記: arr登記 };
}
