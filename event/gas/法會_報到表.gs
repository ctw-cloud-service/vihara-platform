 * 參數：obj工作階段 {null}；obj參數 {Object} { str存取權杖, str副本ID, str報到時段 }
 * 傳回：{Object} { str訊息, str報到時段, obj時段 }
 * ============================================================================
 */
function 副本選單_儲存時段(obj工作階段, obj參數) {
  const obj = 開啟副本情境_(obj參數, obj法會權限.整理資料, '設定報到時段', obj報到表格式.arr可列印狀態);
  檢查是對內活動_(obj.obj活動值);
  const obj結果 = 儲存活動報到時段_(obj.obj身分, obj.obj主控台, obj.obj活動值, obj參數.str報到時段);
  const bool有名冊 = 列出名冊分頁_(obj.obj副本).length > 0;
