 */
function 寫入名冊時段標記_(obj分頁, arr時段欄名) {
  const str鍵 = obj報到表格式.str時段標記鍵;
  obj分頁.createDeveloperMetadataFinder().withKey(str鍵).find().forEach(function (o) { o.remove(); });
