 * 參數：str副本ID {string}；int分頁ID {number}
 * 傳回：{string}
 * ============================================================================
 */
function 產生報到表列印網址_(str副本ID, int分頁ID) {
  return `https://docs.google.com/spreadsheets/d/${encodeURIComponent(str副本ID)}/export?${obj報到表格式.str列印參數}&gid=${Number(int分頁ID)}`;
}


/**
 * ============================================================================
 * 函式名稱：產生報到表_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   只處理副本本身（不碰主控台，方便測試）：
 *     找到場次名冊 → 讀人員與報名時段 → 排序、補空白列 → 寫入（或重建）「報到表_月日日」→ 列印網址。
 * 參數：
 *   obj副本     {Spreadsheet}
 *   str場次     {string}   場次名稱（欄名原文）
 *   obj設定     {Object}   { str標題, arr時段, dat基準 }
 * 傳回：{Object} { str訊息, arr明細, str分頁名, str列印網址, int人數, int頁數, int空白列 }
 * ============================================================================
 */
function 產生報到表_(obj副本, str場次, obj設定) {
  const cfg = obj報到表格式;
  const str選擇 = 取得單一場次參數_({ str場次: str場次 });

  // ① 名冊與人員
  const obj名冊分頁 = 找出場次名冊分頁_(obj副本, str選擇);
  const arr時段 = obj設定.arr時段 || [];
  const obj人員 = 取得名冊報到人員_(obj名冊分頁, arr時段);

  // ② 日期：場次欄名中的第一個日期
  const arr月日 = 擷取月日_(str選擇);
  const dat場次 = arr月日.length > 0 ? 推算月日日期_(arr月日[0], obj設定.dat基準 || new Date()) : null;

  // ③ 組合與寫入
  const obj內容 = 組合報到表內容_({ str標題: obj設定.str標題, str日期: 報到表日期文字_(dat場次), arr時段: arr時段, arr人員: obj人員.arr人員 });
  const obj既有 = 找出報到表分頁_(obj副本, str選擇);
  const str新名稱 = (function () {
    if (obj既有) return obj既有.getName();
    const str基底 = arr月日.length > 0 ? `${cfg.str報到表前綴}${arr月日[0].int月}月${arr月日[0].int日}日` : `${cfg.str報到表前綴}場次`;
    const arr現有 = obj副本.getSheets().map(function (o) { return o.getName(); });
    let str = str基底;
    let int序 = 2;
    while (arr現有.indexOf(str) !== -1) { str = `${str基底}_${int序}`; int序 += 1; }
    return str;
  })();
  const obj分頁 = 寫入報到表分頁_(obj副本, obj既有, str新名稱, str選擇, obj內容);

  // ④ 結果說明
  const arr明細 = [];
  arr明細.push(`報名 ${obj內容.int人數} 人，共 ${obj內容.int頁數} 頁，最後一頁留 ${obj內容.int空白列} 列空白供手寫未報名的人`);
  if (arr時段.length >= 2) arr明細.push(`時段：${格式化時段設定_(arr時段)}（灰底＝沒有報名這個時段）`);
  if (obj人員.bool重新判斷) arr明細.push('名冊的時段欄和目前的報到時段設定不同（名冊可能是設定時段前下載的），已依「報名內容」重新判斷；建議重新下載這個場次的名冊');
  const int提醒 = obj人員.arr人員.filter(function (o) { return 提醒簡稱_(o.str提醒) !== ''; }).length;
  if (int提醒 > 0) arr明細.push(`${int提醒} 人有提醒，已印在備註欄（取消？、同名、編號待填、時段？），詳細請看名冊的「提醒」欄`);
  if (!obj內容.bool筆畫) arr明細.push('這台主機不支援中文筆畫排序，同組內改依電腦內碼排序');
  arr明細.push('列印：按視窗中的「開啟 PDF 列印」，印表機設定選「實際大小（100%）」；也可以用「檔案 → 列印」');

  return {
    str訊息: `已產生「${obj分頁.getName()}」：${obj內容.int人數} 人、${obj內容.int頁數} 頁。`,
    arr明細: arr明細,
    str分頁名: obj分頁.getName(),
    str列印網址: 產生報到表列印網址_(obj副本.getId(), obj分頁.getSheetId()),
    int人數: obj內容.int人數, int頁數: obj內容.int頁數, int空白列: obj內容.int空白列
  };
}


