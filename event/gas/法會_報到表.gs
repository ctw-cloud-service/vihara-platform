/**
 * ============================================================================
 * 函式名稱：取得活動時段_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：讀出活動的報到時段（主控台「活動清單」的「報到時段」欄）。
 *       設定有誤時（例如有人直接改了主控台）提醒到網頁或副本重新設定。
 * 參數：obj活動值 {Object}
 * 傳回：{Object[]} 解析時段設定_ 的結果
 * ============================================================================
 */
function 取得活動時段_(obj活動值) {
  try {
    return 解析時段設定_(obj活動值 ? obj活動值[obj報到表格式.str時段欄位] : '');
  } catch (err) {
    throw new 平台錯誤(obj錯誤代碼.設定缺漏,
      `「${obj活動值['活動名稱']}」的報到時段設定有問題，請用「法會報到 → 設定報到時段」重新設定。\n\n${err.message}`);
  }
}


/**
 * ============================================================================
 * 函式名稱：儲存活動報到時段_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：檢查並儲存報到時段（存標準寫法），寫日誌；也更新記憶體中的 obj活動值，
 *       讓同一次作業（例如接著下載名冊）直接用新設定。內容相同時不寫入。
 * 參數：
 *   obj身分     {Object}      工作階段或副本身分
 *   obj主控台   {Spreadsheet}
 *   obj活動值   {Object}
 *   any設定     {*}           設定文字（空白＝不分時段）
 * 傳回：{Object} { str報到時段（標準寫法）, arr時段, bool有變更 }
 * ============================================================================
 */
function 儲存活動報到時段_(obj身分, obj主控台, obj活動值, any設定) {
  const str欄位 = obj報到表格式.str時段欄位;
  const arr時段 = 解析時段設定_(any設定);
  const str標準 = 格式化時段設定_(arr時段);
  const str原 = String(obj活動值[str欄位] === undefined || obj活動值[str欄位] === null ? '' : obj活動值[str欄位]).trim();
  if (str標準 === str原) return { str報到時段: str標準, arr時段: arr時段, bool有變更: false };

  const str活動ID = String(obj活動值['活動ID']).trim();
  const obj欄位值 = {};
  obj欄位值[str欄位] = str標準;
  更新法會活動_(obj主控台, str活動ID, obj欄位值);
  obj活動值[str欄位] = str標準;
  寫入操作日誌(obj身分, '設定報到時段', `${str活動ID}：${str標準 || '不分時段'}`);
  return { str報到時段: str標準, arr時段: arr時段, bool有變更: true };
}


/**
 * ============================================================================
 * 函式名稱：整理時段資訊_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：給選單視窗看的時段資訊：目前設定、是否已設定、系統建議（尚未設定時才有）。
 * 參數：obj活動值 {Object}；arr建議 {Object[]} 建議報到時段_ 的結果
 * 傳回：{Object} { str報到時段, bool已設定, str建議時段, arr時段: [ { str名稱, str起迄 } ] }
 * ============================================================================
 */
function 整理時段資訊_(obj活動值, arr建議) {
  const str目前 = String(obj活動值[obj報到表格式.str時段欄位] || '').trim();
  let arr時段 = [];
  try { arr時段 = 解析時段設定_(str目前); } catch (err) { arr時段 = []; }
  return {
    str報到時段: str目前,
    bool已設定: str目前 !== '',
    str建議時段: str目前 === '' ? 格式化時段設定_(arr建議 || []) : '',
    arr時段: arr時段.map(function (o) { return { str名稱: o.str名稱, str起迄: o.str起迄 }; })
  };
}


/**
 * ============================================================================
 * 函式名稱：讀取場次欄所有值_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：讀出有效資料所有場次欄的格內值（建議報到時段用）。
 * 參數：obj副本 {Spreadsheet}；dat基準 {Date}
 * 傳回：{Array}
 * ============================================================================
 */
function 讀取場次欄所有值_(obj副本, dat基準) {
  const arr全部 = 讀取有效資料全部_(obj副本);
  const obj欄位 = 找出報到名冊欄位_(arr全部[0], dat基準);
  const arr值 = [];
  arr全部.slice(1).forEach(function (arr列) { obj欄位.arr場次.forEach(function (o) { arr值.push(arr列[o.int欄]); }); });
  return arr值;
}


/**
 * ============================================================================
 * 函式名稱：報到表標題_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：報到表標題「精舍簡稱＋活動名稱＋點名表」，例如「普泉一支香 7-12點名表」。
 *       精舍名稱讀不到時只用活動名稱。
 * 參數：str精舍代號 {string}；obj活動值 {Object}
 * 傳回：{string}
 * ============================================================================
 */
function 報到表標題_(str精舍代號, obj活動值) {
  let str簡稱 = '';
  try {
    str簡稱 = String(取得精舍資訊(str精舍代號).str精舍名稱 || '').replace(/精舍$/, '');
  } catch (err) {
    console.warn('讀取精舍名稱失敗：' + (err && err.message ? err.message : err));
  }
  return `${str簡稱}${String(obj活動值['活動名稱'] || '').trim()}點名表`;
}


