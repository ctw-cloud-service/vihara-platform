/**
 * ============================================================================
 * 函式名稱：讀取名冊時段標記_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：名冊分頁下載時用了哪些時段欄（隱藏標記「法會時段欄」，JSON 陣列）；沒有標記傳回空陣列。
 * 參數：obj分頁 {Sheet|null}
 * 傳回：{string[]}
 * ============================================================================
 */
function 讀取名冊時段標記_(obj分頁) {
  if (!obj分頁) return [];
  const arr = obj分頁.createDeveloperMetadataFinder().withKey(obj報到表格式.str時段標記鍵).find();
  if (arr.length === 0) return [];
  try {
    const any = JSON.parse(arr[0].getValue() || '[]');
    return Array.isArray(any) ? any.map(String) : [];
  } catch (err) {
    return [];
  }
}


