}


/**
 * ============================================================================
 * 函式名稱：取得名冊報到人員_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   從場次名冊分頁讀出要印在報到表上的人員：
 *     · 名冊的時段欄與目前的時段設定相同 → 依名冊的 ✓（承辦人手動打的 ✓ 也算）
 *     · 不同（名冊是設定時段之前下載的、或時段後來改過）→ 依「報名內容」重新判斷，並提醒重新下載
 *     · 不分時段 → 名冊上的人都算報名
 *   承辦人直接刪掉的人不會出現；提醒照名冊的「提醒」欄。
 * 參數：obj名冊分頁 {Sheet}；arr時段 {Object[]}
 * 傳回：{Object} { arr人員, bool重新判斷 }
 * ============================================================================
 */
function 取得名冊報到人員_(obj名冊分頁, arr時段) {
  const obj內容 = 讀取名冊分頁內容_(obj名冊分頁);
  const arr時段名 = (arr時段 || []).map(function (o) { return o.str名稱; });
  const arr標記 = 讀取名冊時段標記_(obj名冊分頁);
  const bool分時段 = arr時段名.length >= 2;
  const bool依打勾 = bool分時段 && arr標記.join('|') === arr時段名.join('|')
    && arr時段名.every(function (s) { return obj內容.arr標題.indexOf(s) !== -1; });

  const arr人員 = obj內容.arr列.map(function (o) {
    const str報名內容 = 出車一般值轉文字_(o['報名內容']);
    let arr報名序 = [];
    let str報名登記 = '';
    let str提醒 = String(o['提醒'] === undefined || o['提醒'] === null ? '' : o['提醒']);
    if (!bool分時段) {
      arr報名序 = [0];
      str報名登記 = 出車一般值轉文字_(o['報名登記']) || str報名內容;
    } else if (bool依打勾) {
      arr時段名.forEach(function (s, i) { if (出車一般值轉文字_(o[s]) !== '') arr報名序.push(i); });
      str報名登記 = 產生報名登記_(arr報名序, arr時段, str報名內容);
    } else {
      const obj對應 = 對應報名時段_(str報名內容, arr時段);
      arr報名序 = obj對應.arr報名序;
      str報名登記 = 產生報名登記_(arr報名序, arr時段, str報名內容);
      if (obj對應.arr對不到.length > 0 && str提醒.indexOf('對不到時段') === -1) str提醒 += (str提醒 ? '；' : '') + '報名內容對不到時段';
    }
    return {
      str姓名: 正規化人名(o['姓名']), str法名: 正規化人名(o['法名']), str學員編號: 正規化學員編號(o['學員編號']),
      arr報名序: arr報名序, str報名登記: str報名登記, str提醒: str提醒,
      // 用齋（法會_用齋登記 v1.0.0）：「大寮・午齋×2」，印在備註
      str用齋: 組合用齋說明_(出車一般值轉文字_(o['義工組別']), 出車一般值轉文字_(o['用齋']), o['便當份數'])
    };
  });
  return { arr人員: arr人員, bool重新判斷: bool分時段 && !bool依打勾 };
}


/**
