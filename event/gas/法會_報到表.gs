/**
 * ============================================================================
 * 函式名稱：儲存法會時段
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：action「event.儲存時段」（網頁）。同 副本選單_儲存時段。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID, str報到時段 }
 * 傳回：{Object} { str訊息, str報到時段, obj時段 }
 * ============================================================================
 */
function 儲存法會時段(obj工作階段, obj參數) {
  檢查必要參數(obj參數, ['str活動ID'], '設定報到時段');
  const obj = 取得對內活動_(obj工作階段, obj參數.str活動ID, '設定報到時段');
  const obj結果 = 儲存活動報到時段_(obj工作階段, obj.obj主控台, obj.obj活動值, obj參數.str報到時段);
  let str訊息 = obj結果.str報到時段 === '' ? '已設定為「不分時段」（每個場次報到一次）。' : `已儲存報到時段：${obj結果.str報到時段}。`;
  if (!obj結果.bool有變更) str訊息 = '報到時段沒有變更。';
  else str訊息 += '\n已下載的場次名冊不會自動更新，請重新下載要用的場次，名冊的時段欄才會跟著改。';
  return { str訊息: str訊息, str報到時段: obj結果.str報到時段, obj時段: 整理時段資訊_(obj.obj活動值, []) };
}


/**
 * ============================================================================
 * 函式名稱：列印法會報到表
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：action「event.列印報到表」（網頁）。同 副本選單_列印報到表，傳回 PDF 列印網址。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID, str場次 }
 * 傳回：{Object} 產生報到表_ 的結果
 * ============================================================================
 */
function 列印法會報到表(obj工作階段, obj參數) {
  檢查必要參數(obj參數, ['str活動ID'], '列印報到表');
  const str場次 = 取得單一場次參數_(obj參數);
  const obj = 取得對內活動_(obj工作階段, obj參數.str活動ID, '列印報到表');
  const str活動ID = String(obj.obj活動值['活動ID']).trim();
  const obj設定 = {
    str標題: 報到表標題_(obj工作階段.str精舍代號, obj.obj活動值),
    arr時段: 取得活動時段_(obj.obj活動值),
    dat基準: 取得場次基準日_(obj.obj活動值)
  };
  const obj結果 = 以活動作業鎖執行_(obj工作階段.str精舍代號, str活動ID, '列印報到表', function () {
    return 產生報到表_(開啟活動副本_(obj.obj活動值), str場次, obj設定);
  });
  寫入操作日誌(obj工作階段, '列印報到表', `${str活動ID}：${obj結果.str訊息}`);
  return obj結果;
}
