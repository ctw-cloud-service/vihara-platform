  if (!obj結果.bool有變更) str訊息 = '報到時段沒有變更。';
  else if (bool有名冊) str訊息 += '\n\n已下載的場次名冊不會自動更新，請重新下載要用的場次，名冊的時段欄才會跟著改。';
  return { str訊息: str訊息, str報到時段: obj結果.str報到時段, obj時段: 整理時段資訊_(obj.obj活動值, []) };
}


