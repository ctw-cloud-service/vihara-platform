 * 參數：obj工作階段 {null}；obj參數 {Object} { str存取權杖, str副本ID, str場次 }
 * 傳回：{Object} 產生報到表_ 的結果
 * ============================================================================
 */
function 副本選單_列印報到表(obj工作階段, obj參數) {
  const str場次 = 取得單一場次參數_(obj參數);
  const obj = 開啟副本情境_(obj參數, obj法會權限.整理資料, '列印報到表', obj報到表格式.arr可列印狀態);
  檢查是對內活動_(obj.obj活動值);
  const str活動ID = String(obj.obj活動值['活動ID']).trim();
  const obj設定 = {
    str標題: 報到表標題_(obj.obj身分.str精舍代號, obj.obj活動值),
    arr時段: 取得活動時段_(obj.obj活動值),
    dat基準: 取得場次基準日_(obj.obj活動值)
  };
  const obj結果 = 以活動作業鎖執行_(obj.obj身分.str精舍代號, str活動ID, '列印報到表', function () {
    return 產生報到表_(obj.obj副本, str場次, obj設定);
  });
  寫入操作日誌(obj.obj身分, '列印報到表', `${str活動ID}：${obj結果.str訊息}`);
  return obj結果;
}


