// ----------------------------------------------------------------------------
// 報到時段與報到表格式
// ----------------------------------------------------------------------------
const obj報到表格式 = Object.freeze({
  str時段欄位: '報到時段',             // 主控台「活動清單」的欄位名稱
  int最多時段: 6,                      // 紙本寬度有限，一個場次最多 6 個時段
  str時段標記鍵: '法會時段欄',          // 名冊分頁的隱藏標記：下載時用了哪些時段欄（JSON 陣列）
  str報到表前綴: '報到表_',             // 報到表_11月15日
  str報到表標記鍵: '法會報到表',        // 報到表分頁的隱藏標記，值＝場次名稱
  str單一時段欄名: '報到',              // 不分時段的活動（共修、培訓）只有一欄
  str打勾符號: '✓',
  int每頁列數: 25,                     // 每頁的人數列（範本 A4 直式 25 列）；實機列印若不同，只改這裡
  obj列高: Object.freeze({ 標題: 34, 欄名: 46, 資料: 40 }),   // 像素；配合 A4 直式、上下邊界 0.16 英吋
  int可用寬度: 720,                    // 欄寬合計（像素），A4 直式 100% 列印不超出紙寬
  obj固定欄寬: Object.freeze({ 序號: 41, 姓名: 95, 法名: 70, 報名登記: 125, 備註: 85 }),
  int時段欄寬上限: 130,
  int標題字級: 18,
  int字級: 14,
  int小字級: 11,                       // 報名登記兩行、備註提醒
  int時段欄名字級: 12,                 // 時段欄名兩行（名稱／起-迄），14 號字放不下「14:00-14:40」
  str淺灰: '#d9d9d9',                  // 沒有報名的時段格（黑白列印仍看得出來）
  str欄名底色: '#f2f2f2',
  // A4 直式 PDF：100%、凍結列（標題與欄名）每頁重複、置中、不印格線（框線由程式畫）
  str列印參數: 'format=pdf&size=A4&portrait=true&scale=1&fzr=true&gridlines=false&printtitle=false'
    + '&sheetnames=false&pagenum=UNDEFINED&horizontal_alignment=CENTER&vertical_alignment=TOP'
    + '&top_margin=0.16&bottom_margin=0.16&left_margin=0.16&right_margin=0.16&attachment=false',
  arr可列印狀態: Object.freeze(['收件中', '報到中'])
});


// ============================================================================
// 甲、報到時段（純計算，不碰檔案）
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：中文序數_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：1 → 一、2 → 二 … 10 → 十（時段預設名稱「第一時段」用）。超過 10 直接用數字。
 * 參數：int {number}
 * 傳回：{string}
 * ============================================================================
 */
function 中文序數_(int) {
  const arr = ['', '一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];
  return arr[int] || String(int);
}


/**
 * ============================================================================
 * 函式名稱：時刻轉文字_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：一天中的第幾分鐘 → 「14:00」。
 * 參數：int分鐘 {number}
 * 傳回：{string}
 * ============================================================================
 */
function 時刻轉文字_(int分鐘) {
  const int時 = Math.floor(int分鐘 / 60);
  const int分 = int分鐘 % 60;
  return `${int時 < 10 ? '0' + int時 : int時}:${int分 < 10 ? '0' + int分 : int分}`;
}


/**
 * ============================================================================
 * 函式名稱：解析時段設定_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把「報到時段」設定文字轉成時段清單：
 *     「第一支香 14:00-14:40；第二支香 14:50-15:30；第三支香 15:40-16:20」
 *   · 分隔：「；」「;」或換行；時間的「-」也可寫「~」「～」「至」「到」，「:」也可寫全形「：」
 *   · 名稱可省略，省略時自動給「第一時段」「第二時段」…
 *   · 空白 → 空陣列（單一時段，不分時段）
 *   · 有錯（看不懂、起不早於迄、時段重疊、名稱重複、超過 6 個、只設 1 個）→ 白話說明哪一段有問題
 *   時段依開始時間排序。
 * 參數：any設定 {*} 設定文字
 * 傳回：{Object[]} [ { str名稱, int起（分鐘）, int迄, str起迄（14:00-14:40） } ]
 * ============================================================================
 */
function 解析時段設定_(any設定) {
  const cfg = obj報到表格式;
  const str設定 = String(any設定 === null || any設定 === undefined ? '' : any設定).trim();
  if (str設定 === '') return [];

  const fn錯誤 = function (str說明) {
    return new 平台錯誤(obj錯誤代碼.參數錯誤,
      `報到時段的設定有問題：${str說明}\n\n`
      + '正確寫法例如「第一支香 14:00-14:40；第二支香 14:50-15:30」（名稱 空格 開始-結束，以「；」分隔）；'
      + '不分時段的活動請留空白。');
  };

  // ① 逐段解析
  const arr段 = str設定.split(/[;；\n\r]+/).map(function (s) { return s.trim(); }).filter(function (s) { return s !== ''; });
  const arr時段 = arr段.map(function (str段) {
    const arr比對 = str段.match(/^(.*?)\s*(\d{1,2})\s*[:：]\s*(\d{2})\s*(?:-|~|～|－|–|—|至|到)\s*(\d{1,2})\s*[:：]\s*(\d{2})$/);
    if (!arr比對) throw fn錯誤(`「${str段}」看不出開始與結束時間`);
    const int起 = Number(arr比對[2]) * 60 + Number(arr比對[3]);
    const int迄 = Number(arr比對[4]) * 60 + Number(arr比對[5]);
    if (Number(arr比對[2]) > 23 || Number(arr比對[4]) > 24 || Number(arr比對[3]) > 59 || Number(arr比對[5]) > 59) {
      throw fn錯誤(`「${str段}」的時間不存在`);
    }
    if (int起 >= int迄) throw fn錯誤(`「${str段}」的開始時間沒有早於結束時間（請用 24 小時制，例如下午 2 點寫 14:00）`);
    return { str名稱: 正規化出車欄名_(arr比對[1]), int起: int起, int迄: int迄 };
  });

  // ② 數量
  if (arr時段.length > cfg.int最多時段) throw fn錯誤(`最多 ${cfg.int最多時段} 個時段（紙本報到表寬度有限），目前有 ${arr時段.length} 個`);
  if (arr時段.length === 1) throw fn錯誤('只有 1 個時段時不必設定，請留空白（整個場次報到一次）');

  // ③ 依開始時間排序、補預設名稱、檢查重疊與名稱重複
  arr時段.sort(function (a, b) { return a.int起 - b.int起; });
  arr時段.forEach(function (o, i) {
    if (o.str名稱 === '') o.str名稱 = `第${中文序數_(i + 1)}時段`;
    o.str起迄 = `${時刻轉文字_(o.int起)}-${時刻轉文字_(o.int迄)}`;
    if (i > 0 && o.int起 < arr時段[i - 1].int迄) throw fn錯誤(`「${arr時段[i - 1].str名稱}」和「${o.str名稱}」的時間重疊`);
  });
  const arr名稱 = arr時段.map(function (o) { return o.str名稱; });
  arr名稱.forEach(function (s, i) { if (arr名稱.indexOf(s) !== i) throw fn錯誤(`時段名稱「${s}」重複`); });
  return arr時段;
}


/**
 * ============================================================================
 * 函式名稱：格式化時段設定_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：時段清單 → 存回主控台的標準寫法「第一支香 14:00-14:40；第二支香 14:50-15:30」。
 * 參數：arr時段 {Object[]}
 * 傳回：{string}
 * ============================================================================
 */
function 格式化時段設定_(arr時段) {
  return (arr時段 || []).map(function (o) { return `${o.str名稱} ${o.str起迄 || (時刻轉文字_(o.int起) + '-' + 時刻轉文字_(o.int迄))}`; }).join('；');
}


/**
 * ============================================================================
 * 函式名稱：解析報名時段值_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把場次格內的值（一支香勾選的時段）拆成時間區間：
 *     「下午2:00-2:40, 下午2:50-3:30」→ [ 14:00-14:40, 14:50-15:30 ]
 *   · 以「,」「，」「、」「;」「；」或換行分隔
 *   · 「下午」「晚上」：12 點以前加 12；「上午」12 點＝0 點；「中午」12 點不變、1～5 點加 12
 *   · 結束時間沒寫上午／下午時，沿用開始時間的；結束仍早於開始時再加 12（例如「11:30-1:00」）
 *   · 沒有時間的值（例如「參加」）放進 arr看不懂
 * 參數：any值 {*}
 * 傳回：{Object} { arr區間: [ { int起, int迄 } ], arr看不懂: string[] }
 * ============================================================================
 */
function 解析報名時段值_(any值) {
  const obj結果 = { arr區間: [], arr看不懂: [] };
  const str值 = String(any值 === null || any值 === undefined ? '' : any值).trim();
  if (str值 === '') return obj結果;

  // 午別轉 24 小時制
  const fn轉換 = function (str午別, int時) {
    if ((str午別 === '下午' || str午別 === '晚上' || str午別 === 'PM') && int時 < 12) return int時 + 12;
    if ((str午別 === '上午' || str午別 === 'AM') && int時 === 12) return 0;
    if (str午別 === '中午' && int時 >= 1 && int時 <= 5) return int時 + 12;
    return int時;
  };

  str值.split(/[,，、;；\n\r]+/).forEach(function (str段原) {
    const str段 = str段原.trim();
    if (str段 === '') return;
    const arr比對 = str段.match(/(上午|中午|下午|晚上|AM|PM|am|pm)?\s*(\d{1,2})\s*[:：]\s*(\d{2})\s*(?:-|~|～|－|–|—|至|到)\s*(上午|中午|下午|晚上|AM|PM|am|pm)?\s*(\d{1,2})\s*[:：]\s*(\d{2})/);
    if (!arr比對) { obj結果.arr看不懂.push(str段); return; }
    const str起午別 = String(arr比對[1] || '').toUpperCase();
    const str迄午別 = String(arr比對[4] || arr比對[1] || '').toUpperCase();
    const int起 = fn轉換(str起午別, Number(arr比對[2])) * 60 + Number(arr比對[3]);
    let int迄 = fn轉換(str迄午別, Number(arr比對[5])) * 60 + Number(arr比對[6]);
    if (int迄 <= int起) int迄 += 12 * 60;
    obj結果.arr區間.push({ int起: int起, int迄: int迄 });
  });
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：建議報到時段_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   尚未設定報到時段時，從所有場次格內的值找出不同的時間區間，名稱給「第一時段」「第二時段」…，
 *   供承辦人確認（可改名為「第一支香」…）：
 *     · 依出現次數多的先選；和已選的區間重疊的不選（例如有人手填「下午2:00-2:45」，
 *       與多數人的 14:00-14:40 重疊，就不列入建議；名冊會提醒他「對不到時段」）
 *     · 選好的依開始時間排序
 *   選出的區間少於 2 個（例如共修、培訓的值都是「參加」）→ 空陣列（單一時段）；
 *   超過上限時也傳回空陣列，由承辦人自行設定。
 * 參數：arr值 {Array} 所有場次欄的格內值
 * 傳回：{Object[]} 與 解析時段設定_ 相同格式
 * ============================================================================
 */
function 建議報到時段_(arr值) {
  // ① 每個區間出現幾次
  const obj區間 = {};
  (arr值 || []).forEach(function (any) {
    解析報名時段值_(any).arr區間.forEach(function (o) {
      const str鍵 = `${o.int起}-${o.int迄}`;
      if (!obj區間[str鍵]) obj區間[str鍵] = { int起: o.int起, int迄: o.int迄, int次數: 0 };
      obj區間[str鍵].int次數 += 1;
    });
  });
  // ② 次數多的先選（同次數時開始早的先），重疊的略過
  const arr候選 = Object.keys(obj區間).map(function (k) { return obj區間[k]; })
    .sort(function (a, b) { return (b.int次數 - a.int次數) || (a.int起 - b.int起); });
  const arr = [];
  arr候選.forEach(function (o) {
    if (arr.every(function (x) { return o.int迄 <= x.int起 || o.int起 >= x.int迄; })) arr.push(o);
  });
  arr.sort(function (a, b) { return a.int起 - b.int起; });
  if (arr.length < 2 || arr.length > obj報到表格式.int最多時段) return [];
  return arr.map(function (o, i) {
    return { str名稱: `第${中文序數_(i + 1)}時段`, int起: o.int起, int迄: o.int迄, str起迄: `${時刻轉文字_(o.int起)}-${時刻轉文字_(o.int迄)}` };
  });
}


/**
 * ============================================================================
 * 函式名稱：對應報名時段_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   這個人報了哪些時段：
 *     · 不分時段（arr時段 少於 2 個）：格內有值＝報名這唯一的時段 → [0]
 *     · 分時段：格內每一段時間與時段的開始、結束都相同才算；對不到的段放進 arr對不到
 * 參數：
 *   any內容   {*}        場次格內的值（名冊的「報名內容」）
 *   arr時段   {Object[]} 解析時段設定_ 的結果
 * 傳回：{Object} { arr報名序: number[]（0 起算、由小到大）, arr對不到: string[] }
 * ============================================================================
 */
function 對應報名時段_(any內容, arr時段) {
  const str內容 = String(any內容 === null || any內容 === undefined ? '' : any內容).trim();
  if (!arr時段 || arr時段.length < 2) return { arr報名序: str內容 !== '' ? [0] : [], arr對不到: [] };

  const obj解析 = 解析報名時段值_(str內容);
  const arr報名序 = [];
  const arr對不到 = obj解析.arr看不懂.slice();
  obj解析.arr區間.forEach(function (o) {
    const int序 = arr時段.findIndex(function (t) { return t.int起 === o.int起 && t.int迄 === o.int迄; });
    if (int序 === -1) arr對不到.push(`${時刻轉文字_(o.int起)}-${時刻轉文字_(o.int迄)}`);
    else if (arr報名序.indexOf(int序) === -1) arr報名序.push(int序);
  });
  arr報名序.sort(function (a, b) { return a - b; });
  return { arr報名序: arr報名序, arr對不到: arr對不到 };
}


/**
 * ============================================================================
 * 函式名稱：產生報名登記_（內部使用）
 * 版本：v1.0.2（2026-11-07）　v1.0.2：全部時段一律顯示「全部時段」（與時段名稱無關）
 * ----------------------------------------------------------------------------
 * 用途：名冊與報到表的「報名登記」欄（決策 AB）：
 *   · 不分時段 → 照錄報名內容（例如「參加」）
 *   · 全部時段都報 → 「全部時段」
 *   · 報了部分時段 → 「14:00-14:40、14:50-15:30」
 *   · 一個都對不到 → 照錄報名內容
 * 參數：
 *   arr報名序   {number[]}
 *   arr時段     {Object[]}
 *   str原內容   {string}
 * 傳回：{string}
 * ============================================================================
 */
function 產生報名登記_(arr報名序, arr時段, str原內容) {
  const str原 = String(str原內容 === null || str原內容 === undefined ? '' : str原內容).trim();
  if (!arr時段 || arr時段.length < 2 || !arr報名序 || arr報名序.length === 0) return str原;
  if (arr報名序.length === arr時段.length) return '全部時段';
  return arr報名序.map(function (i) { return arr時段[i].str起迄; }).join('、');
}


/**
 * ============================================================================
 * 函式名稱：比較報名組別_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：報到表的排序（決策 AD）：
 *   全部時段在前 → 其餘依時段組合（[0] → [0,1] → [0,2] → [1] → [1,2] → [2]）→ 一個都沒對到的最後。
 * 參數：arr甲 {number[]}；arr乙 {number[]}；int時段數 {number}
 * 傳回：{number} 甲在前傳回負數
 * ============================================================================
 */
function 比較報名組別_(arr甲, arr乙, int時段數) {
  const fn等級 = function (arr) { return arr.length === 0 ? 2 : (arr.length >= int時段數 ? 0 : 1); };
  const int差 = fn等級(arr甲) - fn等級(arr乙);
  if (int差 !== 0) return int差;
  for (let i = 0; i < Math.min(arr甲.length, arr乙.length); i++) {
    if (arr甲[i] !== arr乙[i]) return arr甲[i] - arr乙[i];
  }
  return arr甲.length - arr乙.length;     // 前面都相同時，短的（只報較少時段）在前
}


/**
 * ============================================================================
 * 函式名稱：取得姓名排序器_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   姓名依中文筆畫排序（決策 AN）。台灣中文（zh-TW）的排序規則就是筆畫順序；
 *   先以「王」（4 畫）應排在「林」（8 畫）前面檢查這台主機是否支援，不支援時改用電腦內碼順序，
 *   並傳回說明，讓結果視窗告訴承辦人。
 * 參數：無
 * 傳回：{Object} { fn比較: Function, bool筆畫: boolean }
 * ============================================================================
 */
function 取得姓名排序器_() {
  try {
    const obj排序 = new Intl.Collator('zh-TW');
    if (obj排序.compare('王', '林') < 0 && obj排序.compare('林', '蔡') < 0) {
      return { fn比較: obj排序.compare, bool筆畫: true };
    }
  } catch (err) {
    console.warn('筆畫排序無法使用：' + (err && err.message ? err.message : err));
  }
  return { fn比較: function (a, b) { return a < b ? -1 : (a > b ? 1 : 0); }, bool筆畫: false };
}


/**
 * ============================================================================
 * 函式名稱：排序報到人員_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：依報名組別、再依姓名筆畫排序（紙本與第③-2 批的表格畫面共用，順序一致）。
 * 參數：arr人員 {Object[]} [ { str姓名, arr報名序 } ]；int時段數 {number}
 * 傳回：{Object} { arr人員（新陣列）, bool筆畫 }
 * ============================================================================
 */
function 排序報到人員_(arr人員, int時段數) {
  const obj排序器 = 取得姓名排序器_();
  const arr = (arr人員 || []).slice().sort(function (a, b) {
    return 比較報名組別_(a.arr報名序, b.arr報名序, int時段數) || obj排序器.fn比較(a.str姓名, b.str姓名);
  });
  return { arr人員: arr, bool筆畫: obj排序器.bool筆畫 };
}


