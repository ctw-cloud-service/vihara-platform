/**
 * ============================================================================
 * 函式名稱：寫入報到表分頁_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把 組合報到表內容_ 的結果寫進報到表分頁（已存在就整頁重建，不保留舊的內容，決策 AF）：
 *     · 先清空內容、格式、合併儲存格；不足的列欄補上、多的列欄刪掉（列印範圍＝整個分頁）
 *     · 欄寬、列高（固定，換行也不撐高，確保每頁列數固定）、字型大小、置中、換行
 *     · 標題列：標題合併序號～報名登記，日期合併時段欄～備註
 *     · 框線：全部細線、外框粗線；沒有報名的時段格淺灰
 *     · 凍結第 1～2 列（PDF 每頁重複標題與欄名）
 * 參數：
 *   obj副本     {Spreadsheet}
 *   obj分頁     {Sheet|null}  既有的報到表分頁
 *   str新名稱   {string}      沒有既有分頁時的名稱
 *   str場次     {string}      寫入隱藏標記
 *   obj內容     {Object}      組合報到表內容_ 的結果
 * 傳回：{Sheet}
 * ============================================================================
 */
function 寫入報到表分頁_(obj副本, obj分頁, str新名稱, str場次, obj內容) {
  const cfg = obj報到表格式;
  const int列數 = obj內容.arr值.length;
  const int欄數 = obj內容.arr欄名.length;

  // ① 取得或建立分頁；清空
  if (!obj分頁) {
    obj分頁 = obj副本.insertSheet(str新名稱, obj副本.getSheets().length);
    obj分頁.addDeveloperMetadata(cfg.str報到表標記鍵, str場次);
  } else {
    obj分頁.setFrozenRows(0);
    obj分頁.getRange(1, 1, obj分頁.getMaxRows(), obj分頁.getMaxColumns()).breakApart();
    obj分頁.clear();
  }

  // ② 列欄數剛好（列印範圍＝整個分頁，多的空白列會多印一頁）
  if (obj分頁.getMaxRows() < int列數) obj分頁.insertRowsAfter(obj分頁.getMaxRows(), int列數 - obj分頁.getMaxRows());
  if (obj分頁.getMaxRows() > int列數) obj分頁.deleteRows(int列數 + 1, obj分頁.getMaxRows() - int列數);
  if (obj分頁.getMaxColumns() < int欄數) obj分頁.insertColumnsAfter(obj分頁.getMaxColumns(), int欄數 - obj分頁.getMaxColumns());
  if (obj分頁.getMaxColumns() > int欄數) obj分頁.deleteColumns(int欄數 + 1, obj分頁.getMaxColumns() - int欄數);

  // ③ 值、底色、字級、對齊
  const obj全部 = obj分頁.getRange(1, 1, int列數, int欄數);
  obj全部.setNumberFormat('@').setValues(obj內容.arr值)
    .setBackgrounds(obj內容.arr底色).setFontSizes(obj內容.arr字級)
    .setVerticalAlignment('middle').setHorizontalAlignment('center').setWrap(true);
  obj分頁.getRange(1, 1, 1, int欄數).setWrap(false);

  // ④ 標題列：標題（左）與日期（右）
  obj分頁.getRange(1, 1, 1, obj內容.int時段起欄 - 1).merge().setHorizontalAlignment('left');
  obj分頁.getRange(1, obj內容.int時段起欄, 1, int欄數 - obj內容.int時段起欄 + 1).merge().setHorizontalAlignment('right');

  // ⑤ 欄寬、列高（固定高度，換行也不撐高）
  obj內容.arr欄寬.forEach(function (int寬, i) { obj分頁.setColumnWidth(i + 1, int寬); });
  const fn列高 = function (int起, int數, int高) {
    if (typeof obj分頁.setRowHeightsForced === 'function') obj分頁.setRowHeightsForced(int起, int數, int高);
    else obj分頁.setRowHeights(int起, int數, int高);
  };
  fn列高(1, 1, cfg.obj列高.標題);
  fn列高(2, 1, cfg.obj列高.欄名);
  if (int列數 > 2) fn列高(3, int列數 - 2, cfg.obj列高.資料);

  // ⑥ 框線：表格內細線、外框粗線；姓名欄靠左一點比較好認，維持置中與範本相同
  const obj表格 = obj分頁.getRange(2, 1, int列數 - 1, int欄數);
  obj表格.setBorder(true, true, true, true, true, true, '#000000', SpreadsheetApp.BorderStyle.SOLID);
  obj表格.setBorder(true, true, true, true, null, null, '#000000', SpreadsheetApp.BorderStyle.SOLID_MEDIUM);
  obj分頁.getRange(2, 1, 1, int欄數).setBorder(null, null, true, null, null, null, '#000000', SpreadsheetApp.BorderStyle.SOLID_MEDIUM);

  // ⑦ 凍結標題與欄名（PDF 每頁重複）、註解
  obj分頁.setFrozenRows(2);
  obj分頁.getRange(1, 1).setNote(
    `本分頁是場次「${str場次}」的紙本報到表，由選單「法會報到 → 列印報到表」從場次名冊產生，`
    + '每次列印整頁重建（不保留在這裡打的勾）。\n'
    + '灰底＝這個人沒有報名這個時段（到場仍可打勾）；最後幾列空白供手寫未報名的人。\n'
    + '現場打勾後，請到法會活動網頁用報到表格「補登」，報到方式記「紙本」。');
  return obj分頁;
}


/**
 * ============================================================================
 * 函式名稱：產生報到表列印網址_（內部使用）
 * 版本：v1.0.0（2026-11-06）
