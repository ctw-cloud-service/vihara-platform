// ============================================================================
// 檔案名稱：法會_報到名冊.gs
// 所屬模組：法會活動（event）
// 所屬層級：模組／服務層＋控制層
// 檔案版本：v1.6.0（2026-11-08）
//   v1.6.0：副本選單「下載場次名冊」可一併指定這場活動的合併設定（str用齋、str副會長回報，決策 BK）；列出場次（副本）附合併設定
//   v1.5.0：三個來源整合成同一套欄位（決策 BF～BJ）：
//     · 標準欄位「性別」「義工組別」「需要坐椅子」：報名表單、副會長回報（性別、執事、靠背椅＝是）、用齋登記（組別）、
//       學員名冊（性別）一起補；報名表單的同義欄（執事、組別、…椅…）依欄名對應，欄位順序或名稱略有異動也讀得到
//     · 「提醒」「副會長回報」「回報座位」「不參加原因」「用齋」「便當份數」整合進「備註」（不再分欄）
//     · 「來源列」改記來源：表單報名／副會長回報／用齋登記，多個來源以「,」列出
//   v1.4.0：名冊合併三個來源（報名＋副會長回報＋用齋登記，決策 BA～BD）：名冊加「副會長回報」「回報座位」「回報執事」「不參加原因」四欄；
//           副會長回報先合併（有法名）、再合併用齋；寫入後依回報自動取消參加／恢復參加（法會_副會長回報）
//   v1.3.0：合併用齋登記（法會_用齋登記）：名冊加「用齋」「義工組別」「便當份數」三欄；
//           同一天選定餐別的用齋義工已在名冊的補上三欄，沒報名的新增一列（算已報名）；列出場次附上合併用齋設定
//   v1.2.1：網頁「列出場次」每個場次附上是否取消（obj取消，讀報到紀錄）
//   v1.2.0：報到時段（第③-1b 批）：名冊在「報名內容」右側加「報名登記」與每個時段一欄（有報名標 ✓）；
//           報名內容對不到時段時提醒；下載時可一併儲存報到時段（第一次下載時確認系統建議的時段）；
//           列出場次時附上時段設定與建議。時段的解析在 法會_報到表.gs
//   v1.1.0：一次下載一個場次、一個場次一個分頁（「名冊_10月18日」）；每場只保留最近 1 份備份；
//           重新下載時，承辦人自加欄位（例如「座位」）的值依姓名帶回新頁
//   v1.0.0：初版（所有場次合併在「參加名冊」一頁；未部署即改為 v1.1.0）
// 用途說明：
//   對內活動（一支香、共修、培訓…）的表單題目各不相同，但都是「一場活動、多個場次」。
//   本檔從副本「有效資料」整理出「某一個場次的名冊」，供法會報到比對「已報名／未報名」：
//     ① 列出場次：欄名中含有「月/日」日期的欄（時間戳記除外）就是場次欄，格內有值＝參加
//        （一支香的格內是勾選的時段，例如「下午2:00-2:40, 下午2:50-3:30」，時段不算獨立場次）
//     ② 承辦人選一個場次
//     ③ 只看這個場次欄有填的列，同一姓名取時間戳記最晚的一筆
//        （沒有時間戳記＝承辦人手動加入＝最新；時間相同時，下面的列較新）
//     ④ 比對學員編號（各名冊分頁已有的編號沿用 → 學員名冊姓名＋法名 → 找不到配發臨時編號）
//     ⑤ 寫入這個場次自己的分頁「名冊_月日日」（同一天兩場時加 _2）：
//        分頁內有隱藏標記記錄是哪個場次，承辦人改了分頁名稱也找得到；
//        重新下載只重建這一頁，舊的先備份並隱藏（每場保留最近 1 份）
//   提醒（整列黃底，「提醒」欄寫明原因；不自動刪除，由承辦人判斷）：
//     · 備註提到「取消」（備註寫了日期時，只提醒相同日期的場次）
//     · 同名但法名不同（判斷同一人只比姓名，可能是不同人）
//     · 學員名冊中有多位同名同法名（學員編號留空，請承辦人填寫）
//     · 時間戳記看不懂（視為最新的一筆）
//
//   規劃與決策：06-01-01 法會活動\文件\法會活動_法會報到_規劃.md（v1.5）
//
//   ※ 本檔依檔名排序會比 法會_模組定義.gs 先載入，頂層常數一律自給自足，不引用其他檔案的常數。
//
// 相依檔案：
//   平台核心（核心_錯誤、核心_工具、核心_學員名冊、核心_日誌）
//   法會_模組定義（活動、權限、作業鎖）、法會_副本選單（開啟副本情境_）
//   法會_大車匯出（是日期值_、擷取月日_、推算月日日期_、出車一般值轉文字_、正規化出車欄名_、備份點名分頁_）
//   法會_重複檢查（轉為欄位字母_）
//   法會_報到表（時段解析、對應報名時段_、產生報名登記_、名冊時段標記、建議報到時段_、整理時段資訊_、儲存活動報到時段_）
// ============================================================================


// ----------------------------------------------------------------------------
// 場次名冊格式
// ----------------------------------------------------------------------------
const obj報到名冊格式 = Object.freeze({
  str來源分頁名: '有效資料',
  str名冊分頁前綴: '名冊_',          // 每個場次一頁：名冊_10月18日、名冊_10月18日_2
  str場次標記鍵: '法會場次',          // 名冊分頁的隱藏標記（工作表層級 DeveloperMetadata），值＝場次名稱
  str姓名欄: '姓名',
  str法名欄: '法名',
  str時間戳記欄: '時間戳記',
  str系統欄前綴: '系統_',            // 系統管理的欄（例如「系統_追加時間」）不帶入名冊
  str備註關鍵字: '備註',              // 欄名含「備註」的欄，用來找「取消」
  str取消關鍵字: '取消',
  // 名冊固定欄位與順序；其後接「有效資料」的其他欄位（帶入欄），再接承辦人自己加的欄位
  // v1.2.0：加「報名登記」；分時段的活動，各時段欄（欄名＝時段名稱）接在「報名登記」後面
  // v1.5.0：提醒、副會長回報、用齋等整合進「備註」；性別、義工組別、需要坐椅子為三個來源共用的標準欄位
  arr固定欄位: Object.freeze(['場次', '場次日期', '姓名', '法名', '學員編號', '性別', '報名內容', '報名登記',
    '義工組別', '需要坐椅子', '來源列', '報名時間', '備註']),
  // 舊版名冊的系統欄（v1.4.0 以前）：重新下載時不當成承辦人自加的欄位
  arr舊系統欄位: Object.freeze(['提醒', '用齋', '便當份數', '副會長回報', '回報座位', '回報執事', '不參加原因']),
  // 報名表單的欄名對應到標準欄位（v1.5.0）：欄名去空白後「相等」或「符合規則」就算；備註可以有多欄
  arr標準欄位: Object.freeze([
    Object.freeze({ str欄: '性別', fn符合: function (s) { return s === '性別'; } }),
    Object.freeze({ str欄: '義工組別', fn符合: function (s) { return ['義工組別', '執事', '組別', '義工執事', '執事組別'].indexOf(s) !== -1; } }),
    Object.freeze({ str欄: '需要坐椅子', fn符合: function (s) { return s.indexOf('椅') !== -1; } }),
    Object.freeze({ str欄: '備註', fn符合: function (s) { return s.indexOf('備註') !== -1; } })
  ]),
  obj來源: Object.freeze({ 表單: '表單報名', 回報: '副會長回報', 用齋: '用齋登記' }),
  obj備註標籤: Object.freeze({ 提醒: '提醒：', 回報: '副會長回報：', 用齋: '用齋：' }),
  str手動標記: '手動',                // 沒有時間戳記的列（承辦人手動加入），報名時間欄顯示這兩個字
  str場次日期格式: 'M/d',
  str報名時間格式: 'yyyy/M/d HH:mm',
  str備份標記: '_備份_',
  int保留備份數: 1,                   // 每個場次只保留最近 1 份備份（v1.1.0）
  str提醒底色: '#f9eeda',
  str標題底色: '#f3efe6',
  int提醒摘錄字數: 30,                 // 備註摘錄最多幾個字
  arr可下載狀態: Object.freeze(['收件中', '報到中'])
});


