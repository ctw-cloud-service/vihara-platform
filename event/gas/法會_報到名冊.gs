/**
 * ============================================================================
 * 函式名稱：解析報名時間_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把「時間戳記」格的值轉成可比較先後的時間：
 *     · 日期值（表單送出的時間戳記）→ 直接使用
 *     · 文字「2026/9/1 上午 6:08:39」「2026/9/1 下午 2:16:04」「2026/4/1」「2026-09-01 14:16」→ 轉成日期
 *     · 空白 → 視為承辦人手動加入（bool空白＝true）
 *     · 其他看不懂的文字 → bool看不懂＝true（呼叫端當成最新的一筆並提醒）
 * 參數：any值 {*} 時間戳記格的值
 * 傳回：{Object} { dat時間: Date|null, bool空白, bool看不懂 }
 * ============================================================================
 */
function 解析報名時間_(any值) {
  // ① 已是日期
  if (是日期值_(any值)) return { dat時間: any值, bool空白: false, bool看不懂: false };

  // ② 空白
  const str值 = String(any值 === null || any值 === undefined ? '' : any值).trim();
  if (str值 === '') return { dat時間: null, bool空白: true, bool看不懂: false };

  // ③ 文字：年/月/日［上午|下午］時:分［:秒］
  const arr比對 = str值.match(/^(\d{4})\s*[\/\-.]\s*(\d{1,2})\s*[\/\-.]\s*(\d{1,2})(?:\s*(上午|下午|AM|PM|am|pm)?\s*(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(上午|下午|AM|PM|am|pm)?)?$/);
  if (arr比對) {
    const int年 = Number(arr比對[1]);
    const int月 = Number(arr比對[2]);
    const int日 = Number(arr比對[3]);
    let int時 = arr比對[5] ? Number(arr比對[5]) : 0;
    const int分 = arr比對[6] ? Number(arr比對[6]) : 0;
    const int秒 = arr比對[7] ? Number(arr比對[7]) : 0;
    // 上午／下午可以寫在時間前面（Google 表單中文格式）或後面（英文格式）
    const str午別 = String(arr比對[4] || arr比對[8] || '').toUpperCase();
    if ((str午別 === '下午' || str午別 === 'PM') && int時 < 12) int時 += 12;
    if ((str午別 === '上午' || str午別 === 'AM') && int時 === 12) int時 = 0;
    const dat = new Date(int年, int月 - 1, int日, int時, int分, int秒);
    // 檢查日期真的存在（例如 2/30 會被 Date 自動進位成 3/2）
    if (dat.getMonth() === int月 - 1 && dat.getDate() === int日 && int時 < 24 && int分 < 60 && int秒 < 60) {
      return { dat時間: dat, bool空白: false, bool看不懂: false };
    }
  }

  // ④ 看不懂
  return { dat時間: null, bool空白: false, bool看不懂: true };
}


/**
 * ============================================================================
 * 函式名稱：比較報名先後_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   決定同一人的兩筆報名哪一筆較新（決策 D、G）：
 *     · 沒有時間戳記（手動加入）或看不懂 → 視為最新
 *     · 兩筆都有時間 → 時間晚的較新
 *     · 時間相同（或兩筆都沒有時間）→ 列號大的（下面的列）較新
 * 參數：
 *   obj甲 {Object} { obj時間（解析報名時間_ 的結果）, int來源列 }
 *   obj乙 {Object} 同上
 * 傳回：{number} 甲較新傳回正數、乙較新傳回負數
 * ============================================================================
 */
function 比較報名先後_(obj甲, obj乙) {
  // 沒有可用時間＝最新，用一個比任何時間都大的數字代表
  const fn時間值 = function (o) { return o.obj時間.dat時間 ? o.obj時間.dat時間.getTime() : Number.MAX_SAFE_INTEGER; };
  const int差 = fn時間值(obj甲) - fn時間值(obj乙);
  if (int差 !== 0) return int差;
  return obj甲.int來源列 - obj乙.int來源列;
}


/**
 * ============================================================================
 * 函式名稱：找出報到名冊欄位_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   分析「有效資料」第 1 列，找出：
 *     · 姓名、法名、時間戳記欄（必要的只有姓名；重複時用最左邊並提醒）
 *     · 場次欄：欄名含「月/日」或「月月日日」的欄（時間戳記除外）；
 *       場次日期取欄名中的第一個日期，年份依 dat基準 推算（活動日期；12 月→1 月算隔年）；
 *       同一個欄名出現兩次時用最左邊並提醒
 *     · 備註欄：欄名含「備註」的欄（找「取消」用）
 *     · 帶入欄：其他所有欄（「系統_」開頭與空白欄名除外），依原順序；欄名重複時用最左邊並提醒；
 *       與名冊固定欄位同名時改名為「原_欄名」，避免蓋掉系統欄
 * 參數：
 *   arr標題   {Array} 有效資料第 1 列
 *   dat基準   {Date}  推算場次年份的基準（活動日期；沒有就用今天）
 * 傳回：{Object} {
 *   int姓名欄, int法名欄（-1＝沒有）, int時間欄（-1＝沒有）,
 *   arr場次: [ { str場次, int欄, dat日期, int月, int日, bool多個日期 } ]（依日期排序）,
 *   arr備註欄: number[],
 *   arr帶入: [ { str欄名（名冊中的欄名）, int欄 } ],
 *   arr欄位提醒: string[]
 * }
 * ============================================================================
 */
function 找出報到名冊欄位_(arr標題, dat基準) {
  const cfg = obj報到名冊格式;
  const arr欄位提醒 = [];

  // ① 每個欄名（去前後空白）出現在哪幾欄
  const obj位置 = {};
  const arr欄名順序 = [];
  (arr標題 || []).forEach(function (any標題, i) {
    const str欄名 = 正規化出車欄名_(any標題);
    if (str欄名 === '') return;
    if (!(str欄名 in obj位置)) { obj位置[str欄名] = []; arr欄名順序.push(str欄名); }
    obj位置[str欄名].push(i);
  });
  // 重複欄名的提醒文字（決策 H：用最左邊那一欄）
  const fn重複提醒 = function (str欄名) {
    const arr欄 = obj位置[str欄名];
    if (arr欄.length < 2) return;
    const arr字母 = arr欄.map(function (i) { return 轉為欄位字母_(i + 1); });
    arr欄位提醒.push(`「${cfg.str來源分頁名}」有 ${arr欄.length} 個「${str欄名}」欄（第 ${arr字母.join('、')} 欄），已使用最左邊的第 ${arr字母[0]} 欄；如不是這一欄，請刪除或改名多出來的欄位`);
  };

  // ② 姓名（必要）、法名、時間戳記
  if (!obj位置[cfg.str姓名欄]) {
    throw new 平台錯誤(obj錯誤代碼.欄位缺漏,
      `「${cfg.str來源分頁名}」找不到「${cfg.str姓名欄}」欄，系統無法判斷哪幾列是報名資料。`
      + `請確認第 1 列有一欄的標題是「${cfg.str姓名欄}」（一字不差）。\n\n這次沒有產生任何名冊。`);
  }
  [cfg.str姓名欄, cfg.str法名欄, cfg.str時間戳記欄].forEach(function (str欄名) { if (obj位置[str欄名]) fn重複提醒(str欄名); });
  const int姓名欄 = obj位置[cfg.str姓名欄][0];
  const int法名欄 = obj位置[cfg.str法名欄] ? obj位置[cfg.str法名欄][0] : -1;
  const int時間欄 = obj位置[cfg.str時間戳記欄] ? obj位置[cfg.str時間戳記欄][0] : -1;
  if (int法名欄 < 0) arr欄位提醒.push(`「${cfg.str來源分頁名}」沒有「${cfg.str法名欄}」欄，名冊的法名會是空白，學員編號只能用姓名比對不到時配發臨時編號`);
  if (int時間欄 < 0) arr欄位提醒.push(`「${cfg.str來源分頁名}」沒有「${cfg.str時間戳記欄}」欄，同一人有多筆時一律取下面的列`);

  // ③ 逐欄分類（每個欄名只看最左邊那一欄）
  const arr場次 = [];
  const arr備註欄 = [];
  const arr帶入 = [];
  arr欄名順序.forEach(function (str欄名) {
    const int欄 = obj位置[str欄名][0];
    if (int欄 === int姓名欄 || int欄 === int法名欄 || int欄 === int時間欄) return;

    // 場次欄：欄名中有月日
    const arr月日 = 擷取月日_(str欄名);
    if (arr月日.length > 0) {
      fn重複提醒(str欄名);
      const dat日期 = 推算月日日期_(arr月日[0], dat基準);
      arr場次.push({
        str場次: str欄名, int欄: int欄, dat日期: dat日期,
        int月: arr月日[0].int月, int日: arr月日[0].int日, bool多個日期: arr月日.length > 1
      });
      if (arr月日.length > 1) {
        arr欄位提醒.push(`場次「${str欄名}」的欄名有 ${arr月日.length} 個日期，場次日期用第一個（${arr月日[0].int月}/${arr月日[0].int日}）`);
      }
      return;
    }

    // 系統欄不帶入
    if (str欄名.indexOf(cfg.str系統欄前綴) === 0) return;

    // 備註欄（同時也帶入名冊）
    if (str欄名.indexOf(cfg.str備註關鍵字) !== -1) arr備註欄.push(int欄);

    // 帶入欄
    fn重複提醒(str欄名);
    // v1.5.0：標準欄（性別、組別、…椅…、備註）保留原名，之後由 抽出標準欄位_ 併入名冊同名欄
    const str名冊欄名 = cfg.arr固定欄位.indexOf(str欄名) !== -1 && !比對標準欄位_(str欄名) ? `原_${str欄名}` : str欄名;
    arr帶入.push({ str欄名: str名冊欄名, int欄: int欄 });
  });

  // ④ 場次依日期排序（培訓的欄位順序和日期順序不同）；同一天依欄位順序
  arr場次.sort(function (a, b) { return (a.dat日期 - b.dat日期) || (a.int欄 - b.int欄); });

  return {
    int姓名欄: int姓名欄, int法名欄: int法名欄, int時間欄: int時間欄,
    arr場次: arr場次, arr備註欄: arr備註欄, arr帶入: arr帶入, arr欄位提醒: arr欄位提醒
  };
}


/**
 * ============================================================================
 * 函式名稱：讀取格文字_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：讀取某列某欄，轉成去前後空白的文字；欄號 < 0（沒有這一欄）傳回空字串。
 * 參數：arr列 {Array}；int欄 {number} 0 起算
 * 傳回：{string}
 * ============================================================================
 */
function 讀取格文字_(arr列, int欄) {
  if (int欄 < 0 || !arr列) return '';
  return 出車一般值轉文字_(arr列[int欄]);
}


/**
 * ============================================================================
 * 函式名稱：整理取消備註_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   找出每個姓名在「備註」類欄位中提到「取消」的內容（同一人的所有列都看，不限有沒有勾場次），
 *   並記下備註中寫了哪些日期：
 *     · 有日期 → 只提醒相同日期的場次（例如「請取消10/18庶務課培訓」只提醒 10/18）
 *     · 沒有日期 → 這個人的每個場次都提醒（例如備註只寫「取消」）
 * 參數：
 *   arr資料   {Array[]} 有效資料（不含標題列）
 *   obj欄位   {Object}  找出報到名冊欄位_ 的結果
 * 傳回：{Object} { 姓名: [ { str摘錄, arr月日: [ { int月, int日 } ] } ] }
 * ============================================================================
 */
function 整理取消備註_(arr資料, obj欄位) {
  const cfg = obj報到名冊格式;
  const obj結果 = {};
  if (obj欄位.arr備註欄.length === 0) return obj結果;
  arr資料.forEach(function (arr列) {
    const str姓名 = 正規化人名(讀取格文字_(arr列, obj欄位.int姓名欄));
    if (str姓名 === '') return;
    obj欄位.arr備註欄.forEach(function (int欄) {
      const str備註 = 讀取格文字_(arr列, int欄);
      if (str備註.indexOf(cfg.str取消關鍵字) === -1) return;
      // 摘錄過長的備註，避免提醒欄太長
      const str摘錄 = str備註.length > cfg.int提醒摘錄字數 ? str備註.slice(0, cfg.int提醒摘錄字數) + '…' : str備註;
      (obj結果[str姓名] = obj結果[str姓名] || []).push({ str摘錄: str摘錄, arr月日: 擷取月日_(str備註) });
    });
  });
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：整理場次名冊_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   純計算：產生「一個場次」的名冊列（不含學員編號，學員編號由 配發名冊學員編號_ 補上）。
 *     ① 只看這個場次欄有填的列（姓名空白的列略過）
 *     ② 依姓名分組（正規化人名：去掉所有空白），每組取最新的一筆（比較報名先後_）
 *     ③ 提醒：備註提到取消、同名但法名不同、時間戳記看不懂
 *     ④ 依來源列排序（與有效資料順序相同，方便承辦人對照）
 * 參數：
 *   arr資料       {Array[]} 有效資料（不含標題列）；第 i 列的試算表列號＝i＋2
 *   obj欄位       {Object}  找出報到名冊欄位_ 的結果
 *   obj場次       {Object}  obj欄位.arr場次 的其中一個
 *   obj取消備註   {Object=} 整理取消備註_ 的結果（省略時自動計算）
 * 傳回：{Object} {
 *   arr列: [ { str場次, dat場次日期, str姓名, str法名, str報名內容, int來源列, any報名時間,
 *              arr提醒: string[], obj帶入: { 欄名: 值 } } ],
 *   int有填筆數, int去重筆數, arr取消姓名, arr同名不同法名
 * }
 * ============================================================================
 */
function 整理場次名冊_(arr資料, obj欄位, obj場次, obj取消備註) {
  const cfg = obj報到名冊格式;
  const obj取消 = obj取消備註 || 整理取消備註_(arr資料, obj欄位);

  // ① 候選：這個場次欄有填、姓名不空白
  const obj分組 = {};        // 姓名 → [候選]
  const arr姓名順序 = [];
  let int有填筆數 = 0;
  arr資料.forEach(function (arr列, i) {
    const str姓名 = 正規化人名(讀取格文字_(arr列, obj欄位.int姓名欄));
    const str內容 = 讀取格文字_(arr列, obj場次.int欄);
    if (str姓名 === '' || str內容 === '') return;
    int有填筆數 += 1;
    if (!(str姓名 in obj分組)) { obj分組[str姓名] = []; arr姓名順序.push(str姓名); }
    obj分組[str姓名].push({
      arr列: arr列,
      int來源列: i + 2,
      str內容: str內容,
      str法名: 正規化人名(讀取格文字_(arr列, obj欄位.int法名欄)),
      obj時間: 解析報名時間_(obj欄位.int時間欄 >= 0 ? arr列[obj欄位.int時間欄] : '')
    });
  });

  // ② 每組取最新的一筆
  const arr列 = [];
  const arr取消姓名 = [];
  const arr同名不同法名 = [];
  arr姓名順序.forEach(function (str姓名) {
    const arr候選 = obj分組[str姓名];
    const obj最新 = arr候選.reduce(function (o最新, o) { return 比較報名先後_(o, o最新) > 0 ? o : o最新; });
    const arr提醒 = [];

    // ③-1 備註提到取消：沒寫日期的一律提醒；寫了日期的只提醒相同日期
    (obj取消[str姓名] || []).forEach(function (o) {
      const bool相關 = o.arr月日.length === 0 || o.arr月日.some(function (m) {
        return m.int月 === obj場次.int月 && m.int日 === obj場次.int日;
      });
      if (bool相關) arr提醒.push(`備註提到取消：「${o.str摘錄}」，請確認後自行刪除這一列`);
    });
    if (arr提醒.length > 0) arr取消姓名.push(str姓名);

    // ③-2 同名但法名不同（空白法名不算）
    const arr法名 = [];
    arr候選.forEach(function (o) { if (o.str法名 !== '' && arr法名.indexOf(o.str法名) === -1) arr法名.push(o.str法名); });
    if (arr法名.length > 1) {
      arr提醒.push(`同名但法名不同（${arr法名.join('、')}），可能是不同人，請確認（名冊用第 ${obj最新.int來源列} 列）`);
      arr同名不同法名.push(str姓名);
    }

    // ③-3 時間戳記看不懂
    if (obj最新.obj時間.bool看不懂) arr提醒.push(`第 ${obj最新.int來源列} 列的時間戳記看不懂，已當成最新的一筆`);

    // 帶入欄位：取用那一列的其他欄位
    const obj帶入 = {};
    obj欄位.arr帶入.forEach(function (o) { obj帶入[o.str欄名] = 讀取格文字_(obj最新.arr列, o.int欄); });

    arr列.push({
      str場次: obj場次.str場次,
      dat場次日期: obj場次.dat日期,
      str姓名: str姓名,
      str法名: obj最新.str法名,
      str報名內容: obj最新.str內容,
      int來源列: obj最新.int來源列,
      arr來源: [cfg.obj來源.表單],          // v1.5.0
      any報名時間: obj最新.obj時間.dat時間 || (obj最新.obj時間.bool空白 ? cfg.str手動標記 : String(obj最新.arr列[obj欄位.int時間欄]).trim()),
      arr提醒: arr提醒,
      obj帶入: obj帶入
    });
  });

  // ④ 依來源列排序
  arr列.sort(function (a, b) { return a.int來源列 - b.int來源列; });
  return {
    arr列: arr列,
    int有填筆數: int有填筆數,
    int去重筆數: int有填筆數 - arr列.length,
    arr取消姓名: arr取消姓名,
    arr同名不同法名: arr同名不同法名
  };
}


/**
 * ============================================================================
 * 函式名稱：組合名冊標題_（內部使用）
 * 版本：v1.1.0（2026-11-06）　v1.1.0：分時段的活動，時段欄接在「報名登記」後面
 * ----------------------------------------------------------------------------
 * 用途：場次名冊的標題＝固定欄位（含時段欄）＋ 這次的帶入欄 ＋ 這個場次舊名冊中承辦人自己加的欄位（例如「座位」），
 *       不重複、保留各自的順序。這樣重新下載時，承辦人自加的欄位不會消失（值由 帶回自加欄位值_ 帶回）。
 * 參數：
 *   arr帶入欄名   {string[]}  這次的帶入欄名
 *   arr既有標題   {string[]}  這個場次舊名冊的標題（第一次下載時為空陣列；舊的時段欄須先由呼叫端排除）
 *   arr時段欄名   {string[]=} 時段名稱（不分時段時省略或空陣列）
 * 傳回：{string[]}
 * ============================================================================
 */
function 組合名冊標題_(arr帶入欄名, arr既有標題, arr時段欄名) {
  const arr固定 = obj報到名冊格式.arr固定欄位.slice();
  const int登記位置 = arr固定.indexOf('報名登記');
  const arr結果 = arr固定.slice(0, int登記位置 + 1).concat(arr時段欄名 || [], arr固定.slice(int登記位置 + 1));
  (arr帶入欄名 || []).concat(arr既有標題 || []).forEach(function (str欄名) {
    const str名 = 正規化出車欄名_(str欄名);
    if (str名 !== '' && arr結果.indexOf(str名) === -1) arr結果.push(str名);
  });
  return arr結果;
}


/**
 * ============================================================================
 * 函式名稱：產生名冊分頁名稱_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   新場次名冊分頁的名稱：「名冊_10月18日」。場次欄名常含「[ ] /」等分頁名稱不能用的符號，
 *   所以只用場次日期；同名的分頁已存在（例如同一天兩個場次）時依序加「_2」「_3」。
 * 參數：
 *   obj場次       {Object}   找出報到名冊欄位_ 的 arr場次 其中一個（用 int月、int日）
 *   arr現有名稱   {string[]} 副本目前所有分頁名稱
 * 傳回：{string}
 * ============================================================================
 */
function 產生名冊分頁名稱_(obj場次, arr現有名稱) {
  const str基底 = `${obj報到名冊格式.str名冊分頁前綴}${obj場次.int月}月${obj場次.int日}日`;
  let str名稱 = str基底;
  let int序號 = 2;
  while ((arr現有名稱 || []).indexOf(str名稱) !== -1) { str名稱 = `${str基底}_${int序號}`; int序號 += 1; }
  return str名稱;
}


/**
 * ============================================================================
 * 函式名稱：帶回自加欄位值_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   重新下載同一場次時，承辦人在名冊自己加的欄位（例如「座位」「分組」）不能因此清空：
 *   依姓名（去空白）把舊名冊的值帶回新名冊的同一人；舊名冊沒有這個人（新報名）就留空。
 *   舊名冊有、新名冊沒有的人（例如已取消），他的自加欄位值不會帶回（人已不在名冊）。
 * 參數：
 *   arr新列       {Object[]} 新名冊列 { 欄名: 值 }（直接補上自加欄位的值）
 *   arr舊列       {Object[]} 舊名冊列 { 欄名: 值 }
 *   arr自加欄名   {string[]} 承辦人自加的欄位名稱
 * 傳回：{number} 帶回了幾人的值
 * ============================================================================
 */
function 帶回自加欄位值_(arr新列, arr舊列, arr自加欄名) {
  if (!arr自加欄名 || arr自加欄名.length === 0) return 0;
  // ① 舊名冊：姓名 → 那一列（同名多列時用第一列）
  const obj舊 = {};
  (arr舊列 || []).forEach(function (o) {
    const str姓名 = 正規化人名(o['姓名']);
    if (str姓名 !== '' && !(str姓名 in obj舊)) obj舊[str姓名] = o;
  });
  // ② 逐一帶回
  let int人數 = 0;
  (arr新列 || []).forEach(function (o) {
    const obj舊列 = obj舊[正規化人名(o['姓名'])];
    if (!obj舊列) return;
    let bool有值 = false;
    arr自加欄名.forEach(function (str欄名) {
      const any = obj舊列[str欄名];
      o[str欄名] = any === undefined || any === null ? '' : any;
      if (String(o[str欄名]).trim() !== '') bool有值 = true;
    });
    if (bool有值) int人數 += 1;
  });
  return int人數;
}


/**
 * ============================================================================
 * 函式名稱：取得單一場次參數_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   下載場次名冊一次只能選一個場次（v1.1.0）。接受 str場次（文字），
 *   也接受舊寫法 arr場次（只能有一個）；沒有選、或選了兩個以上時給出白話說明。
 * 參數：obj參數 {Object} { str場次 } 或 { arr場次 }
 * 傳回：{string} 場次名稱（去前後空白）
 * ============================================================================
 */
function 取得單一場次參數_(obj參數) {
  const obj = obj參數 || {};
  let arr = [];
  if (obj.str場次 !== undefined && obj.str場次 !== null) arr = [obj.str場次];
  else if (Array.isArray(obj.arr場次)) arr = obj.arr場次;
  const arr有效 = arr.map(正規化出車欄名_).filter(function (s) { return s !== ''; });
  if (arr有效.length === 0) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '沒有選擇場次，請選一個場次。');
  }
  if (arr有效.length > 1) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '一次只能下載一個場次，請一個一個下載。');
  }
  return arr有效[0];
}


/**
 * ============================================================================
 * 函式名稱：轉為名冊物件_（內部使用）
 * 版本：v1.1.0（2026-11-06）　v1.1.0：加「報名登記」與各時段欄（有報名標 ✓）
 * ----------------------------------------------------------------------------
 * 用途：整理場次名冊_ 的一列 → 寫入名冊用的物件 { 欄名: 值 }。
 * 參數：
 *   obj列     {Object}    整理場次名冊_ 的 arr列 其中一筆（已補上 str學員編號；分時段時已補上 arr報名序）
 *   arr時段   {Object[]=} 時段（不分時段時省略）
 * 傳回：{Object}
 * ============================================================================
 */
function 轉為名冊物件_(obj列, arr時段) {
  const arr分時段 = arr時段 && arr時段.length >= 2 ? arr時段 : [];
  const arr報名序 = obj列.arr報名序 || [];
  const obj標準 = obj列.obj標準 || {};
  const obj結果 = Object.assign({}, obj列.obj帶入, {
    '場次': obj列.str場次,
    '場次日期': obj列.dat場次日期,
    '姓名': obj列.str姓名,
    '法名': obj列.str法名,
    '學員編號': obj列.str學員編號 || '',
    '性別': obj標準['性別'] || '',
    '報名內容': obj列.str報名內容,
    '報名登記': 產生報名登記_(arr報名序, arr分時段, obj列.str報名內容),
    '義工組別': obj標準['義工組別'] || '',
    '需要坐椅子': obj標準['需要坐椅子'] || '',
    // v1.5.0：來源（表單報名／副會長回報／用齋登記，多個以「,」列出）
    '來源列': (obj列.arr來源 && obj列.arr來源.length > 0 ? obj列.arr來源 : [obj報到名冊格式.obj來源.表單]).join(','),
    '報名時間': obj列.any報名時間,
    // v1.5.0：報名備註＋提醒＋副會長回報＋用齋，整合在備註
    '備註': 組合名冊備註_(obj列),
    // 內部用（不寫入分頁）：自動取消參加、黃底
    '__回報出席': obj列.obj回報 ? obj列.obj回報.str出席 : '',
    '__不參加原因': obj列.obj回報 ? obj列.obj回報.str原因 : '',
    '__提醒': (obj列.arr提醒 || []).join('、')
  });
  // 時段欄：有報名標 ✓，沒有留空（承辦人可以手動補 ✓，列印報到表時照名冊的 ✓）
  arr分時段.forEach(function (o, i) { obj結果[o.str名稱] = arr報名序.indexOf(i) !== -1 ? obj報到表格式.str打勾符號 : ''; });
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：補上名冊時段_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：分時段的活動，替整理好的名冊列判斷報了哪些時段（obj列.arr報名序）；
 *       報名內容有對不到時段的部分時加提醒（例如表單題目的時間改過）。不分時段時不動。
 * 參數：arr列 {Object[]} 整理場次名冊_ 的 arr列；arr時段 {Object[]}
 * 傳回：{number} 有對不到時段的人數
 * ============================================================================
 */
function 補上名冊時段_(arr列, arr時段) {
  if (!arr時段 || arr時段.length < 2) return 0;
  let int對不到 = 0;
  arr列.forEach(function (o) {
    const obj對應 = 對應報名時段_(o.str報名內容, arr時段);
    o.arr報名序 = obj對應.arr報名序;
    if (obj對應.arr對不到.length > 0) {
      o.arr提醒.push(`報名內容對不到時段：「${obj對應.arr對不到.join('、')}」，請確認後在時段欄自行打 ✓`);
      int對不到 += 1;
    }
  });
  return int對不到;
}


// ============================================================================
// 乙、讀寫副本（碰檔案）
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：讀取有效資料全部_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：一次讀入副本「有效資料」全部內容（含標題列）；沒有資料時給出白話說明。
 * 參數：obj副本 {Spreadsheet}
 * 傳回：{Array[]} 第 0 列為標題
 * ============================================================================
 */
function 讀取有效資料全部_(obj副本) {
  const cfg = obj報到名冊格式;
  const obj來源 = 取得副本分頁_(obj副本, cfg.str來源分頁名);
  const int最後列 = obj來源.getLastRow();
  const int最後欄 = obj來源.getLastColumn();
  if (int最後列 < 2 || int最後欄 < 1) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${cfg.str來源分頁名}」沒有任何報名資料，無法產生場次名冊。`);
  }
  return obj來源.getRange(1, 1, int最後列, int最後欄).getValues();
}


/**
 * ============================================================================
 * 函式名稱：讀取分頁場次標記_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：讀出分頁的「法會場次」隱藏標記（沒有時傳回空字串）。備份分頁一律當成沒有標記。
 * 參數：obj分頁 {Sheet}
 * 傳回：{string} 場次名稱
 * ============================================================================
 */
function 讀取分頁場次標記_(obj分頁) {
  const cfg = obj報到名冊格式;
  if (obj分頁.getName().indexOf(cfg.str備份標記) !== -1) return '';
  const arr = obj分頁.createDeveloperMetadataFinder().withKey(cfg.str場次標記鍵).find();
  return arr.length > 0 ? String(arr[0].getValue() || '').trim() : '';
}


/**
 * ============================================================================
 * 函式名稱：列出名冊分頁_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：找出副本中所有場次名冊分頁（有「法會場次」標記、不是備份）。
 * 參數：obj副本 {Spreadsheet}
 * 傳回：{Object[]} [ { obj分頁, str場次 } ]
 * ============================================================================
 */
function 列出名冊分頁_(obj副本) {
  const arr結果 = [];
  obj副本.getSheets().forEach(function (obj分頁) {
    const str場次 = 讀取分頁場次標記_(obj分頁);
    if (str場次 !== '') arr結果.push({ obj分頁: obj分頁, str場次: str場次 });
  });
  return arr結果;
}


/**
 * ============================================================================
 * 函式名稱：讀取名冊分頁內容_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：讀出一個名冊分頁，每列轉成 { 欄名: 值 }；姓名空白的列（承辦人留的空白列）略過。
 * 參數：obj分頁 {Sheet|null}
 * 傳回：{Object} { arr標題: string[], arr列: Object[] }
 * ============================================================================
 */
function 讀取名冊分頁內容_(obj分頁) {
  if (!obj分頁 || obj分頁.getLastRow() < 1 || obj分頁.getLastColumn() < 1) return { arr標題: [], arr列: [] };
  const arr全部 = obj分頁.getRange(1, 1, obj分頁.getLastRow(), obj分頁.getLastColumn()).getValues();
  const arr標題 = arr全部[0].map(正規化出車欄名_);
  const arr列 = [];
  arr全部.slice(1).forEach(function (arr值) {
    const obj = {};
    arr標題.forEach(function (str欄名, i) { if (str欄名 !== '' && !(str欄名 in obj)) obj[str欄名] = arr值[i]; });
    if (正規化人名(obj['姓名']) !== '') arr列.push(obj);
  });
  return { arr標題: arr標題.filter(function (s) { return s !== ''; }), arr列: arr列 };
}


/**
 * ============================================================================
 * 函式名稱：配發名冊學員編號_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   替新產生的名冊列補上學員編號（決策 N）：
 *     ① 本活動各名冊分頁中，同一姓名已有學員編號（含承辦人手填、之前配發的臨時編號）→ 沿用
 *     ② 其餘姓名一次送平台核心「比對並配發臨時編號」（姓名＋法名比對學員名冊）：
 *        · 符合 → 學員編號；找不到 → 新配發臨時編號
 *        · 多筆符合 → 留空，提醒承辦人填寫（列出候選編號）
 *   ※ 核心函式自行鎖定，本函式不可包在執行並鎖定裡。
 * 參數：
 *   str精舍代號   {string}
 *   arr新列       {Object[]} 整理場次名冊_ 的 arr列（會直接補上 str學員編號、追加 arr提醒）
 *   arr既有       {Object[]} 各名冊分頁既有的列 { 欄名: 值 }
 * 傳回：{Object} { int沿用, int名冊符合, int新臨時編號, int待填 }
 * ============================================================================
 */
function 配發名冊學員編號_(str精舍代號, arr新列, arr既有) {
  const obj統計 = { int沿用: 0, int名冊符合: 0, int新臨時編號: 0, int待填: 0 };

  // ① 既有名冊：姓名 → 學員編號（第一個非空白的）
  const obj既有編號 = {};
  (arr既有 || []).forEach(function (o) {
    const str姓名 = 正規化人名(o['姓名']);
    const str編號 = 正規化學員編號(o['學員編號']);
    if (str姓名 !== '' && str編號 !== '' && !(str姓名 in obj既有編號)) obj既有編號[str姓名] = str編號;
  });

  // ② 需要比對的姓名（不重複）
  const arr待比對 = [];
  const obj待比對位置 = {};
  arr新列.forEach(function (o) {
    if (o.str姓名 in obj既有編號 || o.str姓名 in obj待比對位置) return;
    obj待比對位置[o.str姓名] = arr待比對.length;
    arr待比對.push({ str姓名: o.str姓名, str法名: o.str法名 });
  });
  const arr比對 = arr待比對.length > 0 ? 比對並配發臨時編號(str精舍代號, arr待比對) : [];

  // ③ 填回每一列
  arr新列.forEach(function (o) {
    if (o.str姓名 in obj既有編號) {
      o.str學員編號 = obj既有編號[o.str姓名];
      obj統計.int沿用 += 1;
      return;
    }
    const obj結果 = arr比對[obj待比對位置[o.str姓名]];
    o.str學員編號 = obj結果.str學員編號 || '';
    if (obj結果.str比對結果 === obj比對結果.多筆符合) {
      o.arr提醒.push(`學員名冊中有 ${obj結果.arr候選編號.length} 位同名同法名（${obj結果.arr候選編號.join('、')}），請填寫學員編號`);
      obj統計.int待填 += 1;
    } else if (obj結果.bool臨時編號) {
      obj統計.int新臨時編號 += 1;
    } else {
      obj統計.int名冊符合 += 1;
    }
  });
  return obj統計;
}


/**
 * ============================================================================
 * 函式名稱：備份名冊分頁_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   重建前把這個場次的名冊複製為「名冊_10月18日_備份_yyyyMMdd_HHmm」並隱藏，
 *   拿掉備份上的場次標記（避免被當成名冊），同一場次只保留最近 int保留備份數 份。
 * 參數：obj副本 {Spreadsheet}；obj分頁 {Sheet} 要備份的名冊分頁
 * 傳回：{string} 備份分頁名稱
 * ============================================================================
 */
function 備份名冊分頁_(obj副本, obj分頁) {
  const cfg = obj報到名冊格式;
  const str備份名 = 備份點名分頁_(obj副本, obj分頁);
  const obj備份 = obj副本.getSheetByName(str備份名);
  obj備份.hideSheet();
  // 複製分頁可能連同隱藏標記一起複製，一律拿掉
  obj備份.createDeveloperMetadataFinder().withKey(cfg.str場次標記鍵).find().forEach(function (o) { o.remove(); });

  // 同一場次只保留最近幾份（名稱含時間，依名稱排序即依時間排序）
  const str前綴 = obj分頁.getName() + cfg.str備份標記;
  obj副本.getSheets()
    .filter(function (o) { return o.getName().indexOf(str前綴) === 0; })
    .sort(function (a, b) { return b.getName().localeCompare(a.getName(), 'en', { numeric: true }); })
    .slice(cfg.int保留備份數)
    .forEach(function (o) { obj副本.deleteSheet(o); });
  return str備份名;
}


/**
 * ============================================================================
 * 函式名稱：寫入名冊分頁_（內部使用）
 * 版本：v1.1.0（2026-11-06）　v1.1.0：時段欄置中、記下時段欄標記
 * ----------------------------------------------------------------------------
 * 用途：
 *   重建一個場次的名冊分頁：
 *     ① 已存在 → 先備份（隱藏），再清空內容與格式（不刪分頁，分頁名稱、位置、欄寬不變）；
 *        不存在 → 新增分頁並寫上「法會場次」隱藏標記
 *     ② 學員編號設純文字（開頭 0 不會消失）、場次日期 M/d、報名時間 yyyy/M/d HH:mm
 *     ③ 寫標題與資料；有提醒的整列黃底
 *     ④ 凍結第 1 列、加說明註解
 * 參數：
 *   obj副本       {Spreadsheet}
 *   obj分頁       {Sheet|null} 這個場次既有的名冊分頁
 *   str新分頁名   {string}     沒有既有分頁時使用的名稱
 *   str場次       {string}     場次名稱（寫入隱藏標記）
 *   arr標題       {string[]}
 *   arr列         {Object[]}   { 欄名: 值 }
 *   arr時段欄名   {string[]=}  時段欄名稱（v1.1.0：置中，並記在分頁的隱藏標記「法會時段欄」）
 * 傳回：{Object} { obj分頁, str備份名（第一次為空字串） }
 * ============================================================================
 */
function 寫入名冊分頁_(obj副本, obj分頁, str新分頁名, str場次, arr標題, arr列, arr時段欄名) {
  const cfg = obj報到名冊格式;
  const int欄數 = arr標題.length;
  const int需要列 = arr列.length + 1;

  // ① 取得或建立分頁
  let str備份名 = '';
  if (obj分頁) {
    str備份名 = 備份名冊分頁_(obj副本, obj分頁);
    obj分頁.clear();
  } else {
    obj分頁 = obj副本.insertSheet(str新分頁名, obj副本.getSheets().length);
    obj分頁.addDeveloperMetadata(cfg.str場次標記鍵, str場次);
  }
  if (int需要列 > obj分頁.getMaxRows()) obj分頁.insertRowsAfter(obj分頁.getMaxRows(), int需要列 - obj分頁.getMaxRows());
  if (int欄數 > obj分頁.getMaxColumns()) obj分頁.insertColumnsAfter(obj分頁.getMaxColumns(), int欄數 - obj分頁.getMaxColumns());

  // ② 欄位格式（先設格式再寫值）
  const int資料列數 = Math.max(int需要列 - 1, 1);
  obj分頁.getRange(2, arr標題.indexOf('學員編號') + 1, int資料列數, 1).setNumberFormat('@');
  obj分頁.getRange(2, arr標題.indexOf('場次日期') + 1, int資料列數, 1).setNumberFormat(cfg.str場次日期格式);
  obj分頁.getRange(2, arr標題.indexOf('報名時間') + 1, int資料列數, 1).setNumberFormat(cfg.str報名時間格式);

  // ③ 標題與資料
  obj分頁.getRange(1, 1, 1, int欄數).setValues([arr標題.slice()]).setFontWeight('bold').setBackground(cfg.str標題底色);
  if (arr列.length > 0) {
    const arr值 = arr列.map(function (o) {
      return arr標題.map(function (str欄名) {
        const any = o[str欄名];
        if (str欄名 === '學員編號') return 正規化學員編號(any);      // 學員編號一律轉文字
        return any === undefined || any === null ? '' : any;
      });
    });
    obj分頁.getRange(2, 1, arr列.length, int欄數).setValues(arr值);

    // 有提醒的整列黃底（一次設定整塊，比逐格快；v1.5.0 提醒在備註裡）
    const arr底色 = arr列.map(function (o) {
      const str提醒 = o.__提醒 !== undefined ? String(o.__提醒) : 名冊備註取段_(o['備註'], cfg.obj備註標籤.提醒);
      return new Array(int欄數).fill(String(str提醒).trim() !== '' ? cfg.str提醒底色 : null);
    });
    obj分頁.getRange(2, 1, arr列.length, int欄數).setBackgrounds(arr底色);

    // 時段欄的 ✓ 置中（v1.1.0）
    (arr時段欄名 || []).forEach(function (str欄名) {
      const int欄 = arr標題.indexOf(str欄名);
      if (int欄 !== -1) obj分頁.getRange(1, int欄 + 1, arr列.length + 1, 1).setHorizontalAlignment('center');
    });
  }
  // 記下這次的時段欄（重新下載時，舊的時段欄不會被誤認為承辦人自加的欄位）
  寫入名冊時段標記_(obj分頁, arr時段欄名 || []);

  // ④ 凍結、註解
  obj分頁.setFrozenRows(1);
  obj分頁.getRange(1, 1).setNote(
    `本分頁是場次「${str場次}」的名冊，由選單「法會報到 → 下載場次名冊」從「${cfg.str來源分頁名}」產生：`
    + '同一姓名只列一次，取時間最晚的報名。\n'
    + '重新下載這個場次時整頁重建（舊的自動備份並隱藏，保留最近 1 份）；您自己加的欄位（例如座位）會依姓名帶回。\n'
    + '分頁名稱可以改，系統仍認得是哪個場次。\n'
    + '黃底：請看「提醒」欄（備註提到取消、同名不同法名、學員編號待填、報名內容對不到時段）。取消的人請直接刪除該列；'
    + '但重新下載這個場次時，刪除的人會再出現。');
  obj分頁.getRange(1, arr標題.indexOf('學員編號') + 1).setNote(
    '各名冊已有的編號沿用（可手動填寫或更正）；其餘以姓名＋法名比對學員名冊，找不到時配發臨時編號 T-精舍代號-流水號。');
  if (arr時段欄名 && arr時段欄名.length > 0) {
    obj分頁.getRange(1, arr標題.indexOf('報名登記') + 1).setNote(
      '依「報名內容」判斷報了哪些時段：全部時段顯示「全部時段」，否則列出時段。\n'
      + '右側每個時段一欄，有報名標 ✓；可以手動補 ✓ 或刪掉，列印報到表時照這裡的 ✓（重新下載會依報名內容重算）。');
  }
  return { obj分頁: obj分頁, str備份名: str備份名 };
}


/**
 * ============================================================================
 * 函式名稱：取得場次基準日_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：推算場次年份的基準：活動清單的「活動日期」；沒有或不是日期時用今天。
 * 參數：obj活動值 {Object|null} 活動清單一列的 obj值
 * 傳回：{Date}
 * ============================================================================
 */
function 取得場次基準日_(obj活動值) {
  const any = obj活動值 ? obj活動值['活動日期'] : null;
  return 是日期值_(any) ? any : new Date();
}


/**
 * ============================================================================
 * 函式名稱：列出報到場次_（內部使用）
 * 版本：v1.2.0（2026-11-06）　v1.2.0：附上系統建議的報到時段；v1.1.0：已下載人數改讀各場次自己的名冊分頁，並傳回分頁名稱
 * ----------------------------------------------------------------------------
 * 用途：只處理副本本身：列出「有效資料」的場次、每個場次有填幾筆、已下載的名冊分頁與人數。
 * 參數：
 *   obj副本   {Spreadsheet}
 *   dat基準   {Date} 推算場次年份
 * 傳回：{Object} {
 *   arr場次: [ { str場次, str日期（M/d）, int有填筆數, int已下載人數, str分頁名（未下載為空字串） } ],
 *   arr欄位提醒: string[],
 *   arr建議時段: Object[]（建議報到時段_ 的結果；呼叫端在尚未設定時段時給承辦人確認）
 * }
 * ============================================================================
 */
function 列出報到場次_(obj副本, dat基準) {
  const cfg = obj報到名冊格式;
  const arr全部 = 讀取有效資料全部_(obj副本);
  const obj欄位 = 找出報到名冊欄位_(arr全部[0], dat基準);
  if (obj欄位.arr場次.length === 0) {
    throw new 平台錯誤(obj錯誤代碼.欄位缺漏,
      `「${cfg.str來源分頁名}」沒有找到場次欄。系統把欄名中含有日期（例如「7/5」「10月10日」）的欄當作場次，`
      + '請確認表單的場次題目有寫日期。');
  }
  const arr資料 = arr全部.slice(1);

  // 已下載的名冊分頁：場次 → { 分頁名, 人數 }
  const obj已下載 = {};
  列出名冊分頁_(obj副本).forEach(function (o) {
    if (o.str場次 in obj已下載) return;                       // 同一場次有兩頁時以第一頁為準
    obj已下載[o.str場次] = { str分頁名: o.obj分頁.getName(), int人數: 讀取名冊分頁內容_(o.obj分頁).arr列.length };
  });

  return {
    arr場次: obj欄位.arr場次.map(function (o) {
      const int有填 = arr資料.filter(function (arr列) {
        return 讀取格文字_(arr列, obj欄位.int姓名欄) !== '' && 讀取格文字_(arr列, o.int欄) !== '';
      }).length;
      const obj下載 = obj已下載[o.str場次];
      return {
        str場次: o.str場次, str日期: `${o.int月}/${o.int日}`, int有填筆數: int有填,
        // v1.6.0：網頁預設選最近的場次用（yyyy-MM-dd）
        str日期值: o.dat日期 ? `${o.dat日期.getFullYear()}-${('0' + (o.dat日期.getMonth() + 1)).slice(-2)}-${('0' + o.dat日期.getDate()).slice(-2)}` : '',
        int已下載人數: obj下載 ? obj下載.int人數 : 0, str分頁名: obj下載 ? obj下載.str分頁名 : ''
      };
    }),
    arr欄位提醒: obj欄位.arr欄位提醒,
    arr建議時段: 建議報到時段_(arr資料.reduce(function (arr, arr列) {
      obj欄位.arr場次.forEach(function (o) { arr.push(arr列[o.int欄]); });
      return arr;
    }, []))
  };
}


/**
 * ============================================================================
 * 函式名稱：補上用齋義工法名_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：用齋登記表只有姓名、沒有法名；學員名冊比對要「姓名＋法名」。
 *       新增的用齋義工在學員名冊中剛好只有一位同名時，補上他的法名（之後就能比對到正式學員編號）；
 *       有多位同名時加提醒，請承辦人確認學員編號。學員名冊讀不到時略過（照常配發臨時編號）。
 * 參數：str精舍代號 {string}；arr名冊列 {Object[]}（會直接修改 bool用齋新增 的列）
 * 傳回：無
 * ============================================================================
 */
function 補上用齋義工法名_(str精舍代號, arr名冊列) {
  let arr學員 = [];
  try { arr學員 = 讀取學員名冊(str精舍代號).arr學員 || []; } catch (err) { return; }
  const obj依姓名 = {};
  arr學員.forEach(function (o) {
    const str = 正規化人名(o.str姓名);
    (obj依姓名[str] = obj依姓名[str] || []).push(o);
  });
  arr名冊列.forEach(function (o) {
    if (!o.bool用齋新增) return;
    const arr同名 = obj依姓名[正規化人名(o.str姓名)] || [];
    if (arr同名.length === 1) o.str法名 = 正規化人名(arr同名[0].str法名);
    else if (arr同名.length > 1) o.arr提醒.push(`用齋義工只有姓名，學員名冊有 ${arr同名.length} 位同名，請確認學員編號與法名`);
  });
}


/**
 * ============================================================================
 * 函式名稱：比對標準欄位_（內部使用）
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：欄名對應到哪一個標準欄位（性別、義工組別、需要坐椅子、備註）；欄名先去掉空白與括號說明。
 * 參數：str欄名 {string}
 * 傳回：{string} 標準欄位名稱；不是傳回空字串
 * ============================================================================
 */
function 比對標準欄位_(str欄名) {
  const s = String(str欄名 || '').replace(/[\s　]+/g, '').replace(/[（(][^)）]*[)）]/g, '').replace(/[?？:：]$/g, '');
  if (s === '') return '';
  const o = obj報到名冊格式.arr標準欄位.filter(function (x) { return x.fn符合(s); })[0];
  return o ? o.str欄 : '';
}


/**
 * ============================================================================
 * 函式名稱：抽出標準欄位_（內部使用）
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：
 *   報名表單帶入的欄位中，屬於標準欄位的（性別、執事／組別、…椅…、備註）移到 obj標準，
 *   名冊不再另列原欄（避免同一件事兩欄）。依欄名對應，欄位順序或名稱略有異動都讀得到。
 *   多個備註欄合併；需要坐椅子的值統一成「是」或原值。
 * 參數：arr列 {Object[]}（會直接修改：加 obj標準、刪 obj帶入 對應的欄）；arr帶入 {Object[]} [ { str欄名, int欄 } ]
 * 傳回：{Object[]} 剩下的帶入欄
 * ============================================================================
 */
function 抽出標準欄位_(arr列, arr帶入) {
  const arr對應 = (arr帶入 || []).map(function (o) { return { str欄名: o.str欄名, str標準: 比對標準欄位_(o.str欄名) }; });
  arr列.forEach(function (o) {
    o.obj標準 = o.obj標準 || {};
    const arr備註 = [];
    arr對應.forEach(function (x) {
      if (!x.str標準) return;
      const str值 = String((o.obj帶入 || {})[x.str欄名] || '').trim();
      delete o.obj帶入[x.str欄名];
      if (str值 === '') return;
      if (x.str標準 === '備註') { arr備註.push(str值); return; }
      if (x.str標準 === '需要坐椅子') { o.obj標準['需要坐椅子'] = 正規化坐椅子_(str值, o.obj標準['需要坐椅子']); return; }
      if (x.str標準 === '義工組別') { o.obj標準['義工組別'] = 合併文字清單_(o.obj標準['義工組別'], str值); return; }
      if (!o.obj標準[x.str標準]) o.obj標準[x.str標準] = str值;
    });
    if (arr備註.length > 0) o.obj標準['報名備註'] = arr備註.join('；');
  });
  return (arr帶入 || []).filter(function (o, i) { return !arr對應[i].str標準; });
}


/**
 * ============================================================================
 * 函式名稱：正規化坐椅子_（內部使用）
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：「需要坐椅子」：是、需要、要、V、✓、靠背椅、椅子… → 「是」；否、不需要、不用 → 「否」；其他照錄。
 *       已經是「是」時不會被改回（任何一個來源說要坐椅子就是要）。
 * 參數：str值 {string}；str原值 {string=}
 * 傳回：{string}
 * ============================================================================
 */
function 正規化坐椅子_(str值, str原值) {
  if (str原值 === '是') return '是';
  const s = String(str值 || '').replace(/\s/g, '');
  if (s === '') return str原值 || '';
  if (/^(否|不|無|免|N|X)/i.test(s)) return str原值 || '否';
  if (/^(是|要|需|V|Y|✓|✔|O|好)/i.test(s) || s.indexOf('椅') !== -1) return '是';
  return str原值 || s;
}


/**
 * ============================================================================
 * 函式名稱：合併文字清單_（內部使用）
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：組別這類可能多個值的欄位：以「、」合併、去重複（「梵唄」＋「照客」→「梵唄、照客」）。
 * 參數：str原值 {string}；str新值 {string}
 * 傳回：{string}
 * ============================================================================
 */
function 合併文字清單_(str原值, str新值) {
  const arr = [];
  [str原值, str新值].forEach(function (s) {
    String(s || '').split(/[、,，;；/]/).map(function (x) { return x.trim(); }).filter(Boolean)
      .forEach(function (x) { if (arr.indexOf(x) === -1) arr.push(x); });
  });
  return arr.join('、');
}


/**
 * ============================================================================
 * 函式名稱：加入名冊來源_
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：名冊列記下資料來源（不重複；依 表單報名 → 副會長回報 → 用齋登記 的順序）。
 * 參數：obj列 {Object}；str來源 {string}
 * 傳回：無
 * ============================================================================
 */
function 加入名冊來源_(obj列, str來源) {
  const arr順序 = [obj報到名冊格式.obj來源.表單, obj報到名冊格式.obj來源.回報, obj報到名冊格式.obj來源.用齋];
  const arr = (obj列.arr來源 || []).slice();
  if (arr.indexOf(str來源) === -1) arr.push(str來源);
  arr.sort(function (a, b) { return arr順序.indexOf(a) - arr順序.indexOf(b); });
  obj列.arr來源 = arr;
}


/**
 * ============================================================================
 * 函式名稱：組合名冊備註_
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：名冊「備註」欄：報名備註；提醒：…；副會長回報：…；用齋：…（以「；」分段，有才寫）。
 *   例：「福田；提醒：同名但法名不同…；副會長回報：不參加（請假）；用齋：午齋×2」
 * 參數：obj列 {Object} 名冊列（obj標準.報名備註、arr提醒、obj回報、obj用齋）
 * 傳回：{string}
 * ============================================================================
 */
function 組合名冊備註_(obj列) {
  const cfg = obj報到名冊格式.obj備註標籤;
  const arr = [];
  const str報名 = (obj列.obj標準 || {})['報名備註'];
  if (str報名) arr.push(str報名);
  if ((obj列.arr提醒 || []).length > 0) arr.push(cfg.提醒 + obj列.arr提醒.join('、'));
  const r = obj列.obj回報;
  if (r && r.str出席) arr.push(cfg.回報 + r.str出席 + (r.str出席 === '不參加' && r.str原因 ? `（${r.str原因}）` : ''));
  const u = obj列.obj用齋;
  if (u && u.str餐別) arr.push(cfg.用齋 + u.str餐別 + (Number(u.int份數) > 1 ? `×${Number(u.int份數)}` : ''));
  return arr.join('；');
}


/**
 * ============================================================================
 * 函式名稱：名冊備註取段_
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：從名冊「備註」取出某一段的內容（標籤之後的文字）：例如取「提醒：」那一段。
 * 參數：str備註 {string}；str標籤 {string} 例如「提醒：」
 * 傳回：{string}（沒有這一段傳回空字串）
 * ============================================================================
 */
function 名冊備註取段_(str備註, str標籤) {
  const arr = String(str備註 || '').split('；');
  const s = arr.filter(function (x) { return x.trim().indexOf(str標籤) === 0; })[0];
  return s ? s.trim().slice(str標籤.length).trim() : '';
}


/**
 * ============================================================================
 * 函式名稱：補上名冊性別_（內部使用）
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：性別空白的人，依學員編號從學員名冊補上（「男」「女」）。學員名冊讀不到時略過。
 * 參數：str精舍代號 {string}；arr名冊列 {Object[]}（已配發學員編號）
 * 傳回：{number} 補上的人數
 * ============================================================================
 */
function 補上名冊性別_(str精舍代號, arr名冊列) {
  const arr待補 = arr名冊列.filter(function (o) { return !(o.obj標準 || {})['性別'] && o.str學員編號; });
  if (arr待補.length === 0) return 0;
  let arr學員 = [];
  try { arr學員 = 讀取學員名冊(str精舍代號).arr學員 || []; } catch (err) { return 0; }
  const obj依編號 = {};
  arr學員.forEach(function (o) { obj依編號[正規化學員編號(o.str學員編號)] = o; });
  let int = 0;
  arr待補.forEach(function (o) {
    const x = obj依編號[正規化學員編號(o.str學員編號)];
    const str = x ? 正規化性別_(x.str性別) : '';
    if (!str) return;
    o.obj標準 = o.obj標準 || {};
    o.obj標準['性別'] = str;
    int += 1;
  });
  return int;
}


/**
 * ============================================================================
 * 函式名稱：正規化性別_（內部使用）
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：「男」「女」「男眾」「M」「F」→ 男／女；看不懂（例如「#REF!」）傳回空字串。
 * 參數：any {*}
 * 傳回：{string}
 * ============================================================================
 */
function 正規化性別_(any) {
  const s = String(any === undefined || any === null ? '' : any).replace(/\s/g, '').toUpperCase();
  if (s.indexOf('男') === 0 || s === 'M' || s === 'MALE') return '男';
  if (s.indexOf('女') === 0 || s === 'F' || s === 'FEMALE') return '女';
  return '';
}


/**
 * ============================================================================
 * 函式名稱：產生場次名冊_（內部使用）
 * 版本：v1.2.0（2026-11-06）　v1.2.0：報名登記與時段欄；v1.1.0：一次一個場次、寫入這個場次自己的分頁
 * ----------------------------------------------------------------------------
 * 用途：
 *   只處理副本本身（不碰主控台，方便測試）：
 *     讀有效資料 → 找到選定的場次 → 整理 → 配發學員編號 → 帶回自加欄位的值 → 重建這個場次的名冊分頁。
 *   場次找不到（有效資料欄名被改了）時停止，不寫入任何資料。
 * 參數：
 *   obj副本       {Spreadsheet}
 *   str精舍代號   {string}   配發學員編號用
 *   str場次名稱   {string}   要下載的場次（欄名原文）
 *   dat基準       {Date}     推算場次年份
 *   arr時段       {Object[]=} 報到時段（解析時段設定_ 的結果；不分時段時省略）
 * 傳回：{Object} {
 *   str訊息, arr明細: string[], str分頁名, str備份名,
 *   obj場次結果: { str場次, str日期, int人數, int有填筆數, int去重筆數, arr取消姓名, arr同名不同法名 },
 *   obj編號統計, int提醒人數, int帶回人數
 * }
 * ============================================================================
 */
function 產生場次名冊_(obj副本, str精舍代號, str場次名稱, dat基準, arr時段, any合併來源) {
  // 合併來源（v1.4.0）：{ fn用齋(int月, int日), fn回報(int月, int日) }；舊寫法傳一個函式＝只有用齋
  const obj來源 = typeof any合併來源 === 'function' ? { fn用齋: any合併來源 } : (any合併來源 || {});
  const cfg = obj報到名冊格式;
  const str選擇 = 取得單一場次參數_({ str場次: str場次名稱 });

  // ① 讀有效資料、找場次
  const arr全部 = 讀取有效資料全部_(obj副本);
  const obj欄位 = 找出報到名冊欄位_(arr全部[0], dat基準);
  const arr資料 = arr全部.slice(1);
  const obj場次 = obj欄位.arr場次.filter(function (o) { return o.str場次 === str選擇; })[0];
  if (!obj場次) {
    throw new 平台錯誤(obj錯誤代碼.欄位缺漏,
      `「${cfg.str來源分頁名}」找不到場次「${str選擇}」（欄名可能被改了），請重新開啟「下載場次名冊」再選一次。\n\n這次沒有產生任何名冊。`);
  }

  // ② 整理；分時段時判斷每人報了哪些時段（v1.2.0）
  const arr分時段 = arr時段 && arr時段.length >= 2 ? arr時段 : [];
  const arr時段欄名 = arr分時段.map(function (o) { return o.str名稱; });
  const obj整理 = 整理場次名冊_(arr資料, obj欄位, obj場次);
  // v1.5.0：報名表單的性別、執事、坐椅子、備註等欄移到標準欄位（依欄名對應，不依欄位位置）
  obj欄位.arr帶入 = 抽出標準欄位_(obj整理.arr列, obj欄位.arr帶入);
  const int對不到時段 = 補上名冊時段_(obj整理.arr列, arr分時段);
  const int報名人數 = obj整理.arr列.length;

  // ②-1 合併副會長回報（v1.4.0，有法名，先合併）：讀不到不中斷下載
  const obj回報 = typeof obj來源.fn回報 === 'function' ? obj來源.fn回報(obj場次.int月, obj場次.int日) : null;
  const obj回報統計 = obj回報 && obj回報.arr人員.length > 0
    ? 合併回報人員_(obj整理.arr列, obj回報.arr人員, { str場次: obj場次.str場次, dat日期: obj場次.dat日期 }, arr分時段)
    : null;

  // ②-2 合併用齋登記（v1.3.0）：讀不到登記表不中斷下載，只在結果說明
  const obj用齋 = typeof obj來源.fn用齋 === 'function' ? obj來源.fn用齋(obj場次.int月, obj場次.int日) : null;
  const obj用齋統計 = obj用齋 && obj用齋.arr人員.length > 0
    ? 合併用齋人員_(obj整理.arr列, obj用齋.arr人員, { str場次: obj場次.str場次, dat日期: obj場次.dat日期 }, arr分時段)
    : null;
  if (obj用齋統計 && obj用齋統計.int新增 > 0) 補上用齋義工法名_(str精舍代號, obj整理.arr列);
  // 有效資料的欄名和時段名稱相同時，帶入欄改名為「原_欄名」，避免蓋掉時段欄
  obj欄位.arr帶入.forEach(function (o) { if (arr時段欄名.indexOf(o.str欄名) !== -1) o.str欄名 = `原_${o.str欄名}`; });

  // ③ 學員編號（在寫入前完成；比對失敗會在這裡停止，不動到名冊）
  const arr名冊分頁 = 列出名冊分頁_(obj副本);
  let arr所有既有 = [];
  arr名冊分頁.forEach(function (o) { arr所有既有 = arr所有既有.concat(讀取名冊分頁內容_(o.obj分頁).arr列); });
  const obj編號統計 = 配發名冊學員編號_(str精舍代號, obj整理.arr列, arr所有既有);
  補上名冊性別_(str精舍代號, obj整理.arr列);     // v1.5.0：性別空白的人依學員編號從學員名冊補

  // ④ 這個場次既有的分頁：保留承辦人自加的欄位與值（上一次的時段欄不算自加，時段改了就換成新的）
  const obj既有分頁 = (arr名冊分頁.filter(function (o) { return o.str場次 === str選擇; })[0] || {}).obj分頁 || null;
  const obj既有 = 讀取名冊分頁內容_(obj既有分頁);
  const arr舊時段欄 = 讀取名冊時段標記_(obj既有分頁);
  const arr既有標題 = obj既有.arr標題.filter(function (s) { return arr舊時段欄.indexOf(s) === -1 && cfg.arr舊系統欄位.indexOf(s) === -1; });
  const arr帶入欄名 = obj欄位.arr帶入.map(function (o) { return o.str欄名; });
  const arr標題 = 組合名冊標題_(arr帶入欄名, arr既有標題, arr時段欄名);
  const arr自加欄名 = arr標題.filter(function (s) {
    return cfg.arr固定欄位.indexOf(s) === -1 && arr帶入欄名.indexOf(s) === -1 && arr時段欄名.indexOf(s) === -1;
  });
  const arr新物件 = obj整理.arr列.map(function (o) { return 轉為名冊物件_(o, arr分時段); });
  const int帶回人數 = 帶回自加欄位值_(arr新物件, obj既有.arr列, arr自加欄名);

  // ⑤ 寫入
  const str新分頁名 = 產生名冊分頁名稱_(obj場次, obj副本.getSheets().map(function (o) { return o.getName(); }));
  const obj寫入 = 寫入名冊分頁_(obj副本, obj既有分頁, str新分頁名, str選擇, arr標題, arr新物件, arr時段欄名);
  const str分頁名 = obj寫入.obj分頁.getName();

  // ⑤-1 依副會長回報自動取消參加／恢復參加（v1.4.0；失敗只提醒，名冊已寫好）
  let obj取消統計 = null;
  let str取消錯誤 = '';
  if (obj回報 && typeof 同步回報取消參加_ === 'function') {
    try { obj取消統計 = 同步回報取消參加_(obj副本, obj場次, arr新物件); } catch (err) { str取消錯誤 = String(err.message || err); }
  }

  // ⑥ 結果說明
  const arr明細 = obj欄位.arr欄位提醒.slice();
  arr明細.push(`有填 ${obj整理.int有填筆數} 筆，同一人多筆已合併 ${obj整理.int去重筆數} 筆，報名 ${int報名人數} 人`);
  if (obj回報統計) {
    arr明細.push(`合併副會長回報（「${obj回報.arr分頁名.join('」「')}」）：出席 ${obj回報統計.int出席已在 + obj回報統計.int出席新增} 人`
      + `（已報名 ${obj回報統計.int出席已在}、沒報名加入名冊 ${obj回報統計.int出席新增}）、不參加 ${obj回報統計.int不參加} 人`
      + (obj回報統計.int待確認 > 0 ? `、待確認 ${obj回報統計.int待確認} 人（黃底）` : '')
      + (obj取消統計 ? `；自動登記取消參加 ${obj取消統計.int取消} 人${obj取消統計.int恢復 > 0 ? `、恢復參加 ${obj取消統計.int恢復} 人` : ''}` : '')
      + (obj回報統計.int略過不參加 > 0 ? `；沒報名又回報不參加的 ${obj回報統計.int略過不參加} 人不加入` : '')
      + (obj回報統計.arr略過.length > 0 ? `；沒報名、待確認不加入：${obj回報統計.arr略過.slice(0, 15).join('、')}` : ''));
    if (str取消錯誤) arr明細.push(`自動登記取消參加沒有完成：${str取消錯誤}（請到報到表格「未報到」手動勾「取消參加」）`);
  } else if (obj回報 && obj回報.str說明) {
    arr明細.push(obj回報.str說明);
  }
  if (obj用齋統計) {
    const int份 = obj用齋.arr人員.reduce(function (n, o) { return n + o.int份數; }, 0);
    arr明細.push(`合併用齋登記（${obj用齋.str餐別}，「${obj用齋.arr分頁名.join('」「')}」分頁）：義工 ${obj用齋.arr人員.length} 人、便當 ${int份} 份；`
      + `已報名 ${obj用齋統計.int已在名冊} 人補上用齋，沒報名的 ${obj用齋統計.int新增} 人加入名冊`
      + (obj用齋統計.int新增 > 0 ? `（${obj用齋統計.arr新增姓名.slice(0, 20).join('、')}${obj用齋統計.int新增 > 20 ? '…' : ''}）` : ''));
  } else if (obj用齋 && obj用齋.str說明) {
    arr明細.push(obj用齋.str說明);
  } else if (obj用齋 && obj用齋.arr分頁名.length > 0) {
    arr明細.push(`用齋登記表「${obj用齋.arr分頁名.join('」「')}」分頁沒有義工姓名`);
  }
  if (obj整理.arr取消姓名.length > 0) arr明細.push(`備註提到取消：${obj整理.arr取消姓名.join('、')}`);
  if (obj整理.arr同名不同法名.length > 0) arr明細.push(`同名不同法名：${obj整理.arr同名不同法名.join('、')}`);
  if (arr分時段.length > 0) {
    // 各時段報名人數（v1.2.0）
    const str人數 = arr分時段.map(function (t, i) {
      return `${t.str名稱} ${obj整理.arr列.filter(function (o) { return (o.arr報名序 || []).indexOf(i) !== -1; }).length} 人`;
    }).join('、');
    arr明細.push(`各時段報名：${str人數}`);
    if (int對不到時段 > 0) arr明細.push(`${int對不到時段} 人的報名內容對不到報到時段（黃底），請確認後在時段欄自行打 ✓，或檢查報到時段設定`);
  }
  arr明細.push(`學員編號：沿用名冊已有 ${obj編號統計.int沿用} 人、學員名冊比對到 ${obj編號統計.int名冊符合} 人、新配發臨時編號 ${obj編號統計.int新臨時編號} 人`
    + (obj編號統計.int待填 > 0 ? `、${obj編號統計.int待填} 人學員名冊有多位同名同法名（學員編號空白，請填寫）` : ''));
  const int提醒人數 = obj整理.arr列.filter(function (o) { return o.arr提醒.length > 0; }).length;
  if (int提醒人數 > 0) arr明細.push(`${int提醒人數} 人有提醒（黃底），請看「提醒」欄；取消的人請直接刪除該列（重新下載這個場次時會再出現）`);
  if (arr自加欄名.length > 0) arr明細.push(`您自己加的欄位（${arr自加欄名.join('、')}）已保留，${int帶回人數} 人的值已依姓名帶回`);
  if (obj寫入.str備份名) arr明細.push(`上一次的名冊已備份為「${obj寫入.str備份名}」（隱藏分頁，這個場次保留最近 ${cfg.int保留備份數} 份）`);

  return {
    str訊息: `已下載 ${obj場次.int月}/${obj場次.int日}「${str選擇}」的名冊：${obj整理.arr列.length} 人`
      + ((obj回報統計 && obj回報統計.int出席新增 > 0) || (obj用齋統計 && obj用齋統計.int新增 > 0)
        ? `（含${[obj回報統計 && obj回報統計.int出席新增 > 0 ? `副會長回報 ${obj回報統計.int出席新增} 人` : '', obj用齋統計 && obj用齋統計.int新增 > 0 ? `用齋義工 ${obj用齋統計.int新增} 人` : ''].filter(Boolean).join('、')}）` : '')
      + `（「${str分頁名}」分頁）。`,
    arr明細: arr明細,
    str分頁名: str分頁名,
    str備份名: obj寫入.str備份名,
    obj場次結果: {
      str場次: str選擇, str日期: `${obj場次.int月}/${obj場次.int日}`, int人數: obj整理.arr列.length,
      int有填筆數: obj整理.int有填筆數, int去重筆數: obj整理.int去重筆數,
      arr取消姓名: obj整理.arr取消姓名, arr同名不同法名: obj整理.arr同名不同法名
    },
    obj編號統計: obj編號統計,
    int提醒人數: int提醒人數,
    int帶回人數: int帶回人數,
    int對不到時段: int對不到時段
  };
}


