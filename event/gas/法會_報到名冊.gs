/**
 * ============================================================================
 * 函式名稱：檢查是對內活動_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：法會報到只限對內活動。
 * 參數：obj活動值 {Object}
 * 傳回：無
 * ============================================================================
 */
function 檢查是對內活動_(obj活動值) {
  if (String(obj活動值['活動類型']).trim() !== '對內') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤,
      `「${obj活動值['活動名稱']}」是對外活動，報到請用大車點名系統，不需要下載場次名冊。`);
  }
}


/**
 * ============================================================================
 * 函式名稱：處理下載場次名冊_（內部使用）
 * 版本：v1.2.0（2026-11-06）　v1.2.0：可一併儲存報到時段、依時段產生時段欄；v1.1.0：一次一個場次
 * ----------------------------------------------------------------------------
 * 用途：下載場次名冊的共用處理（網頁與副本選單）：
 *       （有傳報到時段時先檢查並儲存）→ 活動作業鎖 → 產生 → 日誌。
 *       報到時段格式有誤時在這裡停止，名冊不會變動。
 * 參數：
 *   obj身分       {Object}      工作階段或副本身分
 *   obj主控台     {Spreadsheet}
 *   obj活動值     {Object}
 *   str場次名稱   {string}
 *   obj副本       {Spreadsheet} 選填（副本選單已開啟時傳入）
 *   any報到時段   {*}           選填；有傳（含空字串）時先儲存，undefined／null＝沿用目前設定
 * 傳回：{Object} 產生場次名冊_ 的結果（另加 str報到時段）
 * ============================================================================
 */
function 處理下載場次名冊_(obj身分, obj主控台, obj活動值, str場次名稱, obj副本, any報到時段) {
  const str活動ID = String(obj活動值['活動ID']).trim();
  // ① 報到時段：第一次下載時，承辦人在視窗中確認系統建議的時段，隨下載一起送來
  if (any報到時段 !== undefined && any報到時段 !== null) 儲存活動報到時段_(obj身分, obj主控台, obj活動值, any報到時段);
  const arr時段 = 取得活動時段_(obj活動值);

  // ② 產生
  const obj結果 = 以活動作業鎖執行_(obj身分.str精舍代號, str活動ID, '下載場次名冊', function () {
    return 產生場次名冊_(obj副本 || 開啟活動副本_(obj活動值), obj身分.str精舍代號, str場次名稱, 取得場次基準日_(obj活動值), arr時段,
      {   // v1.4.0：合併來源（副會長回報、用齋登記）
        fn回報: function (int月, int日) { return 取得場次回報人員_(obj主控台, obj活動值, int月, int日); },
        fn用齋: function (int月, int日) { return 取得場次用齋人員_(obj主控台, obj活動值, int月, int日); }
      });
  });
  obj結果.str報到時段 = 格式化時段設定_(arr時段);
  寫入操作日誌(obj身分, '下載場次名冊', `${str活動ID}：${obj結果.str訊息}`);
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：取得對內活動_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：網頁動作共用的前置：找活動、權限 event.整理資料、必須是對內活動、收件中或報到中。
 * 參數：obj工作階段 {Object}；str活動ID {string}；str作業名稱 {string}
 * 傳回：{Object} { obj主控台, obj活動值 }
 * ============================================================================
 */
function 取得對內活動_(obj工作階段, str活動ID, str作業名稱) {
  const obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);
  const obj活動值 = 取得法會活動_(obj主控台, str活動ID).obj值;
  檢查活動權限_(obj工作階段, obj活動值, obj法會權限.整理資料, str作業名稱);
  檢查是對內活動_(obj活動值);
  檢查活動狀態_(obj活動值, obj報到名冊格式.arr可下載狀態, str作業名稱);
  return { obj主控台: obj主控台, obj活動值: obj活動值 };
}


/**
 * ============================================================================
 * 函式名稱：列出法會場次
 * 版本：v1.2.0（2026-11-07）　v1.2.0：每個場次附上 obj取消（場次取消，法會_報到）；v1.1.0：附上報到時段（目前設定與建議）
 * ----------------------------------------------------------------------------
 * 用途：action「event.列出場次」（網頁）。列出場次讓承辦人選擇。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID }
 * 傳回：{Object} { bool成功, arr場次, arr欄位提醒, arr建議時段, obj時段, str活動名稱 }
 * ============================================================================
 */
function 列出法會場次(obj工作階段, obj參數) {
  檢查必要參數(obj參數, ['str活動ID'], '列出場次');
  const obj = 取得對內活動_(obj工作階段, obj參數.str活動ID, '下載場次名冊');
  const obj副本 = 開啟活動副本_(obj.obj活動值);
  const obj列出 = 列出報到場次_(obj副本, 取得場次基準日_(obj.obj活動值));
  // 場次取消（v1.2.0）：讀報到紀錄一次；報到紀錄分頁還沒建立時都是 null
  const arr紀錄 = 讀取報到紀錄_(obj副本, []);
  obj列出.arr場次.forEach(function (o) {
    const obj取消 = 計算報到狀態_(arr紀錄, o.str場次).obj場次取消;
    o.obj取消 = obj取消 ? Object.assign({ str說明: 組合場次取消說明_(o.str場次, obj取消) }, obj取消) : null;
  });
  // 合併來源設定（v1.3.0 用齋；v1.4.0 副會長回報；v1.6.0 抽出共用）
  obj列出.obj用齋 = 整理合併來源資訊_(obj.obj主控台, obj.obj活動值);
  return Object.assign({ bool成功: true, str活動名稱: String(obj.obj活動值['活動名稱']).trim() }, obj列出,
    { obj時段: 整理時段資訊_(obj.obj活動值, obj列出.arr建議時段) });
}


/**
 * ============================================================================
 * 函式名稱：下載法會場次名冊
 * 版本：v1.2.0（2026-11-06）　v1.2.0：可一併儲存報到時段（str報到時段）；v1.1.0：一次一個場次（str場次）
 * ----------------------------------------------------------------------------
 * 用途：action「event.下載場次名冊」（網頁）。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID, str場次, str報到時段（選填） }
 * 傳回：{Object} { bool成功, …產生場次名冊_ 的結果 }
 * ============================================================================
 */
function 下載法會場次名冊(obj工作階段, obj參數) {
  檢查必要參數(obj參數, ['str活動ID'], '下載場次名冊');
  const str場次 = 取得單一場次參數_(obj參數);
  const obj = 取得對內活動_(obj工作階段, obj參數.str活動ID, '下載場次名冊');
  return Object.assign({ bool成功: true },
    處理下載場次名冊_(obj工作階段, obj.obj主控台, obj.obj活動值, str場次, null, obj參數.str報到時段));
}


/**
 * ============================================================================
 * 函式名稱：副本選單_列出場次
 * 版本：v1.2.0（2026-11-08）　v1.2.0：附上合併設定 obj用齋（視窗可指定合併）；v1.1.0：附上報到時段（目前設定與建議），選擇視窗讓承辦人確認
 * ----------------------------------------------------------------------------
 * 用途：action「event.副本列出場次」。副本選單「法會報到 → 下載場次名冊」先呼叫這裡，
 *       顯示選擇視窗。限對內活動、收件中或報到中、權限 event.整理資料。
 * 參數：
 *   obj工作階段   {null}   不需要網頁登入
 *   obj參數       {Object} { str存取權杖, str副本ID }
 * 傳回：{Object} { arr場次, arr欄位提醒, arr建議時段, obj時段, obj用齋, str活動名稱 }
 * ============================================================================
 */
function 副本選單_列出場次(obj工作階段, obj參數) {
  const obj = 開啟副本情境_(obj參數, obj法會權限.整理資料, '下載場次名冊', obj報到名冊格式.arr可下載狀態);
  檢查是對內活動_(obj.obj活動值);
  const obj列出 = 列出報到場次_(obj.obj副本, 取得場次基準日_(obj.obj活動值));
  obj列出.obj用齋 = 整理合併來源資訊_(obj.obj主控台, obj.obj活動值);     // v1.6.0：下載視窗可指定合併
  return Object.assign({ str活動名稱: String(obj.obj活動值['活動名稱']).trim() }, obj列出,
    { obj時段: 整理時段資訊_(obj.obj活動值, obj列出.arr建議時段) });
}


/**
 * ============================================================================
 * 函式名稱：副本選單_下載場次名冊
 * 版本：v1.3.0（2026-11-08）　v1.3.0：可一併指定合併設定；v1.2.0：可一併儲存報到時段（str報到時段）；v1.1.0：一次一個場次（str場次）
 * ----------------------------------------------------------------------------
 * 用途：action「event.副本下載場次名冊」。依選擇的場次產生（或重建）該場次的名冊分頁。
 * 參數：
 *   obj工作階段   {null}   不需要網頁登入
 *   obj參數       {Object} { str存取權杖, str副本ID, str場次, str報到時段（選填）,
 *                            str用齋（選填：午齋／藥石／不合併）, str副會長回報（選填：合併／不合併） }（v1.6.0）
 * 傳回：{Object} 產生場次名冊_ 的結果
 * ============================================================================
 */
function 副本選單_下載場次名冊(obj工作階段, obj參數) {
  const str場次 = 取得單一場次參數_(obj參數);
  const obj = 開啟副本情境_(obj參數, obj法會權限.整理資料, '下載場次名冊', obj報到名冊格式.arr可下載狀態);
  檢查是對內活動_(obj.obj活動值);
  // v1.6.0：視窗中選的合併設定先存到這場活動（沒改就不寫），下載就照新設定合併
  const obj合併 = 儲存活動合併來源_(obj.obj身分, obj.obj主控台, obj.obj活動值, obj參數.str用齋, obj參數.str副會長回報);
  const obj結果 = 處理下載場次名冊_(obj.obj身分, obj.obj主控台, obj.obj活動值, str場次, obj.obj副本, obj參數.str報到時段);
  if (obj合併.bool有異動) (obj結果.arr明細 = obj結果.arr明細 || []).unshift(`這場活動的合併設定已更新：${obj合併.str說明}`);
  return obj結果;
}
