/**
 * ============================================================================
 * 函式名稱：設定用齋登記表
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.設定用齋登記表」（限精舍管理員）。貼上登記表網址（或 ID），系統試著開啟並判讀，
 *   成功才儲存，並回報讀到哪些日期；傳空字串＝不使用登記表。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str網址 }
 * 傳回：{Object} { bool成功, str訊息, arr明細 }
 * ============================================================================
 */
function 設定用齋登記表(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.管理活動, '設定用齋登記表');
  const str原文 = String((obj參數 && obj參數.str網址) || '').trim();
  const str試算表ID = 解析試算表ID_(str原文);
  if (str原文 !== '' && !str試算表ID) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '看不出試算表的網址，請從瀏覽器網址列整段複製（https://docs.google.com/spreadsheets/d/…）。');
  }
  const obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);

  // 先試著開啟、判讀（打不開就不儲存）
  const arr明細 = [];
  let str名稱 = '';
  if (str試算表ID) {
    let obj表;
    try { obj表 = SpreadsheetApp.openById(str試算表ID); } catch (err) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, '登記表打不開：請把登記表分享給部署平台的帳號（至少「檢視者」）後再試。');
    }
    str名稱 = obj表.getName();
    const arr分頁 = obj表.getSheets().map(function (sh) {
      const int列 = sh.getLastRow();
      const int欄 = sh.getLastColumn();
      return 解析用齋分頁_(sh.getName(), int列 > 0 && int欄 > 0 ? sh.getRange(1, 1, int列, int欄).getDisplayValues() : []);
    });
    const arr有日期 = arr分頁.filter(function (o) { return o.int月 && o.str餐別; });
    arr明細.push(`共 ${arr分頁.length} 頁，看得出日期與餐別的 ${arr有日期.length} 頁：`
      + arr有日期.map(function (o) { return `${o.int月}/${o.int日}${o.str餐別} ${o.arr人員.length} 人`; }).join('、'));
    const arr略過 = arr分頁.filter(function (o) { return !(o.int月 && o.str餐別); }).map(function (o) { return o.str分頁名; });
    if (arr略過.length > 0) arr明細.push(`看不出日期或餐別、合併時會略過的頁：${arr略過.join('、')}`);
  }

  儲存合併來源設定_(obj工作階段, obj主控台, obj用齋格式.str設定項目, str試算表ID);
  寫入操作日誌(obj工作階段, '設定用齋登記表', str試算表ID ? `${str名稱}（${str試算表ID}）` : '（不使用）');
  return {
    bool成功: true,
    str訊息: str試算表ID ? `已設定用齋登記表「${str名稱}」。下載場次名冊時會合併日期相同的用齋義工。` : '已取消用齋登記表，下載場次名冊時不再合併用齋義工。',
    arr明細: arr明細
  };
}


/**
 * ============================================================================
 * 函式名稱：儲存合併來源設定_（內部使用）
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：把合併來源的試算表 ID 寫進主控台「模組設定」（用齋登記表、副會長回報表共用）。
 * 參數：obj工作階段 {Object}；obj主控台 {Spreadsheet}；str項目 {string}；str試算表ID {string}（空＝不使用）
 * 傳回：無
 * ============================================================================
 */
function 儲存合併來源設定_(obj工作階段, obj主控台, str項目, str試算表ID) {
  執行並鎖定(function () {
    const obj表 = 取得法會分頁_(obj主控台, '模組設定');
    const obj現值 = 讀取模組設定值_(obj主控台, str項目, '');
    const obj新值 = { '項目': str項目, '值': str試算表ID, '更新者': obj工作階段.str帳號, '更新時間': new Date() };
    if (obj現值.int列號 > 0) 更新資料列(obj表.obj分頁, obj現值.int列號, obj新值);
    else 新增資料列(obj表.obj分頁, obj新值);
  }, `設定${str項目}`);
}


/**
 * ============================================================================
 * 函式名稱：設定活動合併用齋
 * 版本：v1.1.0（2026-11-08）　v1.1.0：一併設定「合併副會長回報」
 * ----------------------------------------------------------------------------
 * 用途：action「event.設定合併用齋」。這場活動合併「午齋」「藥石」或「不合併」，以及是否合併副會長回報（權限 event.整理資料）。
 *       改了之後要重新下載場次名冊才會套用。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID, str用齋, str副會長回報（選填：合併／不合併） }
 * 傳回：{Object} { bool成功, str訊息, str用齋, str副會長回報 }
 * ============================================================================
 */
function 設定活動合併用齋(obj工作階段, obj參數) {
  檢查必要參數(obj參數, ['str活動ID', 'str用齋'], '設定合併來源');
  const str用齋 = String(obj參數.str用齋).trim();
  if (obj用齋格式.arr餐別.indexOf(str用齋) === -1) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '合併用齋請選「午齋」「藥石」或「不合併」。');
  }
  // v1.1.0：一併設定合併副會長回報（選填；法會_副會長回報）
  const bool有回報 = obj參數.str副會長回報 !== undefined && obj參數.str副會長回報 !== null && String(obj參數.str副會長回報).trim() !== '';
  const str回報 = bool有回報 ? String(obj參數.str副會長回報).trim() : '';
  if (bool有回報 && obj回報格式.arr設定值.indexOf(str回報) === -1) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '合併副會長回報請選「合併」或「不合併」。');
  }
  const obj = 取得對內活動_(obj工作階段, String(obj參數.str活動ID).trim(), '設定合併來源');
  const obj更新 = { [obj用齋格式.str活動欄]: str用齋 };
  if (bool有回報) obj更新[obj回報格式.str活動欄] = str回報;
  更新法會活動_(obj.obj主控台, obj.obj活動值['活動ID'], obj更新);
  寫入操作日誌(obj工作階段, '設定合併來源', `${obj.obj活動值['活動ID']} ${obj.obj活動值['活動名稱']}：用齋 ${str用齋}${bool有回報 ? `、副會長回報 ${str回報}` : ''}`);
  const arr = [str用齋 === '不合併' ? '不合併用齋義工' : `合併同一天「${str用齋}」的用齋義工`];
  if (bool有回報) arr.push(str回報 === '合併' ? '合併同一天的副會長回報' : '不合併副會長回報');
  return {
    bool成功: true, str用齋: str用齋, str副會長回報: str回報,
    str訊息: `這場活動下載名冊時：${arr.join('、')}。已下載的場次請重新下載名冊才會套用。`
  };
}
