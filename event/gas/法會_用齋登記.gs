// ============================================================================
// 檔案名稱：法會_用齋登記.gs
// 所屬模組：法會活動（event）
// 所屬層級：模組／服務層＋控制層
// 檔案版本：v1.1.0（2026-11-08）
//   v1.1.0：儲存合併來源設定_ 抽出共用；設定合併用齋一併設定合併副會長回報（法會_副會長回報）
// 用途說明：
//   精舍的「用齋登記表」（Google 試算表，例如「普泉用齋登記表」）登記義工預訂的午齋、藥石便當。
//   下載對內活動的場次名冊時，把「日期相同、餐別相同」的用齋登記義工合併進名冊（決策 AW～AZ）：
//     · 已在名冊的人：補上「用齋」「義工組別」「便當份數」
//     · 沒有報名的義工：新增一列，算「已報名」（報名內容「義工（大寮）」；分時段的活動標全部時段）
//   登記表是自由格式（每頁一天一餐、組別名稱下方填姓名），由本檔判讀：
//     ① 每頁第一列是標題，例如「11/9(一)午齋」「11/7（六)共修法會」：
//        讀出日期（月/日）；餐別看標題的「午齋／藥石」，標題沒寫看分頁名稱（例如「共修/六午齋」）
//     ② 組別名稱（照客、大寮、行堂、環保、梵唄、心燈…，以及結尾是「組」的名稱、日初夜高等班別）
//        下方或右側 2 欄內的姓名屬於這一組（取最接近的上方組別）
//     ③ 姓名＝2～5 個中文字，可帶「(苾)」等註記、「*2」＝2 份便當；
//        序號、✔️、「水電行*不用」「禪修班( )人」「已登記( )份」等略過
//     ④ 同一頁同一人只算一次（取第一次出現的組別、最大份數）
//   設定：
//     · 精舍：主控台「模組設定」項目「用齋登記表」＝試算表 ID（精舍管理員在法會活動網頁設定）
//     · 活動：活動清單「合併用齋」欄＝午齋／藥石／不合併（空白＝午齋；承辦人在「四、法會報到」設定）
//   ※ 登記表要讓部署網頁應用程式的帳號（平台擁有者）可以檢視，否則讀取失敗（名冊照樣下載，結果會提醒）。
//   ※ 本檔頂層常數只在本檔使用（依檔名載入順序，其他檔案不可在頂層引用）。
//
// 相依檔案：
//   平台核心（核心_錯誤、核心_工具 正規化人名、核心_日誌）
//   法會_模組定義（obj法會權限、活動清單、模組設定）、法會_活動管理（讀取模組設定值_）
//   法會_報到名冊（取得對內活動_）
// ============================================================================

const obj用齋格式 = Object.freeze({
  str設定項目: '用齋登記表',                  // 主控台「模組設定」的項目名稱（值＝試算表 ID）
  str活動欄: '合併用齋',                      // 活動清單的欄位
  arr餐別: Object.freeze(['午齋', '藥石', '不合併']),
  str預設餐別: '午齋',                        // 活動沒有設定時（決策 AY：預設合併）
  // 常見組別（其他結尾是「組」的名稱也算組別）
  arr組別: Object.freeze(['照客', '大寮', '行堂', '環保', '其他', '機動', '梵唄', '心燈', '小吉祥', '司儀', 'PPT', '庶務',
    '書記', '資料', '視訊音響', '排供飯菜', '兒童班', '禪修班', '香燈', '知客', '交通', '總務', '醫護', '攝影', '音響', '佈置', '水電']),
  re班別: /^[日夜](初|中|高|研)$/,             // 普泉日午齋的班別欄：夜研、日初…
  re組別尾: /^[一-鿿A-Za-z]{1,4}組$/,
  // 姓名：2～5 個中文字，可帶 (苾) 之類的註記，*2／×2＝份數
  re姓名: /^([一-鿿]{2,5})\s*(?:[（(]([^)）]{1,6})[)）])?\s*(?:[*＊×xX]\s*(\d{1,2}))?$/,
  // 看起來像姓名、但不是人的字樣
  arr排除字: Object.freeze(['水電行', '水電', '已登記', '領取', '不用', '禪修班', '午齋', '藥石', '便當', '姓名', '班別', '車次', '實打',
    '共修', '法會', '請打', '人多', '回山']),
  re日期: /(\d{1,2})\s*[/／]\s*(\d{1,2})/,
  int組別欄距: 2                              // 姓名在組別名稱的同欄或右側 2 欄內
});


// ============================================================================
// 甲、判讀（純計算，不碰檔案）
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：是用齋組別_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：判斷一格是不是組別名稱（括號內的註記不算，例如「大寮(B)」＝大寮）。
 * 參數：str格 {string}
 * 傳回：{string} 組別名稱；不是組別傳回空字串
 * ============================================================================
 */
function 是用齋組別_(str格) {
  const cfg = obj用齋格式;
  const str = String(str格 || '').replace(/[（(][^)）]*[)）]/g, '').replace(/\s+/g, '');
  if (str === '') return '';
  if (cfg.arr組別.indexOf(str) !== -1 || cfg.re班別.test(str) || cfg.re組別尾.test(str)) return str;
  return '';
}


/**
 * ============================================================================
 * 函式名稱：解析用齋姓名格_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：一格是不是義工姓名；是的話拆出姓名、註記與份數（「李戎俊*2」→ 李戎俊、2 份）。
 * 參數：str格 {string}
 * 傳回：{Object|null} { str姓名, str註記, int份數 }；不是姓名傳回 null
 * ============================================================================
 */
function 解析用齋姓名格_(str格) {
  const cfg = obj用齋格式;
  const str = String(str格 || '').trim();
  if (str === '' || 是用齋組別_(str)) return null;
  if (cfg.arr排除字.some(function (s) { return str.indexOf(s) !== -1; })) return null;
  const m = str.match(cfg.re姓名);
  if (!m) return null;
  const int份數 = m[3] ? Number(m[3]) : 1;
  return { str姓名: m[1], str註記: m[2] || '', int份數: int份數 >= 1 ? int份數 : 1 };
}


/**
 * ============================================================================
 * 函式名稱：解析用齋分頁_
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：判讀登記表的一頁：日期、餐別、每位義工的組別與便當份數（規則見檔頭）。
 * 參數：
 *   str分頁名  {string}
 *   arr值      {Array[]} 這一頁的顯示文字（getDisplayValues）
 * 傳回：{Object} {
 *   str分頁名, str標題, int月, int日（看不出日期時為 0）, str餐別（'午齋'｜'藥石'｜''）,
 *   arr人員: [ { str姓名, str組別, int份數, str註記 } ]
 * }
 * ============================================================================
 */
function 解析用齋分頁_(str分頁名, arr值) {
  const cfg = obj用齋格式;
  const arr列 = (arr值 || []).map(function (r) { return (r || []).map(function (v) { return String(v === null || v === undefined ? '' : v).trim(); }); });

  // ① 標題：第一個有字的列
  let int標題列 = arr列.findIndex(function (r) { return r.some(function (v) { return v !== ''; }); });
  if (int標題列 < 0) int標題列 = 0;
  const str標題 = (arr列[int標題列] || []).filter(function (v) { return v !== ''; }).join(' ').replace(/\s+/g, ' ');
  const m日 = str標題.match(cfg.re日期);
  const int月 = m日 ? Number(m日[1]) : 0;
  const int日 = m日 ? Number(m日[2]) : 0;
  const fn餐別 = function (s) { return s.indexOf('藥石') !== -1 ? '藥石' : (s.indexOf('午齋') !== -1 ? '午齋' : ''); };
  const str餐別 = fn餐別(str標題) || fn餐別(String(str分頁名 || ''));
  const bool日期有效 = int月 >= 1 && int月 <= 12 && int日 >= 1 && int日 <= 31;

  // ② 組別名稱的位置
  const arr組別 = [];
  arr列.forEach(function (r, i) {
    if (i <= int標題列) return;
    r.forEach(function (v, c) { const str組 = 是用齋組別_(v); if (str組) arr組別.push({ int列: i, int欄: c, str組別: str組 }); });
  });

  // ③ 姓名：歸到最接近的上方組別（同欄或左側 2 欄內；同一列時組別要在左邊）
  const arr人員 = [];
  const obj索引 = {};
  arr列.forEach(function (r, i) {
    if (i <= int標題列) return;
    r.forEach(function (v, c) {
      const obj姓名 = 解析用齋姓名格_(v);
      if (!obj姓名) return;
      let obj組 = null;
      arr組別.forEach(function (g) {
        if (g.int欄 > c || g.int欄 < c - cfg.int組別欄距) return;
        if (g.int列 > i || (g.int列 === i && g.int欄 >= c)) return;
        if (!obj組 || g.int列 > obj組.int列 || (g.int列 === obj組.int列 && g.int欄 > obj組.int欄)) obj組 = g;
      });
      const str姓名 = 正規化人名(obj姓名.str姓名);
      if (str姓名 in obj索引) {
        // 同一頁同一人只算一次：份數取大、組別沿用第一次（第一次沒有組別才補上）
        const o = arr人員[obj索引[str姓名]];
        o.int份數 = Math.max(o.int份數, obj姓名.int份數);
        if (!o.str組別 && obj組) o.str組別 = obj組.str組別;
        return;
      }
      obj索引[str姓名] = arr人員.length;
      arr人員.push({ str姓名: str姓名, str組別: obj組 ? obj組.str組別 : '', int份數: obj姓名.int份數, str註記: obj姓名.str註記 });
    });
  });

  return { str分頁名: String(str分頁名 || ''), str標題: str標題, int月: bool日期有效 ? int月 : 0, int日: bool日期有效 ? int日 : 0, str餐別: str餐別, arr人員: arr人員 };
}


/**
 * ============================================================================
 * 函式名稱：篩選用齋人員_
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：從各頁的判讀結果，找出「月日相同、餐別相同」的頁，合併成一份義工名單（同名只算一次）。
 * 參數：arr分頁 {Object[]} 解析用齋分頁_ 的結果；int月 {number}；int日 {number}；str餐別 {string}
 * 傳回：{Object} { arr人員: [ { str姓名, str組別, int份數, str餐別, str分頁名 } ], arr分頁名 }
 * ============================================================================
 */
function 篩選用齋人員_(arr分頁, int月, int日, str餐別) {
  const arr符合 = (arr分頁 || []).filter(function (o) { return o.int月 === int月 && o.int日 === int日 && o.str餐別 === str餐別; });
  const arr人員 = [];
  const obj索引 = {};
  arr符合.forEach(function (p) {
    p.arr人員.forEach(function (o) {
      if (o.str姓名 in obj索引) {
        const x = arr人員[obj索引[o.str姓名]];
        x.int份數 = Math.max(x.int份數, o.int份數);
        if (!x.str組別) x.str組別 = o.str組別;
        return;
      }
      obj索引[o.str姓名] = arr人員.length;
      arr人員.push({ str姓名: o.str姓名, str組別: o.str組別, int份數: o.int份數, str餐別: str餐別, str分頁名: p.str分頁名 });
    });
  });
  return { arr人員: arr人員, arr分頁名: arr符合.map(function (o) { return o.str分頁名; }) };
}


/**
 * ============================================================================
 * 函式名稱：組合用齋說明_
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：報到表與表格備註欄的簡短字樣：「大寮・午齋×2」（份數 1 不寫）。
 * 參數：str組別 {string}；str餐別 {string}；any份數 {*}
 * 傳回：{string}（沒有用齋時空字串）
 * ============================================================================
 */
function 組合用齋說明_(str組別, str餐別, any份數) {
  const str餐 = String(str餐別 || '').trim();
  if (str餐 === '') return '';
  const int份數 = Number(any份數) || 1;
  return [String(str組別 || '').trim(), str餐 + (int份數 > 1 ? `×${int份數}` : '')].filter(Boolean).join('・');
}


/**
 * ============================================================================
 * 函式名稱：合併用齋人員_
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把義工名單合併進場次名冊列（整理場次名冊_ 的 arr列，會直接修改）：
 *     · 名冊已有同名的人 → obj用齋 補上組別、餐別、份數
 *     · 沒有 → 新增一列（算已報名）：報名內容「義工（組別）」、來源列「用齋登記」；
 *       分時段的活動標全部時段
 *   比對同一人只比姓名（與報名相同，決策 E）。
 * 參數：
 *   arr名冊列  {Object[]}
 *   arr用齋    {Object[]} 篩選用齋人員_ 的 arr人員
 *   obj場次    {Object}   { str場次, dat日期 }
 *   arr時段    {Object[]} 分時段時的時段（不分時段為空陣列）
 * 傳回：{Object} { int已在名冊, int新增, arr新增姓名 }
 * ============================================================================
 */
function 合併用齋人員_(arr名冊列, arr用齋, obj場次, arr時段) {
  const obj名冊 = {};
  arr名冊列.forEach(function (o, i) { obj名冊[正規化人名(o.str姓名)] = i; });
  const arr全部時段 = (arr時段 && arr時段.length >= 2) ? arr時段.map(function (t, i) { return i; }) : [];
  const obj統計 = { int已在名冊: 0, int新增: 0, arr新增姓名: [] };

  (arr用齋 || []).forEach(function (u) {
    const obj用齋 = { str餐別: u.str餐別, str組別: u.str組別, int份數: u.int份數 };
    if (u.str姓名 in obj名冊) {
      arr名冊列[obj名冊[u.str姓名]].obj用齋 = obj用齋;
      obj統計.int已在名冊 += 1;
      return;
    }
    arr名冊列.push({
      str場次: obj場次.str場次,
      dat場次日期: obj場次.dat日期,
      str姓名: u.str姓名,
      str法名: '',
      str報名內容: `義工（${u.str組別 || '用齋登記'}）`,
      int來源列: '用齋登記',
      any報名時間: '',
      arr提醒: [],
      obj帶入: {},
      arr報名序: arr全部時段.slice(),
      obj用齋: obj用齋,
      bool用齋新增: true
    });
    obj名冊[u.str姓名] = arr名冊列.length - 1;
    obj統計.int新增 += 1;
    obj統計.arr新增姓名.push(u.str姓名);
  });
  return obj統計;
}


/**
 * ============================================================================
 * 函式名稱：解析試算表ID_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：從試算表網址或 ID 取出 ID（https://docs.google.com/spreadsheets/d/<ID>/edit…）。
 * 參數：str {string}
 * 傳回：{string}（看不出 ID 時傳回空字串）
 * ============================================================================
 */
function 解析試算表ID_(str) {
  const s = String(str || '').trim();
  const m = s.match(/\/spreadsheets\/d\/([A-Za-z0-9_-]{20,})/);
  if (m) return m[1];
  return /^[A-Za-z0-9_-]{20,}$/.test(s) ? s : '';
}


/**
 * ============================================================================
 * 函式名稱：取得活動用齋餐別_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：活動的「合併用齋」設定：午齋／藥石／不合併；空白或看不懂時用預設（午齋）。
 * 參數：obj活動值 {Object}
 * 傳回：{string}
 * ============================================================================
 */
function 取得活動用齋餐別_(obj活動值) {
  const str = String((obj活動值 || {})[obj用齋格式.str活動欄] || '').trim();
  return obj用齋格式.arr餐別.indexOf(str) !== -1 ? str : obj用齋格式.str預設餐別;
}


// ============================================================================
// 乙、讀取登記表（碰檔案）
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：讀取用齋登記表_（內部使用）
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：開啟精舍設定的用齋登記表，判讀每一頁。
 * 參數：obj主控台 {Spreadsheet}
 * 傳回：{Object} { str試算表ID, str名稱, arr分頁 }；沒有設定時 str試算表ID 為空、arr分頁 為空陣列
 * 例外：設定了但打不開 → 平台錯誤（白話說明要分享給誰）
 * ============================================================================
 */
function 讀取用齋登記表_(obj主控台) {
  const str試算表ID = 解析試算表ID_(讀取模組設定值_(obj主控台, obj用齋格式.str設定項目, '').str值);
  if (!str試算表ID) return { str試算表ID: '', str名稱: '', arr分頁: [] };
  let obj表;
  try {
    obj表 = SpreadsheetApp.openById(str試算表ID);
  } catch (err) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤,
      '用齋登記表打不開：請確認連結正確，並把登記表分享給部署平台的帳號（至少「檢視者」）。');
  }
  const arr分頁 = obj表.getSheets().map(function (sh) {
    const int列 = sh.getLastRow();
    const int欄 = sh.getLastColumn();
    const arr值 = int列 > 0 && int欄 > 0 ? sh.getRange(1, 1, int列, int欄).getDisplayValues() : [];
    return 解析用齋分頁_(sh.getName(), arr值);
  });
  return { str試算表ID: str試算表ID, str名稱: obj表.getName(), arr分頁: arr分頁 };
}


/**
 * ============================================================================
 * 函式名稱：取得場次用齋人員_
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：下載場次名冊時使用：依活動設定的餐別，找出這個場次日期的用齋義工。
 *       不合併、沒有設定登記表、登記表打不開都不會中斷下載，只回傳說明。
 * 參數：obj主控台 {Spreadsheet}；obj活動值 {Object}；int月 {number}；int日 {number}
 * 傳回：{Object} { str餐別, arr人員, arr分頁名, str說明（結果視窗的一行；不合併時空字串）, bool失敗 }
 * ============================================================================
 */
function 取得場次用齋人員_(obj主控台, obj活動值, int月, int日) {
  const str餐別 = 取得活動用齋餐別_(obj活動值);
  const obj空 = { str餐別: str餐別, arr人員: [], arr分頁名: [], str說明: '', bool失敗: false };
  if (str餐別 === '不合併') return obj空;
  let obj登記表;
  try {
    obj登記表 = 讀取用齋登記表_(obj主控台);
  } catch (err) {
    return Object.assign(obj空, { str說明: `${err.message || err}（這次沒有合併用齋登記）`, bool失敗: true });
  }
  if (!obj登記表.str試算表ID) {
    return Object.assign(obj空, { str說明: '精舍還沒有設定用齋登記表，這次沒有合併用齋義工（精舍管理員可在「四、法會報到」設定）' });
  }
  const obj篩選 = 篩選用齋人員_(obj登記表.arr分頁, int月, int日, str餐別);
  if (obj篩選.arr分頁名.length === 0) {
    return Object.assign(obj空, { str說明: `用齋登記表沒有 ${int月}/${int日} ${str餐別}的分頁，這次沒有合併用齋義工` });
  }
  return { str餐別: str餐別, arr人員: obj篩選.arr人員, arr分頁名: obj篩選.arr分頁名, str說明: '', bool失敗: false };
}


