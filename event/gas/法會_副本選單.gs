// ============================================================================
// 檔案名稱：法會_副本選單.gs
// 所屬模組：法會活動（event）
// 所屬層級：模組／控制層（副本選單的後端）
// 檔案版本：v1.0.0（2026-10-26）
// 用途說明：
//   整理副本裡的選單（「下載資料」「檢查重複」「大車點名」）是「薄殼」：
//   副本的綁定指令碼只負責選單、確認視窗與顯示結果，實際處理全部送到這裡，
//   以系統帳號開啟副本執行。日後修改規則只要更新平台，所有副本立即生效。
//
//   身分驗證（不需要網頁登入）：
//     副本選單送來「使用者本人的 Google 存取權杖」與副本代號。本檔：
//       ① 向 Google 查出這個權杖屬於哪個帳號（權杖過期或偽造即拒絕）
//       ② 由副本內的隱藏資訊與精舍設定「副本清單」查出所屬精舍與活動（核心「讀取副本資訊」，兩者不一致即拒絕）
//       ③ 用平台核心判定此帳號在該精舍的角色與權限
//       ④ 必須是精舍管理員，或這場活動的承辦人且具備對應權限
//     權杖只用來查帳號，不保存。
//
//   大車點名三項（領隊代號表、產生點名、匯出點名）於第②批開放，目前回覆「尚未開放」。
//
// 相依檔案：平台核心、法會_模組定義、法會_資料同步與整理、法會_重複檢查
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：驗證副本存取權杖_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   向 Google 查出存取權杖屬於哪個帳號。權杖必須有效、帳號信箱已驗證。
 *   （副本選單的權杖由使用者本人在副本中授權取得，含 userinfo.email 範圍）
 * 參數：
 *   str存取權杖   {string} 副本選單送來的 ScriptApp.getOAuthToken()
 * 傳回：{string} 正規化後的 Google 帳號
 * ============================================================================
 */
function 驗證副本存取權杖_(str存取權杖) {
  const str權杖 = String(str存取權杖 || '').trim();
  if (str權杖 === '' || str權杖.length > 4096) {
    throw new 平台錯誤(obj錯誤代碼.登入失敗, '副本選單沒有送出您的 Google 身分，請關閉試算表後重新開啟再試。');
  }

  let obj回應;
  try {
    obj回應 = UrlFetchApp.fetch(
      'https://oauth2.googleapis.com/tokeninfo?access_token=' + encodeURIComponent(str權杖),
      { muteHttpExceptions: true }
    );
  } catch (err) {
    throw new 平台錯誤(obj錯誤代碼.未預期錯誤, '目前無法連線到 Google 確認身分，請稍後再試。',
      { str原始訊息: err && err.message ? err.message : String(err) });
  }
  if (obj回應.getResponseCode() !== 200) {
    throw new 平台錯誤(obj錯誤代碼.登入失敗, 'Google 身分確認失敗（可能已過期），請關閉試算表後重新開啟再試。',
      { int狀態碼: obj回應.getResponseCode() });
  }

  let obj內容 = {};
  try { obj內容 = JSON.parse(obj回應.getContentText()); } catch (err) { obj內容 = {}; }
  const bool已驗證 = obj內容.email_verified === true || obj內容.email_verified === 'true';
  if (!obj內容.email || !bool已驗證 || !(Number(obj內容.expires_in) > 0)) {
    throw new 平台錯誤(
      obj錯誤代碼.登入失敗,
      '無法從副本選單確認您的 Google 帳號。請先完成授權（第一次使用時按「繼續 → 允許」），再試一次。'
    );
  }
  return 正規化帳號(obj內容.email);
}


/**
 * ============================================================================
 * 函式名稱：開啟副本情境_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：副本選單每個動作共用的前置：驗證身分 → 找出精舍與活動 → 檢查權限與狀態 → 開啟副本。
 * 參數：
 *   obj參數       {Object}   { str存取權杖, str副本ID }
 *   str權限項目   {string}   需要的權限，例如 obj法會權限.整理資料
 *   str作業名稱   {string}   給使用者看的動作名稱
 *   arr允許狀態   {string[]} 選填；活動要在這些狀態才能做
 * 傳回：
 *   {Object} { obj身分, obj主控台, obj活動值, obj副本 }
 *            obj身分 與網頁工作階段格式相同（可交給 寫入操作日誌、檢查權限）
 * ============================================================================
 */
function 開啟副本情境_(obj參數, str權限項目, str作業名稱, arr允許狀態) {
  檢查必要參數(obj參數, ['str存取權杖', 'str副本ID'], str作業名稱);

  // ① 帳號
  const str帳號 = 驗證副本存取權杖_(obj參數.str存取權杖);

  // ② 副本屬於哪個精舍、哪場活動（核心會比對副本隱藏資訊與副本清單）
  const obj資訊 = 讀取副本資訊(String(obj參數.str副本ID).trim());
  if (obj資訊.str模組代號 !== obj法會設定.str模組代號) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '這份試算表不是法會活動的整理副本。');
  }

  // ③ 角色與權限（不是本精舍人員或已停用，核心會說明）
  const obj身分 = 判定身分_(str帳號, obj資訊.str精舍代號);

  // ④ 活動：副本必須是這場活動目前使用的那一份
  const obj主控台 = 開啟法會主控台_(obj資訊.str精舍代號);
  const obj活動值 = 取得法會活動_(obj主控台, obj資訊.str記錄ID).obj值;
  if (String(obj活動值['副本ID']).trim() !== obj資訊.str副本ID) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '這份副本已不是這場活動目前使用的副本，請改開新的副本。');
  }
  檢查活動權限_(obj身分, obj活動值, str權限項目, str作業名稱);
  if (arr允許狀態) 檢查活動狀態_(obj活動值, arr允許狀態, str作業名稱);

  return {
    obj身分: obj身分,
    obj主控台: obj主控台,
    obj活動值: obj活動值,
    obj副本: 開啟試算表(obj資訊.str副本ID, `「${obj活動值['活動名稱']}」的整理副本`)
  };
}


/**
 * ============================================================================
 * 函式名稱：副本選單_檢查新資料
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：action「event.副本檢查」。下載前先問：還有幾筆新報名沒下載（不改資料）。
 * 參數：
 *   obj工作階段   {null}   不需要網頁登入
 *   obj參數       {Object} { str存取權杖, str副本ID }
 * 傳回：{Object} { int未下載, str活動名稱, str訊息 }
 * ============================================================================
 */
function 副本選單_檢查新資料(obj工作階段, obj參數) {
  const obj = 開啟副本情境_(obj參數, obj法會權限.整理資料, '下載新資料', arr法會可同步狀態);
  const str活動ID = String(obj.obj活動值['活動ID']).trim();
  const int未下載 = 計算法會待同步筆數_(obj.obj活動值, 讀取法會已同步紀錄_(obj.obj主控台, str活動ID)[str活動ID] || {});
  return {
    int未下載: int未下載,
    str活動名稱: String(obj.obj活動值['活動名稱']).trim(),
    str訊息: int未下載 > 0 ? `有 ${int未下載} 筆新報名尚未下載。` : '已是最新，沒有新報名。'
  };
}


/**
 * ============================================================================
 * 函式名稱：副本選單_下載新資料
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.副本下載」。與網頁「同步」完全相同的處理（共用已同步紀錄，
 *   網頁同步與副本下載不會重複追加）。
 * 參數：
 *   obj工作階段   {null}   不需要網頁登入
 *   obj參數       {Object} { str存取權杖, str副本ID }
 * 傳回：{Object} { int新增筆數, int提醒筆數, str訊息 }
 * ============================================================================
 */
function 副本選單_下載新資料(obj工作階段, obj參數) {
  const obj = 開啟副本情境_(obj參數, obj法會權限.整理資料, '下載新資料', arr法會可同步狀態);
  const str活動ID = String(obj.obj活動值['活動ID']).trim();
  const obj結果 = 以活動作業鎖執行_(obj.obj身分.str精舍代號, str活動ID, '下載新資料', function () {
    return 同步單一法會活動_(obj.obj主控台, obj.obj活動值, 讀取法會已同步紀錄_(obj.obj主控台, str活動ID)[str活動ID] || {});
  });
  寫入操作日誌(obj.obj身分, '副本下載新資料', `${str活動ID}：新增 ${obj結果.int新增筆數} 筆`);
  return {
    int新增筆數: obj結果.int新增筆數,
    int提醒筆數: obj結果.int提醒筆數,
    str訊息: (obj結果.int新增筆數 > 0
      ? `已下載 ${obj結果.int新增筆數} 筆新報名，加在「有效資料」最後（淺黃底色）。`
      : '沒有新報名，資料已是最新。')
      + (obj結果.int提醒筆數 > 0 ? `\n另有 ${obj結果.int提醒筆數} 則提醒（例如有人修改報名），請到法會活動網頁「同步與整理」查看。` : '')
  };
}


/**
 * ============================================================================
 * 函式名稱：副本選單_查詢重複
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：action「event.副本查詢重複」。列出姓名重複的各組與列號（只查看）。
 *       「跳到下一個重複」也呼叫這裡，由副本端決定跳到哪一列。
 * 參數：
 *   obj工作階段   {null}   不需要網頁登入
 *   obj參數       {Object} { str存取權杖, str副本ID }
 * 傳回：{Object} 查詢重複_ 的結果
 * ============================================================================
 */
function 副本選單_查詢重複(obj工作階段, obj參數) {
  const obj = 開啟副本情境_(obj參數, obj法會權限.整理資料, '查詢重複', arr法會副本可整理狀態);
  return 查詢重複_(obj.obj副本);
}


/**
 * ============================================================================
 * 函式名稱：副本選單_標示重複
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：action「event.副本標示重複」。（重新）設定姓名重複的淡橘色標示與「重複檢查」分頁。
 * 參數：
 *   obj工作階段   {null}   不需要網頁登入
 *   obj參數       {Object} { str存取權杖, str副本ID }
 * 傳回：{Object} { str訊息 }
 * ============================================================================
 */
function 副本選單_標示重複(obj工作階段, obj參數) {
  const obj = 開啟副本情境_(obj參數, obj法會權限.整理資料, '標示重複', arr法會副本可整理狀態);
  return { str訊息: 套用重複標示_(obj.obj副本) + '。姓名重複的整列會標淡橘色，改姓名、刪列都會即時更新。' };
}


/**
 * ============================================================================
 * 函式名稱：副本選單_清除標示
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：action「event.副本清除標示」。移除本系統設的重複標示（承辦人自己加的格式不動）。
 * 參數：
 *   obj工作階段   {null}   不需要網頁登入
 *   obj參數       {Object} { str存取權杖, str副本ID }
 * 傳回：{Object} { str訊息 }
 * ============================================================================
 */
function 副本選單_清除標示(obj工作階段, obj參數) {
  const obj = 開啟副本情境_(obj參數, obj法會權限.整理資料, '清除標示', arr法會副本可整理狀態);
  const int數 = 清除重複標示_(obj.obj副本);
  return {
    str訊息: int數 > 0 ? '已清除姓名重複的淡橘色標示（您自己設定的格式不受影響）。需要時可再按「標示重複」。'
      : '目前沒有系統設定的重複標示，不需要清除。'
  };
}


/**
 * ============================================================================
 * 函式名稱：副本選單_移除重複
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.副本移除重複」。副本端先以 bool僅預覽＝true 顯示確認視窗，
 *   使用者按「是」再以 false 正式移除（以最新資料重新計算）。
 * 參數：
 *   obj工作階段   {null}   不需要網頁登入
 *   obj參數       {Object} { str存取權杖, str副本ID, bool僅預覽 }
 * 傳回：{Object} 移除重複_ 的結果
 * ============================================================================
 */
function 副本選單_移除重複(obj工作階段, obj參數) {
  const obj = 開啟副本情境_(obj參數, obj法會權限.整理資料, '移除重複', arr法會副本可整理狀態);
  const bool僅預覽 = obj參數.bool僅預覽 !== false;
  if (bool僅預覽) return 移除重複_(obj.obj副本, true);

  const str活動ID = String(obj.obj活動值['活動ID']).trim();
  const obj結果 = 以活動作業鎖執行_(obj.obj身分.str精舍代號, str活動ID, '移除重複', function () {
    return 移除重複_(obj.obj副本, false);
  });
  if (obj結果.int移出筆數 > 0) 寫入操作日誌(obj.obj身分, '副本移除重複', `${str活動ID}：移出 ${obj結果.int移出筆數} 筆`);
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：副本選單_尚未開放_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：大車點名三項在第②批上線前的統一回覆（仍先驗證身分，避免被拿來探測）。
 * 參數：
 *   obj參數       {Object} { str存取權杖, str副本ID }
 *   str作業名稱   {string} 動作名稱
 * 傳回：無（一律丟出說明）
 * ============================================================================
 */
function 副本選單_尚未開放_(obj參數, str作業名稱) {
  開啟副本情境_(obj參數, obj法會權限.匯出大車點名, str作業名稱);
  throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${str作業名稱}」將在大車點名功能上線後開放，目前請先完成資料整理。`);
}


/**
 * ============================================================================
 * 函式名稱：副本選單_領隊代號表 ／ 副本選單_產生點名 ／ 副本選單_匯出點名
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：action「event.副本領隊代號表」「event.副本產生點名」「event.副本匯出點名」。
 *       第②批（法會_大車匯出.gs）上線時改為實際處理。
 * 參數：
 *   obj工作階段   {null}   不需要網頁登入
 *   obj參數       {Object} { str存取權杖, str副本ID, bool僅預覽（匯出用） }
 * 傳回：無
 * ============================================================================
 */
function 副本選單_領隊代號表(obj工作階段, obj參數) { return 副本選單_尚未開放_(obj參數, '領隊代號對照表'); }
function 副本選單_產生點名(obj工作階段, obj參數) { return 副本選單_尚未開放_(obj參數, '產生點名資料'); }
function 副本選單_匯出點名(obj工作階段, obj參數) { return 副本選單_尚未開放_(obj參數, '匯出到大車點名試算表'); }
