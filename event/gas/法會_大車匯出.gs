  arr名單欄位: obj出車資料格式.arr欄位.filter(function (str欄) { return obj出車資料格式.arr系統產生欄位.indexOf(str欄) < 0; }),
  // 由點名系統填寫，產生與匯出時一律空白
  arr點名系統欄位: obj出車資料格式.arr點名系統欄位,
  arr報到紀錄欄位: ['日期', '方向', '點名時機', '去程時段', '車次', '學員編號', '姓名', '法名', '手機號碼', '身份別', '報到時間', '狀態'],
  str啟用: '啟用',
  str停用: '停用'
});

// 大車點名可產生與匯出的活動狀態
const arr大車可匯出狀態 = Object.freeze(['收件中', '演練']);


// ============================================================================
// 甲、小工具（純計算，不碰檔案）
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：是日期值_（內部使用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：判斷是不是有效的日期（用 Object.prototype.toString，比 instanceof 穩定）。
 * 參數：any值 {*}
 * 傳回：{boolean}
 * ============================================================================
 */
function 是日期值_(any值) {
  return Object.prototype.toString.call(any值) === '[object Date]' && !isNaN(any值.getTime());
}


/**
 * ============================================================================
 * 函式名稱：擷取月日_（內部使用）
 * 版本：v1.1.0（2026-11-04）　v1.1.0：也接受「5月22日」「5月22」寫法
 * ----------------------------------------------------------------------------
 * 用途：找出文字中所有月日，例如「11/28 (六)、11/29」「5月22日」。
 * 參數：any文字 {*}
 * 傳回：{Object[]} [ { int月, int日 } ]（依文字中出現的順序）
 * ============================================================================
 */
function 擷取月日_(any文字) {
  const arr結果 = [];
  // 「月/日」或「月月日日」兩種寫法；日後面的「日」字可有可無
  const reg月日 = /(\d{1,2})\s*(?:\/|月)\s*(\d{1,2})/g;
  let arr比對;
  while ((arr比對 = reg月日.exec(String(any文字 == null ? '' : any文字))) !== null) {
    const int月 = Number(arr比對[1]);
    const int日 = Number(arr比對[2]);
    if (int月 >= 1 && int月 <= 12 && int日 >= 1 && int日 <= 31) arr結果.push({ int月: int月, int日: int日 });
  }
  return arr結果;
}


/**
 * ============================================================================
 * 函式名稱：推算月日日期_（內部使用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：沒有年份的月日：用基準日的年份；月份比基準月份早超過 6 個月視為隔年
 *       （例如 12 月報名、1 月出發）。
 * 參數：
 *   obj月日     {Object} { int月, int日 }
 *   dat基準     {Date}   報名時間（沒有就用今天）
 * 傳回：{Date}
 * ============================================================================
 */
function 推算月日日期_(obj月日, dat基準) {
  let int年 = dat基準.getFullYear();
  if (obj月日.int月 < dat基準.getMonth() + 1 - 6) int年 += 1;
  return new Date(int年, obj月日.int月 - 1, obj月日.int日);
}


/**
 * ============================================================================
 * 函式名稱：格式化點名手機_（內部使用）
 * 版本：v1.0.0（2026-10-27）
 * ----------------------------------------------------------------------------
 * 用途：統一為 0911-000000。9 碼且 9 開頭（開頭 0 被吃掉）補回 0；
 *       不是 09 開頭的 10 碼 → 保留原樣並標為有問題；空白不算問題。
 * 參數：any值 {*}
 * 傳回：{Object} { str值, bool有問題 }
 * ============================================================================
 */
function 格式化點名手機_(any值) {
  const str原 = String(any值 == null ? '' : any值).trim();
  if (str原 === '') return { str值: '', bool有問題: false };
  let str數字 = str原.replace(/\D/g, '');
  if (str數字.length === 9 && str數字.charAt(0) === '9') str數字 = '0' + str數字;
  if (/^09\d{8}$/.test(str數字)) return { str值: `${str數字.slice(0, 4)}-${str數字.slice(4)}`, bool有問題: false };
  return { str值: str原, bool有問題: true };
}


/**
 * ============================================================================
 * 函式名稱：正規化出車欄名_（內部使用）
 * 版本：v1.0.0（2026-11-04）
 * ----------------------------------------------------------------------------
 * 用途：比對欄名前，去掉前後的半形／全形空白與不換行空白（「車號 」視同「車號」）。
 *       中間的字必須一字不差。
 * 參數：any標題 {*}
 * 傳回：{string}
 * ============================================================================
 */
function 正規化出車欄名_(any標題) {
  return String(any標題 == null ? '' : any標題).replace(/^[\s　 ]+|[\s　 ]+$/g, '');
}


/**
 * ============================================================================
 * 函式名稱：出車一般值轉文字_（內部使用）
 * 版本：v1.0.0（2026-11-04）
 * ----------------------------------------------------------------------------
 * 用途：一般欄位的值轉成寫入出車資料的文字：
 *       數字 1 或 1.0 →「1」；文字去前後空白（只有空白＝空）；日期 → 月/日。
 * 參數：any值 {*}
 * 傳回：{string}
 * ============================================================================
 */
function 出車一般值轉文字_(any值) {
  if (any值 === null || any值 === undefined) return '';
  if (是日期值_(any值)) return `${any值.getMonth() + 1}/${any值.getDate()}`;
  if (typeof any值 === 'number') return String(Number.isInteger(any值) ? any值 : any值);
  if (typeof any值 === 'boolean') return any值 ? '是' : '';
  // 文字：去前後空白；「2.0」這類由試算表轉來的整數改回「2」
  const str值 = 正規化出車欄名_(any值);
  return /^\d+\.0+$/.test(str值) ? str值.replace(/\.0+$/, '') : str值;
}


/**
 * ============================================================================
 * 函式名稱：整理出車日期_（內部使用）
 * 版本：v1.0.0（2026-11-04）
 * ----------------------------------------------------------------------------
 * 用途：日期欄統一成日期（只留年月日）：
 *       · 已是日期 → 去掉時分秒
 *       · 文字「5月22日」「5/22」→ 依基準日推算年份
 *       · 文字「2026/5/22」「2026-05-22」→ 照年份
 *       · 空白 → 空白（不算問題）
 *       · 其他看不懂的文字 → 保留原文字並標為有問題（黃底）
 * 參數：
 *   any值     {*}
 *   dat基準   {Date} 報名時間（推算年份用）
 * 傳回：{Object} { any值: Date|string, bool有問題 }
 * ============================================================================
 */
function 整理出車日期_(any值, dat基準) {
  if (是日期值_(any值)) {
    return { any值: new Date(any值.getFullYear(), any值.getMonth(), any值.getDate()), bool有問題: false };
  }
  const str值 = 出車一般值轉文字_(any值);
  if (str值 === '') return { any值: '', bool有問題: false };

  // ① 有年份：2026/5/22、2026-05-22、2026.5.22、2026年5月22日
  const arr年月日 = str值.match(/^(\d{4})\s*[\/\-.年]\s*(\d{1,2})\s*[\/\-.月]\s*(\d{1,2})\s*日?$/);
  if (arr年月日) {
    const dat = new Date(Number(arr年月日[1]), Number(arr年月日[2]) - 1, Number(arr年月日[3]));
    if (dat.getMonth() === Number(arr年月日[2]) - 1) return { any值: dat, bool有問題: false };
  }
  // ② 只有月日：5月22日、5/22（後面可帶星期，例如「5/22(五)」）；只取第一個
  const arr月日 = 擷取月日_(str值);
  if (arr月日.length === 1) {
    return { any值: 推算月日日期_(arr月日[0], dat基準), bool有問題: false };
  }
  // ③ 看不懂或寫了兩個以上日期
  return { any值: str值, bool有問題: true };
}


/**
 * ============================================================================
 * 函式名稱：讀取領隊代號表_（內部使用）
 * 版本：v1.0.0（2026-11-04）
 * ----------------------------------------------------------------------------
 * 用途：
 *   取得領隊代號對照表 { 代號: 名稱 }：
 *     · 副本有「領隊代號」分頁 → 讀 A 欄代號、B 欄名稱（第 1 列是標題）
 *     · 沒有這個分頁 → 用預設（1 法師、2 總領隊、3 副總領隊、4 領隊、5 副領隊、6 貴賓資料）
 *   分頁內容有誤（全空、代號沒名稱、同代號兩個名稱）時以白話說明丟錯。
 * 參數：obj副本 {Spreadsheet|null}  null 時直接用預設（純計算測試用）
 * 傳回：{Object} { obj表: { 代號: 名稱 }, bool自訂 }
 * ============================================================================
 */
function 讀取領隊代號表_(obj副本) {
  const cfg = obj出車資料格式;
  const obj分頁 = obj副本 ? obj副本.getSheetByName(cfg.str領隊代號分頁名) : null;
  // ① 沒有自訂分頁：用預設
  if (!obj分頁) return { obj表: Object.assign({}, cfg.obj預設領隊代號), bool自訂: false };

  // ② 讀自訂分頁
  const obj表 = {};
  const int最後列 = obj分頁.getLastRow();
  if (int最後列 >= 2) {
    obj分頁.getRange(2, 1, int最後列 - 1, 2).getValues().forEach(function (arr) {
      const str代號 = 出車一般值轉文字_(arr[0]);           // 數字 2、「2.0」都轉成「2」
      const str名稱 = 出車一般值轉文字_(arr[1]);
      if (str代號 === '') return;                           // 空白列略過
      if (str名稱 === '') {
        throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${cfg.str領隊代號分頁名}」分頁的代號「${str代號}」沒有填名稱，請補上名稱或刪除這個代號。`);
      }
      if ((str代號 in obj表) && obj表[str代號] !== str名稱) {
        throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${cfg.str領隊代號分頁名}」分頁的代號「${str代號}」出現兩次（${obj表[str代號]}、${str名稱}），請保留一個。`);
      }
      obj表[str代號] = str名稱;
    });
  }
  if (Object.keys(obj表).length === 0) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${cfg.str領隊代號分頁名}」分頁是空的。請在 A 欄填代號、B 欄填名稱；要改用預設，直接刪除這個分頁即可。`);
  }
  return { obj表: obj表, bool自訂: true };
}


/**
 * ============================================================================
 * 函式名稱：換算領隊名稱_（內部使用）
 * 版本：v1.0.0（2026-11-04）
 * ----------------------------------------------------------------------------
 * 用途：有效資料的領隊代號 → 中文名稱。
 *       空白 → 空白；代號（2、「2」、「2.0」）→ 名稱；已經是名稱 → 照用；
 *       對照表沒有的值 → 保留原值並標為有問題（黃底）。
 * 參數：any值 {*}；obj表 {Object} { 代號: 名稱 }
 * 傳回：{Object} { str值, bool有問題 }
 * ============================================================================
 */
function 換算領隊名稱_(any值, obj表) {
  const str值 = 出車一般值轉文字_(any值);
  if (str值 === '') return { str值: '', bool有問題: false };
  if (Object.prototype.hasOwnProperty.call(obj表, str值)) return { str值: obj表[str值], bool有問題: false };
  const bool已是名稱 = Object.keys(obj表).some(function (k) { return obj表[k] === str值; });
  return { str值: str值, bool有問題: !bool已是名稱 };
}


/**
 * ============================================================================
 * 函式名稱：換回領隊代號_（內部使用）
 * 版本：v1.0.0（2026-11-04）
 * ----------------------------------------------------------------------------
 * 用途：匯出到點名系統時，把出車資料的領隊名稱換回代號（點名系統存代號）。
 *       找不到對應名稱（本來就是代號或其他文字）→ 原值不變。
 * 參數：str名稱 {string}；obj表 {Object} { 代號: 名稱 }
 * 傳回：{string}
 * ============================================================================
 */
function 換回領隊代號_(str名稱, obj表) {
  const str值 = String(str名稱 == null ? '' : str名稱).trim();
  if (str值 === '') return '';
  const str代號 = Object.keys(obj表).filter(function (k) { return obj表[k] === str值; })[0];
  return str代號 !== undefined ? str代號 : str值;
}


/**
 * ============================================================================
 * 函式名稱：列出領隊代號_（內部使用）
 * 版本：v1.0.0（2026-11-04）
 * ----------------------------------------------------------------------------
 * 用途：對照表轉成「1 法師、2 總領隊…」（說明與錯誤訊息用）。
 * 參數：obj表 {Object}
 * 傳回：{string}
 * ============================================================================
 */
function 列出領隊代號_(obj表) {
  const arr = Object.keys(obj表).map(function (k) { return `${k} ${obj表[k]}`; });
  return arr.length ? arr.join('、') : '（尚未設定）';
}


// ============================================================================
// 乙、產生出車資料（副本「有效資料」→ 副本「出車資料」）
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：檢查出車必要欄位_（內部使用）
 * 版本：v1.1.0（2026-11-04）　v1.1.0：重複的欄名改用最左邊那一欄（仍列入 arr重複 供提醒）
 * ----------------------------------------------------------------------------
 * 用途：
 *   比對有效資料的標題與出車資料範本：
 *     · 應有欄位＝範本欄位 − 系統產生欄位（序號）− 點名系統欄位（去程狀態、回程狀態、狀態）
 *     · 欄名去前後空白後必須一字不差
 *     · 同一個欄名出現兩次以上 → 使用最左邊那一欄，並列入 arr重複 提醒承辦人
 *   點名系統欄位若有效資料也有，同樣記錄位置，但輸出時一律空白。
 * 參數：arr標題 {Array} 有效資料第 1 列
 * 傳回：{Object} {
 *   obj索引:  { 欄名: 欄索引(0 起算) }   只含找到的範本欄位
 *   arr缺少:  string[]                    缺少的必要欄名（依範本順序）
 *   arr重複:  [ { str欄名, arr欄字母 } ]  重複的欄名（已採用第一個欄字母那一欄）
 * }
 * ============================================================================
 */
function 檢查出車必要欄位_(arr標題) {
  const cfg = obj出車資料格式;
  // ① 每個正規化後的欄名出現在哪幾欄
  const obj位置 = {};
  (arr標題 || []).forEach(function (any標題, i) {
    const str欄名 = 正規化出車欄名_(any標題);
    if (str欄名 === '') return;
    (obj位置[str欄名] = obj位置[str欄名] || []).push(i);
  });

  // ② 逐一檢查範本欄位
  const obj索引 = {};
  const arr缺少 = [];
  const arr重複 = [];
  cfg.arr欄位.forEach(function (str欄名) {
    if (cfg.arr系統產生欄位.indexOf(str欄名) >= 0) return;          // 序號：系統編號
    const bool點名系統欄 = cfg.arr點名系統欄位.indexOf(str欄名) >= 0;
    const arr欄 = obj位置[str欄名] || [];
    if (arr欄.length === 0) {
      if (!bool點名系統欄) arr缺少.push(str欄名);
      return;
    }
    if (arr欄.length > 1 && !bool點名系統欄) {
      arr重複.push({ str欄名: str欄名, arr欄字母: arr欄.map(function (i) { return 轉為欄位字母_(i + 1); }) });
    }
    obj索引[str欄名] = arr欄[0];                                     // 一律用最左邊那一欄
  });
  return { obj索引: obj索引, arr缺少: arr缺少, arr重複: arr重複 };
}


/**
 * ============================================================================
 * 函式名稱：說明出車欄位問題_（內部使用）
 * 版本：v2.0.0（2026-11-04）
 *   v2.0.0：缺欄、重複欄不再停止，改為回傳提醒文字；只有缺「姓名」時才丟錯
 * ----------------------------------------------------------------------------
 * 用途：
 *   · 有效資料沒有「姓名」欄 → 丟出白話錯誤（無法判斷哪幾列是報名資料，不寫入任何資料）
 *   · 其他欄位缺少 → 提醒：這些欄在出車資料中會是空白，標題格黃底
 *   · 欄名重複 → 提醒：已使用最左邊那一欄
 * 參數：obj檢查 {Object} 檢查出車必要欄位_ 的結果
 * 傳回：{string[]} 提醒文字（沒有問題時為空陣列）
 * ============================================================================
 */
function 說明出車欄位問題_(obj檢查) {
  const cfg = obj出車資料格式;
  // ① 姓名是判斷資料列的依據，沒有就無法產生
  if (obj檢查.arr缺少.indexOf(cfg.str姓名欄位) >= 0) {
    throw new 平台錯誤(obj錯誤代碼.欄位缺漏,
      `「${cfg.str來源分頁名}」找不到「${cfg.str姓名欄位}」欄，系統無法判斷哪幾列是報名資料。`
      + `請確認第 1 列有一欄的標題是「${cfg.str姓名欄位}」（一字不差）。\n\n這次沒有產生任何出車資料。`);
  }
  // ② 其他問題只提醒
  const arr提醒 = [];
  if (obj檢查.arr缺少.length > 0) {
    arr提醒.push(`「${cfg.str來源分頁名}」沒有這些欄位，出車資料中這幾欄是空白（標題黃底）：${obj檢查.arr缺少.join('、')}。`
      + `需要時請在「${cfg.str來源分頁名}」最右側「新增」同名欄位（欄名要一字不差）後重新產生；`
      + '不要把表單原本的欄位改名（改名後，下次下載新資料時新報名會落到另外新增的欄位）');
  }
  obj檢查.arr重複.forEach(function (o) {
    arr提醒.push(`「${cfg.str來源分頁名}」有 ${o.arr欄字母.length} 個「${o.str欄名}」欄（第 ${o.arr欄字母.join('、')} 欄），已使用最左邊的第 ${o.arr欄字母[0]} 欄；如不是這一欄，請刪除或改名多出來的欄位`);
  });
  return arr提醒;
}


/**
 * ============================================================================
 * 函式名稱：組出車資料列_（內部使用）
 * 版本：v1.1.0（2026-11-04）　v1.1.0：領隊代號換成中文名稱（obj領隊表）
 * ----------------------------------------------------------------------------
 * 用途：把有效資料的一列，依範本欄位順序組成出車資料的一列：
 *         序號 → int序號；點名系統欄位 → 空白；手機 → 0911-000000；
 *         日期欄 → 日期（看不懂標問題）；其他 → 去空白的文字。
 * 參數：
 *   arr列       {Array}  有效資料一列
 *   obj索引     {Object} 檢查出車必要欄位_ 的 obj索引
 *   int序號     {number}
 *   dat基準     {Date}   推算日期年份用
 *   obj領隊表   {Object=} { 代號: 名稱 }，省略時用預設
 * 傳回：{Object} { arr值: Array, arr問題欄: number[]（0 起算，對應 arr值）, bool待分車 }
 * ============================================================================
 */
function 組出車資料列_(arr列, obj索引, int序號, dat基準, obj領隊表) {
  const cfg = obj出車資料格式;
  const obj表 = obj領隊表 || cfg.obj預設領隊代號;
  const arr問題欄 = [];
  const arr值 = cfg.arr欄位.map(function (str欄名, i) {
    // ① 系統產生、點名系統填寫
    if (cfg.arr系統產生欄位.indexOf(str欄名) >= 0) return int序號;
    if (cfg.arr點名系統欄位.indexOf(str欄名) >= 0) return '';
    const any原值 = (str欄名 in obj索引) ? arr列[obj索引[str欄名]] : '';

    // ② 手機
    if (str欄名 === cfg.str手機欄位) {
      const obj手機 = 格式化點名手機_(是日期值_(any原值) ? '' : 出車一般值轉文字_(any原值));
      if (obj手機.bool有問題) arr問題欄.push(i);
      return obj手機.str值;
    }
    // ③ 日期
    if (cfg.arr日期欄位.indexOf(str欄名) >= 0) {
      const obj日期 = 整理出車日期_(any原值, dat基準);
      if (obj日期.bool有問題) arr問題欄.push(i);
      return obj日期.any值;
    }
    // ④ 領隊：代號 → 中文名稱（找不到的代號黃底）
    if (str欄名 === cfg.str領隊欄位) {
      const obj領隊 = 換算領隊名稱_(any原值, obj表);
      if (obj領隊.bool有問題) arr問題欄.push(i);
      return obj領隊.str值;
    }
    // ⑤ 其他
    return 出車一般值轉文字_(any原值);
  });

  // ⑤ 日期-迄 早於 日期-起 → 兩格都標問題
  const int起 = cfg.arr欄位.indexOf('日期-起');
  const int迄 = cfg.arr欄位.indexOf('日期-迄');
  if (是日期值_(arr值[int起]) && 是日期值_(arr值[int迄]) && arr值[int迄] < arr值[int起]) {
    if (arr問題欄.indexOf(int起) < 0) arr問題欄.push(int起);
    if (arr問題欄.indexOf(int迄) < 0) arr問題欄.push(int迄);
  }
  const bool待分車 = cfg.arr待分車欄位.some(function (str欄名) {
    return String(arr值[cfg.arr欄位.indexOf(str欄名)]).trim() === '';
  });
  return { arr值: arr值, arr問題欄: arr問題欄, bool待分車: bool待分車 };
}


/**
 * ============================================================================
 * 函式名稱：整理出車資料_（內部使用）
 * 版本：v1.2.0（2026-11-04）
 *   v1.2.0：領隊代號換中文（obj領隊表），回傳 int領隊問題
 *   v1.1.0：缺欄仍產生（該欄空白），回傳 arr缺少欄、arr欄位提醒
 * ----------------------------------------------------------------------------
 * 用途：純計算：有效資料（含標題列）→ 出車資料各列。姓名空白的列（空白列、小計列）略過，不佔序號。
 *       有效資料沒有的欄位在出車資料中留空白；只有缺「姓名」欄時丟錯（見 說明出車欄位問題_）。
 * 參數：
 *   arr全部     {Array[]} 有效資料，第 0 列為標題
 *   dat今天     {Date=}   沒有時間戳記時推算年份的基準（預設今天；測試可指定）
 *   obj領隊表   {Object=} { 代號: 名稱 }，省略時用預設
 * 傳回：{Object} { arr資料: Array[], arr問題: [ { int列(0 起算), int欄(0 起算) } ], int待分車, int略過,
 *                  arr缺少欄: string[]（有效資料沒有的欄名）, arr欄位提醒: string[], int領隊問題 }
 * ============================================================================
 */
function 整理出車資料_(arr全部, dat今天, obj領隊表) {
  const cfg = obj出車資料格式;
  if (!arr全部 || arr全部.length < 2) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${cfg.str來源分頁名}」沒有任何資料，無法產生出車資料。`);
  }
  const arr標題 = arr全部[0];
  const obj檢查 = 檢查出車必要欄位_(arr標題);
  const arr欄位提醒 = 說明出車欄位問題_(obj檢查);      // 缺「姓名」才會在這裡停止

  // 時間戳記欄（選用）：每列用自己的報名時間推算「5月22日」的年份
  const int時間欄 = arr標題.map(正規化出車欄名_).indexOf(cfg.str時間戳記欄);
  const dat預設基準 = dat今天 || new Date();
  const int姓名欄 = obj檢查.obj索引[cfg.str姓名欄位];

  const arr資料 = [];
  const arr問題 = [];
  let int待分車 = 0;
  let int略過 = 0;
  arr全部.slice(1).forEach(function (arr列) {
    if (正規化出車欄名_(arr列[int姓名欄]) === '') { int略過 += 1; return; }
    const any時間 = int時間欄 >= 0 ? arr列[int時間欄] : null;
    const dat基準 = 是日期值_(any時間) ? any時間 : dat預設基準;
    const obj列 = 組出車資料列_(arr列, obj檢查.obj索引, arr資料.length + 1, dat基準, obj領隊表);
    obj列.arr問題欄.forEach(function (int欄) { arr問題.push({ int列: arr資料.length, int欄: int欄 }); });
    if (obj列.bool待分車) int待分車 += 1;
    arr資料.push(obj列.arr值);
  });
  // 只有標題、或全部是空白列：可能 arr全部 有資料但都沒有姓名
  if (arr資料.length === 0) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${cfg.str來源分頁名}」中沒有任何填了姓名的資料列，無法產生出車資料。`);
  }
  return {
    arr資料: arr資料, arr問題: arr問題, int待分車: int待分車, int略過: int略過,
    arr缺少欄: obj檢查.arr缺少.slice(), arr欄位提醒: arr欄位提醒,
    // 領隊欄的問題格數（對照表找不到的代號），供結果說明
    int領隊問題: arr問題.filter(function (o) { return o.int欄 === cfg.arr欄位.indexOf(cfg.str領隊欄位); }).length
  };
}


/**
 * ============================================================================
 * 函式名稱：備份出車資料分頁_（內部使用）
 * 版本：v1.0.0（2026-11-04）
 * ----------------------------------------------------------------------------
 * 用途：重新產生前，把現有「出車資料」複製為「出車資料_備份_yyyyMMdd_HHmm」，
 *       並刪除較舊的備份，只保留最近 int保留備份數 份（名稱含時間，依名稱排序即依時間排序）。
 * 參數：obj副本 {Spreadsheet}；obj分頁 {Sheet} 現有的出車資料分頁
 * 傳回：{string} 備份分頁名稱
 * ============================================================================
 */
function 備份出車資料分頁_(obj副本, obj分頁) {
  const cfg = obj出車資料格式;
  const str備份名 = 備份點名分頁_(obj副本, obj分頁);
  obj副本.getSheetByName(str備份名).hideSheet();      // 備份不干擾承辦人，需要時再取消隱藏

  // 只保留最近幾份
  const str前綴 = cfg.str分頁名 + cfg.str備份標記;
  const arr備份 = obj副本.getSheets()
    .filter(function (o) { return o.getName().indexOf(str前綴) === 0; })
    // 新 → 舊；同一分鐘的備份名稱加 _2、_3…，用數字比較才不會把 _10 排在 _9 前面
    .sort(function (a, b) { return b.getName().localeCompare(a.getName(), 'en', { numeric: true }); });
  arr備份.slice(cfg.int保留備份數).forEach(function (o) { obj副本.deleteSheet(o); });
  return str備份名;
}


/**
 * ============================================================================
 * 函式名稱：寫入出車資料分頁_（內部使用）
 * 版本：v1.1.0（2026-11-04）　v1.1.0：有效資料沒有的欄位，標題格黃底並加註解
 * ----------------------------------------------------------------------------
 * 用途：
 *   整份重建副本「出車資料」：
 *     ① 已存在 → 先備份（隱藏），再清空內容與底色（不刪分頁，承辦人的欄寬、篩選不受影響）
 *     ② 手機欄設純文字、日期欄設 M/d（先設格式再寫值，開頭 0 才不會消失）
 *     ③ 寫標題與資料；問題格黃底；去程或回程空白整列淡藍（條件式格式）
 *     ④ 凍結第 1 列，標題加註解說明「請改有效資料後重新產生」
 * 參數：
 *   obj副本   {Spreadsheet}
 *   obj整理   {Object} 整理出車資料_ 的結果
 * 傳回：{Object} { obj分頁, str備份名（第一次為空字串） }
 * ============================================================================
 */
function 寫入出車資料分頁_(obj副本, obj整理) {
  const cfg = obj出車資料格式;
  const arr標題 = cfg.arr欄位;
  const int欄數 = arr標題.length;
  const int需要列 = obj整理.arr資料.length + 1;

  // ① 取得或建立分頁
  let obj分頁 = obj副本.getSheetByName(cfg.str分頁名);
  let str備份名 = '';
  if (obj分頁) {
    str備份名 = 備份出車資料分頁_(obj副本, obj分頁);
    obj分頁.clear();                                   // 內容、格式一起清（條件式格式下面重設）
  } else {
    obj分頁 = obj副本.insertSheet(cfg.str分頁名, obj副本.getSheets().length);
  }
  if (int需要列 > obj分頁.getMaxRows()) obj分頁.insertRowsAfter(obj分頁.getMaxRows(), int需要列 - obj分頁.getMaxRows());
  if (int欄數 > obj分頁.getMaxColumns()) obj分頁.insertColumnsAfter(obj分頁.getMaxColumns(), int欄數 - obj分頁.getMaxColumns());

  // ② 欄位格式（先設格式再寫值）
  obj分頁.getRange(1, arr標題.indexOf(cfg.str手機欄位) + 1, int需要列, 1).setNumberFormat('@');
  cfg.arr日期欄位.forEach(function (str欄名) {
    obj分頁.getRange(2, arr標題.indexOf(str欄名) + 1, Math.max(int需要列 - 1, 1), 1).setNumberFormat(cfg.str日期格式);
  });

  // ③ 標題與資料
  obj分頁.getRange(1, 1, 1, int欄數).setValues([arr標題.slice()])
    .setFontWeight('bold').setBackground(cfg.str標題底色);
  // 領隊欄標題註解：說明代號對照（v2.2.0；缺欄註解會覆蓋這則）
  if (obj整理.str領隊說明) obj分頁.getRange(1, arr標題.indexOf(cfg.str領隊欄位) + 1).setNote(obj整理.str領隊說明);
  // 有效資料找不到的欄位：標題格黃底並加註解（v2.1.0）
  (obj整理.arr缺少欄 || []).forEach(function (str欄名) {
    obj分頁.getRange(1, arr標題.indexOf(str欄名) + 1).setBackground(cfg.str缺欄標題底色)
      .setNote(`「${cfg.str來源分頁名}」沒有「${str欄名}」欄，這一欄是空白。需要時請在「${cfg.str來源分頁名}」最右側新增同名欄位後重新產生。`);
  });
  if (obj整理.arr資料.length > 0) {
    obj分頁.getRange(2, 1, obj整理.arr資料.length, int欄數).setValues(obj整理.arr資料);
  }
  if (obj整理.arr問題.length > 0) {
    // 一次設定整塊底色（比逐格快）
    const arr底色 = obj整理.arr資料.map(function () { return new Array(int欄數).fill(null); });
    obj整理.arr問題.forEach(function (o) { arr底色[o.int列][o.int欄] = cfg.str問題底色; });
    obj分頁.getRange(2, 1, obj整理.arr資料.length, int欄數).setBackgrounds(arr底色);
  }

  // ④ 待分車條件式格式、凍結、註解
  const str姓 = 轉為欄位字母_(arr標題.indexOf(cfg.str姓名欄位) + 1);
  const str條件 = cfg.arr待分車欄位.map(function (str欄名) {
    return `$${轉為欄位字母_(arr標題.indexOf(str欄名) + 1)}2=""`;
  }).join(',');
  obj分頁.setConditionalFormatRules([
    SpreadsheetApp.newConditionalFormatRule()
      .whenFormulaSatisfied(`=AND($${str姓}2<>"",OR(${str條件}))`)
      .setBackground(cfg.str待分車底色)
      .setRanges([obj分頁.getRange(2, 1, Math.max(obj分頁.getMaxRows() - 1, 1), int欄數)])
      .build()
  ]);
  obj分頁.setFrozenRows(1);
  obj分頁.getRange(1, 1).setNote(
    `本分頁由選單「大車點名 → 產生出車資料」從「${cfg.str來源分頁名}」同名欄位產生，每次整份重建（舊的自動備份並隱藏）。\n`
    + `要修改內容請改「${cfg.str來源分頁名}」後重新產生，直接改這裡下次會被蓋掉。\n`
    + '黃底：手機或日期系統判斷不出（標題黃底＝有效資料沒有這一欄）；淡藍底：去程或回程還沒填。');
  return { obj分頁: obj分頁, str備份名: str備份名 };
}


/**
 * ============================================================================
 * 函式名稱：產生出車資料_（內部使用）
 * 版本：v1.2.0（2026-11-04）
 *   v1.2.0：讀領隊代號對照表，領隊換中文；明細提醒找不到的代號
 *   v1.1.0：明細最前面列出缺少或重複的欄位；回傳 arr缺少欄
 * ----------------------------------------------------------------------------
 * 用途：只處理副本本身（不碰主控台，方便測試）：讀有效資料 → 整理 → 寫入「出車資料」。
 * 參數：
 *   obj副本   {Spreadsheet}
 *   dat今天   {Date=} 推算年份的基準（測試用；預設今天）
 * 傳回：{Object} { str訊息, arr明細, int筆數, int問題格, int待分車, int略過, str備份名, arr缺少欄 }
 * ============================================================================
 */
function 產生出車資料_(obj副本, dat今天) {
  const cfg = obj出車資料格式;
  // ① 讀有效資料（全部讀入一次）
  const obj來源 = 取得副本分頁_(obj副本, cfg.str來源分頁名);
  const int最後列 = obj來源.getLastRow();
  const int最後欄 = obj來源.getLastColumn();
  if (int最後列 < 2 || int最後欄 < 1) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${cfg.str來源分頁名}」沒有任何資料，無法產生出車資料。`);
  }
  const arr全部 = obj來源.getRange(1, 1, int最後列, int最後欄).getValues();

  // ② 整理（只有缺「姓名」欄會在這裡停止，不會動到出車資料分頁）
  const obj領隊 = 讀取領隊代號表_(obj副本);              // 「領隊代號」分頁有誤會在這裡停止
  const obj整理 = 整理出車資料_(arr全部, dat今天, obj領隊.obj表);
  obj整理.str領隊說明 = `「${cfg.str來源分頁名}」的領隊代號換成名稱：${列出領隊代號_(obj領隊.obj表)}`
    + (obj領隊.bool自訂 ? `（依本副本「${cfg.str領隊代號分頁名}」分頁）` : `（系統預設；要自訂請新增「${cfg.str領隊代號分頁名}」分頁，A 欄代號、B 欄名稱）`)
    + '。匯出到點名系統時會換回代號。';

  // ③ 寫入
  const obj寫入 = 寫入出車資料分頁_(obj副本, obj整理);

  // ④ 結果說明
  const arr明細 = obj整理.arr欄位提醒.slice();          // 缺欄、重複欄放最前面
  if (obj整理.int待分車 > 0) arr明細.push(`${obj整理.int待分車} 筆的去程或回程還沒填（淡藍底）：搭車填車次 1、2…，自行填「自行」，請在「${cfg.str來源分頁名}」填好後重新產生`);
  if (obj整理.int領隊問題 > 0) {
    arr明細.push(`${obj整理.int領隊問題} 筆的領隊代號在對照表中找不到（黃底，保留原值）。目前代號：${列出領隊代號_(obj領隊.obj表)}`
      + (obj領隊.bool自訂 ? `；請更正「${cfg.str來源分頁名}」或在「${cfg.str領隊代號分頁名}」分頁新增這個代號`
        : `；請更正「${cfg.str來源分頁名}」，或新增「${cfg.str領隊代號分頁名}」分頁自訂對照表（A 欄代號、B 欄名稱）`));
  }
  if (obj整理.arr問題.length > 0) arr明細.push(`${obj整理.arr問題.length} 格系統判斷不出（黃底：手機格式、日期看不懂，或日期-迄早於日期-起），請到「${cfg.str來源分頁名}」更正`);
  if (obj整理.int略過 > 0) arr明細.push(`${obj整理.int略過} 列沒有姓名，已略過`);
  if (obj寫入.str備份名) arr明細.push(`上一次的出車資料已備份為「${obj寫入.str備份名}」（隱藏分頁，保留最近 ${cfg.int保留備份數} 份）`);
  return {
    str訊息: `已從「${cfg.str來源分頁名}」產生 ${obj整理.arr資料.length} 筆出車資料（「${cfg.str分頁名}」分頁）。`,
    arr明細: arr明細,
    int筆數: obj整理.arr資料.length,
    int問題格: obj整理.arr問題.length,
    int待分車: obj整理.int待分車,
    int略過: obj整理.int略過,
    str備份名: obj寫入.str備份名,
    arr缺少欄: obj整理.arr缺少欄
  };
}


