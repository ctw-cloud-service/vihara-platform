// ============================================================================
// 檔案名稱：測試_法會_報到表範本.gs
// 所屬模組：法會活動（event）
// 所屬層級：測試
// 檔案版本：v1.0.0（2026-11-10）
// 用途說明：報到表範本（決策 BL）的純邏輯測試（GAS 編輯器執行 測試_法會_報到表範本純邏輯）。
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：測試_法會_報到表範本純邏輯
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：自動測試範本檢查、內建範本、找不到範本改用標準、欄位展開與欄寬、欄位值、
 *       報到表依範本排欄（與以前的標準報到表相同）、路由與活動清單欄位。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_報到表範本純邏輯() {
  const t = 建立法會測試記錄器_();
  const fn錯 = function (fn) { try { fn(); return ''; } catch (err) { return String(err.message || err); } };

  // ── 一、範本檢查 ──
  const o義 = 檢查報到表範本_(' 義工版 ', ['序號', '姓名', '姓名', '法名', ' 義工組別 ', '時段', '備註', '']);
  t.記錄('檢查：去空白、去重複', o義.str名稱 === '義工版' && o義.arr欄位.join('|') === '序號|姓名|法名|義工組別|時段|備註', JSON.stringify(o義));
  t.記錄('檢查：文字以「、」分隔也可以', 檢查報到表範本_('座位版', '姓名、座位、時段').arr欄位.join('|') === '姓名|座位|時段');
  t.記錄('檢查：沒有名稱 → 白話說明', fn錯(function () { 檢查報到表範本_('', ['姓名', '時段']); }).indexOf('範本名稱') !== -1);
  t.記錄('檢查：和內建同名（標準）→ 擋下', fn錯(function () { 檢查報到表範本_('標準', ['姓名', '時段']); }).indexOf('內建範本') !== -1);
  t.記錄('檢查：沒有姓名／沒有時段／姓名在時段後 → 擋下', fn錯(function () { 檢查報到表範本_('甲', ['法名', '時段']); }).indexOf('姓名') !== -1
    && fn錯(function () { 檢查報到表範本_('甲', ['姓名', '法名']); }).indexOf('時段') !== -1
    && fn錯(function () { 檢查報到表範本_('甲', ['時段', '姓名']); }).indexOf('前面') !== -1);
  t.記錄('檢查：超過 10 個欄位 → 擋下', fn錯(function () { 檢查報到表範本_('甲', ['姓名', '時段', 'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i']); }).indexOf('最多') !== -1);

  // ── 二、內建與自訂 ──
  const arr自訂 = 解析自訂報到表範本_(JSON.stringify([{ str名稱: '義工版', arr欄位: ['序號', '姓名', '義工組別', '時段'] }, { str名稱: '壞', arr欄位: ['法名'] }, '亂']));
  t.記錄('自訂範本：壞掉的略過', arr自訂.length === 1 && arr自訂[0].str名稱 === '義工版' && 解析自訂報到表範本_('不是JSON').length === 0);
  const arr全部 = 列出全部報到表範本_(arr自訂);
  t.記錄('全部範本：內建（標準、簡易、義工）在前，自訂在後', arr全部.map(function (o) { return o.str名稱 + (o.bool內建 ? '*' : ''); }).join('|') === '標準*|簡易*|義工*|義工版');
  t.記錄('找範本：空白＝標準', 找出報到表範本_(arr自訂, '').obj範本.str名稱 === '標準' && 找出報到表範本_(arr自訂, '義工版').obj範本.arr欄位.indexOf('義工組別') !== -1);
  const o找不到 = 找出報到表範本_(arr自訂, '已刪除的範本');
  t.記錄('找範本：被刪了 → 用標準並提醒', o找不到.obj範本.str名稱 === '標準' && o找不到.str提醒.indexOf('已不存在') !== -1);

  // ── 三、欄位展開與欄寬 ──
  const arr三 = [{ str名稱: '第一支香', str起迄: '14:00-14:40' }, { str名稱: '第二支香', str起迄: '14:50-15:30' }, { str名稱: '第三支香', str起迄: '15:40-16:20' }];
  const o標 = 展開範本欄位_(obj報到表範本格式.arr內建[0].arr欄位, arr三);
  t.記錄('標準範本：欄位與欄寬和以前相同（41,95,70,125,101×3,85）', o標.arr欄.map(function (o) { return o.int寬; }).join(',') === '41,95,70,125,101,101,101,85' && o標.int時段起欄 === 5 && !o標.bool擠);
  const o單 = 展開範本欄位_(['姓名', '時段', '座位'], []);
  t.記錄('不分時段：時段一欄「報到」；名冊其他欄寬 80', o單.arr欄.map(function (o) { return o.str欄名; }).join('|') === '姓名|報到|座位' && o單.arr欄[2].int寬 === 80 && o單.int時段起欄 === 2);
  const o擠 = 展開範本欄位_(['序號', '姓名', '法名', '學員編號', '報名內容', '報名登記', '義工組別', '時段', '名冊備註'], arr三);
  const int總 = o擠.arr欄.reduce(function (n, o) { return n + o.int寬; }, 0);
  t.記錄('欄位太多：縮小、時段至少 50、總寬不超過 720、序號不縮', o擠.bool擠 && o擠.arr欄.filter(function (o) { return o.str類 === '時段'; }).every(function (o) { return o.int寬 === 50; })
    && int總 <= 720 && o擠.arr欄[0].int寬 === 41, `總寬 ${int總}`);
  t.記錄('欄名：需要坐椅子印「坐椅子」、名冊備註印「備註」', 範本欄位名稱_('需要坐椅子') === '坐椅子' && 範本欄位名稱_('名冊備註') === '備註' && 範本欄位名稱_('班別') === '班別');

  // ── 四、欄位值 ──
  const o人 = { str姓名: '王冠羣', str法名: '傳如', str學員編號: 'A01', str報名登記: '全部時段', str提醒: '備註提到取消', str回報: '坐椅子・梵唄', str用齋: '午齋',
    obj欄值: { '義工組別': '梵唄', '班別': '研經', '備註': '晚到；用齋：午齋', '需要坐椅子': '是' } };
  t.記錄('欄位值：備註＝提醒簡稱＋回報＋用齋', 取得報到欄位值_(o人, '備註') === '取消？、坐椅子・梵唄、午齋', 取得報到欄位值_(o人, '備註'));
  t.記錄('欄位值：名冊備註、班別、需要坐椅子、沒有的欄空白', 取得報到欄位值_(o人, '名冊備註') === '晚到；用齋：午齋' && 取得報到欄位值_(o人, '班別') === '研經'
    && 取得報到欄位值_(o人, '需要坐椅子') === '是' && 取得報到欄位值_(o人, '座位') === '');
  t.記錄('名冊沒有的範本欄：班別有、座位沒有', 找出名冊沒有的範本欄_(['姓名', '班別', '座位', '時段', '備註'], ['姓名', '班別']).join('|') === '座位');

  // ── 五、報到表依範本 ──
  const obj表 = 組合報到表內容_({ str標題: '測試', str日期: '115/11/15（日）', arr時段: arr三, arr範本欄位: ['序號', '姓名', '義工組別', '時段', '班別'], arr人員: [Object.assign({ arr報名序: [0] }, o人)] });
  t.記錄('報到表：欄名依範本、時段展開', obj表.arr欄名.join('|') === '序號|姓名|義工組別|第一支香\n14:00-14:40|第二支香\n14:50-15:30|第三支香\n15:40-16:20|班別', JSON.stringify(obj表.arr欄名));
  t.記錄('報到表：值依範本、沒報名的時段灰、日期在時段欄', obj表.arr值[2].slice(0, 3).join('|') === '1|王冠羣|梵唄' && obj表.arr值[2][6] === '研經'
    && obj表.arr底色[2][3] === null && obj表.arr底色[2][4] === obj報到表格式.str淺灰 && obj表.arr值[0][3] === '115/11/15（日）' && obj表.int時段起欄 === 4);
  const obj舊 = 組合報到表內容_({ str標題: '測試', str日期: 'd', arr時段: arr三, arr人員: [Object.assign({ arr報名序: [0, 1, 2] }, o人)] });
  t.記錄('報到表：沒傳範本＝標準（序號、姓名、法名、報名登記、時段、備註）', obj舊.arr欄名[3] === '報名登記' && obj舊.arr欄名[7] === '備註' && obj舊.arr值[2][7] === '取消？、坐椅子・梵唄、午齋');

  // ── 六、路由與主控台 ──
  const obj路由 = 路由定義_event();
  t.記錄('路由：讀取、儲存、刪除、設定活動報到表範本', ['event.讀取報到表範本', 'event.儲存報到表範本', 'event.刪除報到表範本', 'event.設定活動報到表範本']
    .every(function (k) { return obj路由[k] && typeof obj路由[k].fn === 'function'; }));
  t.記錄('活動清單有「報到表範本」欄、結構版本 6', 主控台結構_event().活動清單.arr欄位.indexOf('報到表範本') !== -1 && obj法會設定.str主控台結構版本 === '6');

  return t.結算();
}
