// ============================================================================
// 檔案名稱：測試_法會_純邏輯.gs
// 所屬模組：法會活動（event）
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.1.0（2026-10-27）　加測回覆試算表列分類
// 用途說明：
//   在 Apps Script 編輯器執行「測試_法會_純邏輯」。
//   只測不碰任何檔案的計算規則（數秒內完成）：重複群組、時間判讀、比對鍵、
//   欄位尋找、欄位字母、活動名稱與日期檢查、帳號清單整理、模組定義格式。
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：建立法會測試記錄器_（測試共用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：各測試檔共用的記錄工具：記錄、預期錯誤、最後統計。
 * 參數：無
 * 傳回：{Object} { 記錄(str項目, bool通過, str補充), 預期錯誤(str項目, str代碼, fn), 結算() }
 * ============================================================================
 */
function 建立法會測試記錄器_() {
  const arr結果 = [];
  return {
    記錄: function (str項目, bool通過, str補充) {
      arr結果.push({ str項目: str項目, bool通過: !!bool通過 });
      console.log(`${bool通過 ? '✔' : '✘'} ${str項目}${str補充 ? '：' + str補充 : ''}`);
    },
    預期錯誤: function (str項目, str預期代碼, fn執行) {
      try {
        fn執行();
        this.記錄(str項目, false, '應該要出錯，但沒有出錯');
      } catch (err) {
        this.記錄(str項目, (err instanceof 平台錯誤) && err.str錯誤代碼 === str預期代碼, err.message);
      }
    },
    結算: function () {
      const arr失敗 = arr結果.filter(function (o) { return !o.bool通過; });
      console.log(`==== 測試完成：通過 ${arr結果.length - arr失敗.length} 項，失敗 ${arr失敗.length} 項 ====`);
      return {
        int通過: arr結果.length - arr失敗.length,
        int失敗: arr失敗.length,
        arr失敗項目: arr失敗.map(function (o) { return o.str項目; })
      };
    }
  };
}


/**
 * ============================================================================
 * 函式名稱：測試_法會_純邏輯
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：自動測試不碰檔案的計算規則。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_純邏輯() {
  const t = 建立法會測試記錄器_();

  // ── 一、模組定義 ──
  const obj定義 = 模組定義_event();
  t.記錄('模組定義：活動型、有說明', obj定義.str型態 === '活動型' && obj定義.str說明 !== '');
  t.記錄('模組定義：可指派三項、不含管理活動',
    obj定義.arr可指派權限.length === 3 && obj定義.arr可指派權限.every(function (o) { return o.str項目 !== '管理活動'; }));
  const obj結構 = 主控台結構_event();
  t.記錄('主控台結構：三個分頁且欄位不重複', Object.keys(obj結構).length === 3 && Object.keys(obj結構).every(function (k) {
    const arr = obj結構[k].arr欄位;
    return arr.length > 0 && arr.every(function (s, i) { return arr.indexOf(s) === i; });
  }));
  const obj路由 = 路由定義_event();
  t.記錄('路由：每個 action 都以 event. 開頭且有處理函式', Object.keys(obj路由).every(function (k) {
    return k.indexOf('event.') === 0 && typeof obj路由[k].fn === 'function';
  }));
  t.記錄('路由：副本選單動作不需登入、其他需要登入', Object.keys(obj路由).every(function (k) {
    return (k.indexOf('event.副本') === 0) === (obj路由[k].bool需登入 === false);
  }));

  // ── 二、比對鍵與時間 ──
  t.記錄('比對鍵：去空白、全形轉半形、英文小寫', 正規化比對鍵_(' 王 小明 ') === '王小明' && 正規化比對鍵_('ＡＢｃ') === 'abc');
  t.記錄('比對鍵：空值為空字串', 正規化比對鍵_(null) === '' && 正規化比對鍵_(undefined) === '');
  const dat = new Date(2026, 9, 8, 17, 7, 52);
  t.記錄('時間：日期物件', 解析副本時間戳記_(dat) === dat.getTime());
  t.記錄('時間：文字「下午」', 解析副本時間戳記_('2026/10/8 下午 5:07:52') === dat.getTime());
  t.記錄('時間：文字「上午 12 點」為 0 點', 解析副本時間戳記_('2026/10/8 上午 12:00:00') === new Date(2026, 9, 8, 0, 0, 0).getTime());
  t.記錄('時間：看不懂為負無限大', 解析副本時間戳記_('不是時間') === -Infinity && 解析副本時間戳記_('') === -Infinity);

  // ── 三、重複群組 ──
  const arr資料 = [
    ['時間戳記', '姓名', '法名'],
    [new Date(2026, 0, 1), '王小明', '甲'],    // 第 2 列
    [new Date(2026, 0, 3), '王 小明', '乙'],   // 第 3 列：最晚，保留
    [new Date(2026, 0, 2), '王小明', '丙'],    // 第 4 列
    [new Date(2026, 0, 1), '李大華', ''],      // 第 5 列：不重複
    ['', '', '空白姓名'],                       // 第 6 列：不比對
    [new Date(2026, 0, 5), 'ABC', ''],         // 第 7 列
    [new Date(2026, 0, 5), 'abc', '']          // 第 8 列：時間相同，保留較下方
  ];
  const arr組 = 分析重複群組_(arr資料, 1, 0);
  t.記錄('重複：找出 2 組', arr組.length === 2, arr組.map(function (o) { return o.str顯示鍵值; }).join('、'));
  t.記錄('重複：保留時間最晚的第 3 列，移出第 2、4 列',
    arr組[0].int保留索引 === 2 && arr組[0].arr移出索引.join(',') === '1,3');
  t.記錄('重複：時間相同保留較下方', arr組[1].int保留索引 === 7 && arr組[1].arr移出索引.join(',') === '6');
  const arr無時間 = 分析重複群組_(arr資料, 1, -1);
  t.記錄('重複：沒有時間欄時保留最下方', arr無時間[0].int保留索引 === 3);

  // ── 四、欄位尋找與字母 ──
  const arr標題 = ['時間戳記', '緊急聯絡人(姓名)', '報名者姓名', '法名 '];
  t.記錄('欄位：別名找到「報名者姓名」，不誤認緊急聯絡人', 尋找副本欄位索引_(arr標題, '姓名') === 2);
  t.記錄('欄位：忽略空白', 尋找副本欄位索引_(arr標題, '法名') === 3);
  t.記錄('欄位：找不到為 -1', 尋找副本欄位索引_(arr標題, '手機') === -1);
  t.記錄('欄位字母', 轉為欄位字母_(1) === 'A' && 轉為欄位字母_(26) === 'Z' && 轉為欄位字母_(27) === 'AA' && 轉為欄位字母_(703) === 'AAA');
  t.記錄('同名欄位對應鍵', 建立欄位對應鍵_(['備註', '姓名', '備註']).join(',') === '備註#1,姓名#1,備註#2');

  // ── 五、輸入檢查 ──
  t.記錄('活動名稱：去空白', 檢查活動名稱_('  2026 觀音法會 ') === '2026 觀音法會');
  t.預期錯誤('活動名稱：空白', obj錯誤代碼.參數錯誤, function () { 檢查活動名稱_('  '); });
  t.預期錯誤('活動名稱：含斜線', obj錯誤代碼.參數錯誤, function () { 檢查活動名稱_('11/28 法會'); });
  t.預期錯誤('活動名稱：太長', obj錯誤代碼.參數錯誤, function () { 檢查活動名稱_('一'.repeat(41)); });
  const dat日期 = 解析活動日期_('2026-11-28');
  t.記錄('活動日期：正確', dat日期.getFullYear() === 2026 && dat日期.getMonth() === 10 && dat日期.getDate() === 28);
  t.記錄('活動日期：選填', 解析活動日期_('') === '');
  t.預期錯誤('活動日期：不存在的日期', obj錯誤代碼.參數錯誤, function () { 解析活動日期_('2026-02-30'); });
  t.預期錯誤('活動日期：格式不對', obj錯誤代碼.參數錯誤, function () { 解析活動日期_('2026/11/28'); });
  t.記錄('帳號清單：分隔符號、大小寫、重複',
    分割帳號清單_(' A@x.com，b@y.com; a@x.com\nc@z.com ').join(',') === 'a@x.com,b@y.com,c@z.com');
  t.記錄('帳號清單：陣列與空值', 分割帳號清單_(['B@y.com', '', null]).join(',') === 'b@y.com' && 分割帳號清單_('').length === 0);
  t.記錄('文字格式欄', 是否為文字格式欄_('手機號碼') && 是否為文字格式欄_('緊急聯絡人電話') && !是否為文字格式欄_('姓名'));

  // ── 六、權限判斷（不讀檔） ──
  const obj住持 = { str角色: obj角色.精舍管理員, str帳號: 'abbot@x.com', arr權限: [] };
  const obj承辦 = { str角色: obj角色.承辦人, str帳號: 'staff@x.com', arr權限: ['event.整理資料'] };
  const obj活動 = { 活動ID: 'A0001', 活動名稱: '測試法會', 承辦人: 'staff@x.com', 活動狀態: '收件中' };
  const obj別場 = { 活動ID: 'A0002', 活動名稱: '別場法會', 承辦人: 'other@x.com', 活動狀態: '收件中' };
  t.記錄('看得見：精舍管理員全部、承辦人只看指派的',
    可看見法會活動_(obj住持, obj別場) && 可看見法會活動_(obj承辦, obj活動) && !可看見法會活動_(obj承辦, obj別場));
  檢查活動權限_(obj住持, obj別場, obj法會權限.管理活動, '測試');
  t.記錄('精舍管理員可管理活動', true);
  t.預期錯誤('承辦人不能管理活動', obj錯誤代碼.權限不足, function () { 檢查活動權限_(obj承辦, obj活動, obj法會權限.管理活動, '測試'); });
  t.預期錯誤('承辦人不能整理別人的活動', obj錯誤代碼.權限不足, function () { 檢查活動權限_(obj承辦, obj別場, obj法會權限.整理資料, '測試'); });
  檢查活動權限_(obj承辦, obj活動, obj法會權限.整理資料, '測試');
  t.記錄('承辦人可整理自己的活動', true);
  t.預期錯誤('承辦人沒有匯出權限', obj錯誤代碼.權限不足, function () { 檢查活動權限_(obj承辦, obj活動, obj法會權限.匯出大車點名, '測試'); });
  t.預期錯誤('結束的活動不能同步', obj錯誤代碼.參數錯誤, function () {
    檢查活動狀態_({ 活動名稱: '測試', 活動狀態: '結束' }, arr法會可同步狀態, '同步');
  });

  // ── 回覆試算表列分類（v2.0.0：以列號＋時間戳記辨認） ──
  const fn時 = function (int秒) { return new Date(2026, 9, 20, 9, 0, int秒); };
  const fn來源 = function (arr) {   // arr：[ [列號, 秒] ]
    return { arr列: arr.map(function (a) { return { int列號: a[0], dat時間: fn時(a[1]), obj欄值: { 姓名: '列' + a[0] } }; }) };
  };
  const obj紀錄 = { 列2: { int列號: 2, int最後修改毫秒: fn時(0).getTime() }, 列3: { int列號: 3, int最後修改毫秒: fn時(1).getTime() },
    列4: { int列號: 4, int最後修改毫秒: fn時(5).getTime() } };
  let obj分 = 分類來源資料列_(fn來源([[2, 0], [3, 1], [4, 5], [5, 5], [6, 9]]), obj紀錄);
  t.記錄('列分類：新列號＝新報名（與舊報名同一秒也算新的）', obj分.arr新列.length === 2 && obj分.arr已修改.length === 0 && obj分.str異常說明 === '');
  obj分 = 分類來源資料列_(fn來源([[2, 0], [3, 30], [4, 5]]), obj紀錄);
  t.記錄('列分類：同列時間變新＝已修改', obj分.arr已修改.length === 1 && obj分.arr已修改[0].str鍵 === '列3' && obj分.str異常說明 === '');
  obj分 = 分類來源資料列_(fn來源([[2, 0], [3, 5]]), obj紀錄);
  t.記錄('列分類：刪掉中間一列＝異常', obj分.str異常說明.indexOf('刪除或重新排序') !== -1 && obj分.arr新列.length === 0);
  obj分 = 分類來源資料列_(fn來源([[2, 0], [3, 1]]), obj紀錄);
  t.記錄('列分類：刪掉最後一列＝異常', obj分.str異常說明.indexOf('不見了') !== -1);
  obj分 = 分類來源資料列_(fn來源([[2, 1], [3, 0], [4, 5]]), obj紀錄);
  t.記錄('列分類：排序（時間變舊或變成別列）＝異常', obj分.str異常說明 !== '');
  t.記錄('列分類：列鍵寫法', 來源列鍵_(12) === '列12');
  t.記錄('來源值：手機 9 碼補 0、其他欄不動', 整理來源值_('手機號碼', 912345678) === '0912345678' && 整理來源值_('人數', 3) === 3);

  return t.結算();
}
