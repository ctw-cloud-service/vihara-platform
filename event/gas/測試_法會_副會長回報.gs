// ============================================================================
// 檔案名稱：測試_法會_副會長回報.gs
// 所屬模組：法會活動（event）
// 所屬層級：測試
// 檔案版本：v1.0.0（2026-11-08）
// 用途說明：副會長回報表判讀與合併的純邏輯測試（GAS 編輯器執行 測試_法會_副會長回報純邏輯）。
//   表格內容取自「副會長-法會回報」的實際格式（簡化）。
// ============================================================================

/**
 * ============================================================================
 * 函式名稱：測試_法會_副會長回報純邏輯
 * 版本：v1.0.0（2026-11-08）
 * ----------------------------------------------------------------------------
 * 用途：自動測試出席判讀、職稱去除、日期來源（標題列／分頁名稱）、合併名冊與備註字樣。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_副會長回報純邏輯() {
  const t = 建立法會測試記錄器_();

  // ── 一、出席與姓名 ──
  const fn出 = 解析回報出席_;
  t.記錄('出席：V 椰墊／V 靠背椅／V 有執事', fn出('V 椰墊').str座位 === '椰墊' && fn出('V 靠背椅').str座位 === '靠背椅' && fn出('V 有執事').bool執事 && fn出('V 有執事').str出席 === '出席');
  t.記錄('出席：X 不參加、? 待確認、空白', fn出('X 不參加').str出席 === '不參加' && fn出('? 待確認').str出席 === '待確認' && fn出('').str出席 === '');
  t.記錄('姓名：去掉職稱（總監 簡宣和 → 簡宣和）', 去除職稱_('總監 簡宣和') === '簡宣和' && 去除職稱_('會長　隋濟美') === '隋濟美' && 去除職稱_('洪林從德') === '洪林從德');

  // ── 二、一頁 ──
  const arr頁 = [
    ['姓名', '法名', '性別', '出席', '備註', '不參加原因 X'],
    ['總監 簡宣和', '傳治', '男', 'X 不參加', '請假', ''],
    ['李美夷', '傳宓', '女', 'V 椰墊', '', ''],
    ['郭志聰', '傳恣', '男', 'V 靠背椅', '梵唄', ''],
    ['吳惠華', '傳白', '女', 'X 不參加', '媳婦傳輝+1', '媳婦楊俊英傳輝也參加+1'],
    ['蘇淑靖', '傳靖', '女', '? 待確認', '', ''],
    ['未回報', '傳無', '女', '', '', ''],
    ['', '', '', '', '', '']
  ];
  const p1 = 解析回報分頁_('11/14', arr頁);
  t.記錄('一頁：日期看分頁名稱 11/14', p1.int月 === 11 && p1.int日 === 14 && p1.bool有欄名);
  t.記錄('一頁：5 人（沒回報的不算）', p1.arr人員.length === 5, p1.arr人員.map(function (o) { return o.str姓名; }).join('、'));
  const fn找 = function (s) { return p1.arr人員.filter(function (o) { return o.str姓名 === s; })[0] || {}; };
  t.記錄('一頁：郭志聰 靠背椅、執事梵唄；簡宣和 不參加・請假', fn找('郭志聰').str座位 === '靠背椅' && fn找('郭志聰').str執事 === '梵唄' && fn找('簡宣和').str原因 === '請假');
  t.記錄('一頁：吳惠華 +1 提醒、原因合併', fn找('吳惠華').str提醒.indexOf('額外人數') !== -1 && fn找('吳惠華').str原因.indexOf('媳婦傳輝+1；') === 0);
  const p2 = 解析回報分頁_('1220金剛寶懺卷中', [['11/07 三昧水懺 卷下']].concat(arr頁));
  t.記錄('標題列的日期優先於分頁名稱', p2.int月 === 11 && p2.int日 === 7);
  // 欄位異動：欄名換同義字、順序打亂、多插一欄，仍讀得到（v1.1.0）
  const p變 = 解析回報分頁_('11/14', [
    ['組別', '是否參加', '學員姓名', '執事', '法名', '性別'],
    ['一組', 'V 靠背椅', '郭志聰', '梵唄', '傳恣', '男眾'],
    ['一組', 'X', '李美夷', '', '傳宓', '女']
  ]);
  const o變 = p變.arr人員.filter(function (o) { return o.str姓名 === '郭志聰'; })[0];
  t.記錄('欄位異動：同義欄名＋順序打亂 → 姓名、出席、座位、執事、性別都讀到', p變.bool有欄名 && o變 && o變.str出席 === '出席' && o變.str座位 === '靠背椅'
    && o變.str執事 === '梵唄' && o變.str性別 === '男' && p變.arr人員.length === 2, JSON.stringify(p變.arr人員));
  t.記錄('沒有日期：月日 0；沒有欄名：不判讀', 解析回報分頁_('工作表1', arr頁).int月 === 0 && 解析回報分頁_('11/1', [['隨便']]).bool有欄名 === false);

  // ── 三、合併 ──
  const arr名冊 = [
    { str場次: 'S', str姓名: '李美夷', str法名: '', str報名內容: '參加', arr提醒: [], obj帶入: {} },
    { str場次: 'S', str姓名: '簡宣和', str法名: '傳治', str報名內容: '參加', arr提醒: [], obj帶入: {} },
    { str場次: 'S', str姓名: '蘇淑靖', str法名: '法靖', str報名內容: '參加', arr提醒: [], obj帶入: {} }
  ];
  const obj合 = 合併回報人員_(arr名冊, p1.arr人員, { str場次: 'S', dat日期: new Date(2026, 10, 14) }, []);
  t.記錄('合併：已報名出席 1、新增出席 1（郭志聰）、不參加 1、待確認 1、沒報名不參加略過 1', obj合.int出席已在 === 1 && obj合.int出席新增 === 1 && obj合.int不參加 === 1 && obj合.int待確認 === 1 && obj合.int略過不參加 === 1, JSON.stringify(obj合));
  t.記錄('合併：李美夷補上法名傳宓、座位椰墊', arr名冊[0].str法名 === '傳宓' && arr名冊[0].obj回報.str座位 === '椰墊');
  t.記錄('合併：蘇淑靖法名不同 → 提醒；待確認 → 提醒', arr名冊[2].arr提醒.some(function (s) { return s.indexOf('法名是「傳靖」') !== -1; }) && arr名冊[2].arr提醒.indexOf('副會長回報待確認') !== -1);
  const o郭 = arr名冊.filter(function (o) { return o.str姓名 === '郭志聰'; })[0];
  t.記錄('合併：郭志聰加入，報名內容「副會長回報出席（梵唄）」、來源列「副會長回報」', o郭 && o郭.str報名內容 === '副會長回報出席（梵唄）' && o郭.arr來源.join(',') === '副會長回報' && o郭.obj標準['義工組別'] === '梵唄' && o郭.str法名 === '傳恣');

  // ── 四、說明與設定 ──
  t.記錄('備註：靠背椅・梵唄／椰墊不寫／不參加：請假／待確認', 組合回報說明_('出席', '靠背椅', '梵唄', '') === '靠背椅・梵唄' && 組合回報說明_('出席', '椰墊', '', '') === ''
    && 組合回報說明_('不參加', '', '', '請假') === '不參加：請假' && 組合回報說明_('待確認', '', '', '') === '待確認');
  t.記錄('活動設定：空白＝合併', 取得活動回報設定_({}) === '合併' && 取得活動回報設定_({ '合併副會長回報': '不合併' }) === '不合併');
  const obj路由 = 路由定義_event();
  t.記錄('路由：設定副會長回報表；活動清單有「合併副會長回報」欄', obj路由['event.設定副會長回報表'] && typeof obj路由['event.設定副會長回報表'].fn === 'function'
    && 主控台結構_event().活動清單.arr欄位.indexOf('合併副會長回報') !== -1);
  t.記錄('名冊欄位：回報整合在備註，不另列回報座位等欄，也不佔用承辦人自加的「座位」', obj報到名冊格式.arr固定欄位.indexOf('回報座位') === -1 && obj報到名冊格式.arr固定欄位.indexOf('座位') === -1 && obj報到名冊格式.arr固定欄位.indexOf('備註') !== -1);

  return t.結算();
}
