// ============================================================================
// 檔案名稱：測試_法會_活動編號.gs
// 所屬模組：法會活動（event）
// 所屬層級：測試（上線後可保留，不影響正式功能）
// 檔案版本：v1.0.0（2026-11-06）
// 用途說明：
//   在 Apps Script 編輯器執行：
//     · 測試_法會_活動編號純邏輯（數秒）：年度編號格式、流水號名稱、跳過已存在的編號、
//       判斷活動流水號名稱。不碰任何檔案。
//     · 測試_法會_活動編號（約 1～2 分鐘）：在暫存測試精舍測試預設「每年歸零」、讀取設定與預覽、
//       權限、切換「續編」與切回時跳過已存在的編號（不撞號）。不會動到正式精舍。
// ============================================================================


/**
 * ============================================================================
 * 函式名稱：測試_法會_活動編號純邏輯
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：自動測試年度活動編號中不碰檔案的部分。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_活動編號純邏輯() {
  const t = 建立法會測試記錄器_();

  // 編號格式
  t.記錄('格式：2027-001', 組合活動ID_(2027, 1) === '2027-001');
  t.記錄('格式：2026-050', 組合活動ID_(2026, 50) === '2026-050');
  t.記錄('格式：超過 999 自動變 4 位', 組合活動ID_(2027, 1000) === '2027-1000');

  // 流水號名稱
  t.記錄('流水號名稱：每年歸零＝法會活動_2027', 取得活動流水號名稱_('每年歸零', 2027) === '法會活動_2027');
  t.記錄('流水號名稱：續編＝法會活動（與舊 A 編號共用，號碼接續）', 取得活動流水號名稱_('續編', 2027) === '法會活動');
  t.記錄('流水號名稱：不認得的方式當成每年歸零', 取得活動流水號名稱_('亂寫', 2027) === '法會活動_2027');
  t.記錄('預設編號方式＝每年歸零', obj法會設定.str預設編號方式 === '每年歸零');

  // 跳過已存在的編號
  const arr已用 = ['2026-001', '2026-002', 'A0003', '2027-001'];
  t.記錄('跳號：1、2 已用 → 3', 找出未使用的號碼_(2026, 1, arr已用) === 3);
  t.記錄('跳號：沒有撞號時不跳', 找出未使用的號碼_(2026, 5, arr已用) === 5);
  t.記錄('跳號：舊 A 編號不影響年度編號', 找出未使用的號碼_(2026, 3, arr已用) === 3);
  t.記錄('跳號：不同年度分開判斷', 找出未使用的號碼_(2027, 1, arr已用) === 2 && 找出未使用的號碼_(2028, 1, arr已用) === 1);

  // 判斷活動流水號名稱（重置法會資料用）
  t.記錄('流水號名稱判斷：法會活動、法會活動_2027 是',
    是活動流水號名稱_({ '名稱': '法會活動' }) && 是活動流水號名稱_({ '名稱': '法會活動_2027' }));
  t.記錄('流水號名稱判斷：臨時編號、法會活動_abc、法會活動X 不是',
    !是活動流水號名稱_({ '名稱': '臨時編號' }) && !是活動流水號名稱_({ '名稱': '法會活動_abc' }) && !是活動流水號名稱_({ '名稱': '法會活動X' }));

  // 年度
  t.記錄('年度：四位數西元年', /^\d{4}$/.test(String(取得目前年度_())));
  return t.結算();
}


/**
 * ============================================================================
 * 函式名稱：測試_法會_活動編號
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：在暫存測試精舍測試年度活動編號與編號方式設定。
 * 參數：無
 * 傳回：{Object} { int通過, int失敗, arr失敗項目 }
 * ============================================================================
 */
function 測試_法會_活動編號() {
  const t = 建立法會測試記錄器_();
  let obj環境 = null;

  try {
    obj環境 = 建立法會測試環境_();
    const obj住持 = obj環境.obj住持;
    const obj主控台 = 開啟法會主控台_('TC');
    const int年 = 取得目前年度_();
    let int表單序 = 0;
    const fn新增 = function () {
      int表單序 += 1;
      const obj表單 = 建立法會測試表單_(obj環境, `編號${int表單序}`);
      送出法會測試回應_(obj表單, [{ 姓名: '王小明', 法名: '', 手機號碼: '0912345678', 參加日期: ['11/28'] }]);
      const str活動ID = 新增法會活動(obj住持, { str活動名稱: `編號測試${int表單序}`, str活動類型: '對內', str來源網址: obj表單.obj回覆表.getUrl() }).obj活動.str活動ID;
      obj環境.arr暫存檔.push(String(取得法會活動_(obj主控台, str活動ID).obj值['副本ID']).trim());
      return str活動ID;
    };

    // 主控台結構版本 3：有「模組設定」分頁
    t.記錄('主控台有「模組設定」分頁', obj主控台.getSheetByName('模組設定') !== null);

    // 預設每年歸零
    const obj設定一 = 讀取活動編號設定(obj住持, {});
    t.記錄('預設：每年歸零、下一場為今年-001', obj設定一.str方式 === '每年歸零' && obj設定一.str下一個編號 === 組合活動ID_(int年, 1), JSON.stringify(obj設定一));
    const str第一 = fn新增();
    t.記錄('第一場活動編號＝今年-001', str第一 === 組合活動ID_(int年, 1), str第一);
    t.記錄('預覽：下一場為今年-002（預覽不會用掉號碼）', 讀取活動編號設定(obj住持, {}).str下一個編號 === 組合活動ID_(int年, 2)
      && 讀取活動編號設定(obj住持, {}).str下一個編號 === 組合活動ID_(int年, 2));

    // 權限與輸入
    t.預期錯誤('承辦人不能讀取編號設定', obj錯誤代碼.權限不足, function () { 讀取活動編號設定(obj環境.重新判定(obj環境.str承辦甲), {}); });
    t.預期錯誤('承辦人不能修改編號方式', obj錯誤代碼.權限不足, function () { 設定活動編號方式(obj環境.重新判定(obj環境.str承辦甲), { str方式: '續編' }); });
    t.預期錯誤('不認得的方式停止', obj錯誤代碼.參數錯誤, function () { 設定活動編號方式(obj住持, { str方式: '隨便' }); });

    // 切換續編：「法會活動」流水號從 1 起算，會算到已存在的今年-001 → 跳過
    const obj設定續編 = 設定活動編號方式(obj住持, { str方式: '續編' });
    t.記錄('設定續編成功', obj設定續編.bool成功 && 讀取活動編號設定(obj住持, {}).str方式 === '續編', obj設定續編.str訊息);
    t.記錄('續編預覽跳過已存在的今年-001', 讀取活動編號設定(obj住持, {}).str下一個編號 === 組合活動ID_(int年, 2));
    const str第二 = fn新增();
    t.記錄('續編：第二場為今年-002（跳過已存在的編號，不撞號）', str第二 === 組合活動ID_(int年, 2), str第二);

    // 切回每年歸零：今年流水號目前是 1，下一號 2 已存在 → 跳到 3
    設定活動編號方式(obj住持, { str方式: '每年歸零' });
    const str第三 = fn新增();
    t.記錄('切回每年歸零：第三場為今年-003（不撞號）', str第三 === 組合活動ID_(int年, 3), str第三);
    t.記錄('模組設定只有一列（更新而不是新增）', 取得法會分頁_(obj主控台, '模組設定').obj分頁.getLastRow() === 2);
    const arr全部 = 讀取法會活動清單_(obj主控台).map(function (o) { return String(o.obj值['活動ID']).trim(); });
    t.記錄('三場活動編號都不重複', arr全部.length === 3 && arr全部.filter(function (s, i) { return arr全部.indexOf(s) === i; }).length === 3, arr全部.join(','));

  } catch (err) {
    t.記錄('測試流程中斷', false, (err && err.message ? err.message : err) + (err && err.stack ? '\n' + err.stack : ''));
  } finally {
    清除法會測試環境_(obj環境);
  }
  return t.結算();
}
