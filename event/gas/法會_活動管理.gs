// ============================================================================
// 檔案名稱：法會_活動管理.gs
// 所屬模組：法會活動（event）
// 所屬層級：模組／控制層
// 檔案版本：v2.7.0（2026-11-08）
//   v2.7.0：列出活動附 obj合併來源（精舍有沒有設定兩份來源）；對內活動的 obj報到 加 str合併用齋、str合併副會長回報，
//           活動卡片上直接選要不要合併（決策 BK 補充）
//   v2.6.1：讀取編號設定一併傳回副會長回報表
//   v2.6.0：讀取編號設定一併傳回用齋登記表（精舍管理員在「四、法會報到」設定）；活動顯示資料加合併用齋
//   v2.5.1：顯示的報到碼補回開頭的 0（試算表把 084779 存成 84779）
//   v2.5.0：新增「取消活動」（整場活動不辦了：狀態「取消」、記取消原因到操作日誌；其餘同設為結束）；
//           「重新開啟」可用於結束或取消的活動；結束與取消都算停止（不能整理、匯出、報到）
//   v2.4.0：活動顯示資料加入 obj報到（報到碼、報到碼產生時間、報到時段），法會活動網頁「四、法會報到」用
//   v2.3.0（續）：活動編號改為年度編號「2027-001」，精舍管理員可選每年歸零或續編（event.讀取編號設定、event.設定編號方式）
//   v2.3.0：新增「重建副本」（活動保留、重新建立整理副本並下載報名）與「刪除活動」（副本與活動紀錄一起刪除），
//           限精舍管理員；已匯出到大車點名試算表的活動先擋下。建立副本的步驟抽成 建立並填入活動副本_ 共用
//   v2.2.0：新增活動時在副本寫入「法會活動類型」標記（副本選單依此只顯示該用的選單）
//   v2.1.0：活動可設期間（開始日期＋結束日期）；列出活動多傳回 str結束日期、str日期顯示
//   v2.0.0：新增活動只讀回覆試算表（系統帳號只需檢視者），不再開啟 Google 表單
//   v1.1.0：列出活動多傳回大車點名進度（obj點名）
//   v1.0.0：初版
// 用途說明：
//   活動的建立與生命週期：
//     · 列出活動（精舍管理員看全部；承辦人只看被指派的）
//     · 新增活動：檢查回覆試算表（系統帳號檢視者即可）→ 由範本建立整理副本 → 貼入原始資料 →
//       以列號登記每一筆報名 → 設定姓名重複標示 → 共享給精舍管理員與承辦人
//     · 設定承辦人（同步副本共享）、設為結束、取消活動、重新開啟
//   新增活動、設定承辦人、結束、取消、重新開啟只限精舍管理員（權限 event.管理活動）。
//
// 相依檔案：平台核心、法會_模組定義、法會_表單與副本、法會_重複檢查
// ============================================================================


// 新增活動時，報到範圍的預設值（對內活動）
const str法會預設報到範圍 = '不限';

// 測試專用：指定副本範本，正式執行時一律為 null（改讀指令碼屬性）
let str測試用法會範本ID_ = null;


/**
 * ============================================================================
 * 函式名稱：列出法會活動
 * 版本：v1.1.0（2026-11-08）　v1.1.0：附 obj合併來源（活動卡片的合併選項用）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.列出活動」。活動頁載入時呼叫，傳回登入者看得到的活動，
 *   以及每場活動登入者可以做哪些事（畫面據此顯示按鈕；實際權限仍由各動作檢查）。
 *
 * 參數：
 *   obj工作階段   {Object} 工作階段（精舍管理員或承辦人）
 *   obj參數       {Object} 不需要
 *
 * 傳回：
 *   {Object} { bool成功, bool可管理, obj合併來源: { bool有登記表, bool有回報表 }, arr活動: [ 見 整理活動顯示資料_ ] }
 * ============================================================================
 */
function 列出法會活動(obj工作階段, obj參數) {
  // 只有精舍內的精舍管理員、承辦人可以進入法會活動
  檢查角色(obj工作階段, [obj角色.精舍管理員, obj角色.承辦人], '查看法會活動');
  const obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);

  // 一次讀出需要的資料：活動、未處理提醒數、承辦人姓名
  const obj提醒數 = 計算未處理提醒數_(obj主控台);
  const obj姓名 = 讀取精舍人員姓名_(obj工作階段.str精舍代號);

  const arr活動 = 讀取法會活動清單_(obj主控台)
    .filter(function (obj列) { return 可看見法會活動_(obj工作階段, obj列.obj值); })
    .map(function (obj列) { return 整理活動顯示資料_(obj工作階段, obj列.obj值, obj提醒數, obj姓名); })
    .reverse();   // 新的活動排在前面

  // 精舍有沒有設定副會長回報表、用齋登記表（v1.1.0；讀不到當成沒有，不影響列出活動）
  let obj合併來源 = { bool有登記表: false, bool有回報表: false };
  try {
    const o = 整理合併來源資訊_(obj主控台, {});
    obj合併來源 = { bool有登記表: o.bool有登記表, bool有回報表: o.bool有回報表 };
  } catch (err) { /* 保持都沒有 */ }

  return {
    bool成功: true,
    bool可管理: 是否具備權限(obj工作階段, obj法會權限.管理活動),
    obj合併來源: obj合併來源,
    arr活動: arr活動
  };
}


/**
 * ============================================================================
 * 函式名稱：整理活動顯示資料_（內部使用）
 * 版本：v1.2.0（2026-11-07）　v1.2.0：加入 obj報到（報到碼、產生時間、報到時段）；v1.1.0：加入 obj點名（大車點名進度）
 * ----------------------------------------------------------------------------
 * 用途：把活動清單一列整理成前端用的格式（不回傳表單、來源試算表等內部代號）。
 * 參數：
 *   obj工作階段   {Object} 工作階段
 *   obj值         {Object} 活動清單一列的 obj值
 *   obj提醒數     {Object} { 活動ID: 未處理提醒數 }
 *   obj姓名       {Object} { 帳號: 姓名 }
 * 傳回：
 *   {Object} { str活動ID, str活動名稱, str活動類型, str活動狀態, str活動日期, str結束日期, str日期顯示, str副本網址,
 *              arr承辦人: [ { str帳號, str姓名 } ], str上次同步時間, int已同步筆數,
 *              int待處理提醒, str備註,
 *              obj點名: { str上次產生, str首次匯出, str上次匯出, str轉正式, str匯出分頁名稱, bool有匯出紀錄 },
 *              obj報到: { str報到碼（限能開放報到或整理資料的人）, str報到碼產生時間, str報到時段 },
 *              obj可做: { bool管理, bool整理, bool同步, bool匯出, bool報到 } }
 * ============================================================================
 */
function 整理活動顯示資料_(obj工作階段, obj值, obj提醒數, obj姓名) {
  const str活動ID = String(obj值['活動ID']).trim();
  const str狀態 = String(obj值['活動狀態']).trim();
  const str類型 = String(obj值['活動類型']).trim();
  const str副本ID = String(obj值['副本ID'] || '').trim();

  // 登入者對這場活動能做的事
  const bool管理員 = obj工作階段.str角色 === obj角色.精舍管理員;
  const bool被指派 = bool管理員 || 是否為活動承辦人_(obj工作階段, obj值);
  const fn有權限 = function (str權限) { return bool被指派 && 是否具備權限(obj工作階段, str權限); };
  const bool未結束 = arr法會停止狀態.indexOf(str狀態) === -1;   // v2.5.0：結束、取消都算停止

  return {
    str活動ID: str活動ID,
    str活動名稱: String(obj值['活動名稱']).trim(),
    str活動類型: str類型,
    str活動狀態: str狀態,
    str活動日期: 轉為日期文字_(obj值['活動日期'], 'yyyy-MM-dd'),
    str結束日期: 轉為日期文字_(obj值['結束日期'], 'yyyy-MM-dd'),
    str日期顯示: 組合活動日期文字_(obj值['活動日期'], obj值['結束日期']),
    str副本網址: str副本ID ? `https://docs.google.com/spreadsheets/d/${str副本ID}/edit` : '',
    arr承辦人: 分割帳號清單_(obj值['承辦人']).map(function (str帳號) {
      return { str帳號: str帳號, str姓名: obj姓名[str帳號] || '' };
    }),
    str上次同步時間: 轉為日期文字_(obj值['上次同步時間']),
    int已同步筆數: Number(obj值['已同步筆數']) || 0,
    int待處理提醒: obj提醒數[str活動ID] || 0,
    str報到範圍: String(obj值['報到範圍'] || '').trim(),
    // 法會報到（對內活動；v2.4.0，2026-11-07）：報到碼只給能開放報到或整理資料的人看
    obj報到: {
      str報到碼: (fn有權限(obj法會權限.開放報到) || fn有權限(obj法會權限.整理資料)) ? 正規化報到碼_(obj值['報到碼']) : '',   // v2.5.1：補回開頭的 0（法會_報到）
      str報到碼產生時間: 轉為日期文字_(obj值['報到碼產生時間']),
      str報到時段: String(obj值['報到時段'] || '').trim(),
      // 名冊合併設定（v2.7.0，對內活動；空白時用預設：午齋、合併）
      str合併用齋: str類型 === '對內' ? 取得活動用齋餐別_(obj值) : '',
      str合併副會長回報: str類型 === '對內' ? 取得活動回報設定_(obj值) : ''
    },
    str備註: String(obj值['備註'] || '').trim(),
    // 大車點名進度（對外活動；v1.1.0）
    obj點名: {
      str上次產生: 轉為日期文字_(obj值['上次產生點名時間']),
      str首次匯出: 轉為日期文字_(obj值['首次匯出時間']),
      str上次匯出: 轉為日期文字_(obj值['上次匯出時間']),
      str轉正式: 轉為日期文字_(obj值['轉正式時間']),
      str匯出分頁名稱: String(obj值['匯出分頁名稱'] || '').trim(),
      bool有匯出紀錄: String(obj值['匯出試算表ID'] || '').trim() !== ''
    },
    obj可做: {
      bool管理: 是否具備權限(obj工作階段, obj法會權限.管理活動),
      bool整理: bool未結束 && fn有權限(obj法會權限.整理資料),
      bool同步: arr法會可同步狀態.indexOf(str狀態) !== -1 && fn有權限(obj法會權限.整理資料),
      bool匯出: str類型 === obj法會活動類型.對外 && bool未結束 && fn有權限(obj法會權限.匯出大車點名),
      bool報到: str類型 === obj法會活動類型.對內 && bool未結束 && fn有權限(obj法會權限.開放報到)
    }
  };
}


/**
 * ============================================================================
 * 函式名稱：讀取精舍人員姓名_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：讀精舍設定「人員」分頁，建立「帳號 → 姓名」對照（顯示承辦人姓名用）。
 * 參數：
 *   str精舍代號   {string} 精舍代號
 * 傳回：{Object} { 帳號: 姓名 }
 * ============================================================================
 */
function 讀取精舍人員姓名_(str精舍代號) {
  const obj定義 = obj精舍設定結構.人員;
  const obj對照 = {};
  讀取全部資料列(取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁), obj定義.arr欄位)
    .forEach(function (obj列) {
      obj對照[正規化帳號(obj列.obj值['Google帳號'])] = String(obj列.obj值['姓名']).trim();
    });
  return obj對照;
}


/**
 * ============================================================================
 * 函式名稱：讀取啟用承辦人_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：本精舍啟用中的承辦人，以及每人已被指派的法會活動權限。
 * 參數：
 *   str精舍代號   {string} 精舍代號
 * 傳回：{Object[]} [ { str帳號, str姓名, arr權限: ['整理資料', …] } ]
 * ============================================================================
 */
function 讀取啟用承辦人_(str精舍代號) {
  const obj設定 = 取得精舍設定試算表(str精舍代號);

  // 每位承辦人在 event 模組被指派的項目
  const obj權限定義 = obj精舍設定結構.權限指派;
  const obj權限 = {};
  依條件尋找資料列(取得工作表(obj設定, obj權限定義.str分頁), obj權限定義.arr欄位, function (obj值) {
    return String(obj值['模組代號']).trim() === obj法會設定.str模組代號;
  }).forEach(function (obj列) {
    const str帳號 = 正規化帳號(obj列.obj值['Google帳號']);
    (obj權限[str帳號] = obj權限[str帳號] || []).push(String(obj列.obj值['權限項目']).trim());
  });

  // 啟用中的人員
  const obj人員定義 = obj精舍設定結構.人員;
  return 依條件尋找資料列(取得工作表(obj設定, obj人員定義.str分頁), obj人員定義.arr欄位, function (obj值) {
    return String(obj值['狀態']).trim() === obj狀態.啟用;
  }).map(function (obj列) {
    const str帳號 = 正規化帳號(obj列.obj值['Google帳號']);
    return { str帳號: str帳號, str姓名: String(obj列.obj值['姓名']).trim(), arr權限: obj權限[str帳號] || [] };
  });
}


/**
 * ============================================================================
 * 函式名稱：列出法會承辦人選項
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.列出承辦人選項」。新增活動、設定承辦人時的勾選清單。
 *   同時告訴畫面每人已有哪些法會權限，提醒精舍管理員「被指派但沒有權限」的情形。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} 不需要
 * 傳回：{Object} { bool成功, arr承辦人: [ { str帳號, str姓名, arr權限 } ] }
 * ============================================================================
 */
function 列出法會承辦人選項(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.管理活動, '設定承辦人');
  return { bool成功: true, arr承辦人: 讀取啟用承辦人_(obj工作階段.str精舍代號) };
}


/**
 * ============================================================================
 * 函式名稱：檢查承辦人清單_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：指派的帳號必須是本精舍啟用中的承辦人；不是的一次全部列出。
 * 參數：
 *   str精舍代號   {string}   精舍代號
 *   any承辦人     {string[]|string} 指派的帳號
 * 傳回：{string[]} 整理後的帳號清單
 * ============================================================================
 */
function 檢查承辦人清單_(str精舍代號, any承辦人) {
  const arr帳號 = 分割帳號清單_(any承辦人);
  if (arr帳號.length === 0) return arr帳號;

  const arr可用 = 讀取啟用承辦人_(str精舍代號).map(function (obj) { return obj.str帳號; });
  const arr不符 = arr帳號.filter(function (str帳號) { return arr可用.indexOf(str帳號) === -1; });
  if (arr不符.length > 0) {
    throw new 平台錯誤(
      obj錯誤代碼.參數錯誤,
      `下列帳號不是本精舍啟用中的承辦人：${arr不符.join('、')}。請先到「精舍設定 → 人員與權限」新增，或取消勾選。`
    );
  }
  return arr帳號;
}


/**
 * ============================================================================
 * 函式名稱：檢查活動名稱_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：活動名稱不可空白、不可太長、不可含分頁名稱不允許的符號。
 * 參數：
 *   any名稱   {string} 使用者輸入
 * 傳回：{string} 去除前後空白後的名稱
 * ============================================================================
 */
function 檢查活動名稱_(any名稱) {
  const str名稱 = String(any名稱 || '').trim().replace(/\s+/g, ' ');
  if (str名稱 === '') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '請輸入活動名稱。');
  }
  if (str名稱.length > obj法會設定.int活動名稱最長) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `活動名稱最多 ${obj法會設定.int活動名稱最長} 個字（目前 ${str名稱.length} 個字）。`);
  }
  if (obj法會設定.reg活動名稱禁用字元.test(str名稱)) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '活動名稱不可含有 [ ] * ? / \\ : 這些符號（大車點名系統的分頁名稱不允許）。');
  }
  return str名稱;
}


/**
 * ============================================================================
 * 函式名稱：解析活動日期_（內部使用）
 * 版本：v1.1.0（2026-10-28）　v1.1.0：可指定欄位名稱（開始日期、結束日期共用）
 * ----------------------------------------------------------------------------
 * 用途：日期為選填；有填就必須是 yyyy-MM-dd 且是真實存在的日期。
 * 參數：
 *   any日期     {string} 使用者輸入，例如 2026-11-28
 *   str欄位名稱 {string} 選填，錯誤訊息用；預設「活動日期」
 * 傳回：{Date|string} 日期物件；沒填時為空字串
 * ============================================================================
 */
function 解析活動日期_(any日期, str欄位名稱) {
  const str名稱 = str欄位名稱 || '活動日期';
  const str日期 = String(any日期 || '').trim();
  if (str日期 === '') return '';
  const arr = str日期.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  const dat = arr ? new Date(Number(arr[1]), Number(arr[2]) - 1, Number(arr[3])) : null;
  if (!dat || dat.getMonth() !== Number(arr[2]) - 1 || dat.getDate() !== Number(arr[3])) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `${str名稱}「${str日期}」看不懂，請用「2026-11-28」這樣的格式。`);
  }
  return dat;
}


/**
 * ============================================================================
 * 函式名稱：解析活動期間_（內部使用）
 * 版本：v2.1.0（2026-10-28）
 * ----------------------------------------------------------------------------
 * 用途：
 *   活動期間＝開始日期（活動日期欄）＋結束日期，兩者皆選填：
 *     · 都不填：沒有日期
 *     · 只填開始：單日活動
 *     · 兩者都填：期間；結束不可早於開始；與開始同一天時視為單日（結束日期不存）
 *     · 只填結束：請先填開始日期
 * 參數：
 *   any開始   {string} yyyy-MM-dd
 *   any結束   {string} yyyy-MM-dd
 * 傳回：{Object} { dat開始: Date|'', dat結束: Date|'' }
 * ============================================================================
 */
function 解析活動期間_(any開始, any結束) {
  const dat開始 = 解析活動日期_(any開始, '開始日期');
  const dat結束 = 解析活動日期_(any結束, '結束日期');
  if (dat結束 === '') return { dat開始: dat開始, dat結束: '' };
  if (dat開始 === '') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '有填結束日期時，請一併填開始日期（單日活動只要填開始日期）。');
  }
  if (dat結束.getTime() < dat開始.getTime()) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '結束日期不能早於開始日期，請再確認一次。');
  }
  return { dat開始: dat開始, dat結束: dat結束.getTime() === dat開始.getTime() ? '' : dat結束 };
}


/**
 * ============================================================================
 * 函式名稱：組合活動日期文字_（內部使用）
 * 版本：v2.1.0（2026-10-28）
 * ----------------------------------------------------------------------------
 * 用途：畫面顯示用：
 *     單日 → 2026-11-28
 *     同年期間 → 2026-11-28～12-02
 *     跨年期間 → 2026-12-30～2027-01-02
 *     沒有日期 → 空字串
 * 參數：any開始 {*}；any結束 {*}（活動清單的值）
 * 傳回：{string}
 * ============================================================================
 */
function 組合活動日期文字_(any開始, any結束) {
  const str開始 = 轉為日期文字_(any開始, 'yyyy-MM-dd');
  const str結束 = 轉為日期文字_(any結束, 'yyyy-MM-dd');
  if (str開始 === '') return '';
  if (str結束 === '' || str結束 === str開始) return str開始;
  return str開始 + '～' + (str結束.substring(0, 4) === str開始.substring(0, 4) ? str結束.substring(5) : str結束);
}


/**
 * ============================================================================
 * 函式名稱：取得法會副本範本ID_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：讀取指令碼屬性中的「法會活動副本範本ID」；尚未建立時說明怎麼處理。
 * 參數：無
 * 傳回：{string}
 * ============================================================================
 */
function 取得法會副本範本ID_() {
  // 測試程式會暫時指定範本，正式執行時一律讀指令碼屬性
  const str範本ID = (str測試用法會範本ID_ !== null)
    ? str測試用法會範本ID_
    : PropertiesService.getScriptProperties().getProperty(obj法會設定.str範本屬性名稱);
  if (!str範本ID || String(str範本ID).trim() === '') {
    throw new 平台錯誤(
      obj錯誤代碼.設定缺漏,
      '系統尚未建立「法會活動副本範本」，暫時無法新增活動。請通知系統管理員在 Apps Script 編輯器執行「建立法會副本範本」。'
    );
  }
  return String(str範本ID).trim();
}


/**
 * ============================================================================
 * 函式名稱：組合活動ID_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：純計算：年度＋流水號 → 「2027-001」（不足 3 位補 0；超過 999 自然變 4 位，例如 2027-1000）。
 * 參數：int年 {number} 西元年；int號碼 {number} 流水號
 * 傳回：{string}
 * ============================================================================
 */
function 組合活動ID_(int年, int號碼) {
  return `${int年}-${String(int號碼).padStart(obj法會設定.int活動流水號位數, '0')}`;
}


/**
 * ============================================================================
 * 函式名稱：取得活動流水號名稱_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：純計算：精舍設定「流水號」分頁中要用哪一個名稱：
 *         每年歸零 → 「法會活動_2027」（每年一個名稱，第一次使用時自動從 1 開始）
 *         續編     → 「法會活動」（跨年共用，2026-11-06 以前的 A 編號也是用這個，號碼接續）
 * 參數：str方式 {string} 每年歸零／續編；int年 {number}
 * 傳回：{string}
 * ============================================================================
 */
function 取得活動流水號名稱_(str方式, int年) {
  return str方式 === obj法會設定.obj編號方式.續編
    ? obj法會設定.str活動流水號名稱
    : `${obj法會設定.str活動流水號名稱}_${int年}`;
}


/**
 * ============================================================================
 * 函式名稱：找出未使用的號碼_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   純計算：從 int起始號 開始，找第一個「組成的活動ID 還沒被使用」的號碼。
 *   用在年中切換「每年歸零／續編」時：兩個流水號各自計數，可能算到已經存在的編號，跳過即可，不會撞號。
 * 參數：int年 {number}；int起始號 {number}；arr已用ID {string[]} 活動清單中所有活動ID
 * 傳回：{number}
 * ============================================================================
 */
function 找出未使用的號碼_(int年, int起始號, arr已用ID) {
  const obj已用 = {};
  (arr已用ID || []).forEach(function (s) { obj已用[String(s).trim()] = true; });
  let int號碼 = int起始號;
  while (obj已用[組合活動ID_(int年, int號碼)]) int號碼 += 1;
  return int號碼;
}


/**
 * ============================================================================
 * 函式名稱：取得目前年度_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：新增活動當天的西元年（依 GAS 專案時區，例如 Asia/Taipei）。
 * 參數：dat時間 {Date=} 省略時用現在
 * 傳回：{number}
 * ============================================================================
 */
function 取得目前年度_(dat時間) {
  return Number(Utilities.formatDate(dat時間 || new Date(), Session.getScriptTimeZone(), 'yyyy'));
}


/**
 * ============================================================================
 * 函式名稱：讀取模組設定值_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：讀主控台「模組設定」分頁中某個項目的值；沒有這個項目時傳回 str預設值。
 * 參數：obj主控台 {Spreadsheet}；str項目 {string}；str預設值 {string}
 * 傳回：{Object} { str值, int列號（沒有為 0）, str更新者, any更新時間 }
 * ============================================================================
 */
function 讀取模組設定值_(obj主控台, str項目, str預設值) {
  const obj表 = 取得法會分頁_(obj主控台, '模組設定');
  const arr = 依條件尋找資料列(obj表.obj分頁, obj表.arr欄位, function (o) { return String(o['項目']).trim() === str項目; });
  if (arr.length === 0) return { str值: str預設值, int列號: 0, str更新者: '', any更新時間: '' };
  const str值 = String(arr[0].obj值['值'] || '').trim();
  return { str值: str值 || str預設值, int列號: arr[0].int列號, str更新者: String(arr[0].obj值['更新者'] || '').trim(), any更新時間: arr[0].obj值['更新時間'] };
}


/**
 * ============================================================================
 * 函式名稱：讀取活動編號方式_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：這個精舍的活動編號方式（每年歸零／續編）；沒有設定或值不認得時用預設「每年歸零」。
 * 參數：obj主控台 {Spreadsheet}
 * 傳回：{string}
 * ============================================================================
 */
function 讀取活動編號方式_(obj主控台) {
  const str值 = 讀取模組設定值_(obj主控台, obj法會設定.str編號設定項目, obj法會設定.str預設編號方式).str值;
  return Object.prototype.hasOwnProperty.call(obj法會設定.obj編號方式, str值) ? str值 : obj法會設定.str預設編號方式;
}


/**
 * ============================================================================
 * 函式名稱：讀取活動流水號目前值_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：只讀不改：精舍設定「流水號」某名稱目前用到第幾號（沒有這個名稱＝0）。預覽下一個編號用。
 * 參數：str精舍代號 {string}；str名稱 {string}
 * 傳回：{number}
 * ============================================================================
 */
function 讀取活動流水號目前值_(str精舍代號, str名稱) {
  const obj定義 = obj精舍設定結構.流水號;
  const arr = 依條件尋找資料列(取得工作表(取得精舍設定試算表(str精舍代號), obj定義.str分頁), obj定義.arr欄位,
    function (o) { return String(o['名稱']).trim() === str名稱; });
  return arr.length > 0 ? (Number(arr[0].obj值['目前值']) || 0) : 0;
}


/**
 * ============================================================================
 * 函式名稱：產生法會活動ID_（內部使用）
 * 版本：v2.0.0（2026-11-06）　v2.0.0：改為年度編號「2027-001」，依精舍設定每年歸零或續編；跳過已存在的編號
 * ----------------------------------------------------------------------------
 * 用途：
 *   （鎖定中）依編號方式取精舍設定的流水號，組成活動ID：
 *     ① 讀編號方式 → 決定流水號名稱（每年歸零：法會活動_2027；續編：法會活動）
 *     ② 取下一號；組成的編號已存在（年中切換方式時可能發生）→ 找出下一個沒用過的號碼，
 *        並把流水號推進到那一號，下次不會再算到重複的
 *   號碼只增不減：刪除活動留下的空號不會再使用。
 * 參數：
 *   str精舍代號   {string}
 *   obj主控台     {Spreadsheet} 法會活動主控台
 * 傳回：{string} 例如 2027-001
 * ============================================================================
 */
function 產生法會活動ID_(str精舍代號, obj主控台) {
  return 執行並鎖定(function () {
    const int年 = 取得目前年度_();
    const str名稱 = 取得活動流水號名稱_(讀取活動編號方式_(obj主控台), int年);
    const int號碼 = 取得流水號區段(str精舍代號, str名稱, 1);
    const arr已用 = 讀取法會活動清單_(obj主控台).map(function (o) { return String(o.obj值['活動ID']).trim(); });
    const int可用 = 找出未使用的號碼_(int年, int號碼, arr已用);
    // 跳過的號碼一併用掉（流水號推進到 int可用）
    if (int可用 > int號碼) 取得流水號區段(str精舍代號, str名稱, int可用 - int號碼);
    return 組合活動ID_(int年, int可用);
  }, '產生活動編號');
}


/**
 * ============================================================================
 * 函式名稱：讀取活動編號設定
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：action「event.讀取編號設定」（限精舍管理員）。網頁「活動編號」卡片用：
 *       目前的編號方式、下一場活動的編號預覽（只讀，不會用掉號碼）、最後更新者。
 * 參數：obj工作階段 {Object}；obj參數 {Object} 不需要
 * 傳回：{Object} { bool成功, str方式, arr方式選項, str下一個編號, str更新者, str更新時間 }
 * ============================================================================
 */
function 讀取活動編號設定(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.管理活動, '活動編號設定');
  const str精舍代號 = obj工作階段.str精舍代號;
  const obj主控台 = 開啟法會主控台_(str精舍代號);
  const obj設定 = 讀取模組設定值_(obj主控台, obj法會設定.str編號設定項目, obj法會設定.str預設編號方式);
  const str方式 = 讀取活動編號方式_(obj主控台);
  const int年 = 取得目前年度_();
  const int下一號 = 讀取活動流水號目前值_(str精舍代號, 取得活動流水號名稱_(str方式, int年)) + 1;
  const arr已用 = 讀取法會活動清單_(obj主控台).map(function (o) { return String(o.obj值['活動ID']).trim(); });
  return {
    bool成功: true,
    str方式: str方式,
    arr方式選項: Object.keys(obj法會設定.obj編號方式),
    str下一個編號: 組合活動ID_(int年, 找出未使用的號碼_(int年, int下一號, arr已用)),
    str更新者: obj設定.str更新者,
    str更新時間: 轉為日期文字_(obj設定.any更新時間),
    // v2.6.0：用齋登記表（法會_用齋登記）
    str用齋登記表ID: 解析試算表ID_(讀取模組設定值_(obj主控台, obj用齋格式.str設定項目, '').str值),
    str副會長回報表ID: 解析試算表ID_(讀取模組設定值_(obj主控台, obj回報格式.str設定項目, '').str值)   // v2.6.1
  };
}


/**
 * ============================================================================
 * 函式名稱：設定活動編號方式
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.設定編號方式」（限精舍管理員）。寫入主控台「模組設定」：
 *     · 每年歸零：每年第一場活動從 001 開始（2026-050 → 2027-001）
 *     · 續編：號碼跨年接續（2026-050 → 2027-051）
 *   只影響之後新增的活動；已有的活動編號不變。年中切換時系統會跳過已存在的編號。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str方式 }
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 設定活動編號方式(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.管理活動, '活動編號設定');
  檢查必要參數(obj參數, ['str方式'], '活動編號設定');
  const str方式 = String(obj參數.str方式).trim();
  if (!Object.prototype.hasOwnProperty.call(obj法會設定.obj編號方式, str方式)) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '活動編號方式請選「每年歸零」或「續編」。');
  }
  const str精舍代號 = obj工作階段.str精舍代號;
  const obj主控台 = 開啟法會主控台_(str精舍代號);
  執行並鎖定(function () {
    const obj表 = 取得法會分頁_(obj主控台, '模組設定');
    const obj現值 = 讀取模組設定值_(obj主控台, obj法會設定.str編號設定項目, '');
    const obj新值 = { '項目': obj法會設定.str編號設定項目, '值': str方式, '更新者': obj工作階段.str帳號, '更新時間': new Date() };
    if (obj現值.int列號 > 0) 更新資料列(obj表.obj分頁, obj現值.int列號, obj新值);
    else 新增資料列(obj表.obj分頁, obj新值);
  }, '活動編號設定');
  寫入操作日誌(obj工作階段, '設定活動編號方式', str方式);
  const int年 = 取得目前年度_();
  return {
    bool成功: true,
    str訊息: `活動編號方式已設為「${str方式}」。`
      + (str方式 === obj法會設定.obj編號方式.續編
        ? `號碼跨年接續，例如 ${組合活動ID_(int年, 50)} 之後，明年第一場是 ${組合活動ID_(int年 + 1, 51)}。`
        : `每年第一場活動從 001 開始，例如明年第一場是 ${組合活動ID_(int年 + 1, 1)}。`)
      + '已有的活動編號不會改變。'
  };
}


/**
 * ============================================================================
 * 函式名稱：建立並填入活動副本_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   新增活動與重建副本共用：
 *     ① 從範本建立整理副本（核心「建立副本」：登記副本清單、共享給承辦人）
 *     ② 把回覆試算表的原始資料貼入「有效資料」，並整理出要登記到「已同步紀錄」的列
 *     ③ 副本記錄活動類型（失敗只提示）
 *     ④ 姓名重複標示（失敗只提示）
 *   ①之後任何一步失敗：新副本移到垃圾桶、副本清單設為停用，再把錯誤往上丟。
 *   ※ 不寫主控台；登記主控台由呼叫端在鎖定中處理（失敗時呼叫端要用 丟棄活動副本_ 收拾）。
 * 參數：
 *   str精舍代號   {string}
 *   str活動ID     {string}
 *   str活動名稱   {string}
 *   str活動類型   {string}   對內／對外
 *   arr承辦人     {string[]} 指派帳號（共享為編輯者）
 *   obj來源分頁   {Sheet}    回覆試算表的回覆分頁
 *   str範本ID     {string}   法會副本範本
 * 傳回：{Object} { obj副本結果（建立副本的結果）, arr登記（已同步紀錄的列）, int貼入筆數, arr附註, dat現在 }
 * ============================================================================
 */
function 建立並填入活動副本_(str精舍代號, str活動ID, str活動名稱, str活動類型, arr承辦人, obj來源分頁, str範本ID) {
  // ① 建立副本
  const obj副本結果 = 建立副本({
    str精舍代號: str精舍代號,
    str模組代號: obj法會設定.str模組代號,
    str記錄ID: str活動ID,
    str範本ID: str範本ID,
    str副本名稱: `${str活動名稱}（${str活動ID}）`,
    arr指派帳號: arr承辦人
  });

  const arr附註 = [];
  try {
    // ② 貼入原始資料，並以同一次讀到的內容整理登記列
    const obj副本 = 開啟試算表(obj副本結果.str副本ID, `「${str活動名稱}」的整理副本`);
    const obj有效分頁 = 取得副本分頁_(obj副本, obj法會副本分頁.有效資料);
    const obj貼入 = 貼入原始資料_(obj來源分頁, obj有效分頁);
    const dat現在 = new Date();
    const arr登記 = obj貼入.arr登記.map(function (o) {
      return {
        '活動ID': str活動ID, '回應ID': o.str鍵, '送出時間': o.dat時間,
        '回應最後修改時間': o.dat時間, '複製方式': '首次複製', '複製時間': dat現在
      };
    });

    // ③ 副本記錄活動類型（副本選單依此只顯示該用的選單；失敗只提示，選單會兩個都顯示）
    try {
      標記副本活動類型_(obj副本, str活動類型);
    } catch (err) {
      arr附註.push(`副本未記錄活動類型（${err && err.message ? err.message : err}），副本上方會同時顯示「大車點名」與「法會報到」選單，不影響使用；系統管理員可執行「補齊副本活動類型」補上`);
    }

    // ④ 姓名重複標示（失敗只提示）
    try {
      套用重複標示_(obj副本);
    } catch (err) {
      arr附註.push(`姓名重複標示未設定（${err && err.message ? err.message : err}），可稍後在「同步與整理」按「重複標示」補設`);
    }

    return { obj副本結果: obj副本結果, arr登記: arr登記, int貼入筆數: obj貼入.int貼入筆數, arr附註: arr附註, dat現在: dat現在 };
  } catch (err) {
    丟棄活動副本_(str精舍代號, obj副本結果.str副本ID);
    throw err;
  }
}


/**
 * ============================================================================
 * 函式名稱：丟棄活動副本_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：整理副本移到垃圾桶（30 天內可還原），精舍設定「副本清單」對應列設為停用
 *       （核心沒有刪除副本清單列的功能，停用即不再同步共享）。兩步都失敗也不丟錯。
 * 參數：str精舍代號 {string}；str副本ID {string}
 * 傳回：{Object} { bool已丟棄, bool已停用, str原因 }
 * ============================================================================
 */
function 丟棄活動副本_(str精舍代號, str副本ID) {
  const obj結果 = { bool已丟棄: false, bool已停用: false, str原因: '' };
  if (!str副本ID) return obj結果;
  try { DriveApp.getFileById(str副本ID).setTrashed(true); obj結果.bool已丟棄 = true; }
  catch (err) { obj結果.str原因 = err && err.message ? err.message : String(err); }
  try { 設定副本狀態(str精舍代號, str副本ID, obj狀態.停用); obj結果.bool已停用 = true; }
  catch (errIgnore) { /* 副本清單沒有這一列（例如舊資料）時略過 */ }
  return obj結果;
}


/**
 * ============================================================================
 * 函式名稱：新增法會活動
 * 版本：v2.3.0（2026-11-06）　v2.3.0：建立副本步驟改呼叫 建立並填入活動副本_（行為不變）；v2.2.0：副本寫入「法會活動類型」標記；v2.1.0：可設活動期間（結束日期）
 *       v2.0.0（2026-10-27）　v2.0.0：只讀回覆試算表（系統帳號只需檢視者），以列號登記已下載的報名
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.新增活動」。精舍管理員登錄一場法會，系統一次完成：
 *     ① 檢查輸入（名稱不可重複、同一份回覆試算表不可登錄兩次、承辦人要是本精舍承辦人）
 *     ② 檢查回覆試算表：系統帳號要打得開（檢視者即可）、找得到表單回應分頁
 *     ③ 產生活動ID，由「法會活動副本範本」建立整理副本（平台核心處理共享）
 *     ④ 原始回覆整份貼入副本「有效資料」，以「回覆試算表列號」登記每一筆（同一次讀取，不會漏記）
 *     ⑤ 設定姓名重複標示與「重複檢查」分頁（失敗只提示，不影響建立）
 *     ⑥ 登記到主控台「活動清單」
 *   ③～⑥ 任一步失敗：副本移到垃圾桶、副本清單標為停用，不留半套資料。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str活動名稱, str活動類型（對內／對外）, str來源網址,
 *                            str活動日期（開始日期，選填 yyyy-MM-dd）, str結束日期（選填，期間活動才填）, arr承辦人（選填）, str備註（選填） }
 *
 * 傳回：{Object} { bool成功, str訊息, obj活動 }
 * ============================================================================
 */
function 新增法會活動(obj工作階段, obj參數) {
  // ── ① 權限與輸入 ──
  檢查權限(obj工作階段, obj法會權限.管理活動, '新增活動');
  檢查必要參數(obj參數, ['str活動名稱', 'str活動類型', 'str來源網址'], '新增活動');

  const str精舍代號 = obj工作階段.str精舍代號;
  const str活動名稱 = 檢查活動名稱_(obj參數.str活動名稱);
  const str活動類型 = String(obj參數.str活動類型).trim();
  if (!Object.prototype.hasOwnProperty.call(obj法會活動類型, str活動類型)) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, '活動類型請選「對內」（精舍內法會，要報到）或「對外」（要搭大車）。');
  }
  const obj期間 = 解析活動期間_(obj參數.str活動日期, obj參數.str結束日期);
  const arr承辦人 = 檢查承辦人清單_(str精舍代號, obj參數.arr承辦人);
  const str備註 = String(obj參數.str備註 || '').trim();

  // ── ② 回覆試算表與表單（先檢查完，才開始建立檔案） ──
  const obj主控台 = 開啟法會主控台_(str精舍代號);
  const obj來源 = 開啟報名來源_(obj參數.str來源網址);
  檢查活動不重複_(obj主控台, str活動名稱, obj來源.str來源ID);
  const str範本ID = 取得法會副本範本ID_();

  // ── ③～⑤ 活動ID、建立整理副本、貼入報名、標記類型、姓名重複標示（建立並填入活動副本_） ──
  const str活動ID = 產生法會活動ID_(str精舍代號, obj主控台);
  const obj建立 = 建立並填入活動副本_(str精舍代號, str活動ID, str活動名稱, str活動類型, arr承辦人, obj來源.obj來源分頁, str範本ID);
  const obj副本結果 = obj建立.obj副本結果;
  const arr登記 = obj建立.arr登記;
  const int貼入筆數 = obj建立.int貼入筆數;
  const int登記筆數 = arr登記.length;
  const arr附註 = obj建立.arr附註;
  const dat現在 = obj建立.dat現在;
  try {
    // ── ⑥ 登記到主控台（鎖定中再確認一次沒有重複） ──
    執行並鎖定(function () {
      檢查活動不重複_(obj主控台, str活動名稱, obj來源.str來源ID);
      if (arr登記.length > 0) 批次新增資料列(取得法會分頁_(obj主控台, '已同步紀錄').obj分頁, arr登記);
      新增資料列(取得法會分頁_(obj主控台, '活動清單').obj分頁, {
        '活動ID': str活動ID,
        '活動名稱': str活動名稱,
        '活動類型': str活動類型,
        '活動狀態': obj法會活動狀態.收件中,
        '活動日期': obj期間.dat開始,
        '結束日期': obj期間.dat結束,
        '來源試算表ID': obj來源.str來源ID,
        '表單ID': '',
        '來源分頁': obj來源.obj來源分頁.getName(),
        '副本ID': obj副本結果.str副本ID,
        '承辦人': arr承辦人.join(','),
        '報到範圍': str活動類型 === obj法會活動類型.對內 ? str法會預設報到範圍 : '',
        '上次同步時間': dat現在,
        '已同步筆數': arr登記.length,
        '建立者': obj工作階段.str帳號,
        '建立時間': dat現在,
        '備註': str備註
      });
    }, '登記新活動');
  } catch (err) {
    // 失敗：副本移到垃圾桶，副本清單標為停用
    丟棄活動副本_(str精舍代號, obj副本結果.str副本ID);
    throw err;
  }

  // 共享結果與其他提醒
  const obj共享 = obj副本結果.obj同步結果 || { arr失敗: [] };
  obj共享.arr失敗.forEach(function (obj失敗) { arr附註.push(`${obj失敗.str帳號} 共享失敗：${obj失敗.str原因}`); });
  if (int貼入筆數 > int登記筆數) arr附註.push(`回覆試算表中有 ${int貼入筆數 - int登記筆數} 列沒有時間戳記（不是表單寫入的列），已貼入副本但不列入同步紀錄`);

  寫入操作日誌(obj工作階段, '新增法會活動', `${str活動ID} ${str活動名稱}（${str活動類型}），貼入 ${int貼入筆數} 筆`);
  const obj新活動 = 取得法會活動_(obj主控台, str活動ID);
  return {
    bool成功: true,
    str訊息: `已新增「${str活動名稱}」（${str活動ID}），整理副本已建立，貼入 ${int貼入筆數} 筆報名。`
      + (arr附註.length > 0 ? `\n・${arr附註.join('\n・')}` : ''),
    obj活動: 整理活動顯示資料_(obj工作階段, obj新活動.obj值, {}, 讀取精舍人員姓名_(str精舍代號))
  };
}


/**
 * ============================================================================
 * 函式名稱：檢查活動不重複_（內部使用）
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：同一精舍的活動名稱不可重複（忽略空白與英文大小寫）；同一份回覆試算表不可登錄兩次。
 * 參數：
 *   obj主控台     {Spreadsheet} 主控台
 *   str活動名稱   {string}      新活動名稱
 *   str來源ID     {string}      回覆試算表代號
 * 傳回：無
 * ============================================================================
 */
function 檢查活動不重複_(obj主控台, str活動名稱, str來源ID) {
  const fn比對鍵 = function (str) { return String(str || '').replace(/\s/g, '').toLowerCase(); };
  讀取法會活動清單_(obj主控台).forEach(function (obj列) {
    const obj值 = obj列.obj值;
    if (fn比對鍵(obj值['活動名稱']) === fn比對鍵(str活動名稱)) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, `已經有名為「${obj值['活動名稱']}」的活動（${obj值['活動ID']}），請換一個名稱（例如加上年份）。`);
    }
    if (String(obj值['來源試算表ID']).trim() === str來源ID) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, `這份回覆試算表已登錄為「${obj值['活動名稱']}」（${obj值['活動ID']}），不需要再新增。`);
    }
  });
}


/**
 * ============================================================================
 * 函式名稱：設定法會承辦人
 * 版本：v1.0.0（2026-10-26）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.設定承辦人」。整組取代活動的承辦人，並立即同步副本共享
 *   （新承辦人加入編輯者、移除的承辦人取消共享；精舍管理員永遠保留）。
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str活動ID, arr承辦人 }（空陣列＝不指派任何承辦人）
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 設定法會承辦人(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.管理活動, '設定承辦人');
  檢查必要參數(obj參數, ['str活動ID'], '設定承辦人');

  const str精舍代號 = obj工作階段.str精舍代號;
  const obj主控台 = 開啟法會主控台_(str精舍代號);
  const obj活動 = 取得法會活動_(obj主控台, obj參數.str活動ID);
  const arr承辦人 = 檢查承辦人清單_(str精舍代號, obj參數.arr承辦人 || []);

  更新法會活動_(obj主控台, obj活動.obj值['活動ID'], { '承辦人': arr承辦人.join(',') });

  // 同步副本共享（失敗不影響承辦人設定，只提示）
  let str共享說明 = '';
  const str副本ID = String(obj活動.obj值['副本ID'] || '').trim();
  if (str副本ID) {
    try {
      const obj結果 = 設定副本指派(str精舍代號, str副本ID, arr承辦人);
      str共享說明 = obj結果.arr失敗.length > 0
        ? `（共享未完成：${obj結果.arr失敗.map(function (o) { return o.str帳號 + ' ' + o.str原因; }).join('；')}）`
        : '副本共享已更新。';
    } catch (err) {
      str共享說明 = '（副本共享未能更新，請稍後到精舍設定頁按「重新同步副本共享」。）';
    }
  }

  寫入操作日誌(obj工作階段, '設定法會承辦人', `${obj活動.obj值['活動ID']}：${arr承辦人.join('、') || '（無）'}`);
  return {
    bool成功: true,
    str訊息: `「${obj活動.obj值['活動名稱']}」的承辦人已更新為：${arr承辦人.join('、') || '（不指派）'}。${str共享說明}`
  };
}


/**
 * ============================================================================
 * 函式名稱：停止法會活動_（內部使用）
 * 版本：v1.0.0（2026-11-07）（由 結束法會活動 v1.0.0 拆出，結束與取消共用）
 * ----------------------------------------------------------------------------
 * 用途：
 *   把活動設為「結束」或「取消」。停止後不再同步、不能報到：
 *     · 對外活動曾匯出大車點名：把點名系統「活動配置」改為停用（點名試算表打不開時仍停止，並提醒手動停用）
 *     · 清除報到碼（報到志工立即無法再報到）
 *     · 副本改為「停用」：人員異動時不再自動調整共享（檔案與既有共享不變）
 *   已經是結束或取消時不能再設（請先「重新開啟」）。
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str活動ID, str原因（取消時選填） }
 *   str新狀態     {string} obj法會活動狀態.結束 或 obj法會活動狀態.取消
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 停止法會活動_(obj工作階段, obj參數, str新狀態) {
  const bool取消 = str新狀態 === obj法會活動狀態.取消;
  const str作業 = bool取消 ? '取消活動' : '結束活動';
  檢查權限(obj工作階段, obj法會權限.管理活動, str作業);
  檢查必要參數(obj參數, ['str活動ID'], str作業);

  const str精舍代號 = obj工作階段.str精舍代號;
  const obj主控台 = 開啟法會主控台_(str精舍代號);
  const obj活動 = 取得法會活動_(obj主控台, obj參數.str活動ID);
  const obj值 = obj活動.obj值;
  const str目前 = String(obj值['活動狀態']).trim();
  if (arr法會停止狀態.indexOf(str目前) !== -1) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${obj值['活動名稱']}」已經是「${str目前}」狀態${str目前 === str新狀態 ? '' : '，要改請先按「重新開啟」'}。`);
  }
  // 取消原因：選填，最多 100 字（只記在操作日誌）
  const str原因 = String(obj參數.str原因 || '').replace(/\s+/g, ' ').trim().slice(0, 100);

  // 對外活動：停用點名系統的活動配置（第②批提供；尚未部署時略過）
  const arr附註 = [];
  if (String(obj值['活動類型']).trim() === obj法會活動類型.對外 && String(obj值['匯出試算表ID'] || '').trim() !== ''
    && typeof 設定大車活動配置狀態_ === 'function') {
    try {
      設定大車活動配置狀態_(obj值, '停用');
      arr附註.push('大車點名系統「活動配置」已改為「停用」');
    } catch (err) {
      arr附註.push('大車點名試算表打不開，請手動把「活動配置」的狀態改為「停用」');
    }
  }

  更新法會活動_(obj主控台, obj值['活動ID'], { '活動狀態': str新狀態, '報到碼': '' });

  // 副本停用（失敗只提示）
  const str副本ID = String(obj值['副本ID'] || '').trim();
  if (str副本ID) {
    try { 設定副本狀態(str精舍代號, str副本ID, obj狀態.停用); } catch (err) { arr附註.push('副本狀態未能更新'); }
  }

  寫入操作日誌(obj工作階段, bool取消 ? '取消法會活動' : '結束法會活動',
    `${obj值['活動ID']} ${obj值['活動名稱']}${bool取消 && str原因 ? `　原因：${str原因}` : ''}`);
  const str對內 = String(obj值['活動類型']).trim() === obj法會活動類型.對內 ? '，報到碼已失效' : '';
  return {
    bool成功: true,
    str訊息: (bool取消
      ? `「${obj值['活動名稱']}」已取消${str原因 ? `（${str原因}）` : ''}，之後不再同步報名${str對內}；資料都保留，誤按可「重新開啟」。`
      : `「${obj值['活動名稱']}」已設為結束，之後不再同步報名${str對內}。`)
      + (arr附註.length > 0 ? `（${arr附註.join('；')}）` : '')
  };
}


/**
 * ============================================================================
 * 函式名稱：結束法會活動
 * 版本：v1.1.0（2026-11-07）　v1.1.0：改由 停止法會活動_ 執行（與取消活動共用）
 * ----------------------------------------------------------------------------
 * 用途：action「event.設為結束」。見 停止法會活動_。
 * 參數：obj工作階段 {Object} 精舍管理員；obj參數 {Object} { str活動ID }
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 結束法會活動(obj工作階段, obj參數) {
  return 停止法會活動_(obj工作階段, obj參數, obj法會活動狀態.結束);
}


/**
 * ============================================================================
 * 函式名稱：取消法會活動
 * 版本：v1.0.0（2026-11-07）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.取消活動」（限精舍管理員）。整場活動不辦了（例如颱風停辦）：
 *   狀態改為「取消」，其餘與「設為結束」相同（不再同步、報到碼失效、副本停用）；
 *   報名、名冊、報到紀錄都保留。誤按時用「重新開啟」恢復。
 * 參數：obj工作階段 {Object} 精舍管理員；obj參數 {Object} { str活動ID, str原因（選填） }
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 取消法會活動(obj工作階段, obj參數) {
  return 停止法會活動_(obj工作階段, obj參數, obj法會活動狀態.取消);
}


/**
 * ============================================================================
 * 函式名稱：重新開啟法會活動
 * 版本：v1.1.0（2026-11-07）　v1.1.0：取消的活動也可以重新開啟
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.重新開啟」。誤按結束或需要補資料時，把活動恢復：
 *     · 對外：曾轉正式 → 正式；曾匯出 → 演練；否則 → 收件中
 *       （曾匯出者把點名系統「活動配置」改回啟用，第②批功能）
 *     · 對內：→ 收件中（報到碼需重新開放報到時產生）
 *     · 副本改回「啟用」並立即同步共享
 *
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str活動ID }
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 重新開啟法會活動(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.管理活動, '重新開啟活動');
  檢查必要參數(obj參數, ['str活動ID'], '重新開啟活動');

  const str精舍代號 = obj工作階段.str精舍代號;
  const obj主控台 = 開啟法會主控台_(str精舍代號);
  const obj值 = 取得法會活動_(obj主控台, obj參數.str活動ID).obj值;
  檢查活動狀態_(obj值, [obj法會活動狀態.結束, obj法會活動狀態.取消], '重新開啟');

  // 決定恢復成哪個狀態
  let str新狀態 = obj法會活動狀態.收件中;
  const bool對外 = String(obj值['活動類型']).trim() === obj法會活動類型.對外;
  if (bool對外 && String(obj值['轉正式時間'] || '').trim() !== '') str新狀態 = obj法會活動狀態.正式;
  else if (bool對外 && String(obj值['首次匯出時間'] || '').trim() !== '') str新狀態 = obj法會活動狀態.演練;

  const arr附註 = [];
  if (bool對外 && String(obj值['匯出試算表ID'] || '').trim() !== '' && typeof 設定大車活動配置狀態_ === 'function') {
    try {
      設定大車活動配置狀態_(obj值, '啟用');
      arr附註.push('大車點名系統「活動配置」已改回「啟用」');
    } catch (err) {
      arr附註.push('大車點名試算表打不開，請手動把「活動配置」的狀態改回「啟用」');
    }
  }

  更新法會活動_(obj主控台, obj值['活動ID'], { '活動狀態': str新狀態 });

  // 副本恢復啟用並同步共享
  const str副本ID = String(obj值['副本ID'] || '').trim();
  if (str副本ID) {
    try {
      設定副本狀態(str精舍代號, str副本ID, obj狀態.啟用);
      同步副本共享(str精舍代號, str副本ID);
    } catch (err) {
      arr附註.push('副本共享未能同步，請稍後到精舍設定頁按「重新同步副本共享」');
    }
  }

  寫入操作日誌(obj工作階段, '重新開啟法會活動', `${obj值['活動ID']} ${obj值['活動名稱']} → ${str新狀態}`);
  return {
    bool成功: true,
    str訊息: `「${obj值['活動名稱']}」已重新開啟，目前狀態「${str新狀態}」。` + (arr附註.length > 0 ? `（${arr附註.join('；')}）` : '')
  };
}


