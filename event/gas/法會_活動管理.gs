/**
 * ============================================================================
 * 函式名稱：保留其他活動的列_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：純計算：從分頁的資料列（不含標題）中去掉屬於要刪除活動的列。
 *       空白列一併去掉（重寫時順便整理）。
 * 參數：
 *   arr列         {Array[]}  分頁第 2 列以後的值
 *   int活動ID欄   {number}   「活動ID」欄的索引（0 起算）
 *   arr刪除ID     {string[]} 要刪除的活動ID
 * 傳回：{Object} { arr保留: Array[], int刪除數 }
 * ============================================================================
 */
function 保留其他活動的列_(arr列, int活動ID欄, arr刪除ID) {
  let int刪除數 = 0;
  const arr保留 = (arr列 || []).filter(function (arr) {
    if (arr.join('').trim() === '') return false;
    if (arr刪除ID.indexOf(String(arr[int活動ID欄]).trim().toUpperCase()) !== -1) { int刪除數 += 1; return false; }
    return true;
  });
  return { arr保留: arr保留, int刪除數: int刪除數 };
}


/**
 * ============================================================================
 * 函式名稱：刪除主控台活動列_（內部使用）
 * 版本：v1.0.0（2026-11-05）
 * ----------------------------------------------------------------------------
 * 用途：
 *   刪除主控台某分頁中屬於指定活動的所有列。作法：讀出全部 → 留下其他活動的列 →
 *   清空資料列 → 寫回（已同步紀錄可能有上千列，逐列刪除太慢）。
 *   ※ 請在鎖定範圍內呼叫。
 * 參數：
 *   obj主控台   {Spreadsheet}
 *   str結構鍵   {string}   活動清單／已同步紀錄／修改提醒
 *   arr刪除ID   {string[]}
 * 傳回：{number} 刪除的列數
 * ============================================================================
 */
function 刪除主控台活動列_(obj主控台, str結構鍵, arr刪除ID) {
  const obj分頁 = 取得法會分頁_(obj主控台, str結構鍵).obj分頁;
  const int最後列 = obj分頁.getLastRow();
  if (int最後列 < 2) return 0;
  const int欄數 = Math.max(obj分頁.getLastColumn(), 1);
  const arr標題 = obj分頁.getRange(1, 1, 1, int欄數).getValues()[0].map(function (v) { return String(v).trim(); });
  const int活動ID欄 = arr標題.indexOf('活動ID');
  if (int活動ID欄 < 0) {
    throw new 平台錯誤(obj錯誤代碼.欄位缺漏, `主控台「${obj分頁.getName()}」找不到「活動ID」欄，請通知系統管理員。`);
  }
  const obj結果 = 保留其他活動的列_(obj分頁.getRange(2, 1, int最後列 - 1, int欄數).getValues(), int活動ID欄, arr刪除ID);
  if (obj結果.int刪除數 === 0) return 0;
  清空資料列_(obj分頁);
  if (obj結果.arr保留.length > 0) obj分頁.getRange(2, 1, obj結果.arr保留.length, int欄數).setValues(obj結果.arr保留);
  return obj結果.int刪除數;
}


/**
 * ============================================================================
 * 函式名稱：檢查可以重做活動_（內部使用）
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   重建副本、刪除活動共用的檢查（純計算，不碰檔案）：
 *     ① 確認名稱必須與活動名稱完全相同（去前後空白）
 *     ② 已匯出到大車點名試算表（匯出試算表ID 不是空白）→ 擋下，請先清除點名資料
 * 參數：
 *   obj值         {Object} 活動清單一列的 obj值
 *   str確認名稱   {string} 使用者輸入的活動名稱
 *   str作業名稱   {string} 重建副本／刪除活動
 * 傳回：無（不符合時丟出平台錯誤）
 * ============================================================================
 */
function 檢查可以重做活動_(obj值, str確認名稱, str作業名稱) {
  const str活動名稱 = String(obj值['活動名稱']).trim();
  if (String(str確認名稱 || '').trim() !== str活動名稱) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `確認用的活動名稱不符，沒有${str作業名稱}。請完整輸入「${str活動名稱}」。`);
  }
  if (String(obj值['匯出試算表ID'] || '').trim() !== '') {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤,
      `「${str活動名稱}」已匯出到大車點名試算表，不能直接${str作業名稱}。`
      + '請先到「三、大車點名」把活動設為結束，再按「清除點名資料」刪除點名試算表中這場活動的資料，之後就可以'
      + `${str作業名稱}。`);
  }
}


/**
 * ============================================================================
 * 函式名稱：重建法會副本
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.重建副本」（限精舍管理員）。整理副本做壞了要重做時使用：
 *   活動保留（活動ID、名稱、類型、日期、承辦人、回覆試算表、備註不變），
 *   用同一份回覆試算表重新建立整理副本、重新下載全部報名：
 *     ① 檢查：確認名稱、沒有匯出到大車點名試算表、沒有人正在同步或整理（活動作業鎖）
 *     ② 建立新副本並貼入報名（建立並填入活動副本_；失敗時新副本丟棄，舊副本與主控台完全不動）
 *     ③ （鎖定中）主控台：刪除這場活動的已同步紀錄、修改提醒，登記新的同步紀錄；
 *        活動清單換成新副本ID，狀態回到「收件中」，清除產生點名／匯出／轉正式時間與報到碼
 *        （主控台登記失敗時新副本丟棄，舊副本不動）
 *     ④ 舊副本移到垃圾桶（30 天內可還原）、副本清單設為停用
 *   舊副本中承辦人手動整理的內容（刪除的列、加的欄位、名冊分頁、出車資料）都不會帶到新副本。
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str活動ID, str確認名稱 }
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 重建法會副本(obj工作階段, obj參數) {
  // ── ① 權限與檢查 ──
  檢查權限(obj工作階段, obj法會權限.管理活動, '重建副本');
  檢查必要參數(obj參數, ['str活動ID', 'str確認名稱'], '重建副本');
  const str精舍代號 = obj工作階段.str精舍代號;
  const obj主控台 = 開啟法會主控台_(str精舍代號);
  const obj值 = 取得法會活動_(obj主控台, obj參數.str活動ID).obj值;
  檢查可以重做活動_(obj值, obj參數.str確認名稱, '重建副本');
  const str活動ID = String(obj值['活動ID']).trim();
  const str活動名稱 = String(obj值['活動名稱']).trim();
  const str活動類型 = String(obj值['活動類型']).trim();
  const str舊副本ID = String(obj值['副本ID'] || '').trim();

  const obj結果 = 以活動作業鎖執行_(str精舍代號, str活動ID, '重建副本', function () {
    // ── ② 先確認回覆試算表還打得開，再建立新副本（舊副本此時不動） ──
    const obj來源分頁 = 開啟活動來源分頁_(obj值);
    const arr承辦人 = 分割帳號清單_(obj值['承辦人']);
    const obj建立 = 建立並填入活動副本_(str精舍代號, str活動ID, str活動名稱, str活動類型, arr承辦人, obj來源分頁, 取得法會副本範本ID_());
    const str新副本ID = obj建立.obj副本結果.str副本ID;

    // ── ③ 主控台（鎖定中；更新活動清單直接用 更新資料列，避免重複上鎖） ──
    let obj刪除數;
    try {
      obj刪除數 = 執行並鎖定(function () {
        const obj活動 = 取得法會活動_(obj主控台, str活動ID);
        if (String(obj活動.obj值['副本ID'] || '').trim() !== str舊副本ID) {
          throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${str活動名稱}」的副本剛被其他人更換過，這次沒有重建。請重新整理頁面後再確認。`);
        }
        const int同步 = 刪除主控台活動列_(obj主控台, '已同步紀錄', [str活動ID]);
        const int提醒 = 刪除主控台活動列_(obj主控台, '修改提醒', [str活動ID]);
        if (obj建立.arr登記.length > 0) 批次新增資料列(取得法會分頁_(obj主控台, '已同步紀錄').obj分頁, obj建立.arr登記);
        更新資料列(取得法會分頁_(obj主控台, '活動清單').obj分頁, obj活動.int列號, {
          '副本ID': str新副本ID,
          '活動狀態': obj法會活動狀態.收件中,
          '報到碼': '', '報到碼產生時間': '',
          '匯出分頁名稱': '',
          '上次同步時間': obj建立.dat現在,
          '已同步筆數': obj建立.arr登記.length,
          '上次產生點名時間': '', '首次匯出時間': '', '上次匯出時間': '', '轉正式時間': ''
        });
        return { int同步: int同步, int提醒: int提醒 };
      }, '重建副本');
    } catch (err) {
      丟棄活動副本_(str精舍代號, str新副本ID);
      throw err;
    }

    // ── ④ 舊副本移到垃圾桶、副本清單停用（失敗只提示） ──
    const arr附註 = obj建立.arr附註.slice();
    if (str舊副本ID) {
      const obj丟棄 = 丟棄活動副本_(str精舍代號, str舊副本ID);
      if (!obj丟棄.bool已丟棄) arr附註.push(`舊的整理副本無法移到垃圾桶（${obj丟棄.str原因}），請到雲端硬碟手動刪除`);
    }
    const obj共享 = obj建立.obj副本結果.obj同步結果 || { arr失敗: [] };
    obj共享.arr失敗.forEach(function (o) { arr附註.push(`${o.str帳號} 共享失敗：${o.str原因}`); });
    if (obj建立.int貼入筆數 > obj建立.arr登記.length) {
      arr附註.push(`回覆試算表中有 ${obj建立.int貼入筆數 - obj建立.arr登記.length} 列沒有時間戳記，已貼入副本但不列入同步紀錄`);
    }
    return { int貼入筆數: obj建立.int貼入筆數, obj刪除數: obj刪除數, arr附註: arr附註 };
  });

  寫入操作日誌(obj工作階段, '重建副本', `${str活動ID} ${str活動名稱}：貼入 ${obj結果.int貼入筆數} 筆；`
    + `刪除舊同步紀錄 ${obj結果.obj刪除數.int同步} 列、修改提醒 ${obj結果.obj刪除數.int提醒} 列；舊副本 ${str舊副本ID || '（無）'}`);
  return {
    bool成功: true,
    str訊息: `已重建「${str活動名稱}」（${str活動ID}）的整理副本，重新下載 ${obj結果.int貼入筆數} 筆報名，活動狀態回到「收件中」。`
      + '舊副本已移到垃圾桶（30 天內可還原）。'
      + (obj結果.arr附註.length > 0 ? `\n・${obj結果.arr附註.join('\n・')}` : '')
  };
}


/**
 * ============================================================================
 * 函式名稱：刪除法會活動
 * 版本：v1.0.0（2026-11-06）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.刪除活動」（限精舍管理員；對內、對外都可以）。整場活動重做時使用：
 *     ① 檢查：確認名稱、沒有匯出到大車點名試算表、沒有人正在同步或整理
 *     ② （鎖定中）主控台刪除這場活動的活動清單、已同步紀錄、修改提醒
 *     ③ 整理副本移到垃圾桶（30 天內可還原）、副本清單設為停用
 *   刪除後可用同一份回覆試算表與同一個名稱重新新增活動；活動編號接續往下（流水號不倒回，不補空號）。
 *   不會動：Google 表單與回覆試算表、學員名冊、已配發的臨時編號、其他活動。
 * 參數：
 *   obj工作階段   {Object} 精舍管理員的工作階段
 *   obj參數       {Object} { str活動ID, str確認名稱 }
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 刪除法會活動(obj工作階段, obj參數) {
  // ── ① 權限與檢查 ──
  檢查權限(obj工作階段, obj法會權限.管理活動, '刪除活動');
  檢查必要參數(obj參數, ['str活動ID', 'str確認名稱'], '刪除活動');
  const str精舍代號 = obj工作階段.str精舍代號;
  const obj主控台 = 開啟法會主控台_(str精舍代號);
  const obj值 = 取得法會活動_(obj主控台, obj參數.str活動ID).obj值;
  檢查可以重做活動_(obj值, obj參數.str確認名稱, '刪除活動');
  const str活動ID = String(obj值['活動ID']).trim();
  const str活動名稱 = String(obj值['活動名稱']).trim();
  const str副本ID = String(obj值['副本ID'] || '').trim();

  const obj結果 = 以活動作業鎖執行_(str精舍代號, str活動ID, '刪除活動', function () {
    // ── ② 主控台（先刪紀錄：之後副本丟棄失敗也不會留下指向舊副本的活動） ──
    const obj刪除數 = 執行並鎖定(function () {
      return {
        int活動: 刪除主控台活動列_(obj主控台, '活動清單', [str活動ID]),
        int同步: 刪除主控台活動列_(obj主控台, '已同步紀錄', [str活動ID]),
        int提醒: 刪除主控台活動列_(obj主控台, '修改提醒', [str活動ID])
      };
    }, '刪除活動');

    // ── ③ 副本 ──
    const arr附註 = [];
    if (str副本ID) {
      const obj丟棄 = 丟棄活動副本_(str精舍代號, str副本ID);
      if (!obj丟棄.bool已丟棄) arr附註.push(`整理副本無法移到垃圾桶（${obj丟棄.str原因}），請到雲端硬碟手動刪除`);
    }
    return { obj刪除數: obj刪除數, arr附註: arr附註 };
  });

  寫入操作日誌(obj工作階段, '刪除活動', `${str活動ID} ${str活動名稱}（${String(obj值['活動類型']).trim()}）：`
    + `同步紀錄 ${obj結果.obj刪除數.int同步} 列、修改提醒 ${obj結果.obj刪除數.int提醒} 列；副本 ${str副本ID || '（無）'}`);
  return {
    bool成功: true,
    str訊息: `已刪除「${str活動名稱}」（${str活動ID}）。整理副本已移到垃圾桶（30 天內可還原）；`
      + '可以用同一份回覆試算表與同一個名稱重新新增活動，新活動的編號會接續往下。'
      + (obj結果.arr附註.length > 0 ? `\n・${obj結果.arr附註.join('\n・')}` : '')
  };
}

