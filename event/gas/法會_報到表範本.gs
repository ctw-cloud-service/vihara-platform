/**
 * ============================================================================
 * 函式名稱：範本欄位名稱_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：範本欄位 → 印在欄名列的文字（標準欄用定義的名稱，例如「需要坐椅子」印「坐椅子」；其他欄照原名）。
 * 參數：str鍵 {string}
 * 傳回：{string}
 * ============================================================================
 */
function 範本欄位名稱_(str鍵) {
  const obj = obj報到表範本格式.obj欄位定義[str鍵];
  return obj ? obj.str欄名 : str鍵;
}


/**
 * ============================================================================
 * 函式名稱：檢查報到表範本_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：整理並檢查一個範本（儲存前）：去空白、去重複；名稱與欄位規則不符時以白話說明擋下。
 *   規則：名稱 1～20 字、不可與內建範本同名；欄位 2～10 個；一定要有「姓名」與「時段」，姓名在時段之前；
 *         欄名不可含「"」等特殊符號以外的限制（只去頭尾空白）。
 * 參數：any名稱 {*}；any欄位 {string[]|string}（陣列，或以「、」「,」分隔的文字）
 * 傳回：{Object} { str名稱, arr欄位 }
 * 錯誤：參數錯誤（白話說明）
 * ============================================================================
 */
function 檢查報到表範本_(any名稱, any欄位) {
  const cfg = obj報到表範本格式;
  const str名稱 = String(any名稱 === undefined || any名稱 === null ? '' : any名稱).trim();
  if (str名稱 === '') throw new 平台錯誤(obj錯誤代碼.參數錯誤, '請填範本名稱，例如「義工版」。');
  if (str名稱.length > cfg.int名稱長度) throw new 平台錯誤(obj錯誤代碼.參數錯誤, `範本名稱請在 ${cfg.int名稱長度} 個字以內。`);
  if (cfg.arr內建.some(function (o) { return o.str名稱 === str名稱; })) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${str名稱}」是內建範本的名稱，請換一個名稱。`);
  }

  // 欄位：接受陣列或文字；去空白、去重複（保留第一次出現的位置）
  const arr原 = Array.isArray(any欄位) ? any欄位 : String(any欄位 || '').split(/[、,，;；\n]/);
  const arr欄位 = [];
  arr原.forEach(function (v) {
    const s = String(v === undefined || v === null ? '' : v).trim();
    if (s !== '' && arr欄位.indexOf(s) === -1) arr欄位.push(s);
  });
  if (arr欄位.length > cfg.int最多欄位) throw new 平台錯誤(obj錯誤代碼.參數錯誤, `欄位最多 ${cfg.int最多欄位} 個（時段算 1 個），A4 直式放不下更多。`);
  if (arr欄位.some(function (s) { return s.length > 20; })) throw new 平台錯誤(obj錯誤代碼.參數錯誤, '欄位名稱請在 20 個字以內。');
  const int姓名 = arr欄位.indexOf('姓名');
  const int時段 = arr欄位.indexOf(cfg.str時段鍵);
  if (int姓名 === -1) throw new 平台錯誤(obj錯誤代碼.參數錯誤, '範本一定要有「姓名」欄。');
  if (int時段 === -1) throw new 平台錯誤(obj錯誤代碼.參數錯誤, '範本一定要有「時段」欄（報到打勾的地方）。');
  if (int姓名 > int時段) throw new 平台錯誤(obj錯誤代碼.參數錯誤, '「姓名」要排在「時段」前面。');
  return { str名稱: str名稱, arr欄位: arr欄位 };
}


/**
 * ============================================================================
 * 函式名稱：解析自訂報到表範本_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：主控台「模組設定」的範本 JSON → 自訂範本陣列。格式錯誤或不合規則的範本略過（不讓列印失敗）。
 * 參數：str值 {string}
 * 傳回：{Object[]} [ { str名稱, arr欄位 } ]
 * ============================================================================
 */
function 解析自訂報到表範本_(str值) {
  if (!str值) return [];
  let arr;
  try { arr = JSON.parse(str值); } catch (err) { return []; }
  if (!Array.isArray(arr)) return [];
  const arr結果 = [];
  arr.forEach(function (o) {
    try {
      const obj = 檢查報到表範本_(o && o.str名稱, o && o.arr欄位);
      if (!arr結果.some(function (x) { return x.str名稱 === obj.str名稱; })) arr結果.push(obj);
    } catch (err) { /* 壞掉的範本略過 */ }
  });
  return arr結果;
}


/**
 * ============================================================================
 * 函式名稱：找出報到表範本_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：依名稱找範本（內建＋自訂）；空白＝標準；找不到（範本被刪了）→ 用標準並附提醒。
 * 參數：arr自訂 {Object[]}；any名稱 {*}
 * 傳回：{Object} { obj範本: { str名稱, arr欄位, bool內建 }, str提醒 }
 * ============================================================================
 */
function 找出報到表範本_(arr自訂, any名稱) {
  const cfg = obj報到表範本格式;
  const str名稱 = String(any名稱 === undefined || any名稱 === null ? '' : any名稱).trim() || cfg.str預設;
  const arr全部 = 列出全部報到表範本_(arr自訂);
  const obj = arr全部.filter(function (o) { return o.str名稱 === str名稱; })[0];
  if (obj) return { obj範本: obj, str提醒: '' };
  return {
    obj範本: arr全部[0],
    str提醒: `這場活動選的報到表範本「${str名稱}」已不存在（可能被刪除或改名），改用「${cfg.str預設}」範本；請到活動卡片重新選擇。`
  };
}


/**
 * ============================================================================
 * 函式名稱：列出全部報到表範本_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：內建範本在前、自訂範本在後；每個附 bool內建。
 * 參數：arr自訂 {Object[]}
 * 傳回：{Object[]} [ { str名稱, arr欄位, bool內建 } ]
 * ============================================================================
 */
function 列出全部報到表範本_(arr自訂) {
  return obj報到表範本格式.arr內建.map(function (o) { return { str名稱: o.str名稱, arr欄位: o.arr欄位.slice(), bool內建: true }; })
    .concat((arr自訂 || []).map(function (o) { return { str名稱: o.str名稱, arr欄位: o.arr欄位.slice(), bool內建: false }; }));
}


/**
 * ============================================================================
 * 函式名稱：展開範本欄位_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：
 *   範本欄位 → 報到表實際的每一欄（時段展開成每個時段一欄），並自動算欄寬：
 *     ① 一般欄用預設寬度（名冊其他欄 80）
 *     ② 時段欄平分剩下的寬度，最多 130；
 *     ③ 剩下不夠每個時段 50 → 一般欄（序號除外）等比例縮小（最少 32），bool擠＝true
 * 參數：
 *   arr欄位   {string[]} 範本欄位
 *   arr時段   {Object[]} 報到時段（不分時段傳空陣列；用 str名稱、str起迄）
 *   int可用寬 {number=}  欄寬合計（預設 obj報到表格式.int可用寬度）
 * 傳回：{Object} {
 *   arr欄: [ { str鍵, str欄名, str類: '序號'|'時段'|'欄', int時段序, int寬 } ],
 *   int時段起欄（1 起算）, int時段數, bool擠
 * }
 * ============================================================================
 */
function 展開範本欄位_(arr欄位, arr時段, int可用寬) {
  const cfg = obj報到表範本格式;
  const cfg表 = obj報到表格式;
  const int寬度 = int可用寬 || cfg表.int可用寬度;
  const arr有效時段 = arr時段 && arr時段.length >= 2 ? arr時段 : [];
  const int時段數 = Math.max(arr有效時段.length, 1);

  // ① 欄位與預設寬度
  const arr欄 = [];
  let int時段起欄 = 0;
  (arr欄位 || []).forEach(function (str鍵) {
    if (str鍵 === cfg.str時段鍵) {
      int時段起欄 = arr欄.length + 1;
      for (let j = 0; j < int時段數; j++) {
        arr欄.push({
          str鍵: str鍵, str類: '時段', int時段序: j, int寬: 0,
          str欄名: arr有效時段.length > 0 ? `${arr有效時段[j].str名稱}\n${arr有效時段[j].str起迄}` : cfg表.str單一時段欄名
        });
      }
      return;
    }
    const obj定義 = cfg.obj欄位定義[str鍵];
    arr欄.push({
      str鍵: str鍵, str類: str鍵 === '序號' ? '序號' : '欄', int時段序: -1,
      str欄名: 範本欄位名稱_(str鍵), int寬: obj定義 ? obj定義.int寬 : cfg.int自訂欄寬
    });
  });

  // ② 時段欄平分剩下的寬度
  const arr一般 = arr欄.filter(function (o) { return o.str類 !== '時段'; });
  let int一般寬 = arr一般.reduce(function (n, o) { return n + o.int寬; }, 0);
  let int時段寬 = Math.min(cfg表.int時段欄寬上限, Math.floor((int寬度 - int一般寬) / int時段數));
  let bool擠 = false;

  // ③ 太擠：一般欄（序號除外）等比例縮小
  if (int時段寬 < cfg.int時段最小寬) {
    bool擠 = true;
    int時段寬 = cfg.int時段最小寬;
    const int目標 = int寬度 - int時段寬 * int時段數;
    const arr可縮 = arr一般.filter(function (o) { return o.str類 !== '序號'; });
    const int不縮 = int一般寬 - arr可縮.reduce(function (n, o) { return n + o.int寬; }, 0);
    const num比例 = Math.max(0, (int目標 - int不縮)) / Math.max(1, int一般寬 - int不縮);
    arr可縮.forEach(function (o) { o.int寬 = Math.max(cfg.int最小欄寬, Math.floor(o.int寬 * num比例)); });
    int一般寬 = arr一般.reduce(function (n, o) { return n + o.int寬; }, 0);
  }
  arr欄.forEach(function (o) { if (o.str類 === '時段') o.int寬 = int時段寬; });

  return { arr欄: arr欄, int時段起欄: int時段起欄, int時段數: int時段數, bool擠: bool擠 };
}


/**
 * ============================================================================
 * 函式名稱：取得報到欄位值_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：一位報到人員在某個範本欄位要顯示的文字（紙本與網頁表格共用）。
 *   姓名、法名、學員編號、報名登記：取得名冊報到人員_ 整理好的值；
 *   備註：提醒簡稱＋坐椅子・組別＋用齋（與以前的報到表備註相同）；
 *   名冊備註：名冊「備註」欄全文；其他：名冊同名欄（obj欄值），沒有就空白。
 * 參數：o {Object} 取得名冊報到人員_ 的一人（含 obj欄值）；str鍵 {string}
 * 傳回：{string}
 * ============================================================================
 */
function 取得報到欄位值_(o, str鍵) {
  if (!o) return '';
  const obj欄值 = o.obj欄值 || {};
  switch (str鍵) {
    case '姓名': return o.str姓名 || '';
    case '法名': return o.str法名 || '';
    case '學員編號': return o.str學員編號 || '';
    case '報名登記': return o.str報名登記 || '';
    case '備註': return [提醒簡稱_(o.str提醒), o.str回報 || '', o.str用齋 || ''].filter(Boolean).join('、');
    case '名冊備註': return obj欄值['備註'] || '';
    default: return obj欄值[str鍵] === undefined || obj欄值[str鍵] === null ? '' : String(obj欄值[str鍵]);
  }
}


/**
 * ============================================================================
 * 函式名稱：找出名冊沒有的範本欄_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：範本中「名冊其他欄」（不是標準欄）在這場名冊找不到的欄名，列印時提醒（照樣印空白欄）。
 * 參數：arr欄位 {string[]}；arr名冊標題 {string[]}
 * 傳回：{string[]}
 * ============================================================================
 */
function 找出名冊沒有的範本欄_(arr欄位, arr名冊標題) {
  const obj定義 = obj報到表範本格式.obj欄位定義;
  return (arr欄位 || []).filter(function (s) {
    return !obj定義[s] && (arr名冊標題 || []).indexOf(s) === -1;
  });
}


