/**
 * ============================================================================
 * 函式名稱：讀取自訂報到表範本_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：主控台「模組設定」項目「報到表範本」→ 自訂範本陣列（讀不到當成沒有）。
 * 參數：obj主控台 {Spreadsheet}
 * 傳回：{Object[]}
 * ============================================================================
 */
function 讀取自訂報到表範本_(obj主控台) {
  try { return 解析自訂報到表範本_(讀取模組設定值_(obj主控台, obj報到表範本格式.str設定項目, '').str值); } catch (err) { return []; }
}


/**
 * ============================================================================
 * 函式名稱：取得活動報到表範本_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：這場活動要用的範本（活動清單「報到表範本」欄；空白＝標準；找不到＝標準＋提醒）。
 *       列印報到表與報到表格共用。
 * 參數：obj主控台 {Spreadsheet}；obj活動值 {Object}
 * 傳回：{Object} { obj範本, str提醒 }
 * ============================================================================
 */
function 取得活動報到表範本_(obj主控台, obj活動值) {
  return 找出報到表範本_(讀取自訂報到表範本_(obj主控台), (obj活動值 || {})[obj報到表範本格式.str活動欄]);
}


/**
 * ============================================================================
 * 函式名稱：寫入自訂報到表範本_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：把自訂範本陣列存回「模組設定」（JSON）。
 * 參數：obj工作階段 {Object}；obj主控台 {Spreadsheet}；arr自訂 {Object[]}
 * 傳回：無
 * ============================================================================
 */
function 寫入自訂報到表範本_(obj工作階段, obj主控台, arr自訂) {
  const str = JSON.stringify(arr自訂.map(function (o) { return { str名稱: o.str名稱, arr欄位: o.arr欄位 }; }));
  儲存合併來源設定_(obj工作階段, obj主控台, obj報到表範本格式.str設定項目, str);   // 共用「模組設定」寫入
}


/**
 * ============================================================================
 * 函式名稱：可選報到表欄位_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：設定畫面的「加入欄位」清單（標準欄＋說明）。
 * 傳回：{Object[]} [ { str鍵, str欄名, str說明 } ]
 * ============================================================================
 */
function 可選報到表欄位_() {
  const obj定義 = obj報到表範本格式.obj欄位定義;
  return Object.keys(obj定義).map(function (k) { return { str鍵: k, str欄名: obj定義[k].str欄名, str說明: obj定義[k].str說明 }; });
}


