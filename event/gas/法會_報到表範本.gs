/**
 * ============================================================================
 * 函式名稱：讀取報到表範本
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：action「event.讀取報到表範本」。精舍管理員的範本卡片用：全部範本、可選欄位、
 *       每個範本有幾場活動在用。限精舍管理員（權限 event.管理活動）。
 * 參數：obj工作階段 {Object}；obj參數 {Object} {}
 * 傳回：{Object} { arr範本: [ { str名稱, arr欄位, bool內建, int使用活動數 } ], arr可選欄位 }
 * ============================================================================
 */
function 讀取報到表範本(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.管理活動, '報到表範本');
  const obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);
  const arr活動 = 讀取法會活動清單_(obj主控台);
  const fn使用數 = function (str名稱) {
    return arr活動.filter(function (o) {
      return (String(o.obj值[obj報到表範本格式.str活動欄] || '').trim() || obj報到表範本格式.str預設) === str名稱;
    }).length;
  };
  return {
    arr範本: 列出全部報到表範本_(讀取自訂報到表範本_(obj主控台)).map(function (o) { return Object.assign(o, { int使用活動數: fn使用數(o.str名稱) }); }),
    arr可選欄位: 可選報到表欄位_()
  };
}


/**
 * ============================================================================
 * 函式名稱：儲存報到表範本
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：
 *   action「event.儲存報到表範本」（限精舍管理員）。新增或修改一個自訂範本：
 *     · str原名稱 空白＝新增；有值＝修改那個範本（可改名，用這個範本的活動跟著改名）
 *     · 回傳試算的欄寬：太擠時提醒（以 3 個時段估算）
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str原名稱（選填）, str名稱, arr欄位 }
 * 傳回：{Object} { bool成功, str訊息, arr明細, obj範本 }
 * 錯誤：名稱重複、規則不符、超過 20 個自訂範本 → 參數錯誤
 * ============================================================================
 */
function 儲存報到表範本(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.管理活動, '報到表範本');
  const cfg = obj報到表範本格式;
  const obj新 = 檢查報到表範本_(obj參數 && obj參數.str名稱, obj參數 && obj參數.arr欄位);
  const str原名稱 = String((obj參數 && obj參數.str原名稱) || '').trim();
  const obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);
  let int改名活動 = 0;

  執行並鎖定(function () {
    const arr自訂 = 讀取自訂報到表範本_(obj主控台);
    const int原位置 = str原名稱 === '' ? -1 : arr自訂.findIndex(function (o) { return o.str名稱 === str原名稱; });
    if (str原名稱 !== '' && int原位置 === -1) throw new 平台錯誤(obj錯誤代碼.參數錯誤, `找不到範本「${str原名稱}」，可能已被刪除，請重新整理頁面。`);
    if (arr自訂.some(function (o, i) { return o.str名稱 === obj新.str名稱 && i !== int原位置; })) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, `已經有範本叫「${obj新.str名稱}」，請換一個名稱。`);
    }
    if (int原位置 === -1 && arr自訂.length >= cfg.int最多自訂範本) {
      throw new 平台錯誤(obj錯誤代碼.參數錯誤, `自訂範本最多 ${cfg.int最多自訂範本} 個，請先刪除用不到的範本。`);
    }
    if (int原位置 === -1) arr自訂.push(obj新); else arr自訂[int原位置] = obj新;
    寫入自訂報到表範本_(obj工作階段, obj主控台, arr自訂);

    // 改名：用舊名稱的活動跟著改
    if (int原位置 !== -1 && str原名稱 !== obj新.str名稱) {
      讀取法會活動清單_(obj主控台).forEach(function (o) {
        if (String(o.obj值[cfg.str活動欄] || '').trim() === str原名稱) {
          更新法會活動_(obj主控台, o.obj值['活動ID'], { [cfg.str活動欄]: obj新.str名稱 });
          int改名活動 += 1;
        }
      });
    }
  }, '儲存報到表範本');

  寫入操作日誌(obj工作階段, '儲存報到表範本', `${str原名稱 && str原名稱 !== obj新.str名稱 ? `${str原名稱} → ` : ''}${obj新.str名稱}：${obj新.arr欄位.join('、')}`);
  const arr明細 = [];
  const obj試算 = 展開範本欄位_(obj新.arr欄位, [{ str名稱: '一', str起迄: '' }, { str名稱: '二', str起迄: '' }, { str名稱: '三', str起迄: '' }]);
  if (obj試算.bool擠) arr明細.push('欄位比較多：分 3 個時段的活動，各欄會縮小、字可能擠。建議拿掉一兩個欄位，或改用較短的欄位。');
  if (int改名活動 > 0) arr明細.push(`有 ${int改名活動} 場活動用這個範本，已一起改成新名稱。`);
  return {
    bool成功: true,
    str訊息: `已${範本動作文字_(str原名稱)}範本「${obj新.str名稱}」：${obj新.arr欄位.join('、')}。`,
    arr明細: arr明細,
    obj範本: { str名稱: obj新.str名稱, arr欄位: obj新.arr欄位, bool內建: false }
  };
}


/**
 * ============================================================================
 * 函式名稱：範本動作文字_（內部使用）
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：訊息用字：新增或修改。
 * 參數：str原名稱 {string}
 * 傳回：{string}
 * ============================================================================
 */
function 範本動作文字_(str原名稱) {
  return str原名稱 === '' ? '新增' : '修改';
}


/**
 * ============================================================================
 * 函式名稱：刪除報到表範本
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：action「event.刪除報到表範本」（限精舍管理員）。內建範本不能刪；
 *       用這個範本的活動改回「標準」（活動清單欄位清空）。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str名稱 }
 * 傳回：{Object} { bool成功, str訊息 }
 * ============================================================================
 */
function 刪除報到表範本(obj工作階段, obj參數) {
  檢查權限(obj工作階段, obj法會權限.管理活動, '報到表範本');
  const cfg = obj報到表範本格式;
  const str名稱 = String((obj參數 && obj參數.str名稱) || '').trim();
  if (cfg.arr內建.some(function (o) { return o.str名稱 === str名稱; })) {
    throw new 平台錯誤(obj錯誤代碼.參數錯誤, `「${str名稱}」是內建範本，不能刪除。`);
  }
  const obj主控台 = 開啟法會主控台_(obj工作階段.str精舍代號);
  let int改回 = 0;
  執行並鎖定(function () {
    const arr自訂 = 讀取自訂報到表範本_(obj主控台);
    const int位置 = arr自訂.findIndex(function (o) { return o.str名稱 === str名稱; });
    if (int位置 === -1) throw new 平台錯誤(obj錯誤代碼.參數錯誤, `找不到範本「${str名稱}」，可能已被刪除，請重新整理頁面。`);
    arr自訂.splice(int位置, 1);
    寫入自訂報到表範本_(obj工作階段, obj主控台, arr自訂);
    讀取法會活動清單_(obj主控台).forEach(function (o) {
      if (String(o.obj值[cfg.str活動欄] || '').trim() === str名稱) {
        更新法會活動_(obj主控台, o.obj值['活動ID'], { [cfg.str活動欄]: '' });
        int改回 += 1;
      }
    });
  }, '刪除報到表範本');
  寫入操作日誌(obj工作階段, '刪除報到表範本', str名稱);
  return {
    bool成功: true,
    str訊息: `已刪除範本「${str名稱}」。${int改回 > 0 ? `用這個範本的 ${int改回} 場活動改回「${cfg.str預設}」。` : ''}`
  };
}


/**
 * ============================================================================
 * 函式名稱：設定活動報到表範本
 * 版本：v1.0.0（2026-11-10）
 * ----------------------------------------------------------------------------
 * 用途：action「event.設定活動報到表範本」（承辦人；權限 event.整理資料）。
 *       這場對內活動的紙本報到表與報到表格要用哪個範本（「標準」存成空白）。
 * 參數：obj工作階段 {Object}；obj參數 {Object} { str活動ID, str範本 }
 * 傳回：{Object} { bool成功, str訊息, str範本, arr欄位 }
 * ============================================================================
 */
function 設定活動報到表範本(obj工作階段, obj參數) {
  檢查必要參數(obj參數, ['str活動ID'], '設定報到表範本');
  const cfg = obj報到表範本格式;
  const obj = 取得對內活動_(obj工作階段, String(obj參數.str活動ID).trim(), '設定報到表範本');
  const str名稱 = String(obj參數.str範本 || '').trim() || cfg.str預設;
  const obj找 = 找出報到表範本_(讀取自訂報到表範本_(obj.obj主控台), str名稱);
  if (obj找.str提醒 !== '') throw new 平台錯誤(obj錯誤代碼.參數錯誤, `找不到範本「${str名稱}」，請重新整理頁面後再選。`);
  const str存 = str名稱 === cfg.str預設 ? '' : str名稱;
  if (String(obj.obj活動值[cfg.str活動欄] || '').trim() !== str存) {
    更新法會活動_(obj.obj主控台, obj.obj活動值['活動ID'], { [cfg.str活動欄]: str存 });
    寫入操作日誌(obj工作階段, '設定報到表範本', `${obj.obj活動值['活動ID']} ${obj.obj活動值['活動名稱']}：${str名稱}`);
  }
  return {
    bool成功: true, str範本: str名稱, arr欄位: obj找.obj範本.arr欄位,
    str訊息: `這場活動的報到表改用「${str名稱}」範本：${obj找.obj範本.arr欄位.join('、')}。重新列印報到表就會套用；報到表格重新整理即可看到。`
  };
}
