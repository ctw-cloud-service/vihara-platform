// ============================================================================
// 檔案名稱：法會_報到表範本.gs
// 所屬模組：法會活動（event）
// 所屬層級：模組／服務層＋控制層
// 檔案版本：v1.0.0（2026-11-10）
// 用途說明：
//   紙本報到表（與網頁報到表格）的欄位「範本」（決策 BL）：
//     · 精舍管理員事先建立範本：範本名稱＋欄位順序，例如「義工版：序號、姓名、法名、義工組別、時段、備註」
//     · 承辦人每場對內活動挑一個範本套用（活動清單「報到表範本」欄；空白＝「標準」）
//     · 列印報到表（副本選單、網頁）與報到表格（志工打勾、承辦人補登）都依這場活動的範本排欄
//   內建範本（不能改、不能刪）：
//     標準：序號、姓名、法名、報名登記、時段、備註（與以前的報到表相同）
//     簡易：序號、姓名、法名、時段、備註
//     義工：序號、姓名、法名、義工組別、時段、備註
//   欄位：
//     · 必要：姓名、時段（報到打勾欄，分時段時會展開成每個時段一欄）；姓名要在時段之前
//     · 名冊標準欄：序號、法名、學員編號、性別、報名內容、報名登記、義工組別、需要坐椅子、來源列、報名時間
//     · 備註＝報到備註（提醒簡稱、坐椅子・組別、不參加、用齋）；名冊備註＝名冊「備註」欄全文
//     · 其他：名冊上任何欄名（報名表帶入的班別、承辦人自加的「座位」等），這場名冊沒有這欄時印空白並提醒
//   欄寬自動：每種欄位有預設寬度，時段欄平分剩下的寬度（最多 130 像素）；
//             欄位太多時等比例縮小（最少 32 像素）、時段欄最少 50 像素，並提醒字可能擠。
//   ※ 本檔頂層常數只在本檔使用（依檔名載入順序，其他檔案不可在頂層引用；函式內使用沒問題）。
//
// 相依檔案：
//   平台核心（核心_錯誤、核心_日誌、核心_權限）
//   法會_模組定義（obj法會權限、活動清單、模組設定）、法會_活動管理（讀取模組設定值_、讀取法會活動清單_、更新法會活動_）
//   法會_用齋登記（儲存合併來源設定_：寫「模組設定」共用）、法會_報到名冊（取得對內活動_）
//   法會_報到表（obj報到表格式、提醒簡稱_）
// ============================================================================

const obj報到表範本格式 = Object.freeze({
  str設定項目: '報到表範本',              // 主控台「模組設定」的項目名稱（值＝自訂範本 JSON）
  str活動欄: '報到表範本',                // 活動清單的欄位（值＝範本名稱；空白＝標準）
  str預設: '標準',
  str時段鍵: '時段',                      // 範本中代表「報到打勾欄」的欄位
  int名稱長度: 20,
  int最多欄位: 10,                        // 範本中的欄位數（時段算 1 個）
  int最多自訂範本: 20,
  arr內建: Object.freeze([
    Object.freeze({ str名稱: '標準', arr欄位: Object.freeze(['序號', '姓名', '法名', '報名登記', '時段', '備註']) }),
    Object.freeze({ str名稱: '簡易', arr欄位: Object.freeze(['序號', '姓名', '法名', '時段', '備註']) }),
    Object.freeze({ str名稱: '義工', arr欄位: Object.freeze(['序號', '姓名', '法名', '義工組別', '時段', '備註']) })
  ]),
  // 可選的標準欄位：顯示名稱（印在欄名列）、預設寬度（像素）、說明（設定畫面用）
  obj欄位定義: Object.freeze({
    '序號': Object.freeze({ str欄名: '序號', int寬: 41, str說明: '1、2、3…（空白列接著編）' }),
    '姓名': Object.freeze({ str欄名: '姓名', int寬: 95, str說明: '必要' }),
    '法名': Object.freeze({ str欄名: '法名', int寬: 70, str說明: '' }),
    '學員編號': Object.freeze({ str欄名: '學員編號', int寬: 110, str說明: '' }),
    '性別': Object.freeze({ str欄名: '性別', int寬: 40, str說明: '' }),
    '報名內容': Object.freeze({ str欄名: '報名內容', int寬: 125, str說明: '報名表場次欄填的內容' }),
    '報名登記': Object.freeze({ str欄名: '報名登記', int寬: 125, str說明: '全部時段／報了哪幾個時段' }),
    '義工組別': Object.freeze({ str欄名: '義工組別', int寬: 90, str說明: '執事、組別' }),
    '需要坐椅子': Object.freeze({ str欄名: '坐椅子', int寬: 50, str說明: '是／否' }),
    '來源列': Object.freeze({ str欄名: '來源', int寬: 85, str說明: '表單報名、副會長回報、用齋登記' }),
    '報名時間': Object.freeze({ str欄名: '報名時間', int寬: 90, str說明: '' }),
    '時段': Object.freeze({ str欄名: '時段', int寬: 0, str說明: '必要；報到打勾欄（分時段的活動每個時段一欄）' }),
    '備註': Object.freeze({ str欄名: '備註', int寬: 85, str說明: '提醒簡稱、坐椅子・組別、不參加、用齋' }),
    '名冊備註': Object.freeze({ str欄名: '備註', int寬: 140, str說明: '名冊「備註」欄全文（報名備註、提醒、副會長回報、用齋）' })
  }),
  int自訂欄寬: 80,                        // 名冊其他欄（班別、座位…）的預設寬度
  int最小欄寬: 32,
  int時段最小寬: 50,
  arr小字欄: Object.freeze(['報名內容', '報名登記', '來源列', '備註', '名冊備註', '報名時間', '學員編號'])
});


// ============================================================================
// 甲、純計算（不碰檔案）
